"
`;

exports[`codegen snapshots > settings #1 → scss 1`] = `
"// _settings.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-tpl-split {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p8-space-12);
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-sidenav {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-240);
  box-sizing: border-box;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
