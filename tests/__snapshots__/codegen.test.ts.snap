"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-combobox" data-p8="combobox">
  <input class="p8-combobox__input" type="text" role="combobox" aria-expanded="true" aria-autocomplete="list" placeholder="Search…" aria-label="Search…" />
  <svg class="p8-icon p8-combobox__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 6L8 10L12 6" />
  </svg>
  <div class="p8-combobox__list" role="listbox">
    <button class="p8-combobox__option p8-combobox__option--active" type="button" role="option" tabindex="-1">Apple</button>
    <button class="p8-combobox__option" type="button" role="option" tabindex="-1">Banana</button>
    <button class="p8-combobox__option" type="button" role="option" tabindex="-1">Cherry</button>
    <button class="p8-combobox__option" type="button" role="option" tabindex="-1">Date</button>
  </div>
</div>

<style>
  .p8-combobox {
    position: relative;
    width: var(--p8-size-500);
    max-width: 100%;
  }

  .p8-combobox__input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
    padding-inline-end: var(--p8-space-32);
  }

  .p8-combobox__input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-combobox__input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-combobox__input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-combobox__input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-combobox__icon {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    inset-inline-end: var(--p8-space-12);
    pointer-events: none;
    color: var(--p8-color-ink-muted);
  }

  .p8-combobox__list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--p8-space-8);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    max-height: var(--p8-size-240);
    overflow-y: auto;
  }

  .p8-combobox__list[hidden] {
    display: none;
  }

  .p8-combobox__option {
    text-align: left;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-combobox__option:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-combobox__option:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-combobox__option--active {
    background: var(--p8-color-control-strong);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-combobox__option","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function cbOpts(c) { return Array.from(c.querySelectorAll('[role="option"]')); }
  function cbVis(c) { return cbOpts(c).filter(function (x) { return !x.hidden; }); }
  function cbOpen(c, open) { c.querySelector('[role="listbox"]').hidden = !open; c.querySelector('[role="combobox"]').setAttribute('aria-expanded', String(open)); }
  function cbMark(c, it) { cbOpts(c).forEach(function (x) { setOn(x, x === it); }); }
  function cbPick(c, it) { var i = c.querySelector('input'); i.value = it.textContent; i.dispatchEvent(new Event('change', { bubbles: true })); cbOpen(c, false); cbMark(c, it); }
  root.addEventListener('focusin', function (e) { var c = cl(e, '[data-p8~="combobox"]'); if (c && e.target.tagName === 'INPUT') cbOpen(c, true); }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="combobox"] [role="option"]');
    if (it) { cbPick(it.closest('[data-p8~="combobox"]'), it); return; }
    var c = cl(e, '[data-p8~="combobox"]');
    if (c && e.target.tagName === 'INPUT') cbOpen(c, true);
