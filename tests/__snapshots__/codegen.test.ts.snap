  width: var(--p8-size-400);
  max-width: 100%;
  height: 0;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-divider--vertical {
  width: 0;
  height: var(--p8-size-48);
  border-top: none;
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
}
"
