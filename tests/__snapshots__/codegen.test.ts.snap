<style>
  .p8-dtable {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-dtable__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-dtable__count {
    color: var(--p8-color-ink-muted);
  }

  .p8-dtable__actions {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-popover {
    position: relative;
    display: inline-block;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-popover__panel {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--p8-space-8);
    z-index: 40;
    box-sizing: border-box;
    min-width: var(--p8-size-240);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-popover__panel[hidden] {
    display: none;
  }

  .p8-popover__panel--end {
    left: auto;
    right: 0;
  }

  .p8-dtable__cols {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
  }

  .p8-check {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-check__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink-inverse);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    cursor: inherit;
  }

  .p8-check__box:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-check__box:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-check__box:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-check__box--on {
    background: var(--p8-color-ink);
  }

  .p8-check__box--on:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-check__icon {
    opacity: 0;
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-check__icon--on {
    opacity: 1;
  }

  .p8-dtable__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .p8-dtable__head {
    text-align: left;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    color: var(--p8-color-ink-muted);
    font-weight: var(--p8-type-weight);
    white-space: nowrap;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-dtable__head[hidden] {
    display: none;
  }

  .p8-dtable__head[aria-sort="ascending"] .p8-dtable__arrow {
    opacity: 1;
    rotate: 180deg;
  }

  .p8-dtable__head[aria-sort="descending"] .p8-dtable__arrow {
    opacity: 1;
  }

  .p8-dtable__select {
    width: var(--p8-size-16);
  }

  .p8-dtable__all {
    position: relative;
  }

  .p8-dtable__minus {
    position: absolute;
    inset: 0;
    margin: auto;
    opacity: 0;
  }

  .p8-dtable__sort {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    max-width: 100%;
    padding: 0;
    border: none;
    border-radius: var(--p8-radius-4);
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-dtable__sort:hover:not(:disabled) {
    color: var(--p8-color-ink);
  }

  .p8-dtable__sort:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-dtable__arrow {
    opacity: 0;
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease), rotate var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-dtable__sort:hover .p8-dtable__arrow, .p8-dtable__sort:focus-within .p8-dtable__arrow {
    opacity: 1;
  }

  .p8-dtable__row {
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-dtable__cell {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-dtable__cell[hidden] {
    display: none;
  }
</style>
"
`;

