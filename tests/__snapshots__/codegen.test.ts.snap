"// DropdownMenu.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './dropdown-menu.css';

export function DropdownMenu() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <span ref={ref} className="p8-popover" data-p8="popover" data-select-closes>
      <button className="p8-button" type="button" data-trigger aria-expanded="true" aria-haspopup="menu">Actions</button>
      <div className="p8-popover__panel p8-popover__panel--bare" data-panel>
        <div className="p8-menu" role="menu" data-p8="menu">
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘R">
            Rename
            <span className="p8-menu__shortcut" aria-hidden="true">⌘R</span>
          </button>
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘D">
            Duplicate
            <span className="p8-menu__shortcut" aria-hidden="true">⌘D</span>
          </button>
          <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌫">
            Delete
            <span className="p8-menu__shortcut" aria-hidden="true">⌫</span>
          </button>
        </div>
      </div>
    </span>
  );
}

/* dropdown-menu.css */
.p8-popover {
  position: relative;
  display: inline-block;
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-popover__panel {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: var(--p8-space-8);
  z-index: 40;
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-popover__panel[hidden] {
  display: none;
}

.p8-popover__panel--bare {
  padding: 0;
  background: transparent;
  outline: none;
}

.p8-menu {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
