      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 5" />
      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 6" />
    </div>
  );
