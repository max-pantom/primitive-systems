        </div>
        <div class="p8-chart__area" tabindex="0" role="img" aria-label="Revenue vs costs: bar chart of Revenue, Costs over 6 points. Use the left and right arrow keys to read values." data-plot>
          <svg class="p8-chart__svg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line class="p8-chart__gridline" x1="0" x2="600" y1="0" y2="0" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="25" y2="25" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="50" y2="50" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="75" y2="75" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="100" y2="100" />
            <rect class="p8-chart__band" x="0" y="0" width="100" height="100" data-band />
