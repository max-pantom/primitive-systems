/* file-upload.css */
.p8-upload {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
}

.p8-upload__zone {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  padding-block: var(--p8-space-24);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  text-align: center;
  cursor: pointer;
}

.p8-upload__zone:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-upload__zone:focus-within {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-upload__input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.p8-upload__input:disabled {
  cursor: not-allowed;
}

.p8-upload__list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-upload__list[hidden] {
  display: none;
}

.p8-upload__item {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-upload__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-upload__size {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
