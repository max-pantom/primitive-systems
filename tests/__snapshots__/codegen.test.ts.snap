          <button class="p8-switch" style="position: relative; display: inline-block; flex-shrink: 0; width: var(--p8-size-40); height: var(--p8-size-24); padding: 0; box-sizing: border-box; border-radius: var(--p8-radius-full); border: none; background: var(--p8-color-control-strong); cursor: inherit; transition: background var(--p8-motion-fast) var(--p8-motion-ease)" type="button" role="switch" aria-checked="false">
