        <line x1="9" y1="9" x2="11.5" y2="11.5" />
      </svg>
      <input className="p8-search__input" type="search" placeholder="Search" aria-label="Search" disabled defaultValue="Sample {x} &lt;y&gt;" />
    </div>
  );
}

/* search-input.css */
.p8-search {
  position: relative;
  display: flex;
  align-items: center;
  width: var(--p8-size-500);
  max-width: 100%;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-search__icon {
  position: absolute;
  inset-inline-start: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink-muted);
}

.p8-search__input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  padding-inline-start: var(--p8-space-32);
}

.p8-search__input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-search__input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-search__input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-search__input::placeholder {
  color: var(--p8-color-placeholder);
}
"
`;

