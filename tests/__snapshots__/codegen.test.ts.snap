<div bind:this={el} class="p8-upload" data-p8="upload">
  <div class="p8-upload__zone" data-zone>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2.75 10.75V11.75Q2.75 13.25 4.25 13.25H11.75Q13.25 13.25 13.25 11.75V10.75" />
      <path d="M7.75 8.75V2.75M5.5 5L7.75 2.75L10 5" />
    </svg>
    <span>Drop files here or click to browse</span>
    <span class="p8-upload__hint">Sample {x} &lt;y&gt;</span>
    <input class="p8-upload__input" type="file" aria-label="Drop files here or click to browse" accept="Sample {x} &lt;y&gt;" disabled />
  </div>
  <ul class="p8-upload__list" data-files aria-label="Chosen files" aria-live="polite"></ul>
  <template data-file-template>
    <li class="p8-upload__item">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9.75 1.75H5.25Q3.75 1.75 3.75 3.25V12.75Q3.75 14.25 5.25 14.25H10.75Q12.25 14.25 12.25 12.75V4.25Z" />
        <path d="M9.75 1.75V4.25H12.25" />
        <line x1="6.75" y1="9.75" x2="9.25" y2="9.75" />
      </svg>
      <span class="p8-upload__name">__name__</span>
      <span class="p8-upload__size">__size__</span>
      <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Remove file" data-remove>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
        </svg>
      </button>
    </li>
  </template>
</div>

<style>
  .p8-upload {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
  }

  .p8-upload__zone {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    padding-block: var(--p8-space-24);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    text-align: center;
    cursor: pointer;
  }

  .p8-upload__zone:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-upload__zone:focus-within {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-upload__hint {
    color: var(--p8-color-ink-muted);
  }

  .p8-upload__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .p8-upload__input:disabled {
    cursor: not-allowed;
  }

  .p8-upload__list {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-upload__list[hidden] {
    display: none;
  }

  .p8-upload__item {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
  }

  .p8-upload__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .p8-upload__size {
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
  }

