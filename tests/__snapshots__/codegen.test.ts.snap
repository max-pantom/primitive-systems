<div bind:this={el} class="p8-taginput" data-p8="taginput" data-max="20" data-placeholder="Add a tag…">
  <label class="p8-field__label" for="tag-entry">Tags</label>
  <div class="p8-taginput__field" aria-disabled="true">
    <div class="p8-taginput__list" role="group" aria-label="Tags added" data-chips>
      <span class="p8-tag" data-chip="design">
        design
        <button class="p8-tag__close" type="button" aria-label="Remove design" data-close disabled>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-tag" data-chip="research">
        research
        <button class="p8-tag__close" type="button" aria-label="Remove research" data-close disabled>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
    </div>
    <input class="p8-taginput__entry" id="tag-entry" type="text" placeholder="Add a tag…" autocomplete="off" aria-describedby="tag-help" data-entry disabled />
  </div>
  <div class="p8-taginput__foot">
    <span id="tag-help">Enter or comma to add</span>
    <span aria-live="polite" data-count>2 / 20</span>
  </div>
  <input type="hidden" name="tags" value="design,research" data-value />
  <template data-chip-template>
    <span class="p8-tag" data-chip="__tag__">
      __tag__
      <button class="p8-tag__close" type="button" aria-label="Remove __tag__" data-close disabled>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
