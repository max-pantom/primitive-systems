<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-dtable" data-p8="datatable">
  <div class="p8-dtable__bar">
    <span class="p8-dtable__count" aria-live="polite" data-count>4 rows</span>
  </div>
  <table class="p8-dtable__table">
    <thead>
      <tr>
        <th class="p8-dtable__head" scope="col" aria-sort="none" data-col="0">
          <button class="p8-dtable__sort" type="button" data-sort="0">
            Name
            <svg class="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 5.5L7 9L10.5 5.5" />
            </svg>
          </button>
        </th>
        <th class="p8-dtable__head" scope="col" aria-sort="none" data-col="1">
          <button class="p8-dtable__sort" type="button" data-sort="1">
            Role
            <svg class="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 5.5L7 9L10.5 5.5" />
            </svg>
          </button>
        </th>
        <th class="p8-dtable__head" scope="col" aria-sort="none" data-col="2">
          <button class="p8-dtable__sort" type="button" data-sort="2">
            Joined
            <svg class="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 5.5L7 9L10.5 5.5" />
            </svg>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      <tr class="p8-dtable__row" data-row="0">
        <td class="p8-dtable__cell" data-col="0" title="Ada Lovelace">Ada Lovelace</td>
        <td class="p8-dtable__cell" data-col="1" title="Engineer">Engineer</td>
        <td class="p8-dtable__cell" data-col="2" title="2024-03-12">2024-03-12</td>
      </tr>
      <tr class="p8-dtable__row" data-row="1">
        <td class="p8-dtable__cell" data-col="0" title="Grace Hopper">Grace Hopper</td>
        <td class="p8-dtable__cell" data-col="1" title="Admiral">Admiral</td>
        <td class="p8-dtable__cell" data-col="2" title="2023-11-02">2023-11-02</td>
      </tr>
      <tr class="p8-dtable__row" data-row="2">
        <td class="p8-dtable__cell" data-col="0" title="Alan Turing">Alan Turing</td>
        <td class="p8-dtable__cell" data-col="1" title="Researcher">Researcher</td>
        <td class="p8-dtable__cell" data-col="2" title="2025-01-20">2025-01-20</td>
      </tr>
      <tr class="p8-dtable__row" data-row="3">
        <td class="p8-dtable__cell" data-col="0" title="Katherine Johnson">Katherine Johnson</td>
        <td class="p8-dtable__cell" data-col="1" title="Analyst">Analyst</td>
        <td class="p8-dtable__cell" data-col="2" title="2024-07-08">2024-07-08</td>
      </tr>
    </tbody>
  </table>
</div>

<style>
  .p8-dtable {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
