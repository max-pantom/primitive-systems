  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-check__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink-inverse);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  cursor: inherit;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
}

.p8-check__box--on {
  background: var(--p8-color-ink);
  &:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }
}

.p8-check__icon {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-check__icon--on {
  opacity: 1;
}

.p8-dtable__table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.p8-dtable__head {
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
  white-space: nowrap;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  &[hidden] {
    display: none;
  }
  &[aria-sort="ascending"] .p8-dtable__arrow {
    opacity: 1;
    rotate: 180deg;
  }
  &[aria-sort="descending"] .p8-dtable__arrow {
    opacity: 1;
  }
}

.p8-dtable__select {
  width: var(--p8-size-16);
}

.p8-dtable__all {
  position: relative;
}

.p8-dtable__minus {
  position: absolute;
  inset: 0;
  margin: auto;
  opacity: 0;
}

.p8-dtable__sort {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  max-width: 100%;
  padding: 0;
  border: none;
  border-radius: var(--p8-radius-4);
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  &:hover:not(:disabled) {
    color: var(--p8-color-ink);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-dtable__arrow {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease), rotate var(--p8-motion-fast) var(--p8-motion-ease);
  .p8-dtable__sort:hover &, .p8-dtable__sort:focus-within & {
    opacity: 1;
  }
}

.p8-dtable__row {
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-dtable__cell {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  &[hidden] {
    display: none;
  }
}

