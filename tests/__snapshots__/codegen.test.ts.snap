    inset: 0;
    margin: auto;
    width: 0;
    height: 100%;
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-resize__handle[aria-orientation="horizontal"] {
    cursor: row-resize;
  }

  .p8-resize__handle[aria-orientation="horizontal"]::before {
    width: 100%;
    height: 0;
    border-left: none;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }
</style>
