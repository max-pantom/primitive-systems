</div>

<style>
  .p8-search {
    position: relative;
    display: flex;
    align-items: center;
    width: var(--p8-size-500);
    max-width: 100%;
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-search__icon {
    position: absolute;
    inset-inline-start: var(--p8-space-12);
    pointer-events: none;
    color: var(--p8-color-ink-muted);
  }

