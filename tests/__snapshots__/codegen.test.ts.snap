exports[`codegen snapshots > dashboard #0 → svelte 1`] = `
"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="action"] [data-action]');
      if (!b || b.disabled) return;
      b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
    }, { signal: ac.signal });

    var chColors = ['color-ink', 'color-ink-muted', 'color-placeholder'];
    function chData(c) { try { return JSON.parse(c.getAttribute('data-chart')); } catch (err) { return { labels: [], series: [] }; } }
    function chOff(c, i) { var g = c.querySelector('[data-series="' + i + '"]'); return !!(g && g.hasAttribute('data-off')); }
    function chShow(c, idx) {
      var d = chData(c), n = d.labels.length, band = c.querySelector('[data-band]'), tip = c.querySelector('[data-tip]'), live = c.querySelector('[data-live]');
      if (idx === null || idx < 0 || idx >= n) { band.removeAttribute('data-show'); tip.hidden = true; return; }
      c.__idx = idx;
      band.setAttribute('x', String(idx * 100)); band.setAttribute('data-show', '');
      tip.textContent = '';
      var h = document.createElement('strong'); h.textContent = d.labels[idx]; tip.appendChild(h);
      var spoken = [];
      d.series.forEach(function (s, i) {
        if (chOff(c, i)) return;
        var tpl = c.querySelector('template[data-row]'), row = ((tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild).cloneNode(true);
        row.firstElementChild.style.background = 'var(--p8-' + chColors[i] + ')';
        row.lastElementChild.textContent = s.name + ': ' + s.values[idx];
        tip.appendChild(row); spoken.push(s.name + ' ' + s.values[idx]);
      });
      tip.hidden = false;
      var pct = (idx + 0.5) / n * 100;
      tip.style.left = pct + '%'; tip.style.translate = pct > 60 ? '-100% 0' : '0 0';
      live.textContent = d.labels[idx] + ': ' + spoken.join(', ');
    }
    function chIndex(plot, e) { var d = chData(plot.closest('[data-p8~="chart"]')), r = plot.getBoundingClientRect(); return Math.min(d.labels.length - 1, Math.max(0, Math.floor((e.clientX - r.left) / (r.width || 1) * d.labels.length))); }
    root.addEventListener('pointermove', function (e) {
      var plot = cl(e, '[data-p8~="chart"] [data-plot]');
      if (plot) chShow(plot.closest('[data-p8~="chart"]'), chIndex(plot, e));
    }, { signal: ac.signal });
    root.addEventListener('pointerleave', function (e) {
      var c = cl(e, '[data-p8~="chart"]');
      if (c && !c.contains(doc.activeElement)) chShow(c, null);
    }, { signal: ac.signal, capture: true });
    root.addEventListener('keydown', function (e) {
      var plot = cl(e, '[data-p8~="chart"] [data-plot]');
      if (!plot) return;
      var c = plot.closest('[data-p8~="chart"]'), n = chData(c).labels.length, i = c.__idx === undefined ? -1 : c.__idx;
      if (e.key === 'ArrowRight') i = Math.min(n - 1, i + 1); else if (e.key === 'ArrowLeft') i = Math.max(0, i < 0 ? 0 : i - 1);
      else if (e.key === 'Home') i = 0; else if (e.key === 'End') i = n - 1;
      else if (e.key === 'Escape') { chShow(c, null); return; } else return;
      e.preventDefault();
      chShow(c, i);
    }, { signal: ac.signal });
    root.addEventListener('blur', function (e) { var c = cl(e, '[data-p8~="chart"]'); if (c && e.target.matches && e.target.matches('[data-plot]')) chShow(c, null); }, { signal: ac.signal, capture: true });
    root.addEventListener('click', function (e) {
      var k = cl(e, '[data-p8~="chart"] [data-key]');
      if (!k) return;
      var c = k.closest('[data-p8~="chart"]'), i = k.getAttribute('data-key'), g = c.querySelector('[data-series="' + i + '"]');
      var on = k.getAttribute('aria-pressed') === 'true';
      var visible = c.querySelectorAll('[data-key][aria-pressed="true"]').length;
      if (on && visible <= 1) return;
      k.setAttribute('aria-pressed', String(!on));
      if (on) g.setAttribute('data-off', ''); else g.removeAttribute('data-off');
      if (c.__idx !== undefined && !c.querySelector('[data-tip]').hidden) chShow(c, c.__idx);
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-tpl-page" data-p8="action">
  <div class="p8-tpl-bar">
    <h1 class="p8-heading">Overview</h1>
    <button class="p8-button p8-button--primary" type="button" data-action="New report">New report</button>
  </div>
  <div class="p8-tpl-grid">
    <div class="p8-stat">
      <span class="p8-stat__label">Revenue</span>
      <span class="p8-stat__value">12,400</span>
      <span class="p8-stat__change">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 8.5L7 5L10.5 8.5" />
        </svg>
        12%
      </span>
    </div>
    <div class="p8-stat">
      <span class="p8-stat__label">Signups</span>
      <span class="p8-stat__value">1,820</span>
      <span class="p8-stat__change">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 8.5L7 5L10.5 8.5" />
        </svg>
        4%
      </span>
    </div>
    <div class="p8-stat">
      <span class="p8-stat__label">Churn</span>
      <span class="p8-stat__value">2.1%</span>
      <span class="p8-stat__change">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 5.5L7 9L10.5 5.5" />
        </svg>
        0.3%
      </span>
    </div>
  </div>
  <div class="p8-tpl-wide">
    <figure class="p8-chart" data-p8="chart" data-chart="{&quot;labels&quot;:[&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;],&quot;series&quot;:[{&quot;name&quot;:&quot;Revenue&quot;,&quot;values&quot;:[120,150,170,140,190,230]},{&quot;name&quot;:&quot;Costs&quot;,&quot;values&quot;:[80,95,110,100,120,130]}]}">
      <div class="p8-chart__head">
        <figcaption class="p8-chart__title">Revenue vs costs</figcaption>
        <div class="p8-chart__legend" role="group" aria-label="Series">
          <button class="p8-chart__key" type="button" aria-pressed="true" data-key="0">
            <span class="p8-chart__swatch" style="background: var(--p8-color-ink)"></span>
            Revenue
          </button>
          <button class="p8-chart__key" type="button" aria-pressed="true" data-key="1">
            <span class="p8-chart__swatch" style="background: var(--p8-color-ink-muted)"></span>
            Costs
          </button>
        </div>
      </div>
      <div class="p8-chart__plot">
        <div class="p8-chart__y" aria-hidden="true">
          <span>250</span>
          <span>187.5</span>
          <span>125</span>
          <span>62.5</span>
          <span>0</span>
        </div>
        <div class="p8-chart__area" tabindex="0" role="img" aria-label="Revenue vs costs: bar chart of Revenue, Costs over 6 points. Use the left and right arrow keys to read values." data-plot>
          <svg class="p8-chart__svg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line class="p8-chart__gridline" x1="0" x2="600" y1="0" y2="0" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="25" y2="25" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="50" y2="50" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="75" y2="75" />
            <line class="p8-chart__gridline" x1="0" x2="600" y1="100" y2="100" />
            <rect class="p8-chart__band" x="0" y="0" width="100" height="100" data-band />
            <g class="p8-chart__series" data-series="0">
              <rect class="p8-chart__s1" x="20" y="52" width="26" height="48" rx="2" data-bar />
              <rect class="p8-chart__s1" x="120" y="40" width="26" height="60" rx="2" data-bar />
              <rect class="p8-chart__s1" x="220" y="32" width="26" height="68" rx="2" data-bar />
              <rect class="p8-chart__s1" x="320" y="44" width="26" height="56" rx="2" data-bar />
              <rect class="p8-chart__s1" x="420" y="24" width="26" height="76" rx="2" data-bar />
              <rect class="p8-chart__s1" x="520" y="8" width="26" height="92" rx="2" data-bar />
            </g>
            <g class="p8-chart__series" data-series="1">
              <rect class="p8-chart__s2" x="50" y="68" width="26" height="32" rx="2" data-bar />
              <rect class="p8-chart__s2" x="150" y="62" width="26" height="38" rx="2" data-bar />
              <rect class="p8-chart__s2" x="250" y="56" width="26" height="44" rx="2" data-bar />
              <rect class="p8-chart__s2" x="350" y="60" width="26" height="40" rx="2" data-bar />
              <rect class="p8-chart__s2" x="450" y="52" width="26" height="48" rx="2" data-bar />
              <rect class="p8-chart__s2" x="550" y="48" width="26" height="52" rx="2" data-bar />
            </g>
          </svg>
          <div class="p8-chart__tip" data-tip hidden aria-hidden="true"></div>
        </div>
        <div class="p8-chart__x" style="grid-template-columns: repeat(6, minmax(0, 1fr))" aria-hidden="true">
          <span>Jan</span>
          <span>Feb</span>
          <span>Mar</span>
          <span>Apr</span>
          <span>May</span>
