"// SidebarNav.tsx — Requires the Primitive Systems theme variables (theme.css).
import './sidebar-nav.css';

export function SidebarNav() {
  return (
    <nav className="p8-sidenav" aria-label="Sidebar">
      <div className="p8-sidenav__heading">Workspace</div>
      <a className="p8-sidenav__item p8-sidenav__item--active" href="#" aria-current="page">Overview</a>
      <a className="p8-sidenav__item" href="#">Projects</a>
      <a className="p8-sidenav__item" href="#">Settings</a>
    </nav>
  );
}

/* sidebar-nav.css */
.p8-sidenav {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-240);
  box-sizing: border-box;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-sidenav__heading {
  padding-inline: var(--p8-space-12);
  padding-block: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
}

.p8-sidenav__item {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  color: var(--p8-color-ink-muted);
  text-decoration: none;
}

.p8-sidenav__item:hover:not(:disabled) {
  color: var(--p8-color-ink);
  background: var(--p8-color-control);
}

.p8-sidenav__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-sidenav__item--active {
  color: var(--p8-color-ink);
  background: var(--p8-color-control-strong);
}
"
`;

