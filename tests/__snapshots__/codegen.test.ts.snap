import './toolbar.css';

export function Toolbar() {
  return (
    <div className="p8-toolbar" role="toolbar">
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="edit">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <polygon points="3,10 10,3 13,6 6,13 2.75,13.25" />
          <line x1="8.5" y1="4.5" x2="11.5" y2="7.5" />
        </svg>
      </button>
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="copy">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M5.75 3.25Q5.75 1.75 7.25 1.75H12.75Q14.25 1.75 14.25 3.25V8.75Q14.25 10.25 12.75 10.25" />
          <rect x="1.75" y="5.75" width="8.5" height="8.5" rx="2.5" />
        </svg>
      </button>
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="download">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M2.75 10.75V11.75Q2.75 13.25 4.25 13.25H11.75Q13.25 13.25 13.25 11.75V10.75" />
          <path d="M7.75 2.75V8.75M5.5 6.5L7.75 8.75L10 6.5" />
        </svg>
      </button>
      <div className="p8-divider p8-divider--vertical" role="separator" aria-orientation="vertical"></div>
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="star">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
        </svg>
      </button>
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="trash">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M3.75 6.75L4.25 12.25Q4.3 13.25 5.75 13.25H10.25Q11.7 13.25 11.75 12.25L12.25 6.75" />
          <path d="M2.75 5.75H13.25M5.75 5.75V2.75H10.25V5.75" />
          <line x1="7.75" y1="8.75" x2="7.75" y2="10.25" />
        </svg>
      </button>
    </div>
  );
}

/* toolbar.css */
.p8-toolbar {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-divider {
  flex-shrink: 0;
  width: var(--p8-size-400);
  max-width: 100%;
  height: 0;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-divider--vertical {
  width: 0;
  height: var(--p8-size-48);
  border-top: none;
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
}
"
`;

