"// InfiniteList.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './infinite-list.css';

export function InfiniteList() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-infinite" data-p8="infinite" data-page="1" data-size="10" data-total="40" data-demo="true">
      <div className="p8-infinite__scroller" tabIndex="0" role="region" aria-label="Results list" data-scroller>
        <ul className="p8-infinite__list" data-list aria-label="Results">
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1024</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1023</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1022</span>
            <span className="p8-infinite__meta">Refunded</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1021</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1020</span>
            <span className="p8-infinite__meta">Pending</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1019</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1018</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
          <li className="p8-infinite__item" data-item>
            <span className="p8-infinite__title">Order 1017</span>
            <span className="p8-infinite__meta">Paid</span>
          </li>
        </ul>
        <div className="p8-infinite__foot" data-foot>
          <button className="p8-button p8-button--ghost p8-button--block" type="button" data-more>Load more</button>
        </div>
        <p className="p8-infinite__end" data-end hidden>You have reached the end</p>
      </div>
      <p className="p8-infinite__status" role="status" data-status>Showing 8 of 40</p>
      <template data-item-template>
        <li className="p8-infinite__item" data-item>
          <span className="p8-infinite__title">__title__</span>
          <span className="p8-infinite__meta">__meta__</span>
        </li>
      </template>
    </div>
  );
}

/* infinite-list.css */
.p8-infinite {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  width: var(--p8-size-400);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-infinite__scroller {
  height: var(--p8-size-320);
  overflow-y: auto;
  border-radius: var(--p8-radius-12);
  overscroll-behavior: contain;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-infinite__scroller:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-infinite__list {
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-infinite__item {
  display: flex;
  justify-content: space-between;
  gap: var(--p8-space-12);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-16);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-infinite__title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-infinite__meta {
  color: var(--p8-color-ink-muted);
  white-space: nowrap;
}

.p8-infinite__foot {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-16);
}

.p8-infinite__foot[hidden] {
  display: none;
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
