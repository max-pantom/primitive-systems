// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-shell p8-shell--framed" data-p8="shell nav action">
  <aside class="p8-shell__side" aria-label="Sidebar">
    <div class="p8-shell__side-head">
      <span class="p8-shell__brand">
        <span class="p8-shell__logo" aria-hidden="true"></span>
        Acme
      </span>
