"// _image-viewer.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-gallery {
  width: var(--p8-size-400);
  max-width: 100%;
}

.p8-gallery__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--p8-space-8);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-gallery__thumb {
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  overflow: hidden;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  cursor: zoom-in;
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:hover img {
    opacity: var(--p8-opacity-hover);
  }
}

.p8-gallery__img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  background: var(--p8-color-backdrop);
  box-sizing: border-box;
  padding: var(--p8-space-24);
  &[hidden] {
    display: none;
  }
}

.p8-lightbox {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-500);
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  padding: var(--p8-space-16);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-lightbox__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-lightbox__counter {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-lightbox__nav {
  display: flex;
  gap: var(--p8-space-8);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-iconbtn--flat {
  background: transparent;
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
}

.p8-icon {
  flex-shrink: 0;
}

.p8-lightbox__figure {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  margin: 0;
  min-height: 0;
}

.p8-lightbox__img {
  flex: 1 1 auto;
  min-height: 0;
  display: block;
  width: 100%;
  max-height: 60vh;
  object-fit: contain;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-lightbox__caption {
  display: flex;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

