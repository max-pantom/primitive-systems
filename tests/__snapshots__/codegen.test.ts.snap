"// SwatchPicker.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './swatch-picker.css';

export function SwatchPicker() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-swatches" role="radiogroup" aria-label="Colour" data-p8="group">
      <button className="p8-swatch p8-swatch--ink p8-swatch--on" type="button" role="radio" aria-checked="true" aria-label="ink" tabIndex="0"></button>
      <button className="p8-swatch p8-swatch--ink-muted" type="button" role="radio" aria-checked="false" aria-label="ink-muted" tabIndex="-1"></button>
      <button className="p8-swatch p8-swatch--control-strong" type="button" role="radio" aria-checked="false" aria-label="control-strong" tabIndex="-1"></button>
      <button className="p8-swatch p8-swatch--control" type="button" role="radio" aria-checked="false" aria-label="control" tabIndex="-1"></button>
      <button className="p8-swatch p8-swatch--canvas" type="button" role="radio" aria-checked="false" aria-label="canvas" tabIndex="-1"></button>
    </div>
  );
}

/* swatch-picker.css */
.p8-swatches {
  display: inline-flex;
  gap: var(--p8-space-12);
}

.p8-swatch {
  width: var(--p8-size-24);
  height: var(--p8-size-24);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-full);
  border: none;
  background: var(--p8-color-control);
  cursor: pointer;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-swatch:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-swatch:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-swatch--ink {
  background: var(--p8-color-ink);
}

.p8-swatch--on {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-space-2);
}

.p8-swatch--ink-muted {
  background: var(--p8-color-ink-muted);
}

.p8-swatch--control-strong {
  background: var(--p8-color-control-strong);
}

.p8-swatch--control {
  background: var(--p8-color-control);
}

.p8-swatch--canvas {
  background: var(--p8-color-canvas);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-swatch","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  var ITEM = '[data-p8~="group"] [role="tab"], [data-p8~="group"] [role="radio"]';
  function gItems(g) { return Array.from(g.querySelectorAll('[role="tab"], [role="radio"]')); }
  function gSelect(g, it) {
    gItems(g).forEach(function (x) {
      var on = x === it;
      x.setAttribute(x.getAttribute('role') === 'tab' ? 'aria-selected' : 'aria-checked', String(on));
      x.tabIndex = on ? 0 : -1;
      [x].concat(Array.from(x.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
    });
  }
  root.addEventListener('click', function (e) {
    var it = cl(e, ITEM);
    if (it && !it.disabled) gSelect(it.closest('[data-p8~="group"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var it = cl(e, ITEM);
    if (!it) return;
    var g = it.closest('[data-p8~="group"]');
    var list = gItems(g).filter(function (x) { return !x.disabled; });
    var i = list.indexOf(it), k = e.key;
    if (k === 'ArrowRight' || k === 'ArrowDown') i = (i + 1) % list.length;
    else if (k === 'ArrowLeft' || k === 'ArrowUp') i = (i - 1 + list.length) % list.length;
    else if (k === 'Home') i = 0;
    else if (k === 'End') i = list.length - 1;
    else return;
    e.preventDefault();
    gSelect(g, list[i]);
    list[i].focus();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
