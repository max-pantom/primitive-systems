"// FileUpload.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './file-upload.css';

export function FileUpload() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-upload" data-p8="upload">
      <div className="p8-upload__zone" data-zone>
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M2.75 10.75V11.75Q2.75 13.25 4.25 13.25H11.75Q13.25 13.25 13.25 11.75V10.75" />
          <path d="M7.75 8.75V2.75M5.5 5L7.75 2.75L10 5" />
        </svg>
        <span>Drop files here or click to browse</span>
        <span className="p8-upload__hint">Sample {'{'}x{'}'} &lt;y&gt;</span>
        <input className="p8-upload__input" type="file" aria-label="Drop files here or click to browse" accept="Sample {x} &lt;y&gt;" disabled />
      </div>
      <ul className="p8-upload__list" data-files aria-label="Chosen files" aria-live="polite"></ul>
      <template data-file-template>
        <li className="p8-upload__item">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M9.75 1.75H5.25Q3.75 1.75 3.75 3.25V12.75Q3.75 14.25 5.25 14.25H10.75Q12.25 14.25 12.25 12.75V4.25Z" />
            <path d="M9.75 1.75V4.25H12.25" />
            <line x1="6.75" y1="9.75" x2="9.25" y2="9.75" />
          </svg>
          <span className="p8-upload__name">__name__</span>
          <span className="p8-upload__size">__size__</span>
          <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Remove file" data-remove>
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
              <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
            </svg>
          </button>
        </li>
      </template>
    </div>
  );
}

/* file-upload.css */
.p8-upload {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
}

.p8-upload__zone {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  padding-block: var(--p8-space-24);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  text-align: center;
  cursor: pointer;
}

.p8-upload__zone:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-upload__zone:focus-within {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-upload__hint {
  color: var(--p8-color-ink-muted);
}

.p8-upload__input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}

.p8-upload__input:disabled {
  cursor: not-allowed;
}

.p8-upload__list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-upload__list[hidden] {
  display: none;
}

.p8-upload__item {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-upload__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-upload__size {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function uSize(n) { return n < 1024 ? n + ' B' : n < 1048576 ? (n / 1024).toFixed(1) + ' KB' : (n / 1048576).toFixed(1) + ' MB'; }
  function uFiles(u) { return u.__files || Array.from(u.querySelector('input[type="file"]').files || []); }
  function uRender(u) {
    var list = u.querySelector('[data-files]'), tpl = u.querySelector('template[data-file-template]');
    var src = (tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild;
    list.textContent = '';
    uFiles(u).forEach(function (f, i) {
      var li = src.cloneNode(true), spans = li.querySelectorAll('span');
      spans[0].textContent = f.name; spans[1].textContent = uSize(f.size);
      var b = li.querySelector('[data-remove]'); b.setAttribute('data-index', String(i)); b.setAttribute('aria-label', 'Remove ' + f.name);
      list.appendChild(li);
    });
  }
  root.addEventListener('change', function (e) {
    var u = cl(e, '[data-p8~="upload"]');
    if (!u || e.target.type !== 'file') return;
    u.__files = null; uRender(u);
  }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="upload"] [data-remove]');
    if (!b) return;
    var u = b.closest('[data-p8~="upload"]'), idx = Number(b.getAttribute('data-index'));
    u.__files = uFiles(u).filter(function (f, i) { return i !== idx; });
    try { var dt = new DataTransfer(); u.__files.forEach(function (f) { dt.items.add(f); }); u.querySelector('input[type="file"]').files = dt.files; } catch (err) { }
    uRender(u);
  }, { signal: ac.signal });
  ['dragenter', 'dragover'].forEach(function (t) { root.addEventListener(t, function (e) {
    var z = cl(e, '[data-p8~="upload"] [data-zone]');
    if (!z) return;
    e.preventDefault();
    if (!z.querySelector('input').disabled) z.classList.add('p8-upload__zone--over');
  }, { signal: ac.signal }); });
  root.addEventListener('dragleave', function (e) { var z = cl(e, '[data-p8~="upload"] [data-zone]'); if (z && !z.contains(e.relatedTarget)) z.classList.remove('p8-upload__zone--over'); }, { signal: ac.signal });
  root.addEventListener('drop', function (e) {
    var z = cl(e, '[data-p8~="upload"] [data-zone]');
    if (!z) return;
    e.preventDefault(); z.classList.remove('p8-upload__zone--over');
    var inp = z.querySelector('input');
    if (inp.disabled || !e.dataTransfer) return;
    var files = Array.from(e.dataTransfer.files), accept = inp.accept.toLowerCase().split(',').map(function (v) { return v.trim(); }).filter(Boolean);
    files = files.filter(function (f) { return !accept.length || accept.some(function (a) { return a[0] === '.' ? f.name.toLowerCase().endsWith(a) : a.endsWith('/*') ? f.type.toLowerCase().startsWith(a.slice(0, -1)) : f.type.toLowerCase() === a; }); });
    if (!inp.multiple) files = files.slice(0, 1);
    var dt = new DataTransfer(); files.forEach(function (f) { dt.items.add(f); }); inp.files = dt.files;
    inp.dispatchEvent(new Event('change', { bubbles: true }));
