    <a class="p8-sidenav__item [padding-block:var(--p8-space-8)] [padding-inline:var(--p8-space-12)] [border-radius:var(--p8-radius-8)] [color:var(--p8-color-ink-muted)] [text-decoration:none] enabled:hover:[color:var(--p8-color-ink)] enabled:hover:[background:var(--p8-color-control)] focus-visible:[box-shadow:0_0_0_var(--p8-border-focus)_var(--p8-color-ring-focus)]" href="#">Billing</a>
  </nav>
  <div class="[display:flex] [flex-direction:column] [gap:var(--p8-space-12)] [box-sizing:border-box] [width:100%] [max-width:var(--p8-size-500)] [color:var(--p8-color-ink)] [flex:1_1_var(--p8-size-320)] [min-width:0]">
