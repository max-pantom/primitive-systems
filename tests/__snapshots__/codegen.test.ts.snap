/* data-table.css */
.p8-dtable {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-dtable__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-dtable__count {
  color: var(--p8-color-ink-muted);
}

.p8-dtable__table {
  width: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.p8-dtable__head {
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
  white-space: nowrap;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-dtable__head[hidden] {
  display: none;
}

.p8-dtable__head[aria-sort="ascending"] .p8-dtable__arrow {
  opacity: 1;
  rotate: 180deg;
}

.p8-dtable__head[aria-sort="descending"] .p8-dtable__arrow {
  opacity: 1;
}

.p8-dtable__sort {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  max-width: 100%;
  padding: 0;
  border: none;
  border-radius: var(--p8-radius-4);
  background: transparent;
  color: inherit;
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-dtable__sort:hover:not(:disabled) {
  color: var(--p8-color-ink);
}

.p8-dtable__sort:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-dtable__arrow {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease), rotate var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-dtable__sort:hover .p8-dtable__arrow, .p8-dtable__sort:focus-within .p8-dtable__arrow {
  opacity: 1;
}

.p8-dtable__row {
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-dtable__cell {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-dtable__cell[hidden] {
  display: none;
}

