    <div className="p8-field">
      <label className="p8-field__label" htmlFor="field">Message</label>
      <textarea className="p8-textarea" id="field" rows="6" placeholder="Placeholder" disabled defaultValue="Sample {x} &lt;y&gt;"></textarea>
    </div>
  );
}

/* textarea.css */
.p8-field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  font-family: var(--p8-type-family);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-textarea {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  box-shadow: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  resize: vertical;
}

.p8-textarea:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-textarea:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}

.p8-textarea:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-textarea::placeholder {
  color: var(--p8-color-placeholder);
}
"
`;

