"// Navbar.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './navbar.css';

export function Navbar() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <header ref={ref} className="p8-navbar" data-p8="nav action">
      <a className="p8-navbar__brand" href="/">
        <span className="p8-navbar__logo" aria-hidden="true"></span>
        Acme
      </a>
      <nav className="p8-navbar__links" aria-label="Main">
        <a className="p8-navbar__link" href="#overview" data-nav>Overview</a>
        <a className="p8-navbar__link p8-navbar__link--active" href="#projects" data-nav aria-current="page">Projects</a>
        <a className="p8-navbar__link" href="#team" data-nav>Team</a>
        <a className="p8-navbar__link" href="#settings" data-nav>Settings</a>
      </nav>
      <div className="p8-navbar__right">
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Search" data-action="search">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="7" cy="7" r="4.25" />
            <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
          </svg>
        </button>
        <button className="p8-button p8-button--primary" type="button" data-action="New project">
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
            <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
          </svg>
          New project
        </button>
        <span className="p8-avatar" role="img" aria-label="Ada Lovelace">AL</span>
      </div>
    </header>
  );
}

/* navbar.css */
.p8-navbar {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  width: 100%;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-16);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-navbar__brand {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  flex-shrink: 0;
  color: var(--p8-color-ink);
  font-weight: var(--p8-type-weight-strong);
  text-decoration: none;
  border-radius: var(--p8-radius-4);
}

.p8-navbar__brand:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-navbar__logo {
  width: var(--p8-size-24);
  height: var(--p8-size-24);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-ink);
}

.p8-navbar__links {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.p8-navbar__link {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  color: var(--p8-color-ink-muted);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-navbar__link:hover:not(:disabled) {
  color: var(--p8-color-ink);
  background: var(--p8-color-control);
}

.p8-navbar__link:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-navbar__link--active {
  color: var(--p8-color-ink);
  background: var(--p8-color-control-strong);
}

.p8-navbar__right {
  display: flex;
