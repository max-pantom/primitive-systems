"---
// Requires the Primitive Systems theme variables (theme.css).
---

<form class="p8-form" novalidate aria-label="Sample {x} &lt;y&gt;" data-p8="form action" data-success="Account created.">
  <h2 class="p8-form__title">Sample {x} &lt;y&gt;</h2>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-full-name">Full name</label>
    <input class="p8-input p8-form__control" id="form-full-name" name="full-name" aria-describedby="form-full-name-error" data-field="Full name" required aria-required="true" disabled type="text" autocomplete="name" />
    <p class="p8-form__error" id="form-full-name-error" data-error></p>
  </div>
  <div class="p8-form__field">
