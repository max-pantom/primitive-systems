"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-taginput" data-p8="taginput" data-max="10" data-placeholder="Add a tag…">
  <label class="p8-field__label" for="tag-entry">Tags</label>
  <div class="p8-taginput__field">
    <div class="p8-taginput__list" role="group" aria-label="Tags added" data-chips>
      <span class="p8-tag" data-chip="design">
        design
        <button class="p8-tag__close" type="button" aria-label="Remove design" data-close>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-tag" data-chip="research">
        research
        <button class="p8-tag__close" type="button" aria-label="Remove research" data-close>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
    </div>
    <input class="p8-taginput__entry" id="tag-entry" type="text" placeholder="Add a tag…" autocomplete="off" aria-describedby="tag-help" data-entry />
  </div>
  <div class="p8-taginput__foot">
    <span id="tag-help">Enter or comma to add</span>
    <span aria-live="polite" data-count>2 / 10</span>
  </div>
  <input type="hidden" name="tags" value="design,research" data-value />
  <template data-chip-template>
    <span class="p8-tag" data-chip="__tag__">
      __tag__
      <button class="p8-tag__close" type="button" aria-label="Remove __tag__" data-close>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
        </svg>
      </button>
    </span>
  </template>
</div>

<style>
  .p8-taginput {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    width: var(--p8-size-500);
    max-width: 100%;
    font-family: var(--p8-type-family);
  }

  .p8-field__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
    color: var(--p8-color-ink);
  }

  .p8-taginput__field {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
    cursor: text;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-taginput__field:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-taginput__field:focus-within {
    background: var(--p8-color-control-strong);
  }

  .p8-taginput__field[aria-disabled="true"] {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-taginput__list {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    flex-shrink: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .p8-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-tag__close {
    display: inline-flex;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--p8-radius-4);
  }

  .p8-tag__close:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-taginput__entry {
    flex: 1;
    min-width: var(--p8-size-64);
    box-sizing: border-box;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    outline: none;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-taginput__entry:disabled {
    cursor: not-allowed;
  }

  .p8-taginput__entry::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-taginput__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function tiEl(t, sel) { return t.querySelector(sel); }
  function tiTags(t) { return Array.from(t.querySelectorAll('[data-chips] [data-chip]')).map(function (c) { return c.getAttribute('data-chip'); }); }
  function tiSync(t) {
    var tags = tiTags(t), max = Number(t.getAttribute('data-max')) || 10, entry = tiEl(t, '[data-entry]');
    tiEl(t, '[data-value]').value = tags.join(',');
    tiEl(t, '[data-count]').textContent = tags.length + ' / ' + max;
    entry.placeholder = tags.length >= max ? 'Limit reached' : (t.getAttribute('data-placeholder') || '');
    t.dispatchEvent(new CustomEvent('p8-change', { bubbles: true, detail: { tags: tags } }));
  }
  function tiAdd(t, raw) {
    var label = raw.replace(/,/g, '').trim(), max = Number(t.getAttribute('data-max')) || 10, tags = tiTags(t);
    if (!label || tags.length >= max || tags.some(function (x) { return x.toLowerCase() === label.toLowerCase(); })) return false;
    var tpl = tiEl(t, 'template[data-chip-template]');
    var src = (tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild;
    var chip = src.cloneNode(true);
    chip.setAttribute('data-chip', label); chip.firstChild.textContent = label;
    chip.querySelector('[data-close]').setAttribute('aria-label', 'Remove ' + label);
    tiEl(t, '[data-chips]').appendChild(chip);
    return true;
  }
  root.addEventListener('keydown', function (e) {
    var en = cl(e, '[data-p8~="taginput"] [data-entry]');
    if (!en) return;
    var t = en.closest('[data-p8~="taginput"]');
    if ((e.key === 'Enter' || e.key === ',') && !e.isComposing) { e.preventDefault(); if (tiAdd(t, en.value)) { en.value = ''; tiSync(t); } else if (!en.value.trim()) return; else en.value = ''; }
    else if (e.key === 'Backspace' && !en.value) { var chips = t.querySelectorAll('[data-chips] [data-chip]'); if (chips.length) { chips[chips.length - 1].remove(); tiSync(t); } }
  }, { signal: ac.signal });
  root.addEventListener('paste', function (e) {
    var en = cl(e, '[data-p8~="taginput"] [data-entry]');
    if (!en) return;
    var text = (e.clipboardData && e.clipboardData.getData('text')) || '';
    if (text.indexOf(',') < 0 && text.indexOf('\\n') < 0) return;
    e.preventDefault();
    var t = en.closest('[data-p8~="taginput"]'), any = false;
    text.split(/[,\\n]/).forEach(function (x) { if (tiAdd(t, x)) any = true; });
    if (any) tiSync(t);
  }, { signal: ac.signal });
  root.addEventListener('focusout', function (e) {
    var en = cl(e, '[data-p8~="taginput"] [data-entry]');
    if (en && en.value.trim()) { var t = en.closest('[data-p8~="taginput"]'); if (tiAdd(t, en.value)) { en.value = ''; tiSync(t); } }
  }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var t = cl(e, '[data-p8~="taginput"]');
    if (!t) return;
    var close = cl(e, '[data-p8~="taginput"] [data-chip] [data-close]');
    if (close) { close.closest('[data-chip]').remove(); tiSync(t); tiEl(t, '[data-entry]').focus(); return; }
    if (cl(e, '[data-p8~="taginput"] [data-chips]') === null) { var en = tiEl(t, '[data-entry]'); if (!en.disabled) en.focus(); }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
