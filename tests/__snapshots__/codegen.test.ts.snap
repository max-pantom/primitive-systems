      <button class="p8-button p8-button--ghost" type="button" data-action="retry">Try again</button>
    </p>
  </div>
</article>

<style>
  .p8-chatmsg {
    display: flex;
    align-items: flex-start;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-chatmsg--user {
    flex-direction: row-reverse;
  }

  .p8-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
