exports[`codegen snapshots > stepper #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<ol class="p8-stepper">
  <li class="p8-stepper__step">
    <span class="p8-stepper__dot p8-stepper__dot--done">
      <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 7L5.5 10L11.5 4" />
      </svg>
    </span>
    Account
  </li>
  <li class="p8-stepper__line" aria-hidden="true"></li>
  <li class="p8-stepper__step" aria-current="step">
    <span class="p8-stepper__dot p8-stepper__dot--now">2</span>
    Plan
  </li>
  <li class="p8-stepper__line" aria-hidden="true"></li>
  <li class="p8-stepper__step">
    <span class="p8-stepper__dot">3</span>
    Confirm
  </li>
</ol>

<style>
  .p8-stepper {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
  }

  .p8-stepper__step {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
  }

  .p8-stepper__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--p8-size-24);
    height: var(--p8-size-24);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink-muted);
    flex-shrink: 0;
  }

  .p8-stepper__dot--done {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-stepper__line {
    flex: 1;
    min-width: var(--p8-size-24);
    height: 0;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-stepper__dot--now {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }
</style>
"
`;

