  }

  .p8-copybtn--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-copybtn__icon {
    display: none;
  }

  .p8-copybtn__icon--on {
    display: block;
  }
</style>

