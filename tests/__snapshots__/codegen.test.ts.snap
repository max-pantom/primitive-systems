      <button class="p8-iconbtn p8-iconbtn--flat" style="display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; padding-block: var(--p8-space-8); padding-inline: var(--p8-space-12); border-radius: var(--p8-radius-8); border: none; background: transparent; color: var(--p8-color-ink); cursor: pointer" type="button" aria-label="Mark &quot;Invite accepted&quot; as read" data-read>
        <svg style="flex-shrink: 0" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
