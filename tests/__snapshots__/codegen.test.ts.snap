            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-tag" data-chip="Priority: High">
        Priority: High
        <button class="p8-tag__close" type="button" aria-label="Remove Priority: High" data-close disabled>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-filters__empty" data-empty hidden>No filters</span>
    </div>
    <button class="p8-button p8-button--ghost" type="button" data-clear disabled>Clear all</button>
  </div>
  <template data-chip-template>
    <span class="p8-tag" data-chip="__label__">
      __label__
      <button class="p8-tag__close" type="button" aria-label="Remove __label__" data-close disabled>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
