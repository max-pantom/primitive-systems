            <th class="p8-table__head" scope="col">Owner</th>
            <th class="p8-table__head" scope="col">When</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p8-table__cell">Invoice 1042 paid</td>
            <td class="p8-table__cell">Ada</td>
