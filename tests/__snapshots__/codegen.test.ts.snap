  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-row--interactive {
  cursor: pointer;
}

.p8-row--interactive:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-row--interactive:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-row__lead {
  color: var(--p8-color-ink-muted);
  display: inline-flex;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-row__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-row__title {
  font-weight: var(--p8-type-weight-strong);
}

.p8-row__meta {
  color: var(--p8-color-ink-muted);
}

.p8-row__end {
  display: inline-flex;
  color: var(--p8-color-ink-muted);
}
"
