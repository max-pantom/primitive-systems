"// Banner.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './banner.css';

export function Banner() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-banner p8-banner--inverted" role="region" aria-label="Announcement" data-p8="dismiss">
      <span className="p8-banner__text">A short announcement.</span>
      <button className="p8-banner__close" type="button" aria-label="Dismiss" data-close>
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <line x1="4" y1="4" x2="12" y2="12" />
          <line x1="12" y1="4" x2="4" y2="12" />
        </svg>
      </button>
    </div>
  );
}

/* banner.css */
.p8-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: 100%;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  background: var(--p8-color-surface);
