exports[`codegen snapshots > chart #1 → react 1`] = `
"// Chart.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './chart.css';

export function Chart() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <figure ref={ref} className="p8-chart" data-p8="chart" data-chart="{&quot;labels&quot;:[&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;],&quot;series&quot;:[{&quot;name&quot;:&quot;Revenue&quot;,&quot;values&quot;:[120,150,170,140,190,230]},{&quot;name&quot;:&quot;Costs&quot;,&quot;values&quot;:[80,95,110,100,120,130]}]}">
      <div className="p8-chart__head">
        <figcaption className="p8-chart__title">Revenue vs costs</figcaption>
      </div>
      <div className="p8-chart__plot">
        <div className="p8-chart__y" aria-hidden="true">
          <span>250</span>
          <span>187.5</span>
          <span>125</span>
          <span>62.5</span>
          <span>0</span>
        </div>
        <div className="p8-chart__area" tabIndex="0" role="img" aria-label="Revenue vs costs: area chart of Revenue, Costs over 6 points. Use the left and right arrow keys to read values." data-plot>
          <svg className="p8-chart__svg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <line className="p8-chart__gridline" x1="0" x2="600" y1="0" y2="0" />
            <line className="p8-chart__gridline" x1="0" x2="600" y1="25" y2="25" />
            <line className="p8-chart__gridline" x1="0" x2="600" y1="50" y2="50" />
            <line className="p8-chart__gridline" x1="0" x2="600" y1="75" y2="75" />
            <line className="p8-chart__gridline" x1="0" x2="600" y1="100" y2="100" />
            <rect className="p8-chart__band" x="0" y="0" width="100" height="100" data-band />
            <g className="p8-chart__series" data-series="0">
              <path className="p8-chart__s1" d="M50 52 L150 40 L250 32 L350 44 L450 24 L550 8 L550 100 L50 100 Z" data-fill />
              <path className="p8-chart__s1" d="M50 52 L150 40 L250 32 L350 44 L450 24 L550 8" data-line />
            </g>
            <g className="p8-chart__series" data-series="1">
              <path className="p8-chart__s2" d="M50 68 L150 62 L250 56 L350 60 L450 52 L550 48 L550 100 L50 100 Z" data-fill />
              <path className="p8-chart__s2" d="M50 68 L150 62 L250 56 L350 60 L450 52 L550 48" data-line />
            </g>
          </svg>
          <div className="p8-chart__tip" data-tip hidden aria-hidden="true"></div>
        </div>
        <div className="p8-chart__x" style={{ gridTemplateColumns: "repeat(6, minmax(0, 1fr))" }} aria-hidden="true">
          <span>Jan</span>
          <span>Feb</span>
          <span>Mar</span>
          <span>Apr</span>
          <span>May</span>
          <span>Jun</span>
        </div>
      </div>
      <p className="p8-chart__sr" aria-live="polite" data-live></p>
      <template data-row>
        <div className="p8-chart__tip-row">
          <span className="p8-chart__swatch"></span>
          <span></span>
        </div>
      </template>
      <table className="p8-chart__sr">
        <caption>Revenue vs costs</caption>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">Revenue</th>
            <th scope="col">Costs</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Jan</th>
            <td>120</td>
            <td>80</td>
          </tr>
          <tr>
            <th scope="row">Feb</th>
            <td>150</td>
            <td>95</td>
          </tr>
          <tr>
            <th scope="row">Mar</th>
            <td>170</td>
            <td>110</td>
          </tr>
          <tr>
            <th scope="row">Apr</th>
            <td>140</td>
            <td>100</td>
          </tr>
          <tr>
            <th scope="row">May</th>
            <td>190</td>
            <td>120</td>
          </tr>
          <tr>
            <th scope="row">Jun</th>
            <td>230</td>
            <td>130</td>
          </tr>
        </tbody>
      </table>
    </figure>
  );
}

/* chart.css */
.p8-chart {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-chart__title {
  margin: 0;
  font-weight: var(--p8-type-weight);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-chart__plot {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: var(--p8-space-8);
  row-gap: var(--p8-space-4);
}

.p8-chart__y {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: var(--p8-size-160);
  color: var(--p8-color-ink-muted);
  text-align: right;
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-chart__area {
  position: relative;
  height: var(--p8-size-160);
  border-radius: var(--p8-radius-4);
  cursor: crosshair;
}

.p8-chart__area:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-chart__svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.p8-chart__gridline {
  stroke: var(--p8-color-ring);
  stroke-width: var(--p8-border-hairline);
  vector-effect: non-scaling-stroke;
}

.p8-chart__band {
  fill: var(--p8-color-control);
  opacity: 0;
}

.p8-chart__band[data-show] {
  opacity: 1;
}

.p8-chart__series[data-off] {
  display: none;
}

.p8-chart__s1 {
  fill: var(--p8-color-ink);
  stroke: var(--p8-color-ink);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.p8-chart__s1[data-line] {
  fill: none;
}

.p8-chart__s1[data-fill] {
  stroke: none;
  fill-opacity: 0.15;
}

.p8-chart__s1[data-bar] {
  stroke: none;
}

.p8-chart__s2 {
  fill: var(--p8-color-ink-muted);
  stroke: var(--p8-color-ink-muted);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.p8-chart__s2[data-line] {
  fill: none;
}

.p8-chart__s2[data-fill] {
  stroke: none;
  fill-opacity: 0.15;
}

.p8-chart__s2[data-bar] {
  stroke: none;
}

.p8-chart__tip {
  position: absolute;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  min-width: var(--p8-size-160);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  pointer-events: none;
  translate: -50% 0;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__tip[hidden] {
  display: none;
}

.p8-chart__x {
  display: grid;
  color: var(--p8-color-ink-muted);
  text-align: center;
  grid-column: 2;
}

.p8-chart__sr {
