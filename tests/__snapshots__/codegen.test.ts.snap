  .p8-tree__item:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-tree__item:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-tree__item--on .p8-tree__chev {
    rotate: 90deg;
  }

  .p8-tree__chev {
    display: inline-flex;
    width: var(--p8-icon-sm);
    height: var(--p8-icon-sm);
    flex-shrink: 0;
    color: var(--p8-color-ink-muted);
    transition: rotate var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-tree__icon {
    display: inline-flex;
    color: var(--p8-color-ink-muted);
  }

  .p8-tree__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
