    <span class="p8-daterange__sep" aria-hidden="true">–</span>
    <input class="p8-input p8-daterange__input" type="text" inputmode="numeric" placeholder="YYYY-MM-DD" aria-label="End date" data-end value="2026-11-14" />
    <button class="p8-iconbtn p8-iconbtn--ghost" type="button" aria-label="Choose dates" data-trigger aria-expanded="true" aria-haspopup="dialog">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2.75" y="4.75" width="10.5" height="8.5" rx="2.5" />
        <path d="M2.75 8.75H13.25M5.75 2.75V5.25M10.25 2.75V5.25" />
