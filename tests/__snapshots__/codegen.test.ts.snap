"// RichText.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './rich-text.css';

export function RichText() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-rich" data-p8="richtext">
      <div className="p8-rich__bar" role="toolbar" aria-label="Notes formatting" aria-controls="rich-editor">
        <button className="p8-rich__btn p8-rich__btn--bold" type="button" data-cmd="bold" aria-label="Bold" aria-pressed="false" tabIndex="0">B</button>
        <button className="p8-rich__btn p8-rich__btn--italic" type="button" data-cmd="italic" aria-label="Italic" aria-pressed="false" tabIndex="-1">I</button>
        <button className="p8-rich__btn p8-rich__btn--underline" type="button" data-cmd="underline" aria-label="Underline" aria-pressed="false" tabIndex="-1">U</button>
        <span className="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
        <button className="p8-rich__btn" type="button" data-cmd="h2" aria-label="Heading" aria-pressed="false" tabIndex="-1">H</button>
        <button className="p8-rich__btn" type="button" data-cmd="quote" aria-label="Quote" aria-pressed="false" tabIndex="-1">“</button>
        <span className="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
        <button className="p8-rich__btn" type="button" data-cmd="ul" aria-label="Bulleted list" aria-pressed="false" tabIndex="-1">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="3" cy="4" r="1" fill="currentColor" stroke="none" />
            <circle cx="3" cy="8" r="1" fill="currentColor" stroke="none" />
            <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none" />
            <path d="M7.75 3.75H13.25M7.75 7.75H13.25M7.75 12.25H13.25" />
          </svg>
        </button>
        <button className="p8-rich__btn" type="button" data-cmd="ol" aria-label="Numbered list" aria-pressed="false" tabIndex="-1">1.</button>
        <span className="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
        <button className="p8-rich__btn" type="button" data-cmd="link" aria-label="Link" aria-pressed="false" tabIndex="-1">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M6.5 4.5L8 3A3.535 3.535 0 0 1 13 8L11.5 9.5M4.5 6.5L3 8A3.535 3.535 0 0 0 8 13L9.5 11.5" />
            <line x1="5.5" y1="10.5" x2="10.5" y2="5.5" />
          </svg>
        </button>
        <span className="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
        <button className="p8-rich__btn" type="button" data-cmd="undo" aria-label="Undo" aria-pressed="false" tabIndex="-1">Undo</button>
        <button className="p8-rich__btn" type="button" data-cmd="redo" aria-label="Redo" aria-pressed="false" tabIndex="-1">Redo</button>
      </div>
      <div className="p8-rich__link" data-linkbar role="group" aria-label="Add link" hidden>
        <input className="p8-input p8-rich__link-field" type="url" placeholder="https://" aria-label="Link address" data-url />
        <button className="p8-rich__btn" type="button" data-link-apply>Apply</button>
        <button className="p8-rich__btn" type="button" data-link-cancel>Cancel</button>
        <p className="p8-rich__error" role="alert" data-linkerr hidden></p>
      </div>
      <div className="p8-rich__editor p8-rich__editor--h8" id="rich-editor" role="textbox" aria-multiline="true" aria-label="Notes" data-placeholder="Start writing…" tabIndex="0" contentEditable="true" data-editor>
        <p>Write something worth reading.</p>
        <p>Select some text to format it.</p>
      </div>
      <p className="p8-rich__sr" role="status" aria-live="polite" data-live></p>
    </div>
  );
}

/* rich-text.css */
.p8-rich {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-rich__bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-rich__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--p8-size-32);
  height: var(--p8-size-32);
  box-sizing: border-box;
  padding-inline: var(--p8-space-12);
  padding-block: 0;
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink-muted);
  cursor: pointer;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-rich__btn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
}

.p8-rich__btn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-rich__btn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-rich__btn--bold {
  font-weight: var(--p8-type-weight-strong);
}

.p8-rich__btn--italic {
  font-style: italic;
}

.p8-rich__btn--underline {
  text-decoration: underline;
}

.p8-rich__sep {
  width: 0;
  height: var(--p8-size-16);
  margin-inline: var(--p8-space-4);
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-rich__link {
  position: absolute;
  top: var(--p8-size-40);
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-rich__link[hidden] {
  display: none;
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-rich__link-field {
  flex: 1 1 auto;
  min-width: var(--p8-size-160);
}

.p8-rich__error {
  margin: 0;
  flex-basis: 100%;
  color: var(--p8-color-ink);
  font-weight: var(--p8-type-weight);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-rich__error[hidden] {
  display: none;
}

.p8-rich__editor {
  box-sizing: border-box;
  overflow-y: auto;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  outline: none;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-rich__editor:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-rich__editor:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-rich__editor:empty::before {
  content: attr(data-placeholder);
  color: var(--p8-color-placeholder);
  pointer-events: none;
}

.p8-rich__editor h2 {
  margin: 0 0 var(--p8-space-8);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-rich__editor p {
  margin: 0 0 var(--p8-space-8);
}

.p8-rich__editor blockquote {
  margin: 0 0 var(--p8-space-8);
  padding-inline-start: var(--p8-space-12);
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  color: var(--p8-color-ink-muted);
}

.p8-rich__editor ul {
  margin: 0 0 var(--p8-space-8);
  padding-inline-start: var(--p8-space-24);
}

.p8-rich__editor ol {
  margin: 0 0 var(--p8-space-8);
  padding-inline-start: var(--p8-space-24);
}

.p8-rich__editor a {
  color: var(--p8-color-ink);
  text-decoration: underline;
}

.p8-rich__editor > :last-child {
  margin-bottom: 0;
}

.p8-rich__editor--h8 {
  min-height: var(--p8-size-160);
}

.p8-rich__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

