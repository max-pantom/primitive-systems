        <line class="p8-chart__gridline" x1="0" x2="600" y1="50" y2="50" />
        <line class="p8-chart__gridline" x1="0" x2="600" y1="75" y2="75" />
        <line class="p8-chart__gridline" x1="0" x2="600" y1="100" y2="100" />
        <rect class="p8-chart__band" x="0" y="0" width="100" height="100" data-band />
        <g class="p8-chart__series" data-series="0">
          <path class="p8-chart__s1" d="M50 52 L150 40 L250 32 L350 44 L450 24 L550 8 L550 100 L50 100 Z" data-fill />
          <path class="p8-chart__s1" d="M50 52 L150 40 L250 32 L350 44 L450 24 L550 8" data-line />
        </g>
        <g class="p8-chart__series" data-series="1">
          <path class="p8-chart__s2" d="M50 68 L150 62 L250 56 L350 60 L450 52 L550 48 L550 100 L50 100 Z" data-fill />
          <path class="p8-chart__s2" d="M50 68 L150 62 L250 56 L350 60 L450 52 L550 48" data-line />
        </g>
