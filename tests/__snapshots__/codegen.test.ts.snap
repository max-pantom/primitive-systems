"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


    all('[data-p8~="carousel"]').forEach(function (c) {
      var tr = c.querySelector('[data-track]'), prev = c.querySelector('[data-dir="-1"]'), next = c.querySelector('[data-dir="1"]');
      function upd() { prev.disabled = tr.scrollLeft <= 1; next.disabled = tr.scrollLeft + tr.clientWidth >= tr.scrollWidth - 1; }
      tr.addEventListener('scroll', upd, { signal: ac.signal });
      upd();
    });
    function cGo(c, dir) { var tr = c.querySelector('[data-track]'); if (tr.scrollBy) tr.scrollBy({ left: dir * tr.clientWidth, behavior: 'smooth' }); else tr.scrollLeft += dir * tr.clientWidth; }
    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="carousel"] [data-dir]');
      if (b && !b.disabled) cGo(b.closest('[data-p8~="carousel"]'), Number(b.getAttribute('data-dir')));
    }, { signal: ac.signal });
    root.addEventListener('keydown', function (e) {
      var tr = cl(e, '[data-p8~="carousel"] [data-track]');
      if (!tr || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
      e.preventDefault();
      cGo(tr.closest('[data-p8~="carousel"]'), e.key === 'ArrowRight' ? 1 : -1);
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-carousel" role="region" aria-roledescription="carousel" aria-label="Carousel" data-p8="carousel">
  <div class="p8-carousel__track" data-track tabindex="0" aria-label="Slides">
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="1 of 8">Slide 1</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="2 of 8">Slide 2</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="3 of 8">Slide 3</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="4 of 8">Slide 4</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="5 of 8">Slide 5</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="6 of 8">Slide 6</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="7 of 8">Slide 7</div>
    <div class="p8-carousel__slide p8-carousel__slide--half" role="group" aria-roledescription="slide" aria-label="8 of 8">Slide 8</div>
  </div>
  <div class="p8-carousel__nav">
    <button class="p8-iconbtn" type="button" aria-label="Previous slide" disabled data-dir="-1">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 4L6 8L10 12" />
      </svg>
    </button>
    <button class="p8-iconbtn" type="button" aria-label="Next slide" data-dir="1">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 4L10 8L6 12" />
      </svg>
    </button>
  </div>
</div>

<style>
  .p8-carousel {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-400);
    max-width: 100%;
  }

  .p8-carousel__track {
    display: flex;
    gap: var(--p8-space-12);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--p8-radius-8);
  }

  .p8-carousel__track:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .p8-carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: var(--p8-size-160);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-carousel__slide--half {
    flex: 0 0 calc((100% - var(--p8-space-12)) / 2);
  }

  .p8-carousel__nav {
    display: flex;
    justify-content: flex-end;
    gap: var(--p8-space-8);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-icon {
    flex-shrink: 0;
  }
</style>
"
`;

