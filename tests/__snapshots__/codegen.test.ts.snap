"// Timer.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './timer.css';

export function Timer() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-timer" role="timer" aria-label="Countdown" data-p8="timer" data-mode="countdown" data-seconds="90">
      <span className="p8-timer__time" data-time>01:30</span>
      <span className="p8-timer__actions">
        <button className="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="toggle">Start</button>
        <button className="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="reset">Reset</button>
      </span>
    </div>
  );
}

/* timer.css */
.p8-timer {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-12);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight);
}

.p8-timer__time {
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  font-weight: var(--p8-type-weight-strong);
  font-variant-numeric: tabular-nums;
  min-width: var(--p8-size-64);
  text-align: center;
}

.p8-timer__actions {
  display: inline-flex;
  gap: var(--p8-space-8);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
