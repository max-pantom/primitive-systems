<style>
  .p8-popover {
    position: relative;
    display: inline-block;
  }

  .p8-datepicker {
    position: relative;
    display: inline-block;
    width: var(--p8-size-500);
    max-width: 100%;
  }

  .p8-datepicker__field {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
    padding-inline-end: var(--p8-space-32);
  }

  .p8-datepicker__field:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-datepicker__field:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-datepicker__field:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-datepicker__field::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-datepicker__trigger {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    inset-inline-end: var(--p8-space-4);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-popover__panel {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--p8-space-8);
    z-index: 40;
    box-sizing: border-box;
    min-width: var(--p8-size-240);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-popover__panel[hidden] {
    display: none;
  }

  .p8-cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
    margin-bottom: var(--p8-space-8);
  }

  .p8-cal__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--p8-space-4);
    text-align: center;
  }

  .p8-cal__dow {
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-cal__day {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--p8-size-32);
    height: var(--p8-size-32);
    padding: 0;
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-cal__day:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-cal__day:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-cal__day--out {
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

