`;

exports[`codegen snapshots > dashboard #0 → scss 1`] = `
"// _dashboard.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-tpl-page {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-tpl-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
  &:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }
}

.p8-tpl-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--p8-size-160), 1fr));
  gap: var(--p8-space-12);
}

.p8-stat {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
