"// ResizablePanels.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './resizable-panels.css';

export function ResizablePanels() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-resize p8-resize--vertical" data-p8="resize">
      <div className="p8-resize__pane p8-resize__pane--first" data-pane style={{ flexBasis: "70%" }}>
        <span className="p8-resize__title">Navigation</span>
        <span>Placeholder content</span>
      </div>
      <div className="p8-resize__handle" role="separator" tabIndex="0" aria-orientation="horizontal" aria-label="Resize Navigation and Content" aria-valuenow="70" aria-valuemin="20" aria-valuemax="80" data-handle></div>
      <div className="p8-resize__pane">
        <span className="p8-resize__title">Content</span>
        <span>Placeholder content</span>
      </div>
    </div>
  );
}

