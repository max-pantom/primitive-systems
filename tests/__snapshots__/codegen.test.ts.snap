      <path d="M2.75 5.75H13.25M5.75 5.75V2.75H10.25V5.75" />
      <line x1="7.75" y1="8.75" x2="7.75" y2="10.25" />
    </svg>
  </button>
</div>

<style>
  .p8-toolbar {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    border-radius: var(--p8-radius-12);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-divider {
    flex-shrink: 0;
    width: var(--p8-size-400);
    max-width: 100%;
    height: 0;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-divider--vertical {
    width: 0;
    height: var(--p8-size-48);
    border-top: none;
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  }
</style>
"
`;

