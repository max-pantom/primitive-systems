        <span class="p8-menu__shortcut" aria-hidden="true">⌫</span>
      </button>
    </div>
  </div>
</span>

<style>
  .p8-popover {
    position: relative;
    display: inline-block;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
