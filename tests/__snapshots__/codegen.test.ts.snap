          <path d="M7.75 8.75V2.75M5.5 5L7.75 2.75L10 5" />
        </svg>
        <span>Drop files here or click to browse</span>
        <input className="p8-upload__input" type="file" aria-label="Drop files here or click to browse" multiple />
      </div>
      <ul className="p8-upload__list" data-files aria-label="Chosen files" aria-live="polite"></ul>
      <template data-file-template>
        <li className="p8-upload__item">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M9.75 1.75H5.25Q3.75 1.75 3.75 3.25V12.75Q3.75 14.25 5.25 14.25H10.75Q12.25 14.25 12.25 12.75V4.25Z" />
