    <div class="p8-mcal__nav">
      <button class="p8-button p8-button--ghost" type="button" data-today-btn>Today</button>
      <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Previous month" data-dir="-1">
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 4L6 8L10 12" />
        </svg>
      </button>
      <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Next month" data-dir="1">
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 4L10 8L6 12" />
