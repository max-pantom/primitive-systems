"---
// Requires the Primitive Systems theme variables (theme.css).
---

<header class="p8-navbar" data-p8="nav action">
  <a class="p8-navbar__brand" href="/">
    <span class="p8-navbar__logo" aria-hidden="true"></span>
    Acme
  </a>
  <nav class="p8-navbar__links" aria-label="Main">
    <a class="p8-navbar__link" href="#overview" data-nav>Overview</a>
    <a class="p8-navbar__link p8-navbar__link--active" href="#projects" data-nav aria-current="page">Projects</a>
    <a class="p8-navbar__link" href="#team" data-nav>Team</a>
    <a class="p8-navbar__link" href="#settings" data-nav>Settings</a>
  </nav>
  <div class="p8-navbar__right">
    <button class="p8-button p8-button--primary" type="button" data-action="New project">
      <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
        <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
      </svg>
      New project
    </button>
    <span class="p8-avatar" role="img" aria-label="Ada Lovelace">AL</span>
  </div>
</header>

<style>
  .p8-navbar {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
    width: 100%;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    flex-shrink: 0;
    color: var(--p8-color-ink);
    font-weight: var(--p8-type-weight-strong);
    text-decoration: none;
    border-radius: var(--p8-radius-4);
  }

  .p8-navbar__brand:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-navbar__logo {
    width: var(--p8-size-24);
    height: var(--p8-size-24);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-ink);
  }

  .p8-navbar__links {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .p8-navbar__link {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    color: var(--p8-color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-navbar__link:hover:not(:disabled) {
    color: var(--p8-color-ink);
    background: var(--p8-color-control);
  }

  .p8-navbar__link:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-navbar__link--active {
    color: var(--p8-color-ink);
    background: var(--p8-color-control-strong);
  }

  .p8-navbar__right {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    flex-shrink: 0;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    width: var(--p8-size-32);
    height: var(--p8-size-32);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
