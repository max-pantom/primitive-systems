    var it = cl(e, '[data-p8~="rating"] [role="radio"]');
    if (it && !it.disabled) rSet(it.closest('[data-p8~="rating"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var it = cl(e, '[data-p8~="rating"] [role="radio"]');
    if (!it) return;
