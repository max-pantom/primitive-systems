"// Dialog.tsx — Requires the Primitive Systems theme variables (theme.css).
import './dialog.css';

export function Dialog() {
  return (
    <div className="p8-dialog" role="dialog" aria-modal="true">
      <div>
        <h2 className="p8-dialog__title">Dialog title</h2>
        <p className="p8-dialog__body">Explain what happens when the user confirms.</p>
      </div>
      <div className="p8-dialog__footer">
        <button className="p8-button p8-button--ghost" type="button">Cancel</button>
        <button className="p8-button p8-button--primary" type="button">Confirm</button>
      </div>
    </div>
  );
}

/* dialog.css */
.p8-dialog {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-16);
  box-sizing: border-box;
