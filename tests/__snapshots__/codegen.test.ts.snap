exports[`codegen snapshots > command-palette #1 → svelte 1`] = `
"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
    var PAIRS = [["p8-palette__item","--active"]];
    function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

    function pOpts(p) { return Array.from(p.querySelectorAll('[role="option"]')).filter(function (x) { return !x.hidden && !x.closest('[hidden]') && !x.closest('template'); }); }
    function pMark(p, it) { Array.from(p.querySelectorAll('[role="option"]')).forEach(function (x) { setOn(x, x === it); }); }
    function pLabel(x) { var l = x.querySelector('[data-label]'); return (l || x).textContent.trim(); }
    function pFilter(p, q) {
      var empty = p.querySelector('[data-empty]'), any = false;
      Array.from(p.querySelectorAll('[role="group"]')).forEach(function (g) {
        var recent = g.getAttribute('data-group') === 'recent', n = 0;
        Array.from(g.querySelectorAll('[role="option"]')).forEach(function (x) { var show = recent ? !q : pLabel(x).toLowerCase().indexOf(q) >= 0; x.hidden = !show; if (show) n++; });
        var hasRecent = recent && g.querySelectorAll('[role="option"]').length > 0;
        g.hidden = recent ? !(hasRecent && !q) : n === 0;
        if (n) any = true;
      });
      if (empty) empty.hidden = any;
      pMark(p, pOpts(p)[0]);
    }
    function pRun(p, it) {
      var label = pLabel(it), section = it.getAttribute('data-section') || '';
      var rg = p.querySelector('[data-group="recent"]'), tpl = p.querySelector('template[data-item-template]');
      if (rg && tpl) {
        Array.from(rg.querySelectorAll('[role="option"]')).forEach(function (x) { if (pLabel(x) === label) x.remove(); });
        var src = (tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild, c = src.cloneNode(true);
        c.querySelector('[data-label]').textContent = label; c.setAttribute('data-section', 'Recent');
        var h = it.querySelector('span:not([data-label])'); if (h) c.appendChild(h.cloneNode(true));
        var heading = rg.querySelector('[aria-hidden]'); rg.insertBefore(c, heading ? heading.nextSibling : rg.firstChild);
        Array.from(rg.querySelectorAll('[role="option"]')).slice(3).forEach(function (x) { x.remove(); });
        rg.setAttribute('aria-label', 'Recent');
      }
      p.dispatchEvent(new CustomEvent('p8-run', { bubbles: true, detail: { command: label, section: section } }));
      var inp = p.querySelector('input'); if (inp) { inp.value = ''; pFilter(p, ''); }
      var o = p.closest('[data-p8~="overlay"]'); if (o) o.hidden = true;
    }
    root.addEventListener('input', function (e) {
      var p = cl(e, '[data-p8~="palette"]');
      if (!p || e.target.tagName !== 'INPUT') return;
      pFilter(p, e.target.value.toLowerCase().trim());
    }, { signal: ac.signal });
    root.addEventListener('keydown', function (e) {
      var p = cl(e, '[data-p8~="palette"]');
      if (!p) return;
      var list = pOpts(p), cur = list.findIndex(function (x) { return x.classList.contains('p8-palette__item--active'); });
      if (e.key === 'ArrowDown') cur = (cur + 1) % list.length;
      else if (e.key === 'ArrowUp') cur = (cur - 1 + list.length) % list.length;
      else if (e.key === 'Home') cur = 0;
      else if (e.key === 'End') cur = list.length - 1;
      else if (e.key === 'Enter') { if (list[cur]) { e.preventDefault(); pRun(p, list[cur]); } return; }
      else return;
      e.preventDefault();
      if (list[cur]) { pMark(p, list[cur]); list[cur].scrollIntoView && list[cur].scrollIntoView({ block: 'nearest' }); }
    }, { signal: ac.signal });
    root.addEventListener('click', function (e) {
      var it = cl(e, '[data-p8~="palette"] [role="option"]');
      if (it) pRun(it.closest('[data-p8~="palette"]'), it);
    }, { signal: ac.signal });
    root.addEventListener('mousemove', function (e) { var it = cl(e, '[data-p8~="palette"] [role="option"]'); if (it && !it.classList.contains('p8-palette__item--active')) pMark(it.closest('[data-p8~="palette"]'), it); }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-palette" role="dialog" aria-label="Command palette" data-p8="palette">
  <input class="p8-palette__input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" placeholder="Type a command" aria-label="Command" />
  <div class="p8-palette__list" role="listbox" id="palette-list">
    <div class="p8-palette__group" role="group" aria-label="Recent" data-group="recent">
      <div class="p8-palette__heading" aria-hidden="true">Recent</div>
      <button class="p8-palette__item p8-palette__item--active" type="button" role="option" data-section="Recent" data-recent aria-keyshortcuts="⌘N">
        <span data-label>Create project</span>
        <span class="p8-palette__hint" aria-hidden="true">⌘N</span>
      </button>
    </div>
    <div class="p8-palette__group" role="group" aria-label="Navigate">
      <div class="p8-palette__heading" aria-hidden="true">Navigate</div>
      <button class="p8-palette__item" type="button" role="option" data-section="Navigate" aria-keyshortcuts="G O">
        <span data-label>Go to Overview</span>
        <span class="p8-palette__hint" aria-hidden="true">G O</span>
      </button>
      <button class="p8-palette__item" type="button" role="option" data-section="Navigate" aria-keyshortcuts="G P">
        <span data-label>Go to Projects</span>
        <span class="p8-palette__hint" aria-hidden="true">G P</span>
      </button>
    </div>
    <div class="p8-palette__group" role="group" aria-label="Actions">
      <div class="p8-palette__heading" aria-hidden="true">Actions</div>
      <button class="p8-palette__item" type="button" role="option" data-section="Actions" aria-keyshortcuts="⌘N">
        <span data-label>Create project</span>
        <span class="p8-palette__hint" aria-hidden="true">⌘N</span>
      </button>
      <button class="p8-palette__item" type="button" role="option" data-section="Actions">
        <span data-label>Invite people</span>
      </button>
      <button class="p8-palette__item" type="button" role="option" data-section="Actions" aria-keyshortcuts="⌘,">
        <span data-label>Open settings</span>
        <span class="p8-palette__hint" aria-hidden="true">⌘,</span>
      </button>
    </div>
    <p class="p8-palette__empty" data-empty hidden role="status">No commands match.</p>
    <template data-item-template>
      <button class="p8-palette__item" type="button" role="option" data-section="Recent" data-recent>
        <span data-label>__label__</span>
      </button>
    </template>
  </div>
</div>

<style>
  .p8-palette {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    width: var(--p8-size-400);
