exports[`codegen snapshots > media-timeline #1 → scss 1`] = `
"// _media-timeline.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-mt {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: var(--p8-size-720);
  max-width: 100%;
  overflow: hidden;
  padding: 0;
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mt__body {
  display: flex;
  min-width: 0;
}

.p8-mt__labels {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: var(--p8-size-96);
  border-right: var(--p8-border-hairline) solid var(--p8-color-ring);
  background: var(--p8-color-surface);
}

.p8-mt__corner {
  height: var(--p8-size-24);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mt__label {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  height: var(--p8-size-48);
  box-sizing: border-box;
  padding-inline: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-mt__scroll {
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: thin;
  scrollbar-color: var(--p8-color-ring-focus) transparent;
}

.p8-mt__canvas {
  position: relative;
  user-select: none;
  touch-action: none;
  min-width: 100%;
}

.p8-mt__ruler {
  position: relative;
  height: var(--p8-size-24);
  box-sizing: border-box;
  cursor: pointer;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  background-image: repeating-linear-gradient(to right, var(--p8-color-ring) 0, var(--p8-color-ring) var(--p8-border-hairline), transparent var(--p8-border-hairline), transparent calc(var(--p8-pps) * var(--p8-unit-px)));
  background-size: 100% 40%;
  background-repeat: no-repeat;
  background-position: bottom left;
  color: var(--p8-color-ink-muted);
  &:focus-visible {
    box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-mt__tick {
  position: absolute;
  top: 0;
  bottom: 0;
  padding-inline-start: var(--p8-space-4);
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  pointer-events: none;
  white-space: nowrap;
}

.p8-mt__lane {
  position: relative;
  height: var(--p8-size-48);
  box-sizing: border-box;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mt__clip {
  position: absolute;
  top: var(--p8-space-4);
  bottom: var(--p8-space-4);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: var(--p8-space-4);
  padding: 0;
  overflow: hidden;
  border: none;
  border-radius: var(--p8-radius-4);
  color: var(--p8-color-ink);
  cursor: grab;
  text-align: left;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-mt__clip--video {
  background: var(--p8-color-control-strong);
}

.p8-mt__handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: var(--p8-space-8);
  cursor: ew-resize;
  background: transparent;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  .p8-mt__clip:hover &, .p8-mt__clip:focus-within & {
    background: var(--p8-color-ring-focus);
  }
}

.p8-mt__handle--start {
  left: 0;
}

.p8-mt__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-inline: var(--p8-space-8);
  pointer-events: none;
}

.p8-mt__handle--end {
  right: 0;
}

.p8-mt__clip--audio {
  background: var(--p8-color-control);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-mt__playhead {
  position: absolute;
  top: 0;
  bottom: 0;
  width: var(--p8-space-2);
  translate: -50% 0;
  background: var(--p8-color-ink);
  pointer-events: none;
  z-index: 5;
  &::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: var(--p8-space-12);
    height: var(--p8-space-12);
    border-radius: var(--p8-radius-4);
    background: var(--p8-color-ink);
  }
}

.p8-mt__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

