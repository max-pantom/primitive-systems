"// Timer.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './timer.css';

export function Timer() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-timer" role="timer" aria-label="Stopwatch" data-p8="timer" data-mode="stopwatch" data-seconds="90" data-autostart>
      <span className="p8-timer__time" data-time>00:00</span>
    </div>
  );
}

