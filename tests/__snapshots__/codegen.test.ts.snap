"// Toast.tsx — Requires the Primitive Systems theme variables (theme.css).
import './toast.css';

export function Toast() {
  return (
    <div className="p8-toast p8-toast--inverted" role="status">
      <span className="p8-toast__message">Changes saved.</span>
      <button className="p8-toast__action" type="button">Sample {'{'}x{'}'} &lt;y&gt;</button>
    </div>
  );
}

/* toast.css */
.p8-toast {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  min-width: var(--p8-size-320);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
  border-radius: var(--p8-radius-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-toast--inverted {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
  box-shadow: none;
}

.p8-toast__message {
  flex: 1;
}

.p8-toast__action {
  border: none;
  background: transparent;
  color: inherit;
  padding: 0;
  cursor: pointer;
  font-weight: var(--p8-type-weight);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-toast__action:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}
"
`;

