"// Sheet.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './sheet.css';

export function Sheet() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-overlay p8-overlay--bottom" data-p8="overlay">
      <div className="p8-sheet p8-sheet--bottom" role="dialog" aria-modal="true">
        <div className="p8-sheet__head">
          <h2 className="p8-sheet__title">Sheet title</h2>
          <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Close" data-close>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="4" y1="4" x2="12" y2="12" />
              <line x1="12" y1="4" x2="4" y2="12" />
            </svg>
          </button>
        </div>
        <div className="p8-sheet__body">Sheet content goes here.</div>
      </div>
    </div>
  );
}

/* sheet.css */
.p8-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  background: var(--p8-color-backdrop);
  box-sizing: border-box;
  padding: var(--p8-space-24);
}

.p8-overlay[hidden] {
  display: none;
}

.p8-overlay--bottom {
  align-items: flex-end;
  padding: 0;
}

.p8-sheet {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-320);
  max-width: 100%;
  height: 100%;
  padding: var(--p8-space-16);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-sheet--bottom {
  width: 100%;
  height: auto;
  min-height: var(--p8-size-240);
}

.p8-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.p8-sheet__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-sheet__body {
  color: var(--p8-color-ink-muted);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function oClose(o) { o.hidden = true; o.dispatchEvent(new CustomEvent('p8-closed', { bubbles: true })); }
  function oOpen() { return all('[data-p8~="overlay"]').filter(function (o) { return !o.hidden; }); }
  root.addEventListener('click', function (e) {
    var o = cl(e, '[data-p8~="overlay"]');
    if (!o) return;
    if (e.target === o || cl(e, '[data-close]')) oClose(o);
  }, { signal: ac.signal });
  doc.addEventListener('keydown', function (e) {
    var open = oOpen();
    var o = open[open.length - 1];
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      var hot = all('[data-p8~="overlay"][data-hotkey]')[0];
      if (hot) { e.preventDefault(); hot.hidden = !hot.hidden; if (!hot.hidden) { var i = hot.querySelector('input'); if (i) i.focus(); } }
      return;
    }
    if (!o) return;
    if (e.key === 'Escape') { oClose(o); return; }
    if (e.key !== 'Tab') return;
    var f = Array.from(o.querySelectorAll('button, input, [href], select, textarea, [tabindex]')).filter(function (x) { return !x.disabled && x.tabIndex >= 0; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1], act = doc.activeElement;
    if (!o.contains(act)) { e.preventDefault(); first.focus(); }
    else if (e.shiftKey && act === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && act === last) { e.preventDefault(); first.focus(); }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

