"// ColorPicker.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './color-picker.css';

export function ColorPicker() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-popover p8-colorpicker" data-p8="popover color" data-h="217" data-s="78" data-v="92" data-label="Brand colour">
      <div className="p8-colorpicker__field">
        <button className="p8-colorpicker__swatch" type="button" style={{ background: "#347AEB" }} aria-label="Brand colour: #347AEB" aria-haspopup="dialog" aria-expanded="false" data-trigger disabled></button>
        <input className="p8-input p8-colorpicker__hex" type="text" aria-label="Brand colour hex value" spellCheck="false" autoComplete="off" maxLength="7" data-hex disabled defaultValue="#347AEB" />
      </div>
      <div className="p8-popover__panel p8-colorpicker__panel" data-panel role="dialog" aria-label="Choose brand colour" hidden>
        <div className="p8-colorpicker__area" style={{ background: "linear-gradient(to top, black, transparent), linear-gradient(to right, white, hsl(217 100% 50%))" }} data-area="sv">
          <div className="p8-colorpicker__thumb" role="slider" tabIndex="0" aria-label="Saturation and brightness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="78" aria-valuetext="Saturation 78%, brightness 92%" style={{ left: "78%",top: "8%" }} data-thumb="sv"></div>
        </div>
        <div className="p8-colorpicker__hue" data-area="hue">
          <div className="p8-colorpicker__thumb" role="slider" tabIndex="0" aria-label="Hue" aria-valuemin="0" aria-valuemax="360" aria-valuenow="217" style={{ left: "60.27777777777777%",top: "50%" }} data-thumb="hue"></div>
        </div>
        <div className="p8-colorpicker__row">
          <span className="p8-colorpicker__preview" style={{ background: "#347AEB" }} data-preview></span>
          <span aria-live="polite" data-readout>#347AEB</span>
        </div>
      </div>
    </div>
  );
}

/* color-picker.css */
.p8-popover {
  position: relative;
  display: inline-block;
}

.p8-colorpicker {
  position: relative;
  display: inline-block;
  width: var(--p8-size-240);
  max-width: 100%;
}

.p8-colorpicker__field {
  display: flex;
  align-items: stretch;
  gap: var(--p8-space-8);
}

.p8-colorpicker__swatch {
  flex-shrink: 0;
