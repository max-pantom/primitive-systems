        </tbody>
      </table>
    </figure>
  </div>
  <section style="display: flex; flex-direction: column; gap: var(--p8-space-12); min-width: 0">
    <h2 style="margin: 0; color: var(--p8-color-ink); font-family: var(--p8-type-family); font-size: var(--p8-type-size-sm); line-height: var(--p8-type-line-sm); font-weight: var(--p8-type-weight-strong)">Recent activity</h2>
    <div style="min-width: 0; overflow: auto">
