/* password-input.css */
.p8-password {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  width: var(--p8-size-500);
  max-width: 100%;
  font-family: var(--p8-type-family);
}

.p8-password__wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-password__field {
  position: relative;
  display: flex;
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-password__input {
  padding-inline-end: calc(var(--p8-size-40) + var(--p8-space-4));
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-password__toggle {
  position: absolute;
  top: 50%;
  translate: 0 -50%;
  inset-inline-end: var(--p8-space-2);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-password__rules {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-password__rule {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  transition: color var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-password__yes {
  display: none;
}

.p8-password__no {
  display: inline-flex;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
