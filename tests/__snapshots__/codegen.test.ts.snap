      </svg>
    </button>
  </div>
</div>

<style>
  .p8-carousel {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-400);
    max-width: 100%;
  }

  .p8-carousel__track {
    display: flex;
    gap: var(--p8-space-12);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--p8-radius-8);
  }

  .p8-carousel__track:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-carousel__track::-webkit-scrollbar {
    display: none;
  }

