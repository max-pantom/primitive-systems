"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-dialog" role="dialog" aria-modal="true">
  <div>
    <h2 class="p8-dialog__title">Dialog title</h2>
    <p class="p8-dialog__body">Explain what happens when the user confirms.</p>
  </div>
  <div class="p8-dialog__footer">
    <button class="p8-button p8-button--ghost" type="button">Cancel</button>
    <button class="p8-button p8-button--primary" type="button">Confirm</button>
  </div>
</div>

<style>
  .p8-dialog {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-16);
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding: var(--p8-space-16);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
    border-radius: var(--p8-radius-8);
    font-family: var(--p8-type-family);
  }

  .p8-dialog__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-dialog__body {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink-muted);
  }

  .p8-dialog__footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--p8-space-12);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    box-shadow: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    outline: var(--p8-border-focus) solid var(--p8-color-ink);
    outline-offset: var(--p8-border-focus-offset);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button--ghost {
    background: transparent;
    box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }
</style>
"
`;

