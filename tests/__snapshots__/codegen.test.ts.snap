"// Carousel.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './carousel.css';

export function Carousel() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-carousel" role="region" aria-roledescription="carousel" aria-label="Carousel" data-p8="carousel">
      <div className="p8-carousel__track" data-track tabIndex="0" aria-label="Slides">
        <div className="p8-carousel__slide" role="group" aria-roledescription="slide" aria-label="1 of 5">Slide 1</div>
        <div className="p8-carousel__slide" role="group" aria-roledescription="slide" aria-label="2 of 5">Slide 2</div>
        <div className="p8-carousel__slide" role="group" aria-roledescription="slide" aria-label="3 of 5">Slide 3</div>
        <div className="p8-carousel__slide" role="group" aria-roledescription="slide" aria-label="4 of 5">Slide 4</div>
        <div className="p8-carousel__slide" role="group" aria-roledescription="slide" aria-label="5 of 5">Slide 5</div>
      </div>
      <div className="p8-carousel__nav">
        <button className="p8-iconbtn" type="button" aria-label="Previous slide" disabled data-dir="-1">
