"// ColorPicker.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './color-picker.css';

export function ColorPicker() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-popover p8-colorpicker" data-p8="popover color" data-h="217" data-s="78" data-v="92" data-label="Brand colour">
      <div className="p8-colorpicker__field">
        <button className="p8-colorpicker__swatch" type="button" style={{ background: "#347AEB" }} aria-label="Brand colour: #347AEB" aria-haspopup="dialog" aria-expanded="true" data-trigger></button>
        <input className="p8-input p8-colorpicker__hex" type="text" aria-label="Brand colour hex value" spellCheck="false" autoComplete="off" maxLength="7" data-hex defaultValue="#347AEB" />
      </div>
      <div className="p8-popover__panel p8-colorpicker__panel" data-panel role="dialog" aria-label="Choose brand colour">
        <div className="p8-colorpicker__area" style={{ background: "linear-gradient(to top, black, transparent), linear-gradient(to right, white, hsl(217 100% 50%))" }} data-area="sv">
          <div className="p8-colorpicker__thumb" role="slider" tabIndex="0" aria-label="Saturation and brightness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="78" aria-valuetext="Saturation 78%, brightness 92%" style={{ left: "78%",top: "8%" }} data-thumb="sv"></div>
        </div>
        <div className="p8-colorpicker__hue" data-area="hue">
          <div className="p8-colorpicker__thumb" role="slider" tabIndex="0" aria-label="Hue" aria-valuemin="0" aria-valuemax="360" aria-valuenow="217" style={{ left: "60.27777777777777%",top: "50%" }} data-thumb="hue"></div>
        </div>
        <div className="p8-colorpicker__row">
          <span className="p8-colorpicker__preview" style={{ background: "#347AEB" }} data-preview></span>
          <span aria-live="polite" data-readout>#347AEB</span>
        </div>
      </div>
    </div>
  );
}

/* color-picker.css */
.p8-popover {
  position: relative;
  display: inline-block;
}

.p8-colorpicker {
  position: relative;
  display: inline-block;
  width: var(--p8-size-240);
  max-width: 100%;
}

.p8-colorpicker__field {
  display: flex;
  align-items: stretch;
  gap: var(--p8-space-8);
}

.p8-colorpicker__swatch {
  flex-shrink: 0;
  width: var(--p8-size-40);
  padding: 0;
  border: none;
  border-radius: var(--p8-radius-8);
  cursor: pointer;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-colorpicker__swatch:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-colorpicker__swatch:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-colorpicker__hex {
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  text-transform: uppercase;
}

.p8-popover__panel {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: var(--p8-space-8);
  z-index: 40;
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-popover__panel[hidden] {
  display: none;
}

.p8-colorpicker__panel {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-240);
}

.p8-colorpicker__area {
  position: relative;
  height: var(--p8-size-160);
  border-radius: var(--p8-radius-8);
  cursor: crosshair;
  touch-action: none;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-colorpicker__thumb {
