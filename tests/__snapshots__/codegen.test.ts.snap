"---
// Requires the Primitive Systems theme variables (theme.css).
---

<span class="p8-sparkline">
  <svg class="p8-sparkline__svg" width="160" height="32" viewBox="0 0 160 32" role="img" aria-label="Signups: 12 to 24, up 100%">
    <path class="p8-sparkline__line" d="M2 30 L28 25.33 L54 27.67 L80 16 L106 18.33 L132 9 L158 2" />
    <circle class="p8-sparkline__dot" cx="158" cy="2" r="2.5" />
  </svg>
  <span class="p8-sparkline__value" aria-hidden="true">24</span>
  <span class="p8-sparkline__delta" aria-hidden="true">+100%</span>
</span>

<style>
  .p8-sparkline {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-sparkline__svg {
    display: block;
    flex-shrink: 0;
    overflow: visible;
  }

  .p8-sparkline__line {
    fill: none;
    stroke: var(--p8-color-ink);
    stroke-width: var(--p8-border-focus);
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .p8-sparkline__dot {
    fill: var(--p8-color-ink);
  }

  .p8-sparkline__value {
    font-weight: var(--p8-type-weight-strong);
    font-variant-numeric: tabular-nums;
  }

  .p8-sparkline__delta {
    color: var(--p8-color-ink-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
"
`;

