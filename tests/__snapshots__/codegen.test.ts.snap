"// Tabs.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './tabs.css';

export function Tabs() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-tabs-root">
      <div className="p8-tabs" role="tablist" data-p8="group">
        <button className="p8-tabs__tab p8-tabs__tab--active" type="button" role="tab" aria-selected="true" tabIndex="0">Overview</button>
        <button className="p8-tabs__tab" type="button" role="tab" aria-selected="false" tabIndex="-1">Activity</button>
        <button className="p8-tabs__tab" type="button" role="tab" aria-selected="false" tabIndex="-1">Settings</button>
      </div>
    </div>
  );
}

/* tabs.css */
.p8-tabs-root {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  font-family: var(--p8-type-family);
  color: var(--p8-color-ink);
}

.p8-tabs {
  display: flex;
  gap: var(--p8-space-12);
}

.p8-tabs__tab {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink-muted);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tabs__tab:hover:not(:disabled) {
  color: var(--p8-color-ink);
}

.p8-tabs__tab:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-tabs__tab--active {
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
}

// ---behavior---
