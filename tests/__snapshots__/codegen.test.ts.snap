exports[`codegen snapshots > calendar #1 → react 1`] = `
"// Calendar.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './calendar.css';

export function Calendar() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <section ref={ref} className="p8-mcal" aria-label="Calendar" data-p8="monthcal" data-month="2026-11" data-week="0" data-selected="2026-11-12" data-events="{&quot;2026-11-03&quot;:[&quot;Design review&quot;,&quot;1:1 with Ada&quot;],&quot;2026-11-12&quot;:[&quot;Launch&quot;,&quot;Retro&quot;,&quot;Team dinner&quot;],&quot;2026-11-20&quot;:[&quot;Quarterly planning&quot;],&quot;2026-11-26&quot;:[&quot;Office closed&quot;]}">
      <div className="p8-mcal__head">
        <h2 className="p8-mcal__title" aria-live="polite" data-label>November 2026</h2>
        <div className="p8-mcal__nav">
          <button className="p8-button p8-button--ghost" type="button" data-today-btn>Today</button>
          <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Previous month" data-dir="-1">
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M10 4L6 8L10 12" />
            </svg>
          </button>
          <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Next month" data-dir="1">
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M6 4L10 8L6 12" />
            </svg>
          </button>
        </div>
      </div>
      <div className="p8-mcal__grid" role="group" aria-label="Days" data-grid>
        <span className="p8-mcal__dow" aria-hidden="true">Su</span>
        <span className="p8-mcal__dow" aria-hidden="true">Mo</span>
        <span className="p8-mcal__dow" aria-hidden="true">Tu</span>
        <span className="p8-mcal__dow" aria-hidden="true">We</span>
        <span className="p8-mcal__dow" aria-hidden="true">Th</span>
        <span className="p8-mcal__dow" aria-hidden="true">Fr</span>
        <span className="p8-mcal__dow" aria-hidden="true">Sa</span>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-01" aria-pressed="false" aria-label="Sunday, November 1, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">1</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-02" aria-pressed="false" aria-label="Monday, November 2, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">2</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-03" aria-pressed="false" aria-label="Tuesday, November 3, 2 events" tabIndex="-1">
