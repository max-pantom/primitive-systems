"// MediaTimeline.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './media-timeline.css';

export function MediaTimeline() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <section ref={ref} className="p8-mt" role="group" aria-label="Timeline" data-p8="mediatl" data-fps="30" data-duration="30" data-time="0" data-pps="24" data-snap="true" data-playing="false" style={{ "--p8-pps":"24" }}>
      <div className="p8-mt__bar" role="toolbar" aria-label="Timeline controls">
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Go to start" data-act="start">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="2.75" y1="3.75" x2="2.75" y2="12.25" />
            <polygon points="12.25,3.75 5.75,8 12.25,12.25" />
          </svg>
        </button>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Play" data-act="play" aria-pressed="false">
          <svg className="p8-icon p8-mt__ic p8-mt__ic--on" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <polygon points="5.75,3.75 12.5,8 5.75,12.25" />
          </svg>
          <svg className="p8-icon p8-mt__ic" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="5.75" y1="3.75" x2="5.75" y2="12.25" />
            <line x1="10.25" y1="3.75" x2="10.25" y2="12.25" />
          </svg>
        </button>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Go to end" data-act="end">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="13.25" y1="3.75" x2="13.25" y2="12.25" />
            <polygon points="3.75,3.75 10.25,8 3.75,12.25" />
          </svg>
        </button>
        <span className="p8-mt__sep" role="separator" aria-orientation="vertical"></span>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Split at playhead" data-act="split">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="4.5" cy="4.5" r="1.75" />
            <circle cx="4.5" cy="11.5" r="1.75" />
            <path d="M6 6L13 13M6 10L13 3" />
          </svg>
        </button>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Delete clip" data-act="delete">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M3.75 6.75L4.25 12.25Q4.3 13.25 5.75 13.25H10.25Q11.7 13.25 11.75 12.25L12.25 6.75" />
            <path d="M2.75 5.75H13.25M5.75 5.75V2.75H10.25V5.75" />
            <line x1="7.75" y1="8.75" x2="7.75" y2="10.25" />
          </svg>
        </button>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Snapping" data-act="snap" aria-pressed="true">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M2.75 2.75H5.75V8.75C5.75 12 10.25 12 10.25 8.75V2.75H13.25V8.75C13.25 16 2.75 16 2.75 8.75Z" />
            <path d="M2.75 6.25H5.75M10.25 6.25H13.25" />
          </svg>
        </button>
        <span className="p8-mt__grow"></span>
        <output className="p8-mt__time" data-timecode aria-label="Playhead timecode">00:00:00:00</output>
        <span className="p8-mt__grow"></span>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Zoom out" data-act="zoomout">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="7" cy="7" r="4.25" />
            <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
            <path d="M5.25 7H8.75" />
          </svg>
        </button>
        <span className="p8-mt__zoom" data-zoomlabel aria-hidden="true">1×</span>
        <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Zoom in" data-act="zoomin">
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <circle cx="7" cy="7" r="4.25" />
            <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
            <path d="M5.25 7H8.75M7 5.25V8.75" />
          </svg>
        </button>
      </div>
      <div className="p8-mt__body">
        <div className="p8-mt__labels" aria-hidden="true">
          <div className="p8-mt__corner"></div>
          <div className="p8-mt__label">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <rect x="1.75" y="3.75" width="6.5" height="6.5" rx="1.5" />
              <path d="M8.75 5.75L12.25 3.75V10.25L8.75 8.25" />
            </svg>
            Video 2
          </div>
          <div className="p8-mt__label">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <rect x="1.75" y="3.75" width="6.5" height="6.5" rx="1.5" />
              <path d="M8.75 5.75L12.25 3.75V10.25L8.75 8.25" />
            </svg>
            Video 1
          </div>
          <div className="p8-mt__label">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M4.75 10.25V3.75L11.25 2.75V9.25" />
              <circle cx="3" cy="11" r="1.5" fill="currentColor" stroke="none" />
              <circle cx="9.5" cy="10" r="1.5" fill="currentColor" stroke="none" />
            </svg>
            Audio 1
          </div>
        </div>
        <div className="p8-mt__scroll" data-scroll>
          <div className="p8-mt__canvas" data-canvas style={{ width: "calc(var(--p8-pps) * 30px)" }}>
            <div className="p8-mt__ruler" role="slider" tabIndex="0" aria-label="Playhead" aria-valuemin="0" aria-valuemax="30" aria-valuenow="0" aria-valuetext="00:00:00:00" data-ruler>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 0px)" }}>0:00</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 5px)" }}>0:05</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 10px)" }}>0:10</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 15px)" }}>0:15</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 20px)" }}>0:20</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 25px)" }}>0:25</span>
              <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 30px)" }}>0:30</span>
            </div>
            <div className="p8-mt__lane" role="group" aria-label="Track Video 2" data-lane data-track="Video 2" data-kind="video">
              <button className="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="1" data-dur="4" aria-pressed="false" tabIndex="-1" aria-label="Title, Video 2, starts at 00:00:01:00, 4 seconds" style={{ left: "calc(var(--p8-pps) * 1px)",width: "calc(var(--p8-pps) * 4px)" }}>
                <span className="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
                <span className="p8-mt__name" data-name>Title</span>
                <span className="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
              </button>
            </div>
            <div className="p8-mt__lane" role="group" aria-label="Track Video 1" data-lane data-track="Video 1" data-kind="video">
              <button className="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="0" data-dur="6" aria-pressed="false" tabIndex="0" aria-label="Intro, Video 1, starts at 00:00:00:00, 6 seconds" style={{ left: "calc(var(--p8-pps) * 0px)",width: "calc(var(--p8-pps) * 6px)" }}>
                <span className="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
                <span className="p8-mt__name" data-name>Intro</span>
                <span className="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
              </button>
              <button className="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="6.5" data-dur="12" aria-pressed="false" tabIndex="-1" aria-label="Interview, Video 1, starts at 00:00:06:15, 12 seconds" style={{ left: "calc(var(--p8-pps) * 6.5px)",width: "calc(var(--p8-pps) * 12px)" }}>
                <span className="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
                <span className="p8-mt__name" data-name>Interview</span>
                <span className="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
              </button>
            </div>
            <div className="p8-mt__lane" role="group" aria-label="Track Audio 1" data-lane data-track="Audio 1" data-kind="audio">
              <button className="p8-mt__clip p8-mt__clip--audio" type="button" data-clip data-start="0" data-dur="24" aria-pressed="false" tabIndex="-1" aria-label="Music, Audio 1, starts at 00:00:00:00, 24 seconds" style={{ left: "calc(var(--p8-pps) * 0px)",width: "calc(var(--p8-pps) * 24px)" }}>
                <span className="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
                <span className="p8-mt__name" data-name>Music</span>
                <span className="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
              </button>
            </div>
            <div className="p8-mt__playhead" data-playhead aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 0px)" }}></div>
          </div>
        </div>
      </div>
      <p className="p8-mt__sr" role="status" aria-live="polite" data-live></p>
      <template data-parts>
        <span className="p8-mt__tick" data-tick aria-hidden="true" style={{ left: "calc(var(--p8-pps) * 0px)" }}>0:00</span>
      </template>
    </section>
  );
}

/* media-timeline.css */
.p8-mt {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: var(--p8-size-720);
  max-width: 100%;
  overflow: hidden;
  padding: 0;
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mt__bar {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-8);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-mt__ic {
  display: none;
}

.p8-mt__ic--on {
  display: block;
}

.p8-mt__sep {
  width: 0;
  height: var(--p8-size-16);
  margin-inline: var(--p8-space-4);
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mt__grow {
  flex: 1;
}

.p8-mt__time {
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  font-variant-numeric: tabular-nums;
  min-width: var(--p8-size-96);
  text-align: center;
  color: var(--p8-color-ink);
}

.p8-mt__zoom {
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  min-width: var(--p8-size-40);
  text-align: center;
  color: var(--p8-color-ink-muted);
}

.p8-mt__body {
  display: flex;
  min-width: 0;
}

.p8-mt__labels {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: var(--p8-size-96);
  border-right: var(--p8-border-hairline) solid var(--p8-color-ring);
  background: var(--p8-color-surface);
}

.p8-mt__corner {
  height: var(--p8-size-24);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mt__label {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  height: var(--p8-size-48);
  box-sizing: border-box;
  padding-inline: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.p8-mt__scroll {
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: thin;
  scrollbar-color: var(--p8-color-ring-focus) transparent;
}

.p8-mt__canvas {
  position: relative;
  user-select: none;
  touch-action: none;
  min-width: 100%;
}

.p8-mt__ruler {
  position: relative;
  height: var(--p8-size-24);
  box-sizing: border-box;
  cursor: pointer;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  background-image: repeating-linear-gradient(to right, var(--p8-color-ring) 0, var(--p8-color-ring) var(--p8-border-hairline), transparent var(--p8-border-hairline), transparent calc(var(--p8-pps) * var(--p8-unit-px)));
  background-size: 100% 40%;
  background-repeat: no-repeat;
  background-position: bottom left;
  color: var(--p8-color-ink-muted);
}

.p8-mt__ruler:focus-visible {
  box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-mt__tick {
  position: absolute;
  top: 0;
  bottom: 0;
  padding-inline-start: var(--p8-space-4);
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  pointer-events: none;
  white-space: nowrap;
}

.p8-mt__lane {
  position: relative;
  height: var(--p8-size-48);
  box-sizing: border-box;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mt__clip {
  position: absolute;
  top: var(--p8-space-4);
  bottom: var(--p8-space-4);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: var(--p8-space-4);
  padding: 0;
  overflow: hidden;
  border: none;
  border-radius: var(--p8-radius-4);
  color: var(--p8-color-ink);
  cursor: grab;
  text-align: left;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mt__clip:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-mt__clip--video {
  background: var(--p8-color-control-strong);
}

.p8-mt__handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: var(--p8-space-8);
  cursor: ew-resize;
  background: transparent;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-mt__clip:hover .p8-mt__handle, .p8-mt__clip:focus-within .p8-mt__handle {
  background: var(--p8-color-ring-focus);
}

.p8-mt__handle--start {
  left: 0;
}

.p8-mt__name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-inline: var(--p8-space-8);
  pointer-events: none;
}

.p8-mt__handle--end {
  right: 0;
}

.p8-mt__clip--audio {
  background: var(--p8-color-control);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-mt__playhead {
  position: absolute;
  top: 0;
  bottom: 0;
  width: var(--p8-space-2);
  translate: -50% 0;
  background: var(--p8-color-ink);
  pointer-events: none;
  z-index: 5;
}

.p8-mt__playhead::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  translate: -50% 0;
  width: var(--p8-space-12);
  height: var(--p8-space-12);
  border-radius: var(--p8-radius-4);
  background: var(--p8-color-ink);
}

.p8-mt__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-mt__ic","--on"],["p8-mt__clip","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  var mtSteps = [1, 2, 5, 10, 15, 30, 60, 120, 300, 600];
  function mtR(el) { return el.closest('[data-p8~="mediatl"]'); }
  function mtN(r, a, d) { var v = Number(r.getAttribute(a)); return isNaN(v) || !v ? d : v; }
  function mtFps(r) { return mtN(r, 'data-fps', 30); }
  function mtPPS(r) { return mtN(r, 'data-pps', 24); }
  function mtDur(r) { return mtN(r, 'data-duration', 30); }
  function mtTime(r) { return Number(r.getAttribute('data-time')) || 0; }
  function mtFrame(r, t) { var f = mtFps(r); return Math.round(t * f) / f; }
  function mtPad(n) { return (n < 10 ? '0' : '') + n; }
  function mtTC(r, t) { var fps = mtFps(r), f = Math.round(t * fps), s = Math.floor(f / fps); return mtPad(Math.floor(s / 3600)) + ':' + mtPad(Math.floor(s % 3600 / 60)) + ':' + mtPad(s % 60) + ':' + mtPad(f % fps); }
  function mtShort(t) { return Math.floor(t / 60) + ':' + mtPad(Math.round(t % 60)); }
  function mtPx(secs) { return 'calc(var(--p8-pps) * ' + secs + 'px)'; }
  function mtClips(r) { return Array.from(r.querySelectorAll('[data-clip]')); }
  function mtLanes(r) { return Array.from(r.querySelectorAll('[data-lane]')); }
  function mtStart(c) { return Number(c.getAttribute('data-start')); }
  function mtLen(c) { return Number(c.getAttribute('data-dur')); }
  function mtName(c) { return c.querySelector('[data-name]').textContent; }
  function mtSay(r, msg) { r.querySelector('[data-live]').textContent = msg; }
  function mtLabel(r, c) { c.setAttribute('aria-label', mtName(c) + ', ' + c.parentNode.getAttribute('data-track') + ', starts at ' + mtTC(r, mtStart(c)) + ', ' + (Math.round(mtLen(c) * 100) / 100) + ' seconds'); }
  function mtPlace(r, c) { c.style.left = mtPx(mtStart(c)); c.style.width = mtPx(mtLen(c)); mtLabel(r, c); }
  function mtInfo(c) { return { track: c.parentNode.getAttribute('data-track'), name: mtName(c), start: mtStart(c), duration: mtLen(c) }; }
  function mtChange(r) { r.dispatchEvent(new CustomEvent('p8-change', { bubbles: true, detail: { clips: mtClips(r).map(mtInfo) } })); }
  function mtReveal(r, t) { var sc = r.querySelector('[data-scroll]'), x = t * mtPPS(r); if (sc.clientWidth && (x < sc.scrollLeft || x > sc.scrollLeft + sc.clientWidth - 8)) sc.scrollLeft = Math.max(0, x - sc.clientWidth / 2); }
  function mtSeek(r, t, opt) {
    opt = opt || {};
    t = Math.max(0, Math.min(mtDur(r), mtFrame(r, t)));
    r.setAttribute('data-time', String(t));
    r.querySelector('[data-playhead]').style.left = mtPx(t);
    var ru = r.querySelector('[data-ruler]'), tc = mtTC(r, t);
    ru.setAttribute('aria-valuenow', String(Math.round(t * 100) / 100)); ru.setAttribute('aria-valuetext', tc);
    var out = r.querySelector('[data-timecode]'); if (out) out.textContent = tc;
    if (opt.say) mtSay(r, tc);
    if (opt.reveal) mtReveal(r, t);
    r.dispatchEvent(new CustomEvent('p8-seek', { bubbles: true, detail: { time: t, timecode: tc } }));
    return t;
  }
  function mtRuler(r) {
