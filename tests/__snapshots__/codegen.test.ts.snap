<label class="p8-check">
  <button class="p8-check__box p8-check__box--on" type="button" role="checkbox" aria-checked="true">
    <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2.5 7L5.5 10L11.5 4" />
    </svg>
  </button>
  Label
</label>

<style>
  .p8-check {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-check__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink-inverse);
    box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
    cursor: inherit;
  }

  .p8-check__box:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-check__box:focus-visible {
    outline: var(--p8-border-focus) solid var(--p8-color-ink);
    outline-offset: var(--p8-border-focus-offset);
  }

  .p8-check__box:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-check__box--on {
    background: var(--p8-color-ink);
  }

  .p8-check__box--on:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-icon {
    flex-shrink: 0;
  }
</style>
"
`;

