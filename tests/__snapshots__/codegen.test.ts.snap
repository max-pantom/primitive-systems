/* tree-view.css */
.p8-tree {
  margin: 0;
  padding: 0;
  list-style: none;
  width: var(--p8-size-320);
  max-width: 100%;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
}

.p8-tree__item {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  width: 100%;
  box-sizing: border-box;
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  text-align: left;
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tree__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-tree__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-tree__chev {
  display: inline-flex;
  width: var(--p8-icon-sm);
  height: var(--p8-icon-sm);
  flex-shrink: 0;
  color: var(--p8-color-ink-muted);
  transition: rotate var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-tree__icon {
  display: inline-flex;
  color: var(--p8-color-ink-muted);
}

.p8-tree__label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-tree__group {
  margin: 0;
  margin-inline-start: var(--p8-space-16);
  padding: 0;
  list-style: none;
}

.p8-tree__group[hidden] {
  display: none;
}

.p8-tree__item--active {
  background: var(--p8-color-control-strong);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function tItems(t) { return Array.from(t.querySelectorAll('[role="treeitem"]')).filter(function (x) { return !x.closest('[role="group"][hidden]'); }); }
  function tGroup(it) { var g = it.nextElementSibling; return g && g.getAttribute('role') === 'group' ? g : null; }
  function tOpen(it, open) { var g = tGroup(it); if (!g) return; g.hidden = !open; it.setAttribute('aria-expanded', String(open)); it.classList.toggle('p8-tree__item--on', open); }
  function tSelect(t, it) { Array.from(t.querySelectorAll('[role="treeitem"]')).forEach(function (x) { x.classList.toggle('p8-tree__item--active', x === it); x.tabIndex = x === it ? 0 : -1; }); }
  root.addEventListener('click', function (e) {
