exports[`codegen snapshots > filter-bar #0 → react 1`] = `
"// FilterBar.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './filter-bar.css';

export function FilterBar() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-filters" data-p8="filters" data-fields="{&quot;Status&quot;:[&quot;Open&quot;,&quot;In progress&quot;,&quot;Closed&quot;],&quot;Owner&quot;:[&quot;Ada&quot;,&quot;Grace&quot;,&quot;Alan&quot;],&quot;Priority&quot;:[&quot;High&quot;,&quot;Medium&quot;,&quot;Low&quot;]}">
      <div className="p8-filters__row">
        <div className="p8-select p8-filters__pick">
          <select className="p8-select__control" aria-label="Filter field" data-field defaultValue="Status">
            <option value="Status">Status</option>
            <option value="Owner">Owner</option>
            <option value="Priority">Priority</option>
          </select>
          <svg className="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M4 6L8 10L12 6" />
          </svg>
        </div>
        <div className="p8-select p8-filters__pick">
          <select className="p8-select__control" aria-label="Filter value" data-value defaultValue="Open">
            <option value="Open">Open</option>
            <option value="In progress">In progress</option>
            <option value="Closed">Closed</option>
          </select>
          <svg className="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M4 6L8 10L12 6" />
          </svg>
        </div>
        <button className="p8-button" type="button" data-add>
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
            <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
          </svg>
          Add filter
        </button>
      </div>
      <div className="p8-filters__chips">
        <div className="p8-filters__list" role="group" aria-label="Active filters" data-chips>
          <span className="p8-tag" data-chip="Status: Open">
            Status: Open
            <button className="p8-tag__close" type="button" aria-label="Remove Status: Open" data-close>
              <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
                <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
              </svg>
            </button>
          </span>
          <span className="p8-tag" data-chip="Priority: High">
            Priority: High
            <button className="p8-tag__close" type="button" aria-label="Remove Priority: High" data-close>
              <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
                <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
              </svg>
            </button>
          </span>
          <span className="p8-filters__empty" data-empty hidden>No filters</span>
        </div>
        <button className="p8-button p8-button--ghost" type="button" data-clear>Clear all</button>
      </div>
      <template data-chip-template>
        <span className="p8-tag" data-chip="__label__">
          __label__
          <button className="p8-tag__close" type="button" aria-label="Remove __label__" data-close>
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
              <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
            </svg>
          </button>
        </span>
      </template>
    </div>
  );
}

/* filter-bar.css */
.p8-filters {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-filters__row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
}

.p8-select {
  position: relative;
  display: flex;
  align-items: center;
}

.p8-filters__pick {
  flex: 1;
  min-width: 0;
}

.p8-select__control {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  appearance: none;
  padding-inline-end: var(--p8-space-32);
  cursor: pointer;
}

.p8-select__control:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-select__control:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-select__control:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-select__icon {
  position: absolute;
  inset-inline-end: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-filters__chips {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
}

.p8-filters__list {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  overflow-x: auto;
  scrollbar-width: thin;
  white-space: nowrap;
}

.p8-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-8);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tag__close {
  display: inline-flex;
  padding: 0;
  border: none;
  background: transparent;
  color: inherit;
  cursor: pointer;
  border-radius: var(--p8-radius-4);
}

.p8-tag__close:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-filters__empty {
  color: var(--p8-color-ink-muted);
}

.p8-filters__empty[hidden] {
  display: none;
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function fbData(b) { try { return JSON.parse(b.getAttribute('data-fields') || '{}'); } catch (err) { return {}; } }
  function fbChips(b) { return Array.from(b.querySelectorAll('[data-chips] [data-chip]')); }
  function fbSync(b) {
    var chips = fbChips(b), off = b.querySelector('[data-add]').disabled;
    b.querySelector('[data-empty]').hidden = chips.length > 0;
    b.querySelector('[data-clear]').disabled = off || !chips.length;
    b.dispatchEvent(new CustomEvent('p8-change', { bubbles: true, detail: { filters: chips.map(function (c) { var t = c.getAttribute('data-chip'), i = t.indexOf(': '); return { field: t.slice(0, i), value: t.slice(i + 2) }; }) } }));
  }
  root.addEventListener('change', function (e) {
    var b = cl(e, '[data-p8~="filters"]');
    if (!b || !e.target.hasAttribute('data-field')) return;
    var vs = fbData(b)[e.target.value] || [], sel = b.querySelector('[data-value]');
    sel.textContent = '';
    vs.forEach(function (v) { var o = doc.createElement('option'); o.value = v; o.textContent = v; sel.appendChild(o); });
  }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="filters"]');
    if (!b) return;
    var add = cl(e, '[data-add]'), clear = cl(e, '[data-clear]'), x = cl(e, '[data-chip] [data-close]');
    if (add && !add.disabled) {
      var label = b.querySelector('[data-field]').value + ': ' + b.querySelector('[data-value]').value;
      if (fbChips(b).some(function (c) { return c.getAttribute('data-chip') === label; })) return;
      var tpl = b.querySelector('template[data-chip-template]'), src = (tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild, chip = src.cloneNode(true);
      chip.setAttribute('data-chip', label); chip.firstChild.textContent = label; chip.querySelector('[data-close]').setAttribute('aria-label', 'Remove ' + label);
      b.querySelector('[data-chips]').insertBefore(chip, b.querySelector('[data-empty]'));
      fbSync(b); return;
    }
    if (x) { x.closest('[data-chip]').remove(); fbSync(b); b.querySelector('[data-add]').focus(); return; }
    if (clear && !clear.disabled) { fbChips(b).forEach(function (c) { c.remove(); }); fbSync(b); b.querySelector('[data-field]').focus(); }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

