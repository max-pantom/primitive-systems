// Requires the Primitive Systems theme variables (theme.css).
---

<span class="p8-hovercard">
  <a class="p8-hovercard__trigger" href="#">@primitive</a>
  <span class="p8-hovercard__wrap">
    <span class="p8-hovercard__card" role="tooltip">
      <span class="p8-avatar p8-avatar--40" role="img" aria-label="Primitive 8">P8</span>
      <span class="p8-hovercard__text">
        <span class="p8-hovercard__title">Primitive 8</span>
        <span class="p8-hovercard__body">A short preview of what this link points to.</span>
      </span>
    </span>
  </span>
</span>

<style>
  .p8-hovercard {
    position: relative;
    display: inline-block;
  }

  .p8-hovercard__trigger {
    color: var(--p8-color-ink);
    text-decoration: underline;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
