"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-toast" role="status">
  <span class="p8-toast__message">Changes saved.</span>
  <button class="p8-toast__close" type="button" aria-label="Dismiss">
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="4" x2="12" y2="12" />
      <line x1="12" y1="4" x2="4" y2="12" />
    </svg>
  </button>
</div>

<style>
  .p8-toast {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    min-width: var(--p8-size-320);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
    border-radius: var(--p8-radius-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-toast__message {
    flex: 1;
  }

  .p8-toast__close {
    display: inline-flex;
    border: none;
    background: transparent;
    color: inherit;
    padding: 0;
    cursor: pointer;
