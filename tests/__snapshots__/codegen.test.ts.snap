<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-tpl-center">
  <section class="p8-tpl-panel" aria-label="Sign in" data-p8="action">
    <div class="p8-heading-group">
      <h1 class="p8-heading">Sign in</h1>
      <p class="p8-heading__desc">Welcome back. Enter your details to continue.</p>
    </div>
    <form class="p8-form" novalidate aria-label="Form" data-p8="form action" data-success="Signed in.">
      <div class="p8-form__field">
        <label class="p8-field__label" for="form-email">Email</label>
        <input class="p8-input p8-form__control" id="form-email" name="email" aria-describedby="form-email-error" data-field="Email" required aria-required="true" type="email" autocomplete="email" />
        <p class="p8-form__error" id="form-email-error" data-error></p>
      </div>
      <div class="p8-form__field">
        <label class="p8-field__label" for="form-password">Password</label>
        <input class="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" type="password" autocomplete="new-password" />
        <p class="p8-form__error" id="form-password-error" data-error></p>
      </div>
      <div class="p8-form__field">
        <label class="p8-check" data-p8="toggle">
          <button class="p8-check__box p8-form__control" type="button" role="checkbox" aria-checked="false" id="form-keep-me-signed-in" name="keep-me-signed-in" aria-describedby="form-keep-me-signed-in-error" data-field="Keep me signed in">
            <svg class="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </button>
          Keep me signed in
        </label>
        <p class="p8-form__error" id="form-keep-me-signed-in-error" data-error></p>
      </div>
      <div class="p8-form__actions">
        <button class="p8-button p8-button--primary" type="submit" data-submit>Sign in</button>
      </div>
      <p class="p8-form__status" role="status" data-status></p>
    </form>
    <div class="p8-tpl-row">
      <a class="p8-link" href="#">Forgot your password?</a>
    </div>
    <div class="p8-divider-row" role="separator" aria-orientation="horizontal">
      <div class="p8-divider__line"></div>
      <span>or</span>
      <div class="p8-divider__line"></div>
    </div>
    <button class="p8-button p8-button--ghost p8-button--block" type="button" data-action="sso">Continue with SSO</button>
    <p class="p8-tpl-foot">
      No account yet?
      <a class="p8-link" href="#">Create one</a>
    </p>
  </section>
</div>

<style>
  .p8-tpl-center {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: var(--p8-size-320);
    padding-block: var(--p8-space-24);
    padding-inline: var(--p8-space-16);
  }

  .p8-tpl-panel {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding: var(--p8-space-16);
