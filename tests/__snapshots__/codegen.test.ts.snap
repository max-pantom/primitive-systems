"// CommandPalette.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './command-palette.css';

export function CommandPalette() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-overlay" data-p8="overlay" data-hotkey>
      <div className="p8-palette" role="dialog" aria-label="Command palette" data-p8="palette">
        <input className="p8-palette__input" type="text" role="combobox" aria-expanded="true" placeholder="Type a command" aria-label="Command" />
        <div className="p8-palette__list" role="listbox">
          <button className="p8-palette__item p8-palette__item--active" type="button" role="option">Go to Overview</button>
          <button className="p8-palette__item" type="button" role="option">Create project</button>
          <button className="p8-palette__item" type="button" role="option">Open settings</button>
        </div>
      </div>
    </div>
  );
}

/* command-palette.css */
.p8-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  background: var(--p8-color-backdrop);
  box-sizing: border-box;
  padding: var(--p8-space-24);
}

.p8-overlay[hidden] {
  display: none;
}

.p8-palette {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding: var(--p8-space-8);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-palette__input {
  box-sizing: border-box;
  width: 100%;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__input:focus-visible {
  outline: none;
  background: var(--p8-color-control-strong);
}

.p8-palette__input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-palette__list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-palette__item {
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-palette__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-palette__item--active {
  background: var(--p8-color-control-strong);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-palette__item","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function oClose(o) { o.hidden = true; o.dispatchEvent(new CustomEvent('p8-closed', { bubbles: true })); }
  function oOpen() { return all('[data-p8~="overlay"]').filter(function (o) { return !o.hidden; }); }
  root.addEventListener('click', function (e) {
    var o = cl(e, '[data-p8~="overlay"]');
    if (!o) return;
    if (e.target === o || cl(e, '[data-close]')) oClose(o);
  }, { signal: ac.signal });
  doc.addEventListener('keydown', function (e) {
    var open = oOpen();
    var o = open[open.length - 1];
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      var hot = all('[data-p8~="overlay"][data-hotkey]')[0];
      if (hot) { e.preventDefault(); hot.hidden = !hot.hidden; if (!hot.hidden) { var i = hot.querySelector('input'); if (i) i.focus(); } }
      return;
    }
    if (!o) return;
    if (e.key === 'Escape') { oClose(o); return; }
    if (e.key !== 'Tab') return;
    var f = Array.from(o.querySelectorAll('button, input, [href], select, textarea, [tabindex]')).filter(function (x) { return !x.disabled && x.tabIndex >= 0; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1], act = doc.activeElement;
    if (!o.contains(act)) { e.preventDefault(); first.focus(); }
    else if (e.shiftKey && act === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && act === last) { e.preventDefault(); first.focus(); }
  }, { signal: ac.signal });

  function pOpts(p) { return Array.from(p.querySelectorAll('[role="option"]')).filter(function (x) { return !x.hidden; }); }
  function pMark(p, it) { Array.from(p.querySelectorAll('[role="option"]')).forEach(function (x) { setOn(x, x === it); }); }
  root.addEventListener('input', function (e) {
    var p = cl(e, '[data-p8~="palette"]');
    if (!p || e.target.tagName !== 'INPUT') return;
    var q = e.target.value.toLowerCase();
    Array.from(p.querySelectorAll('[role="option"]')).forEach(function (x) { x.hidden = x.textContent.toLowerCase().indexOf(q) < 0; });
    pMark(p, pOpts(p)[0]);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var p = cl(e, '[data-p8~="palette"]');
    if (!p) return;
    var list = pOpts(p), cur = list.findIndex(function (x) { return x.classList.contains('p8-palette__item--active'); });
    if (e.key === 'ArrowDown') cur = (cur + 1) % list.length;
    else if (e.key === 'ArrowUp') cur = (cur - 1 + list.length) % list.length;
    else if (e.key === 'Enter') { if (list[cur]) { e.preventDefault(); list[cur].click(); } return; }
    else return;
    e.preventDefault();
    pMark(p, list[cur]);
  }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="palette"] [role="option"]');
    if (it) pMark(it.closest('[data-p8~="palette"]'), it);
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(clearTimeout); };
}
"
`;

