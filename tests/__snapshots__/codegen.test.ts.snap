exports[`codegen snapshots > form #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<form class="p8-form" novalidate aria-label="Form" data-p8="form action" data-success="Account created.">
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-full-name">Full name</label>
    <input class="p8-input p8-form__control" id="form-full-name" name="full-name" aria-describedby="form-full-name-error" data-field="Full name" required aria-required="true" type="text" autocomplete="name" />
    <p class="p8-form__error" id="form-full-name-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-work-email">Work email</label>
    <input class="p8-input p8-form__control" id="form-work-email" name="work-email" aria-describedby="form-work-email-error" data-field="Work email" required aria-required="true" type="email" autocomplete="email" />
    <p class="p8-form__error" id="form-work-email-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-password">Password</label>
    <input class="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" data-min="8" type="password" autocomplete="new-password" />
    <p class="p8-form__error" id="form-password-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-role">
      Role
      <span class="p8-form__optional"> (optional)</span>
    </label>
    <div class="p8-select">
      <select class="p8-select__control p8-form__control" id="form-role" name="role" aria-describedby="form-role-error" data-field="Role">
        <option value="Designer" selected>Designer</option>
        <option value="Engineer">Engineer</option>
        <option value="Manager">Manager</option>
      </select>
      <svg class="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6L8 10L12 6" />
      </svg>
    </div>
    <p class="p8-form__error" id="form-role-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-about-you">
      About you
      <span class="p8-form__optional"> (optional)</span>
    </label>
    <textarea class="p8-input p8-form__control" id="form-about-you" name="about-you" aria-describedby="form-about-you-error" data-field="About you" rows="3"></textarea>
    <p class="p8-form__error" id="form-about-you-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-check" data-p8="toggle">
      <button class="p8-check__box p8-form__control" type="button" role="checkbox" aria-checked="false" id="form-i-agree-to-the-terms" name="i-agree-to-the-terms" aria-describedby="form-i-agree-to-the-terms-error" data-field="I agree to the terms" required aria-required="true">
        <svg class="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
      I agree to the terms
    </label>
    <p class="p8-form__error" id="form-i-agree-to-the-terms-error" data-error></p>
  </div>
  <div class="p8-form__actions">
    <button class="p8-button p8-button--primary" type="submit" data-submit>Create account</button>
  </div>
  <p class="p8-form__status" role="status" data-status></p>
</form>

<style>
  .p8-form {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    margin: 0;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
  }

  .p8-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    min-width: 0;
  }

  .p8-field__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
    color: var(--p8-color-ink);
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-form__control[aria-invalid="true"] {
    outline: var(--p8-border-hairline) solid var(--p8-color-ink);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-form__error {
    margin: 0;
    min-height: var(--p8-type-line-sm);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-form__optional {
    color: var(--p8-color-ink-muted);
    font-weight: var(--p8-type-weight);
  }

  .p8-select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .p8-select__control {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
    appearance: none;
    padding-inline-end: var(--p8-space-32);
    cursor: pointer;
  }

  .p8-select__control:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-select__icon {
    position: absolute;
    inset-inline-end: var(--p8-space-12);
    pointer-events: none;
    color: var(--p8-color-ink);
  }

  .p8-check {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-check__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink-inverse);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    cursor: inherit;
  }

  .p8-check__box:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-check__box:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-check__box:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-check__icon {
    opacity: 0;
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-form__actions {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
