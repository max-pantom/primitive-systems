"// OtpInput.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './otp-input.css';

export function OtpInput() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-otp" role="group" aria-label="One-time code" data-p8="otp">
      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" />
      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 2" />
