    outline: var(--p8-border-focus) solid var(--p8-color-ink);
    outline-offset: var(--p8-border-focus-offset);
  }

  .p8-divider {
    flex-shrink: 0;
    width: 100%;
    height: var(--p8-border-hairline);
    background: var(--p8-color-ring);
  }
</style>
"
