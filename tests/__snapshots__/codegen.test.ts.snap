          </tr>
        </thead>
        <tbody>
          <tr className="p8-dtable__row" data-row="0">
            <td className="p8-dtable__cell p8-dtable__select">
              <button className="p8-check__box" type="button" role="checkbox" aria-checked="false" aria-label="Select Ada Lovelace" data-pick>
                <svg className="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
