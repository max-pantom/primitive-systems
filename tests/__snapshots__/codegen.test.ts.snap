exports[`codegen snapshots > filter-bar #1 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-filters" data-p8="filters" data-fields="{&quot;Status&quot;:[&quot;Open&quot;,&quot;In progress&quot;,&quot;Closed&quot;],&quot;Owner&quot;:[&quot;Ada&quot;,&quot;Grace&quot;,&quot;Alan&quot;],&quot;Priority&quot;:[&quot;High&quot;,&quot;Medium&quot;,&quot;Low&quot;]}">
  <div class="p8-filters__row">
    <div class="p8-select p8-filters__pick">
      <select class="p8-select__control" aria-label="Filter field" data-field disabled>
        <option value="Status" selected>Status</option>
        <option value="Owner">Owner</option>
        <option value="Priority">Priority</option>
      </select>
      <svg class="p8-icon p8-select__icon p8-select__icon--disabled" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6L8 10L12 6" />
      </svg>
    </div>
    <div class="p8-select p8-filters__pick">
      <select class="p8-select__control" aria-label="Filter value" data-value disabled>
        <option value="Open" selected>Open</option>
        <option value="In progress">In progress</option>
        <option value="Closed">Closed</option>
      </select>
      <svg class="p8-icon p8-select__icon p8-select__icon--disabled" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6L8 10L12 6" />
      </svg>
    </div>
    <button class="p8-button" type="button" data-add disabled>
      <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
        <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
      </svg>
      Add filter
    </button>
  </div>
  <div class="p8-filters__chips">
    <div class="p8-filters__list" role="group" aria-label="Active filters" data-chips>
      <span class="p8-tag" data-chip="Status: Open">
        Status: Open
        <button class="p8-tag__close" type="button" aria-label="Remove Status: Open" data-close disabled>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-tag" data-chip="Priority: High">
        Priority: High
        <button class="p8-tag__close" type="button" aria-label="Remove Priority: High" data-close disabled>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-filters__empty" data-empty hidden>No filters</span>
    </div>
    <button class="p8-button p8-button--ghost" type="button" data-clear disabled>Clear all</button>
  </div>
  <template data-chip-template>
    <span class="p8-tag" data-chip="__label__">
      __label__
      <button class="p8-tag__close" type="button" aria-label="Remove __label__" data-close disabled>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
        </svg>
      </button>
    </span>
  </template>
</div>

<style>
  .p8-filters {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-filters__row {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
  }

  .p8-select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .p8-filters__pick {
    flex: 1;
    min-width: 0;
  }

  .p8-select__control {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
    appearance: none;
    padding-inline-end: var(--p8-space-32);
    cursor: pointer;
  }

  .p8-select__control:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-select__icon {
    position: absolute;
    inset-inline-end: var(--p8-space-12);
    pointer-events: none;
    color: var(--p8-color-ink);
  }

  .p8-select__icon--disabled {
    opacity: var(--p8-opacity-disabled);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-filters__chips {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
  }

  .p8-filters__list {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    overflow-x: auto;
    scrollbar-width: thin;
    white-space: nowrap;
  }

  .p8-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-tag__close {
    display: inline-flex;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--p8-radius-4);
  }

  .p8-tag__close:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-filters__empty {
    color: var(--p8-color-ink-muted);
  }

  .p8-filters__empty[hidden] {
    display: none;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


