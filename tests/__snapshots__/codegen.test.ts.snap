"// ChatComposer.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './chat-composer.css';

export function ChatComposer() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <form ref={ref} className="p8-composer" aria-label="Send a message" data-p8="composer" data-busy="true">
      <div className="p8-composer__box">
        <textarea className="p8-composer__input" rows="1" placeholder="Message the assistant…" aria-label="Message" aria-describedby="composer-hint" enterKeyHint="send" data-input disabled defaultValue="Sample {x} &lt;y&gt;"></textarea>
        <div className="p8-composer__bar">
          <div className="p8-composer__tools"></div>
          <div className="p8-composer__tools">
            <button className="p8-iconbtn p8-composer__send" type="button" aria-label="Stop generating" data-stop disabled>
              <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="4" y1="4" x2="12" y2="12" />
                <line x1="12" y1="4" x2="4" y2="12" />
              </svg>
            </button>
            <button className="p8-iconbtn p8-composer__send" type="submit" aria-label="Send message" data-send hidden disabled>
              <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="2.75" y1="7.75" x2="13.25" y2="7.75" />
                <path d="M10.5 5L13.25 7.75L10.5 10.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <p className="p8-composer__hint" id="composer-hint" hidden>Enter to send, Shift+Enter for a new line</p>
    </form>
  );
}

/* chat-composer.css */
.p8-composer {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  font-family: var(--p8-type-family);
}

.p8-composer__box {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-control);
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-composer__box:focus-within {
  background: var(--p8-color-control-strong);
}

.p8-composer__input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  max-height: var(--p8-size-160);
  padding: 0;
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  resize: none;
  outline: none;
  overflow-y: auto;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-composer__input:disabled {
  cursor: not-allowed;
}

.p8-composer__input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-composer__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-8);
}

.p8-composer__tools {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  min-width: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-composer__send {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-composer__send:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-composer__send[hidden] {
  display: none;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-composer__hint {
  margin: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-composer__hint[hidden] {
  display: none;
}

// ---behavior---
