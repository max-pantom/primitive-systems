"// Select.tsx — Requires the Primitive Systems theme variables (theme.css).
import './select.css';

export function Select() {
  return (
    <div className="p8-field">
      <label className="p8-field__label" htmlFor="field">Option</label>
      <div className="p8-select">
        <select className="p8-select__control" id="field" disabled defaultValue="One">
          <option>One</option>
          <option>Two</option>
          <option>Three</option>
        </select>
        <svg className="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M4 6L8 10L12 6" />
        </svg>
      </div>
    </div>
  );
}

/* select.css */
.p8-field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  font-family: var(--p8-type-family);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-select {
  position: relative;
  display: flex;
  align-items: center;
}

.p8-select__control {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  box-shadow: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  appearance: none;
  padding-inline-end: var(--p8-space-32);
  cursor: pointer;
}

.p8-select__control:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-select__control:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}

.p8-select__control:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-select__icon {
  position: absolute;
  inset-inline-end: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink);
}
"
`;

