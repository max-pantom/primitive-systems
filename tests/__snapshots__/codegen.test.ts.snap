"// PasswordInput.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './password-input.css';

export function PasswordInput() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-password" data-p8="password">
      <div className="p8-password__wrap">
        <label className="p8-field__label" htmlFor="password">Password</label>
        <div className="p8-password__field">
          <input className="p8-input p8-password__input" id="password" type="password" autoComplete="new-password" spellCheck="false" data-password aria-describedby="password-rules" />
          <button className="p8-iconbtn p8-iconbtn--flat p8-password__toggle" type="button" aria-label="Show password" aria-pressed="false" data-reveal>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M1.75 8C4.75 1.75 11.25 1.75 14.25 8C11.25 14.25 4.75 14.25 1.75 8Z" />
              <circle cx="8" cy="8" r="2.25" />
            </svg>
          </button>
        </div>
      </div>
      <ul className="p8-password__rules" id="password-rules" aria-label="Password requirements">
        <li className="p8-password__rule" data-rule="length:8">
          <svg className="p8-icon p8-password__yes" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M2.5 7L5.5 10L11.5 4" />
          </svg>
