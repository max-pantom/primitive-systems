"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


    function cmpFit(t) { t.style.height = 'auto'; t.style.height = Math.min(t.scrollHeight, 160) + 'px'; }
    function cmpSync(f) {
      var t = f.querySelector('[data-input]'), send = f.querySelector('[data-send]');
      send.disabled = !t.value.trim() || t.disabled || f.getAttribute('data-busy') === 'true';
    }
    function cmpBusy(f, busy) {
      f.setAttribute('data-busy', String(busy));
      f.querySelector('[data-send]').hidden = busy; f.querySelector('[data-stop]').hidden = !busy;
      cmpSync(f);
    }
    function cmpSend(f) {
      var t = f.querySelector('[data-input]'), text = t.value.trim();
      if (!text || f.getAttribute('data-busy') === 'true' || t.disabled) return;
      f.dispatchEvent(new CustomEvent('p8-send', { bubbles: true, detail: { text: text } }));
      t.value = ''; cmpFit(t); cmpSync(f); t.focus();
    }
    root.addEventListener('input', function (e) { var f = cl(e, '[data-p8~="composer"]'); if (f && e.target.hasAttribute('data-input')) { cmpFit(e.target); cmpSync(f); } }, { signal: ac.signal });
    root.addEventListener('keydown', function (e) {
      var f = cl(e, '[data-p8~="composer"]');
      if (!f || !e.target.hasAttribute('data-input')) return;
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); cmpSend(f); }
    }, { signal: ac.signal });
    root.addEventListener('submit', function (e) { var f = cl(e, '[data-p8~="composer"]'); if (f) { e.preventDefault(); cmpSend(f); } }, { signal: ac.signal });
    root.addEventListener('click', function (e) {
      var f = cl(e, '[data-p8~="composer"]');
      if (!f) return;
      if (cl(e, '[data-p8~="composer"] [data-stop]')) f.dispatchEvent(new CustomEvent('p8-stop', { bubbles: true }));
      else if (cl(e, '[data-p8~="composer"] [data-attach]')) f.querySelector('[data-file]').click();
    }, { signal: ac.signal });
    root.addEventListener('change', function (e) {
      var f = cl(e, '[data-p8~="composer"]');
      if (!f || !e.target.hasAttribute('data-file')) return;
      var files = Array.from(e.target.files || []);
      f.querySelector('[data-files]').textContent = files.length ? files.length + (files.length === 1 ? ' file' : ' files') : '';
      f.dispatchEvent(new CustomEvent('p8-attach', { bubbles: true, detail: { files: files } }));
    }, { signal: ac.signal });
    all('[data-p8~="composer"]').forEach(function (f) {
      var t = f.querySelector('[data-input]');
      if (t.value) cmpFit(t);
      cmpSync(f);
      f.addEventListener('p8-busy', function (e) { cmpBusy(f, !!(e.detail && e.detail.busy)); }, { signal: ac.signal });
    });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<form bind:this={el} class="p8-composer" aria-label="Send a message" data-p8="composer" data-busy="true">
  <div class="p8-composer__box">
    <textarea class="p8-composer__input" rows="1" placeholder="Message the assistant…" aria-label="Message" aria-describedby="composer-hint" enterkeyhint="send" data-input disabled>Sample {x} &lt;y&gt;</textarea>
    <div class="p8-composer__bar">
      <div class="p8-composer__tools"></div>
      <div class="p8-composer__tools">
        <button class="p8-iconbtn p8-composer__send" type="button" aria-label="Stop generating" data-stop disabled>
          <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="4" x2="12" y2="12" />
            <line x1="12" y1="4" x2="4" y2="12" />
          </svg>
        </button>
        <button class="p8-iconbtn p8-composer__send" type="submit" aria-label="Send message" data-send hidden disabled>
          <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="2.75" y1="7.75" x2="13.25" y2="7.75" />
            <path d="M10.5 5L13.25 7.75L10.5 10.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
  <p class="p8-composer__hint" id="composer-hint" hidden>Enter to send, Shift+Enter for a new line</p>
</form>

<style>
  .p8-composer {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    width: var(--p8-size-500);
    max-width: 100%;
    margin: 0;
    font-family: var(--p8-type-family);
  }

  .p8-composer__box {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-12);
    background: var(--p8-color-control);
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-composer__box:focus-within {
    background: var(--p8-color-control-strong);
  }

  .p8-composer__input {
    display: block;
    width: 100%;
    box-sizing: border-box;
    max-height: var(--p8-size-160);
    padding: 0;
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    resize: none;
    outline: none;
    overflow-y: auto;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-composer__input:disabled {
    cursor: not-allowed;
  }

  .p8-composer__input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-composer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-8);
  }

  .p8-composer__tools {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    min-width: 0;
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-composer__send {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-composer__send:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-composer__send[hidden] {
    display: none;
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-composer__hint {
    margin: 0;
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-composer__hint[hidden] {
    display: none;
  }
</style>
"
