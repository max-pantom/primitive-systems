exports[`codegen snapshots > timer #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-timer" role="timer" aria-label="Countdown" data-p8="timer" data-mode="countdown" data-seconds="90">
  <span class="p8-timer__time" data-time>01:30</span>
  <span class="p8-timer__actions">
    <button class="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="toggle">Start</button>
    <button class="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="reset">Reset</button>
  </span>
</div>

<style>
  .p8-timer {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-12);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight);
  }

  .p8-timer__time {
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
    font-weight: var(--p8-type-weight-strong);
    font-variant-numeric: tabular-nums;
    min-width: var(--p8-size-64);
    text-align: center;
  }

  .p8-timer__actions {
    display: inline-flex;
    gap: var(--p8-space-8);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-timer__btn {
    min-width: var(--p8-size-72);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function tFmt(s) { var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), x = s % 60; var pad = function (n) { return (n < 10 ? '0' : '') + n; }; return h > 0 ? h + ':' + pad(m) + ':' + pad(x) : pad(m) + ':' + pad(x); }
  all('[data-p8~="timer"]').forEach(function (t) {
    var down = t.getAttribute('data-mode') !== 'stopwatch', start = Number(t.getAttribute('data-seconds')) || 0;
    var cur = down ? start : 0, run = false, id = null, el = t.querySelector('[data-time]'), btn = t.querySelector('[data-timer="toggle"]');
    function paint() { el.textContent = tFmt(cur); t.classList.toggle('p8-timer--done', down && cur === 0); }
    function stop() { run = false; clearInterval(id); if (btn) btn.textContent = 'Start'; }
    function tick() {
      if (down) { cur = Math.max(0, cur - 1); if (cur === 0) { stop(); t.dispatchEvent(new CustomEvent('p8-timer-done', { bubbles: true })); } } else cur++;
      paint();
    }
    function go() { if (run || (down && cur === 0)) return; run = true; id = setInterval(tick, 1000); timers.push(id); if (btn) btn.textContent = 'Pause'; }
    t.__p8 = { toggle: function () { run ? stop() : go(); }, reset: function () { stop(); cur = down ? start : 0; paint(); } };
    paint();
    if (t.hasAttribute('data-autostart')) go();
  });
  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="timer"] [data-timer]');
    if (!b) return;
    var t = b.closest('[data-p8~="timer"]');
    if (t.__p8) t.__p8[b.getAttribute('data-timer')]();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
`;

