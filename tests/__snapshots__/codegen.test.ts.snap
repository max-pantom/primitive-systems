      var clipEl = cl(e, '[data-p8~="mediatl"] [data-clip]');
      if (clipEl) { if (r.__sel !== clipEl) mtSelect(r, clipEl, false); return; }
      var b = cl(e, '[data-p8~="mediatl"] [data-act]');
      if (!b || b.disabled) return;
      var a = b.getAttribute('data-act');
      if (a === 'play') mtPlay(r, !r.__iv);
      else if (a === 'start') mtSeek(r, 0, { say: true, reveal: true });
      else if (a === 'end') mtSeek(r, mtDur(r), { say: true, reveal: true });
      else if (a === 'split') mtSplit(r);
      else if (a === 'delete') mtDelete(r);
      else if (a === 'snap') { var on = !mtSnapOn(r); r.setAttribute('data-snap', String(on)); b.setAttribute('aria-pressed', String(on)); mtSay(r, 'Snapping ' + (on ? 'on' : 'off')); }
      else if (a === 'zoomin') mtZoom(r, mtPPS(r) * 1.5);
      else if (a === 'zoomout') mtZoom(r, mtPPS(r) / 1.5);
    }, { signal: ac.signal });
    root.addEventListener('wheel', function (e) {
      var r = cl(e, '[data-p8~="mediatl"] [data-scroll]') && mtR(e.target);
      if (!r || !(e.ctrlKey || e.metaKey)) return;
      e.preventDefault();
      mtZoom(r, mtPPS(r) * (e.deltaY < 0 ? 1.15 : 1 / 1.15));
    }, { signal: ac.signal, passive: false });
    root.addEventListener('keydown', function (e) {
      var r = cl(e, '[data-p8~="mediatl"]');
      if (!r) return;
      var t = e.target, k = e.key, fps = mtFps(r), step = e.shiftKey ? 1 : 1 / fps;
      if (t.hasAttribute && t.hasAttribute('data-ruler')) {
        var now = mtTime(r), to = null;
        if (k === 'ArrowRight') to = now + step; else if (k === 'ArrowLeft') to = now - step;
        else if (k === 'PageUp') to = now + 5; else if (k === 'PageDown') to = now - 5;
        else if (k === 'Home') to = 0; else if (k === 'End') to = mtDur(r);
        else if (k === ' ') { e.preventDefault(); mtPlay(r, !r.__iv); return; }
        if (to === null) return;
        e.preventDefault(); mtSeek(r, to, { say: true, reveal: true }); return;
      }
      if (!(t.hasAttribute && t.hasAttribute('data-clip'))) return;
      var lane = t.parentNode, list = mtSorted(lane), i = list.indexOf(t), lanes = mtLanes(r), li = lanes.indexOf(lane);
      if (k === 's' || k === 'S') { e.preventDefault(); mtSelect(r, t, false); mtSplit(r); return; }
      if (k === 'Delete' || k === 'Backspace') { e.preventDefault(); mtSelect(r, t, false); mtDelete(r); return; }
      if (k === '[' || k === ']') {
        e.preventDefault(); var pt = mtTime(r), s0 = mtStart(t), e0 = s0 + mtLen(t);
        if (pt <= s0 || pt >= e0) { mtSay(r, 'Move the playhead inside the clip to trim'); return; }
        mtTrim(r, t, k === '[' ? 'start' : 'end', pt); mtSay(r, mtName(t) + ' trimmed'); mtChange(r); return;
      }
      if (e.altKey) {
        var moved = false;
        if (k === 'ArrowLeft') moved = mtMoveTo(r, t, lane, mtStart(t) - step);
        else if (k === 'ArrowRight') moved = mtMoveTo(r, t, lane, mtStart(t) + step);
        else if (k === 'ArrowUp' && lanes[li - 1]) moved = mtMoveTo(r, t, lanes[li - 1], mtStart(t));
        else if (k === 'ArrowDown' && lanes[li + 1]) moved = mtMoveTo(r, t, lanes[li + 1], mtStart(t));
        else return;
        e.preventDefault();
        if (moved) { t.focus(); mtSay(r, mtName(t) + ' moved to ' + mtTC(r, mtStart(t)) + ' on ' + t.parentNode.getAttribute('data-track')); mtChange(r); } else mtSay(r, 'No room there');
        return;
      }
      var target = null;
      if (k === 'ArrowLeft') target = list[i - 1]; else if (k === 'ArrowRight') target = list[i + 1];
      else if (k === 'ArrowUp' || k === 'ArrowDown') {
        var other = lanes[li + (k === 'ArrowUp' ? -1 : 1)];
        if (other) { var s = mtStart(t), cl2 = mtSorted(other); target = cl2.find(function (o) { return mtStart(o) + mtLen(o) > s; }) || cl2[cl2.length - 1]; }
      } else return;
      e.preventDefault();
      if (target) { t.tabIndex = -1; target.tabIndex = 0; target.focus(); }
    }, { signal: ac.signal });
    all('[data-p8~="mediatl"]').forEach(function (r) {
      mtClips(r).forEach(function (c) { mtLabel(r, c); });
      if (r.getAttribute('data-playing') === 'true') mtPlay(r, true);
    });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<section bind:this={el} class="p8-mt" role="group" aria-label="Timeline" data-p8="mediatl" data-fps="30" data-duration="30" data-time="0" data-pps="24" data-snap="true" data-playing="false" style="--p8-pps: 24">
  <div class="p8-mt__bar" role="toolbar" aria-label="Timeline controls">
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Go to start" data-act="start">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="3.75" x2="2.75" y2="12.25" />
        <polygon points="12.25,3.75 5.75,8 12.25,12.25" />
      </svg>
    </button>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Play" data-act="play" aria-pressed="false">
      <svg class="p8-icon p8-mt__ic p8-mt__ic--on" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="5.75,3.75 12.5,8 5.75,12.25" />
      </svg>
      <svg class="p8-icon p8-mt__ic" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5.75" y1="3.75" x2="5.75" y2="12.25" />
        <line x1="10.25" y1="3.75" x2="10.25" y2="12.25" />
      </svg>
    </button>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Go to end" data-act="end">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="13.25" y1="3.75" x2="13.25" y2="12.25" />
        <polygon points="3.75,3.75 10.25,8 3.75,12.25" />
      </svg>
    </button>
    <span class="p8-mt__sep" role="separator" aria-orientation="vertical"></span>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Split at playhead" data-act="split">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="4.5" cy="4.5" r="1.75" />
        <circle cx="4.5" cy="11.5" r="1.75" />
        <path d="M6 6L13 13M6 10L13 3" />
      </svg>
    </button>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Delete clip" data-act="delete">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3.75 6.75L4.25 12.25Q4.3 13.25 5.75 13.25H10.25Q11.7 13.25 11.75 12.25L12.25 6.75" />
        <path d="M2.75 5.75H13.25M5.75 5.75V2.75H10.25V5.75" />
        <line x1="7.75" y1="8.75" x2="7.75" y2="10.25" />
      </svg>
    </button>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Snapping" data-act="snap" aria-pressed="true">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.75 2.75H5.75V8.75C5.75 12 10.25 12 10.25 8.75V2.75H13.25V8.75C13.25 16 2.75 16 2.75 8.75Z" />
        <path d="M2.75 6.25H5.75M10.25 6.25H13.25" />
      </svg>
    </button>
    <span class="p8-mt__grow"></span>
    <output class="p8-mt__time" data-timecode aria-label="Playhead timecode">00:00:00:00</output>
    <span class="p8-mt__grow"></span>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Zoom out" data-act="zoomout">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="7" cy="7" r="4.25" />
        <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
        <path d="M5.25 7H8.75" />
      </svg>
    </button>
    <span class="p8-mt__zoom" data-zoomlabel aria-hidden="true">1×</span>
    <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Zoom in" data-act="zoomin">
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="7" cy="7" r="4.25" />
        <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
        <path d="M5.25 7H8.75M7 5.25V8.75" />
      </svg>
    </button>
  </div>
  <div class="p8-mt__body">
    <div class="p8-mt__labels" aria-hidden="true">
      <div class="p8-mt__corner"></div>
      <div class="p8-mt__label">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1.75" y="3.75" width="6.5" height="6.5" rx="1.5" />
          <path d="M8.75 5.75L12.25 3.75V10.25L8.75 8.25" />
        </svg>
        Video 2
      </div>
      <div class="p8-mt__label">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1.75" y="3.75" width="6.5" height="6.5" rx="1.5" />
          <path d="M8.75 5.75L12.25 3.75V10.25L8.75 8.25" />
        </svg>
        Video 1
      </div>
      <div class="p8-mt__label">
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4.75 10.25V3.75L11.25 2.75V9.25" />
          <circle cx="3" cy="11" r="1.5" fill="currentColor" stroke="none" />
          <circle cx="9.5" cy="10" r="1.5" fill="currentColor" stroke="none" />
        </svg>
        Audio 1
      </div>
    </div>
    <div class="p8-mt__scroll" data-scroll>
      <div class="p8-mt__canvas" data-canvas style="width: calc(var(--p8-pps) * 30px)">
        <div class="p8-mt__ruler" role="slider" tabindex="0" aria-label="Playhead" aria-valuemin="0" aria-valuemax="30" aria-valuenow="0" aria-valuetext="00:00:00:00" data-ruler>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 0px)">0:00</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 5px)">0:05</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 10px)">0:10</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 15px)">0:15</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 20px)">0:20</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 25px)">0:25</span>
          <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 30px)">0:30</span>
        </div>
        <div class="p8-mt__lane" role="group" aria-label="Track Video 2" data-lane data-track="Video 2" data-kind="video">
          <button class="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="1" data-dur="4" aria-pressed="false" tabindex="-1" aria-label="Title, Video 2, starts at 00:00:01:00, 4 seconds" style="left: calc(var(--p8-pps) * 1px); width: calc(var(--p8-pps) * 4px)">
            <span class="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
            <span class="p8-mt__name" data-name>Title</span>
            <span class="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
          </button>
        </div>
        <div class="p8-mt__lane" role="group" aria-label="Track Video 1" data-lane data-track="Video 1" data-kind="video">
          <button class="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="0" data-dur="6" aria-pressed="false" tabindex="0" aria-label="Intro, Video 1, starts at 00:00:00:00, 6 seconds" style="left: calc(var(--p8-pps) * 0px); width: calc(var(--p8-pps) * 6px)">
            <span class="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
            <span class="p8-mt__name" data-name>Intro</span>
            <span class="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
          </button>
          <button class="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="6.5" data-dur="12" aria-pressed="false" tabindex="-1" aria-label="Interview, Video 1, starts at 00:00:06:15, 12 seconds" style="left: calc(var(--p8-pps) * 6.5px); width: calc(var(--p8-pps) * 12px)">
            <span class="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
            <span class="p8-mt__name" data-name>Interview</span>
            <span class="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
          </button>
        </div>
        <div class="p8-mt__lane" role="group" aria-label="Track Audio 1" data-lane data-track="Audio 1" data-kind="audio">
          <button class="p8-mt__clip p8-mt__clip--audio" type="button" data-clip data-start="0" data-dur="24" aria-pressed="false" tabindex="-1" aria-label="Music, Audio 1, starts at 00:00:00:00, 24 seconds" style="left: calc(var(--p8-pps) * 0px); width: calc(var(--p8-pps) * 24px)">
            <span class="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
            <span class="p8-mt__name" data-name>Music</span>
            <span class="p8-mt__handle p8-mt__handle--end" data-handle="end" aria-hidden="true"></span>
          </button>
        </div>
        <div class="p8-mt__playhead" data-playhead aria-hidden="true" style="left: calc(var(--p8-pps) * 0px)"></div>
      </div>
    </div>
  </div>
  <p class="p8-mt__sr" role="status" aria-live="polite" data-live></p>
  <template data-parts>
    <span class="p8-mt__tick" data-tick aria-hidden="true" style="left: calc(var(--p8-pps) * 0px)">0:00</span>
  </template>
</section>

<style>
  .p8-mt {
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: var(--p8-size-720);
    max-width: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--p8-radius-12);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-mt__bar {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-mt__ic {
    display: none;
  }

  .p8-mt__ic--on {
    display: block;
  }

  .p8-mt__sep {
    width: 0;
    height: var(--p8-size-16);
    margin-inline: var(--p8-space-4);
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-mt__grow {
    flex: 1;
  }

  .p8-mt__time {
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
    font-variant-numeric: tabular-nums;
    min-width: var(--p8-size-96);
    text-align: center;
    color: var(--p8-color-ink);
  }

  .p8-mt__zoom {
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
    min-width: var(--p8-size-40);
    text-align: center;
    color: var(--p8-color-ink-muted);
  }

  .p8-mt__body {
    display: flex;
    min-width: 0;
  }

  .p8-mt__labels {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: var(--p8-size-96);
    border-right: var(--p8-border-hairline) solid var(--p8-color-ring);
    background: var(--p8-color-surface);
  }

  .p8-mt__corner {
    height: var(--p8-size-24);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-mt__label {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    height: var(--p8-size-48);
    box-sizing: border-box;
    padding-inline: var(--p8-space-8);
    color: var(--p8-color-ink-muted);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .p8-mt__scroll {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--p8-color-ring-focus) transparent;
  }

  .p8-mt__canvas {
    position: relative;
    user-select: none;
    touch-action: none;
    min-width: 100%;
  }

  .p8-mt__ruler {
    position: relative;
    height: var(--p8-size-24);
    box-sizing: border-box;
    cursor: pointer;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
    background-image: repeating-linear-gradient(to right, var(--p8-color-ring) 0, var(--p8-color-ring) var(--p8-border-hairline), transparent var(--p8-border-hairline), transparent calc(var(--p8-pps) * var(--p8-unit-px)));
    background-size: 100% 40%;
    background-repeat: no-repeat;
    background-position: bottom left;
    color: var(--p8-color-ink-muted);
  }

  .p8-mt__ruler:focus-visible {
    box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-mt__tick {
    position: absolute;
    top: 0;
    bottom: 0;
    padding-inline-start: var(--p8-space-4);
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
    pointer-events: none;
    white-space: nowrap;
  }

  .p8-mt__lane {
    position: relative;
    height: var(--p8-size-48);
    box-sizing: border-box;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-mt__clip {
    position: absolute;
    top: var(--p8-space-4);
    bottom: var(--p8-space-4);
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-width: var(--p8-space-4);
    padding: 0;
    overflow: hidden;
    border: none;
    border-radius: var(--p8-radius-4);
    color: var(--p8-color-ink);
    cursor: grab;
    text-align: left;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-mt__clip:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-mt__clip--video {
    background: var(--p8-color-control-strong);
  }

  .p8-mt__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--p8-space-8);
    cursor: ew-resize;
    background: transparent;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-mt__clip:hover .p8-mt__handle, .p8-mt__clip:focus-within .p8-mt__handle {
    background: var(--p8-color-ring-focus);
  }

  .p8-mt__handle--start {
    left: 0;
  }

  .p8-mt__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-inline: var(--p8-space-8);
    pointer-events: none;
  }

  .p8-mt__handle--end {
    right: 0;
  }

  .p8-mt__clip--audio {
    background: var(--p8-color-control);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-mt__playhead {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--p8-space-2);
    translate: -50% 0;
    background: var(--p8-color-ink);
    pointer-events: none;
    z-index: 5;
  }

  .p8-mt__playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: var(--p8-space-12);
    height: var(--p8-space-12);
    border-radius: var(--p8-radius-4);
    background: var(--p8-color-ink);
  }

  .p8-mt__sr {
    position: absolute;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
"
`;

