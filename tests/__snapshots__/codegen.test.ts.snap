  .p8-mt__scroll {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--p8-color-ring-focus) transparent;
  }

  .p8-mt__canvas {
