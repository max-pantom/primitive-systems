<button class="[display:inline-flex] [align-items:center] [gap:var(--p8-space-8)] [padding-block:var(--p8-space-8)] [padding-inline:var(--p8-space-12)] [border-radius:var(--p8-radius-8)] [border:none] [background:transparent] [color:var(--p8-color-ink)] [cursor:pointer] [font-family:var(--p8-type-family)] [font-size:var(--p8-type-size-sm)] [line-height:var(--p8-type-line-sm)] [font-weight:var(--p8-type-weight)] [outline:var(--p8-border-hairline)_solid_var(--p8-color-ring)] [outline-offset:calc(-1_*_var(--p8-border-hairline))] enabled:hover:[background:var(--p8-color-control)] focus-visible:[box-shadow:0_0_0_var(--p8-border-focus)_var(--p8-color-ring-focus)]" type="button" data-p8="copy" data-copy="Text to copy" aria-label="Copy">
  <svg class="p8-copybtn__icon p8-copybtn__icon--on [flex-shrink:0] [display:none]" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5.75 3.25Q5.75 1.75 7.25 1.75H10.75Q12.25 1.75 12.25 3.25V6.75Q12.25 8.25 10.75 8.25" />
    <rect x="1.75" y="5.75" width="6.5" height="6.5" rx="2" />
  </svg>
  <svg class="p8-copybtn__icon [flex-shrink:0] [display:none]" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.5 7L5.5 10L11.5 4" />
  </svg>
  Copy
</button>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-copybtn__icon","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="copy"]');
    if (!b) return;
    var text = b.getAttribute('data-copy') || '';
    if (doc.defaultView && doc.defaultView.navigator && doc.defaultView.navigator.clipboard) doc.defaultView.navigator.clipboard.writeText(text);
    var icons = Array.from(b.querySelectorAll('svg'));
    icons.forEach(function (i) { setOn(i, !i.classList.contains('p8-copybtn__icon--on')); });
    timers.push(setTimeout(function () { icons.forEach(function (i) { setOn(i, !i.classList.contains('p8-copybtn__icon--on')); }); }, 1500));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
`;

exports[`codegen snapshots > dashboard #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-tpl-page" data-p8="action">
  <div class="p8-tpl-bar">
