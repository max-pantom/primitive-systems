"// Sheet.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './sheet.css';

export function Sheet() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-overlay p8-overlay--end" data-p8="overlay">
      <div className="p8-sheet" role="dialog" aria-modal="true">
        <div className="p8-sheet__head">
          <h2 className="p8-sheet__title">Sheet title</h2>
          <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Close" data-close>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="4" y1="4" x2="12" y2="12" />
              <line x1="12" y1="4" x2="4" y2="12" />
            </svg>
          </button>
        </div>
        <div className="p8-sheet__body">Sheet content goes here.</div>
      </div>
    </div>
  );
}

