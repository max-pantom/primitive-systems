            <img className="p8-gallery__img" src="data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'800'%20height%3D'600'%20viewBox%3D'0%200%20800%20600'%3E%3Crect%20width%3D'800'%20height%3D'600'%20fill%3D'whitesmoke'%2F%3E%3Ccircle%20cx%3D'320'%20cy%3D'180'%20r%3D'70'%20fill%3D'white'%20fill-opacity%3D'0.7'%2F%3E%3Cpath%20d%3D'M0%20600L260%20340L420%20460L560%20340L800%20520V600Z'%20fill%3D'dimgray'%20fill-opacity%3D'0.55'%2F%3E%3C%2Fsvg%3E" alt="" loading="lazy" />
          </button>
        </li>
      </ul>
      <div className="p8-overlay" data-p8="overlay" data-lightbox>
        <div className="p8-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
          <div className="p8-lightbox__bar">
            <span className="p8-lightbox__counter" data-counter aria-live="polite">1 / 6</span>
            <div className="p8-lightbox__nav">
              <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Previous image" data-dir="-1">
                <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M10 4L6 8L10 12" />
                </svg>
              </button>
              <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Next image" data-dir="1">
                <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M6 4L10 8L6 12" />
                </svg>
              </button>
              <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Close" data-close>
                <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <line x1="4" y1="4" x2="12" y2="12" />
                  <line x1="12" y1="4" x2="4" y2="12" />
                </svg>
              </button>
            </div>
          </div>
          <figure className="p8-lightbox__figure">
            <img className="p8-lightbox__img" src="data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20width%3D'800'%20height%3D'600'%20viewBox%3D'0%200%20800%20600'%3E%3Crect%20width%3D'800'%20height%3D'600'%20fill%3D'gainsboro'%2F%3E%3Ccircle%20cx%3D'560'%20cy%3D'180'%20r%3D'70'%20fill%3D'white'%20fill-opacity%3D'0.7'%2F%3E%3Cpath%20d%3D'M0%20600L220%20300L420%20460L560%20340L800%20520V600Z'%20fill%3D'dimgray'%20fill-opacity%3D'0.55'%2F%3E%3C%2Fsvg%3E" alt="Dunes at dawn" data-full />
            <figcaption className="p8-lightbox__caption">
              <span data-caption>Dunes at dawn</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  );
}

/* image-viewer.css */
.p8-gallery {
  width: var(--p8-size-400);
  max-width: 100%;
}

.p8-gallery__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--p8-space-8);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-gallery__grid--4 {
  grid-template-columns: repeat(4, 1fr);
}

.p8-gallery__thumb {
  display: block;
  width: 100%;
  padding: 0;
  border: none;
  overflow: hidden;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  cursor: zoom-in;
}

.p8-gallery__thumb:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-gallery__thumb:hover img {
  opacity: var(--p8-opacity-hover);
}

.p8-gallery__img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-overlay {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
  background: var(--p8-color-backdrop);
  box-sizing: border-box;
  padding: var(--p8-space-24);
}

.p8-overlay[hidden] {
  display: none;
}

.p8-lightbox {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-500);
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  padding: var(--p8-space-16);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-lightbox__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-lightbox__counter {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-lightbox__nav {
  display: flex;
  gap: var(--p8-space-8);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-lightbox__figure {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  margin: 0;
  min-height: 0;
}

.p8-lightbox__img {
  flex: 1 1 auto;
  min-height: 0;
  display: block;
  width: 100%;
  max-height: 60vh;
  object-fit: contain;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-lightbox__caption {
  display: flex;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function lbThumbs(g) { return Array.from(g.querySelectorAll('[data-open]')); }
  function lbShow(g, i) {
    var t = lbThumbs(g), n = t.length; i = (i + n) % n;
    var o = g.querySelector('[data-lightbox]'), img = o.querySelector('[data-full]'), th = t[i];
    img.src = th.querySelector('img').getAttribute('src'); img.alt = th.getAttribute('data-caption');
    o.querySelector('[data-caption]').textContent = th.getAttribute('data-caption');
    o.querySelector('[data-counter]').textContent = (i + 1) + ' / ' + n;
    g.setAttribute('data-index', String(i));
  }
  root.addEventListener('click', function (e) {
    var g = cl(e, '[data-p8~="lightbox"]');
    if (!g) return;
    var th = cl(e, '[data-open]'), dir = cl(e, '[data-lightbox] [data-dir]');
    if (th) { g.__opener = th; lbShow(g, Number(th.getAttribute('data-open'))); var o = g.querySelector('[data-lightbox]'); o.hidden = false; o.querySelector('[data-close]').focus(); return; }
    if (dir && !dir.disabled) lbShow(g, Number(g.getAttribute('data-index') || 0) + Number(dir.getAttribute('data-dir')));
  }, { signal: ac.signal });
  doc.addEventListener('keydown', function (e) {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    all('[data-p8~="lightbox"]').forEach(function (g) {
      if (g.querySelector('[data-lightbox]').hidden || lbThumbs(g).length < 2) return;
      e.preventDefault();
      lbShow(g, Number(g.getAttribute('data-index') || 0) + (e.key === 'ArrowRight' ? 1 : -1));
    });
  }, { signal: ac.signal });
  root.addEventListener('p8-closed', function (e) {
    var g = cl(e, '[data-p8~="lightbox"]');
    if (g && g.__opener) g.__opener.focus();
  }, { signal: ac.signal });

  function oClose(o) { o.hidden = true; o.dispatchEvent(new CustomEvent('p8-closed', { bubbles: true })); }
  function oOpen() { return all('[data-p8~="overlay"]').filter(function (o) { return !o.hidden; }); }
  root.addEventListener('click', function (e) {
    var o = cl(e, '[data-p8~="overlay"]');
    if (!o) return;
    if (e.target === o || cl(e, '[data-close]')) oClose(o);
  }, { signal: ac.signal });
  doc.addEventListener('keydown', function (e) {
    var open = oOpen();
    var o = open[open.length - 1];
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      var hot = all('[data-p8~="overlay"][data-hotkey]')[0];
      if (hot) { e.preventDefault(); hot.hidden = !hot.hidden; if (!hot.hidden) { var i = hot.querySelector('input'); if (i) i.focus(); } }
      return;
    }
    if (!o) return;
    if (e.key === 'Escape') { oClose(o); return; }
    if (e.key !== 'Tab') return;
    var f = Array.from(o.querySelectorAll('button, input, [href], select, textarea, [tabindex]')).filter(function (x) { return !x.disabled && x.tabIndex >= 0; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1], act = doc.activeElement;
    if (!o.contains(act)) { e.preventDefault(); first.focus(); }
    else if (e.shiftKey && act === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && act === last) { e.preventDefault(); first.focus(); }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

