exports[`codegen snapshots > command-palette #1 → react 1`] = `
"// CommandPalette.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './command-palette.css';

export function CommandPalette() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-palette" role="dialog" aria-label="Command palette" data-p8="palette">
      <input className="p8-palette__input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" placeholder="Type a command" aria-label="Command" />
      <div className="p8-palette__list" role="listbox" id="palette-list">
        <div className="p8-palette__group" role="group" aria-label="Recent" data-group="recent">
          <div className="p8-palette__heading" aria-hidden="true">Recent</div>
          <button className="p8-palette__item p8-palette__item--active" type="button" role="option" data-section="Recent" data-recent aria-keyshortcuts="⌘N">
            <span data-label>Create project</span>
            <span className="p8-palette__hint" aria-hidden="true">⌘N</span>
          </button>
        </div>
        <div className="p8-palette__group" role="group" aria-label="Navigate">
          <div className="p8-palette__heading" aria-hidden="true">Navigate</div>
          <button className="p8-palette__item" type="button" role="option" data-section="Navigate" aria-keyshortcuts="G O">
            <span data-label>Go to Overview</span>
            <span className="p8-palette__hint" aria-hidden="true">G O</span>
          </button>
          <button className="p8-palette__item" type="button" role="option" data-section="Navigate" aria-keyshortcuts="G P">
            <span data-label>Go to Projects</span>
            <span className="p8-palette__hint" aria-hidden="true">G P</span>
          </button>
        </div>
        <div className="p8-palette__group" role="group" aria-label="Actions">
          <div className="p8-palette__heading" aria-hidden="true">Actions</div>
          <button className="p8-palette__item" type="button" role="option" data-section="Actions" aria-keyshortcuts="⌘N">
            <span data-label>Create project</span>
            <span className="p8-palette__hint" aria-hidden="true">⌘N</span>
          </button>
          <button className="p8-palette__item" type="button" role="option" data-section="Actions">
            <span data-label>Invite people</span>
          </button>
          <button className="p8-palette__item" type="button" role="option" data-section="Actions" aria-keyshortcuts="⌘,">
            <span data-label>Open settings</span>
            <span className="p8-palette__hint" aria-hidden="true">⌘,</span>
          </button>
        </div>
        <p className="p8-palette__empty" data-empty hidden role="status">No commands match.</p>
        <template data-item-template>
          <button className="p8-palette__item" type="button" role="option" data-section="Recent" data-recent>
            <span data-label>__label__</span>
          </button>
        </template>
      </div>
    </div>
  );
}

/* command-palette.css */
.p8-palette {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding: var(--p8-space-8);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-palette__input {
  box-sizing: border-box;
  width: 100%;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__input:focus-visible {
  outline: none;
  background: var(--p8-color-control-strong);
}

.p8-palette__input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-palette__list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  max-height: var(--p8-size-320);
  overflow-y: auto;
}

.p8-palette__group {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-palette__group[hidden] {
  display: none;
}

.p8-palette__heading {
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-palette__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-palette__item[hidden] {
  display: none;
}

.p8-palette__item--active {
  background: var(--p8-color-control-strong);
}

.p8-palette__hint {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-palette__empty {
  margin: 0;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-palette__empty[hidden] {
  display: none;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-palette__item","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function pOpts(p) { return Array.from(p.querySelectorAll('[role="option"]')).filter(function (x) { return !x.hidden && !x.closest('[hidden]') && !x.closest('template'); }); }
  function pMark(p, it) { Array.from(p.querySelectorAll('[role="option"]')).forEach(function (x) { setOn(x, x === it); }); }
  function pLabel(x) { var l = x.querySelector('[data-label]'); return (l || x).textContent.trim(); }
  function pFilter(p, q) {
    var empty = p.querySelector('[data-empty]'), any = false;
    Array.from(p.querySelectorAll('[role="group"]')).forEach(function (g) {
      var recent = g.getAttribute('data-group') === 'recent', n = 0;
      Array.from(g.querySelectorAll('[role="option"]')).forEach(function (x) { var show = recent ? !q : pLabel(x).toLowerCase().indexOf(q) >= 0; x.hidden = !show; if (show) n++; });
