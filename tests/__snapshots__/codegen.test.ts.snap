"---
// Requires the Primitive Systems theme variables (theme.css).
---

<article class="p8-chatmsg" aria-label="Assistant at 10:24" data-p8="action">
  <span class="p8-avatar" role="img" aria-label="Assistant">A</span>
  <div class="p8-chatmsg__body">
    <div class="p8-chatmsg__meta">
      <span class="p8-chatmsg__name">Assistant</span>
      <time>10:24</time>
    </div>
    <div class="p8-chatmsg__bubble">
      <p class="p8-chatmsg__p">Here is a summary of the review:</p>
      <p class="p8-chatmsg__p">
        The layout passes, but 
        <code class="p8-chatmsg__code">gap: 10px</code>
         is off the grid. Use 12:
      </p>
      <pre class="p8-chatmsg__pre"><code>.list { gap: var(--p8-space-12); }</code></pre>
    </div>
    <div class="p8-chatmsg__actions">
      <button class="p8-copybtn p8-copybtn--ghost" type="button" data-p8="copy" data-copy="Here is a summary of the review:

The layout passes, but \`gap: 10px\` is off the grid. Use 12:

\`\`\`css
.list { gap: var(--p8-space-12); }
\`\`\`" aria-label="Copy message">
        <svg class="p8-icon p8-copybtn__icon p8-copybtn__icon--on" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5.75 3.25Q5.75 1.75 7.25 1.75H10.75Q12.25 1.75 12.25 3.25V6.75Q12.25 8.25 10.75 8.25" />
          <rect x="1.75" y="5.75" width="6.5" height="6.5" rx="2" />
        </svg>
        <svg class="p8-icon p8-copybtn__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
      <button class="p8-button p8-button--ghost" type="button" data-action="retry">Retry</button>
    </div>
  </div>
</article>

<style>
  .p8-chatmsg {
    display: flex;
    align-items: flex-start;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    width: var(--p8-size-32);
    height: var(--p8-size-32);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-chatmsg__body {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    min-width: 0;
    flex: 1;
  }

  .p8-chatmsg__body:where(.p8-chatmsg--user *) {
    align-items: flex-end;
  }

  .p8-chatmsg__meta {
    display: flex;
    align-items: baseline;
    gap: var(--p8-space-8);
    color: var(--p8-color-ink-muted);
  }

  .p8-chatmsg__name {
    color: var(--p8-color-ink);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-chatmsg__bubble {
    display: flex;
    flex-direction: column;
