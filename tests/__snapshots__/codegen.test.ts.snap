"// SortableList.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './sortable-list.css';

export function SortableList() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-sortable-wrap" data-p8="sortable">
      <ul className="p8-sortable" aria-label="Reorderable list">
        <li className="p8-sortable__item" data-item="Write brief">
