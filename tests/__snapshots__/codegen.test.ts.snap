"// RadioGroup.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './radio-group.css';

export function RadioGroup() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-radiogroup p8-radiogroup--row" role="radiogroup" data-p8="group">
      <button className="p8-radio p8-radio--on" type="button" role="radio" aria-checked="true" tabIndex="0" disabled>
        <span className="p8-radio__dot p8-radio__dot--on"></span>
        One
      </button>
      <button className="p8-radio" type="button" role="radio" aria-checked="false" tabIndex="-1" disabled>
        <span className="p8-radio__dot"></span>
        Two
      </button>
      <button className="p8-radio" type="button" role="radio" aria-checked="false" tabIndex="-1" disabled>
        <span className="p8-radio__dot"></span>
        Three
      </button>
    </div>
  );
}

/* radio-group.css */
.p8-radiogroup {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
}

.p8-radiogroup--row {
  flex-direction: row;
  gap: var(--p8-space-12);
}

.p8-radio {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding: 0;
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-radio:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-radio:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-radio__dot {
  box-sizing: border-box;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  flex-shrink: 0;
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-control);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  transition: background var(--p8-motion-fast) var(--p8-motion-ease), border-width var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-radio__dot--on {
  background: var(--p8-color-canvas);
  border: var(--p8-space-4) solid var(--p8-color-ink);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-radio__dot","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  var ITEM = '[data-p8~="group"] [role="tab"], [data-p8~="group"] [role="radio"]';
  function gItems(g) { return Array.from(g.querySelectorAll('[role="tab"], [role="radio"]')); }
  function gSelect(g, it) {
    gItems(g).forEach(function (x) {
      var on = x === it;
      x.setAttribute(x.getAttribute('role') === 'tab' ? 'aria-selected' : 'aria-checked', String(on));
      x.tabIndex = on ? 0 : -1;
      [x].concat(Array.from(x.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
    });
  }
  root.addEventListener('click', function (e) {
    var it = cl(e, ITEM);
    if (it && !it.disabled) gSelect(it.closest('[data-p8~="group"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var it = cl(e, ITEM);
    if (!it) return;
    var g = it.closest('[data-p8~="group"]');
    var list = gItems(g).filter(function (x) { return !x.disabled; });
    var i = list.indexOf(it), k = e.key;
    if (k === 'ArrowRight' || k === 'ArrowDown') i = (i + 1) % list.length;
    else if (k === 'ArrowLeft' || k === 'ArrowUp') i = (i - 1 + list.length) % list.length;
    else if (k === 'Home') i = 0;
    else if (k === 'End') i = list.length - 1;
    else return;
    e.preventDefault();
    gSelect(g, list[i]);
    list[i].focus();
