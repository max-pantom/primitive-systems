        <button className="p8-mcal__cell" type="button" data-date="2026-11-23" aria-pressed="false" aria-label="Monday, November 23, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">23</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-24" aria-pressed="false" aria-label="Tuesday, November 24, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">24</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-25" aria-pressed="false" aria-label="Wednesday, November 25, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">25</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-26" aria-pressed="false" aria-label="Thursday, November 26, 1 event" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">26</span>
          <span className="p8-mcal__event" aria-hidden="true">Office closed</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-27" aria-pressed="false" aria-label="Friday, November 27, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">27</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-28" aria-pressed="false" aria-label="Saturday, November 28, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">28</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-29" aria-pressed="false" aria-label="Sunday, November 29, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">29</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-30" aria-pressed="false" aria-label="Monday, November 30, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">30</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-01" aria-pressed="false" aria-label="Tuesday, December 1, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">1</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-02" aria-pressed="false" aria-label="Wednesday, December 2, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">2</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-03" aria-pressed="false" aria-label="Thursday, December 3, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">3</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-04" aria-pressed="false" aria-label="Friday, December 4, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">4</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-05" aria-pressed="false" aria-label="Saturday, December 5, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">5</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-06" aria-pressed="false" aria-label="Sunday, December 6, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">6</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-07" aria-pressed="false" aria-label="Monday, December 7, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">7</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-08" aria-pressed="false" aria-label="Tuesday, December 8, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">8</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-09" aria-pressed="false" aria-label="Wednesday, December 9, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">9</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-10" aria-pressed="false" aria-label="Thursday, December 10, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">10</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-11" aria-pressed="false" aria-label="Friday, December 11, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">11</span>
        </button>
        <button className="p8-mcal__cell p8-mcal__cell--out" type="button" data-date="2026-12-12" aria-pressed="false" aria-label="Saturday, December 12, no events" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">12</span>
        </button>
      </div>
      <div className="p8-mcal__agenda" aria-live="polite">
        <p className="p8-mcal__agenda-head" data-agenda-head>Thursday, November 12 · 3 events</p>
        <ul className="p8-mcal__agenda-list" data-agenda>
          <li>Launch</li>
          <li>Retro</li>
          <li>Team dinner</li>
        </ul>
      </div>
      <template data-parts>
        <span className="p8-mcal__num" aria-hidden="true"></span>
        <span className="p8-mcal__event" aria-hidden="true"></span>
        <span className="p8-mcal__more" aria-hidden="true"></span>
      </template>
    </section>
  );
}

/* calendar.css */
.p8-mcal {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mcal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-mcal__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-mcal__nav {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-mcal__grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  border-radius: var(--p8-radius-12);
  overflow: hidden;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-mcal__dow {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
  text-align: left;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mcal__cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--p8-space-4);
  min-width: 0;
  height: var(--p8-size-72);
  padding: var(--p8-space-4);
  border: none;
  border-radius: 0;
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  border-inline-end: var(--p8-border-hairline) solid var(--p8-color-ring);
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mcal__cell:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-mcal__cell:focus-visible {
  box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  outline: none;
}

.p8-mcal__num {
  padding-inline: var(--p8-space-4);
}

.p8-mcal__num[data-today] {
  align-self: flex-start;
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-mcal__event {
  padding-inline: var(--p8-space-4);
  border-radius: var(--p8-radius-4);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-mcal__cell--on {
  background: var(--p8-color-control-strong);
}

.p8-mcal__cell--on:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-mcal__more {
  padding-inline: var(--p8-space-4);
  color: var(--p8-color-ink-muted);
  white-space: nowrap;
}

.p8-mcal__cell--out {
  color: var(--p8-color-ink-muted);
}

.p8-mcal__agenda {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  height: var(--p8-size-72);
  overflow-y: auto;
}

.p8-mcal__agenda-head {
  margin: 0;
  font-weight: var(--p8-type-weight-strong);
}

.p8-mcal__agenda-list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
  color: var(--p8-color-ink-muted);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  var mcLong = new Intl.DateTimeFormat('en', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
  var mcMonth = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  function mcEvents(c) { try { return JSON.parse(c.getAttribute('data-events') || '{}'); } catch (err) { return {}; } }
  function mcCount(k) { return k ? k + ' event' + (k === 1 ? '' : 's') : 'No events'; }
  function mcIso(d) { return d.toISOString().slice(0, 10); }
  function mcYM(c) { var p = c.getAttribute('data-month').split('-'); return [Number(p[0]), Number(p[1]) - 1]; }
  function mcMk(c, i, text) { var tpl = c.querySelector('template[data-parts]'), kids = (tpl.content && tpl.content.children.length ? tpl.content : tpl).children; var s = kids[i].cloneNode(true); s.textContent = text; return s; }
  function mcPaint(c, focusIso) {
    var ym = mcYM(c), ws = Number(c.getAttribute('data-week')), ev = mcEvents(c), sel = c.getAttribute('data-selected'), today = mcIso(new Date());
    var off = (new Date(Date.UTC(ym[0], ym[1], 1)).getUTCDay() - ws + 7) % 7;
    var cells = Array.from(c.querySelectorAll('[data-grid] [data-date]'));
    var firstIn = null;
    cells.forEach(function (b, i) {
      var d = new Date(Date.UTC(ym[0], ym[1], 1 - off + i)), iso = mcIso(d), out = d.getUTCMonth() !== ym[1], list = ev[iso] || [];
      if (!out && !firstIn) firstIn = iso;
      b.classList.toggle('p8-mcal__cell--out', out); b.classList.toggle('p8-mcal__cell--on', iso === sel);
      b.setAttribute('data-date', iso); b.setAttribute('aria-pressed', String(iso === sel));
      b.setAttribute('aria-label', mcLong.format(d) + ', ' + mcCount(list.length).toLowerCase());
      b.textContent = '';
      var num = mcMk(c, 0, String(d.getUTCDate())); if (iso === today) num.setAttribute('data-today', ''); b.appendChild(num);
      list.slice(0, list.length > 2 ? 1 : 2).forEach(function (t) { b.appendChild(mcMk(c, 1, t)); });
      if (list.length > 2) b.appendChild(mcMk(c, 2, '+' + (list.length - 1) + ' more'));
    });
    var target = focusIso && cells.some(function (b) { return b.getAttribute('data-date') === focusIso; }) ? focusIso : (cells.some(function (b) { return b.getAttribute('data-date') === sel; }) ? sel : firstIn);
    cells.forEach(function (b) { b.tabIndex = b.getAttribute('data-date') === target ? 0 : -1; });
    c.querySelector('[data-label]').textContent = mcMonth.format(new Date(Date.UTC(ym[0], ym[1], 1)));
    var list2 = sel ? (ev[sel] || []) : [];
    c.querySelector('[data-agenda-head]').textContent = sel ? mcLong.format(new Date(sel + 'T00:00:00Z')) + ' · ' + mcCount(list2.length) : 'Select a day to see its events';
    var ul = c.querySelector('[data-agenda]'); ul.textContent = '';
    list2.forEach(function (t) { var li = document.createElement('li'); li.textContent = t; ul.appendChild(li); });
    return target;
  }
  function mcGoto(c, iso, focus) {
    c.setAttribute('data-month', iso.slice(0, 7));
    mcPaint(c, iso);
    if (focus) { var b = c.querySelector('[data-grid] [data-date="' + iso + '"]'); if (b) b.focus(); }
  }
  function mcSelect(c, iso) {
    c.setAttribute('data-selected', iso);
    mcPaint(c, iso);
    c.dispatchEvent(new CustomEvent('p8-select', { bubbles: true, detail: { date: iso, events: mcEvents(c)[iso] || [] } }));
  }
  function mcShift(c, months, keepDay) {
    var ym = mcYM(c), cur = c.querySelector('[data-grid] [tabindex="0"]'), day = cur ? Number(cur.getAttribute('data-date').slice(8)) : 1;
    var d = new Date(Date.UTC(ym[0], ym[1] + months, 1)), last = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
    return mcIso(new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), keepDay ? Math.min(day, last) : 1)));
  }
  root.addEventListener('click', function (e) {
    var c = cl(e, '[data-p8~="monthcal"]');
    if (!c) return;
    var dir = cl(e, '[data-p8~="monthcal"] [data-dir]'), day = cl(e, '[data-p8~="monthcal"] [data-date]'), td = cl(e, '[data-p8~="monthcal"] [data-today-btn]');
    if (dir) mcGoto(c, mcShift(c, Number(dir.getAttribute('data-dir')), true), false);
    else if (td) { var iso = mcIso(new Date()); mcGoto(c, iso, false); mcSelect(c, iso); var b = c.querySelector('[data-grid] [data-date="' + iso + '"]'); if (b) b.focus(); }
    else if (day) mcSelect(c, day.getAttribute('data-date'));
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var day = cl(e, '[data-p8~="monthcal"] [data-date]');
    if (!day) return;
    var c = day.closest('[data-p8~="monthcal"]'), iso = day.getAttribute('data-date'), d = new Date(iso + 'T00:00:00Z'), ws = Number(c.getAttribute('data-week')), k = e.key, n = null;
    var dow = (d.getUTCDay() - ws + 7) % 7;
    if (k === 'ArrowRight') n = 1; else if (k === 'ArrowLeft') n = -1; else if (k === 'ArrowDown') n = 7; else if (k === 'ArrowUp') n = -7;
    else if (k === 'Home') n = -dow; else if (k === 'End') n = 6 - dow;
    else if (k === 'PageDown' || k === 'PageUp') { e.preventDefault(); var ym = mcYM(c); var m = k === 'PageDown' ? 1 : -1; var t = new Date(Date.UTC(ym[0], ym[1] + m, Math.min(d.getUTCDate(), new Date(Date.UTC(ym[0], ym[1] + m + 1, 0)).getUTCDate()))); mcGoto(c, mcIso(t), true); return; }
    else return;
    e.preventDefault();
    mcGoto(c, mcIso(new Date(d.getTime() + n * 86400000)), true);
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

exports[`codegen snapshots > calendar #1 → scss 1`] = `
"// _calendar.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-mcal {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mcal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-mcal__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-mcal__nav {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-iconbtn--flat {
  background: transparent;
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
}

.p8-icon {
  flex-shrink: 0;
}

.p8-mcal__grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  border-radius: var(--p8-radius-12);
  overflow: hidden;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-mcal__dow {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
  text-align: left;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-mcal__cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--p8-space-4);
  min-width: 0;
  height: var(--p8-size-72);
  padding: var(--p8-space-4);
  border: none;
  border-radius: 0;
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  text-align: left;
  cursor: pointer;
  overflow: hidden;
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  border-inline-end: var(--p8-border-hairline) solid var(--p8-color-ring);
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
  &:focus-visible {
    box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
    outline: none;
  }
}

.p8-mcal__num {
  padding-inline: var(--p8-space-4);
  &[data-today] {
    align-self: flex-start;
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }
}

.p8-mcal__event {
  padding-inline: var(--p8-space-4);
  border-radius: var(--p8-radius-4);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-mcal__cell--on {
  background: var(--p8-color-control-strong);
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
}

.p8-mcal__more {
  padding-inline: var(--p8-space-4);
  color: var(--p8-color-ink-muted);
  white-space: nowrap;
}

.p8-mcal__cell--out {
  color: var(--p8-color-ink-muted);
}

.p8-mcal__agenda {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  height: var(--p8-size-72);
  overflow-y: auto;
}

.p8-mcal__agenda-head {
  margin: 0;
  font-weight: var(--p8-type-weight-strong);
}

.p8-mcal__agenda-list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
  color: var(--p8-color-ink-muted);
}

