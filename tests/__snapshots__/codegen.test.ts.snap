<div class="[display:flex] [gap:var(--p8-space-12)] [align-items:flex-start] [box-sizing:border-box] [width:var(--p8-size-400)] [max-width:100%] [padding-block:var(--p8-space-12)] [padding-inline:var(--p8-space-16)] [border-radius:var(--p8-radius-8)] [background:var(--p8-color-surface)] [color:var(--p8-color-ink)] [outline:var(--p8-border-hairline)_solid_var(--p8-color-ring)] [outline-offset:calc(-1_*_var(--p8-border-hairline))] [font-family:var(--p8-type-family)] [font-size:var(--p8-type-size-sm)] [line-height:var(--p8-type-line-sm)] [font-weight:var(--p8-type-weight)]" role="alert" data-p8="dismiss">
  <svg class="[flex-shrink:0]" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <circle cx="8" cy="5" r="1" fill="currentColor" stroke="none" />
    <line x1="7.75" y1="8.75" x2="7.75" y2="11.25" />
  </svg>
  <div class="[flex:1] [display:flex] [flex-direction:column] [gap:var(--p8-space-4)]">
    <div class="[font-weight:var(--p8-type-weight-strong)]">Heads up</div>
    <div class="[color:var(--p8-color-ink-muted)]">Something you should know about.</div>
  </div>
</div>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var c = cl(e, '[data-p8~="dismiss"] [data-close]');
    if (c) c.closest('[data-p8~="dismiss"]').remove();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
`;

exports[`codegen snapshots > alert #1 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-alert" role="alert" data-p8="dismiss">
  <svg class="p8-icon p8-alert__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8" cy="8" r="6.25" />
    <path d="M4.5 8L7 10.5L11.5 6" />
  </svg>
  <div class="p8-alert__text">
    <div class="p8-alert__title">Heads up</div>
    <div class="p8-alert__body">Something you should know about.</div>
  </div>
  <button class="p8-alert__close" type="button" aria-label="Dismiss" data-close>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="4" y1="4" x2="12" y2="12" />
      <line x1="12" y1="4" x2="4" y2="12" />
    </svg>
  </button>
</div>

<style>
  .p8-alert {
    display: flex;
    gap: var(--p8-space-12);
    align-items: flex-start;
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-alert__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-alert__title {
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-alert__body {
    color: var(--p8-color-ink-muted);
  }

  .p8-alert__close {
    display: inline-flex;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .p8-alert__close:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var c = cl(e, '[data-p8~="dismiss"] [data-close]');
    if (c) c.closest('[data-p8~="dismiss"]').remove();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
`;

