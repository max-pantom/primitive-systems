"// Checkbox.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './checkbox.css';

export function Checkbox() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <label ref={ref} className="p8-check" data-p8="toggle">
      <button className="p8-check__box p8-check__box--on" type="button" role="checkbox" aria-checked="true">
        <svg className="p8-icon p8-check__icon p8-check__icon--on" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
      Label
    </label>
  );
}

/* checkbox.css */
.p8-check {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-check__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink-inverse);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  cursor: inherit;
}

.p8-check__box:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-check__box:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-check__box:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-check__box--on {
  background: var(--p8-color-ink);
}

.p8-check__box--on:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-check__icon {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-check__icon--on {
  opacity: 1;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-check__box","--on"],["p8-check__icon","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="toggle"] [role="checkbox"], [data-p8~="toggle"] [role="switch"]');
    if (!b || b.disabled) return;
    var on = b.getAttribute('aria-checked') !== 'true';
    b.setAttribute('aria-checked', String(on));
    [b].concat(Array.from(b.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

