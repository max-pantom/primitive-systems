          </button>
          <button class="p8-mt__clip p8-mt__clip--video" type="button" data-clip data-start="6.5" data-dur="12" aria-pressed="false" tabindex="-1" aria-label="Interview, Video 1, starts at 00:00:06:30, 12 seconds" style="left: calc(var(--p8-pps) * 6.5px); width: calc(var(--p8-pps) * 12px)">
            <span class="p8-mt__handle p8-mt__handle--start" data-handle="start" aria-hidden="true"></span>
            <span class="p8-mt__name" data-name>Interview</span>
