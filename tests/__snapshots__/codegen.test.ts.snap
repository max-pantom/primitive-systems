          <span className="p8-mcal__num" aria-hidden="true">19</span>
        </button>
        <button className="p8-mcal__cell" type="button" data-date="2026-11-20" aria-pressed="false" aria-label="Friday, November 20, 1 event" tabIndex="-1">
          <span className="p8-mcal__num" aria-hidden="true">20</span>
          <span className="p8-mcal__event" aria-hidden="true">Quarterly planning</span>
