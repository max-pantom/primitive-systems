"// NumberInput.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './number-input.css';

export function NumberInput() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-number" role="group" data-p8="number" aria-label="Quantity">
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Decrease" data-step="-1">
        <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
        </svg>
      </button>
      <input className="p8-number__input" type="number" min="0" max="10" step="1" aria-label="Quantity" defaultValue="1" />
      <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Increase" data-step="1">
        <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
          <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
        </svg>
      </button>
    </div>
  );
}

/* number-input.css */
.p8-number {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-number__input {
  box-sizing: border-box;
  width: var(--p8-size-48);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  text-align: center;
  appearance: textfield;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-number__input:focus-visible {
  background: var(--p8-color-control-strong);
  outline: none;
}

.p8-number__input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-number__input::-webkit-inner-spin-button {
  appearance: none;
  margin: 0;
}

.p8-number__input::-webkit-outer-spin-button {
  appearance: none;
  margin: 0;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="number"] [data-step]');
    if (!b || b.disabled) return;
    var inp = b.closest('[data-p8~="number"]').querySelector('input');
    if (Number(b.getAttribute('data-step')) > 0) inp.stepUp(); else inp.stepDown();
    inp.dispatchEvent(new Event('input', { bubbles: true }));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

