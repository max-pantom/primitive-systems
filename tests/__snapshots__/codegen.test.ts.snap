exports[`codegen snapshots > form #1 → react 1`] = `
"// Form.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './form.css';

export function Form() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <form ref={ref} className="p8-form" noValidate aria-label="Sample {x} &lt;y&gt;" data-p8="form action" data-success="Account created.">
      <h2 className="p8-form__title">Sample {'{'}x{'}'} &lt;y&gt;</h2>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-full-name">Full name</label>
        <input className="p8-input p8-form__control" id="form-full-name" name="full-name" aria-describedby="form-full-name-error" data-field="Full name" required aria-required="true" disabled type="text" autoComplete="name" />
        <p className="p8-form__error" id="form-full-name-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-work-email">Work email</label>
        <input className="p8-input p8-form__control" id="form-work-email" name="work-email" aria-describedby="form-work-email-error" data-field="Work email" required aria-required="true" disabled type="email" autoComplete="email" />
        <p className="p8-form__error" id="form-work-email-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-password">Password</label>
        <input className="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" data-min="8" disabled type="password" autoComplete="new-password" />
        <p className="p8-form__error" id="form-password-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-role">
          Role
          <span className="p8-form__optional"> (optional)</span>
        </label>
        <div className="p8-select">
          <select className="p8-select__control p8-form__control" id="form-role" name="role" aria-describedby="form-role-error" data-field="Role" disabled defaultValue="Designer">
            <option value="Designer">Designer</option>
            <option value="Engineer">Engineer</option>
            <option value="Manager">Manager</option>
          </select>
          <svg className="p8-icon p8-select__icon p8-select__icon--disabled" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M4 6L8 10L12 6" />
          </svg>
        </div>
        <p className="p8-form__error" id="form-role-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-about-you">
          About you
          <span className="p8-form__optional"> (optional)</span>
        </label>
        <textarea className="p8-input p8-form__control" id="form-about-you" name="about-you" aria-describedby="form-about-you-error" data-field="About you" disabled rows="3"></textarea>
        <p className="p8-form__error" id="form-about-you-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-check" data-p8="toggle">
          <button className="p8-check__box p8-form__control" type="button" role="checkbox" aria-checked="false" disabled id="form-i-agree-to-the-terms" name="i-agree-to-the-terms" aria-describedby="form-i-agree-to-the-terms-error" data-field="I agree to the terms" required aria-required="true">
            <svg className="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </button>
          I agree to the terms
        </label>
        <p className="p8-form__error" id="form-i-agree-to-the-terms-error" data-error></p>
      </div>
      <div className="p8-form__actions">
        <button className="p8-button p8-button--primary" type="submit" data-submit disabled>Create account</button>
        <button className="p8-button p8-button--ghost" type="button" data-action="cancel" disabled>Sample {'{'}x{'}'} &lt;y&gt;</button>
      </div>
      <p className="p8-form__status" role="status" data-status></p>
    </form>
  );
}

/* form.css */
.p8-form {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
}

.p8-form__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-form__control[aria-invalid="true"] {
  outline: var(--p8-border-hairline) solid var(--p8-color-ink);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-form__error {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__optional {
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
}

.p8-select {
  position: relative;
  display: flex;
  align-items: center;
}

.p8-select__control {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  appearance: none;
  padding-inline-end: var(--p8-space-32);
  cursor: pointer;
}

.p8-select__control:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-select__control:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-select__control:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-select__icon {
  position: absolute;
  inset-inline-end: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink);
}

.p8-select__icon--disabled {
  opacity: var(--p8-opacity-disabled);
}

.p8-check {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-check__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink-inverse);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  cursor: inherit;
}

.p8-check__box:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-check__box:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-check__box:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-check__icon {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-form__actions {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
