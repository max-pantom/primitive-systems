"// Pagination.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './pagination.css';

export function Pagination() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <nav ref={ref} className="p8-pager" aria-label="Pagination" data-p8="pager">
      <button className="p8-pager__btn" type="button" data-step="-1" aria-label="Previous page">
        <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M8.5 3.5L5 7L8.5 10.5" />
        </svg>
      </button>
      <button className="p8-pager__btn p8-pager__page p8-pager__page--active" type="button" data-page aria-current="page">1</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>2</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>3</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>4</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>5</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>6</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>7</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>8</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>9</button>
      <button className="p8-pager__btn p8-pager__page" type="button" data-page>10</button>
      <button className="p8-pager__btn" type="button" data-step="1" aria-label="Next page">
        <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M5.5 3.5L9 7L5.5 10.5" />
        </svg>
      </button>
    </nav>
  );
}

/* pagination.css */
.p8-pager {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
}

.p8-pager__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: var(--p8-size-32);
  height: var(--p8-size-32);
  box-sizing: border-box;
  padding: 0;
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink-muted);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-pager__btn:hover:not(:disabled) {
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
}

.p8-pager__btn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-pager__page--active {
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-pager__page","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function pgSet(nav, page) {
    Array.from(nav.querySelectorAll('[data-page]')).forEach(function (x) {
      var on = x === page;
      if (on) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current');
      setOn(x, on);
    });
  }
  root.addEventListener('click', function (e) {
    var nav = cl(e, '[data-p8~="pager"]');
    if (!nav) return;
    var pages = Array.from(nav.querySelectorAll('[data-page]'));
    var page = cl(e, '[data-page]'), step = cl(e, '[data-step]');
    if (page) pgSet(nav, page);
    else if (step) {
      var cur = pages.findIndex(function (x) { return x.getAttribute('aria-current') === 'page'; });
      var next = Math.min(pages.length - 1, Math.max(0, cur + Number(step.getAttribute('data-step'))));
      pgSet(nav, pages[next]);
    }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(clearTimeout); };
}
"
`;

