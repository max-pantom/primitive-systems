<div bind:this={el} class="p8-overlay p8-overlay--end" data-p8="overlay">
  <div class="p8-sheet" role="dialog" aria-modal="true">
    <div class="p8-sheet__head">
      <h2 class="p8-sheet__title">Sheet title</h2>
      <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Close" data-close>
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="4" x2="12" y2="12" />
          <line x1="12" y1="4" x2="4" y2="12" />
        </svg>
      </button>
    </div>
    <div class="p8-sheet__body">Sheet content goes here.</div>
  </div>
</div>

<style>
  .p8-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    background: var(--p8-color-backdrop);
    box-sizing: border-box;
    padding: var(--p8-space-24);
  }

  .p8-overlay[hidden] {
    display: none;
  }

  .p8-overlay--end {
    justify-content: flex-end;
    padding: 0;
  }

  .p8-sheet {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: var(--p8-size-320);
    max-width: 100%;
    height: 100%;
    padding: var(--p8-space-16);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .p8-sheet__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-sheet__body {
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

