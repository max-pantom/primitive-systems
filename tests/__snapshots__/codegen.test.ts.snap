    flex-direction: column;
    gap: var(--p8-space-12);
  }

  .p8-disclosure {
    box-sizing: border-box;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    border-radius: var(--p8-radius-8);
    font-family: var(--p8-type-family);
    min-width: var(--p8-size-320);
    interpolate-size: allow-keywords;
  }

  .p8-disclosure::details-content {
    height: 0;
    overflow: clip;
    transition: height var(--p8-motion-fast) var(--p8-motion-ease), content-visibility var(--p8-motion-fast) var(--p8-motion-ease) allow-discrete;
  }

  .p8-disclosure[open]::details-content {
    height: auto;
  }

  .p8-disclosure[open] .p8-disclosure__icon {
    rotate: 90deg;
  }

  .p8-disclosure__summary {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    cursor: pointer;
    list-style: none;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-disclosure__summary:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-disclosure__icon {
    transition: rotate var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-disclosure__body {
    padding-top: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

