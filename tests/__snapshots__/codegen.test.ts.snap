"// SplitButton.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './split-button.css';

export function SplitButton() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-popover p8-split" role="group" aria-label="Save" data-p8="popover split" data-select-closes>
      <button className="p8-button p8-button--primary p8-split__main" type="button" data-main>Save</button>
      <button className="p8-button p8-button--primary p8-split__toggle" type="button" aria-label="More save options" aria-haspopup="menu" aria-expanded="false" data-trigger>
        <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M3.5 5.5L7 9L10.5 5.5" />
        </svg>
      </button>
      <div className="p8-popover__panel p8-popover__panel--bare p8-popover__panel--end" data-panel hidden>
        <div className="p8-menu" role="menu" data-p8="menu">
          <button className="p8-menu__item" type="button" role="menuitem">Save as draft</button>
          <button className="p8-menu__item" type="button" role="menuitem">Save and publish</button>
          <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
          <button className="p8-menu__item" type="button" role="menuitem">Schedule…</button>
        </div>
      </div>
    </div>
  );
}

/* split-button.css */
.p8-popover {
  position: relative;
  display: inline-block;
}

.p8-split {
  display: inline-flex;
  align-items: stretch;
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-split__main {
  border-start-end-radius: 0;
  border-end-end-radius: 0;
}

.p8-split__toggle {
  border-start-start-radius: 0;
  border-end-start-radius: 0;
  border-inline-start: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-popover__panel {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: var(--p8-space-8);
  z-index: 40;
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-popover__panel[hidden] {
  display: none;
}

.p8-popover__panel--bare {
  padding: 0;
  background: transparent;
  outline: none;
}

.p8-popover__panel--end {
  left: auto;
  right: 0;
}

.p8-menu {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  min-width: var(--p8-size-240);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  border-radius: var(--p8-radius-12);
  font-family: var(--p8-type-family);
}

.p8-menu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  text-align: left;
  width: 100%;
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-6);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-menu__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-menu__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
