exports[`codegen snapshots > settings #1 → svelte 1`] = `
"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
    var PAIRS = [["p8-switch","--on"],["p8-switch__thumb","--on"],["p8-sidenav__item","--active"]];
    function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

    var frmEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;
    function frmValue(el) { return el.getAttribute('role') === 'checkbox' ? el.getAttribute('aria-checked') === 'true' : el.value; }
    function frmCheck(el) {
      var label = el.getAttribute('data-field') || 'This field', v = frmValue(el), type = el.getAttribute('type'), min = Number(el.getAttribute('data-min')) || 0;
      var empty = v === false || (typeof v === 'string' && !v.trim());
      if (el.hasAttribute('required') && empty) return el.getAttribute('role') === 'checkbox' ? 'You must accept: ' + label : label + ' is required';
      if (empty) return '';
      if (type === 'email' && !frmEmail.test(v)) return 'Enter a valid email address';
      if (type === 'url') { try { new URL(v); } catch (err) { return 'Enter a full URL, like https://example.com'; } }
      if (type === 'number' && isNaN(Number(v))) return 'Enter a number';
      if (type === 'tel' && !/^[+\\d][\\d\\s().-]{5,}$/.test(v)) return 'Enter a valid phone number';
      if (min && typeof v === 'string' && v.length < min) return label + ' must be at least ' + min + ' characters';
      return '';
    }
    function frmShow(el, msg) {
      var err = el.id ? el.closest('form').querySelector('#' + el.id + '-error') : null;
      if (err) err.textContent = msg;
      if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
    }
    function frmFields(f) { return Array.from(f.querySelectorAll('[data-field]')); }
    function frmStatus(f, msg) { f.querySelector('[data-status]').textContent = msg; }
    root.addEventListener('submit', function (e) {
      var f = cl(e, '[data-p8~="form"]');
      if (!f) return;
      e.preventDefault();
      f.__tried = true;
      var bad = frmFields(f).filter(function (el) { var m = frmCheck(el); frmShow(el, m); return !!m; });
      if (bad.length) { frmStatus(f, bad.length + (bad.length === 1 ? ' field needs' : ' fields need') + ' attention'); bad[0].focus(); return; }
      var values = {};
      frmFields(f).forEach(function (el) { values[el.getAttribute('name') || el.id] = frmValue(el); });
      var btn = f.querySelector('[data-submit]');
      function done(r) {
        r = r || { ok: true };
        btn.disabled = false; btn.removeAttribute('aria-busy');
        if (r.errors) {
          var first = null;
          Object.keys(r.errors).forEach(function (k) { var el = f.querySelector('[name="' + k + '"]'); if (el) { frmShow(el, r.errors[k]); first = first || el; } });
          frmStatus(f, 'Could not save: fix the highlighted fields');
          if (first) first.focus();
        } else if (r.ok !== false) frmStatus(f, r.message || f.getAttribute('data-success') || 'Saved.');
        else frmStatus(f, r.message || 'Could not save.');
      }
      var ev = new CustomEvent('p8-submit', { bubbles: true, cancelable: true, detail: { values: values, done: done } });
      var handled = !f.dispatchEvent(ev);
      if (handled) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); frmStatus(f, 'Saving…'); } else done({ ok: true });
    }, { signal: ac.signal });
    function frmLive(e) {
      var f = cl(e, '[data-p8~="form"]');
      if (!f || !f.__tried || !e.target.hasAttribute || !e.target.hasAttribute('data-field')) return;
      frmShow(e.target, frmCheck(e.target));
    }
    root.addEventListener('input', frmLive, { signal: ac.signal });
    root.addEventListener('change', frmLive, { signal: ac.signal });
    root.addEventListener('click', function (e) { var cb = cl(e, '[data-p8~="form"] [role="checkbox"][data-field]'); if (cb) setTimeout(function () { frmLive({ target: cb }); }, 0); }, { signal: ac.signal });

    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="action"] [data-action]');
      if (!b || b.disabled) return;
      b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
    }, { signal: ac.signal });

    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="toggle"] [role="checkbox"], [data-p8~="toggle"] [role="switch"]');
      if (!b || b.disabled) return;
      var on = b.getAttribute('aria-checked') !== 'true';
      b.setAttribute('aria-checked', String(on));
      [b].concat(Array.from(b.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-tpl-split">
  <nav class="p8-sidenav" aria-label="Sidebar">
    <a class="p8-sidenav__item p8-sidenav__item--active" href="#" aria-current="page">Profile</a>
    <a class="p8-sidenav__item" href="#">Account</a>
    <a class="p8-sidenav__item" href="#">Notifications</a>
    <a class="p8-sidenav__item" href="#">Billing</a>
  </nav>
  <div class="p8-tpl-page p8-tpl-main">
    <section class="p8-tpl-section" aria-label="Profile">
      <div class="p8-heading-group">
        <h2 class="p8-heading">Profile</h2>
        <p class="p8-heading__desc">How you appear to others.</p>
      </div>
      <form class="p8-form" novalidate aria-label="Form" data-p8="form action" data-success="Profile saved.">
        <div class="p8-form__field">
          <label class="p8-field__label" for="form-display-name">Display name</label>
          <input class="p8-input p8-form__control" id="form-display-name" name="display-name" aria-describedby="form-display-name-error" data-field="Display name" required aria-required="true" type="text" autocomplete="name" />
          <p class="p8-form__error" id="form-display-name-error" data-error></p>
        </div>
        <div class="p8-form__field">
          <label class="p8-field__label" for="form-email">Email</label>
          <input class="p8-input p8-form__control" id="form-email" name="email" aria-describedby="form-email-error" data-field="Email" required aria-required="true" type="email" autocomplete="email" />
          <p class="p8-form__error" id="form-email-error" data-error></p>
        </div>
        <div class="p8-form__field">
          <label class="p8-field__label" for="form-bio">
            Bio
            <span class="p8-form__optional"> (optional)</span>
          </label>
          <textarea class="p8-input p8-form__control" id="form-bio" name="bio" aria-describedby="form-bio-error" data-field="Bio" rows="3"></textarea>
          <p class="p8-form__error" id="form-bio-error" data-error></p>
        </div>
        <div class="p8-form__actions">
          <button class="p8-button p8-button--primary" type="submit" data-submit>Save changes</button>
        </div>
        <p class="p8-form__status" role="status" data-status></p>
      </form>
    </section>
    <div class="p8-divider" role="separator" aria-orientation="horizontal"></div>
    <section class="p8-tpl-section" aria-label="Notifications">
      <div class="p8-heading-group">
        <h2 class="p8-heading">Notifications</h2>
        <p class="p8-heading__desc">Choose what we email you about.</p>
      </div>
      <div class="p8-tpl-prefs">
        <label class="p8-switch-row" data-p8="toggle">
          <button class="p8-switch p8-switch--on" type="button" role="switch" aria-checked="true">
            <span class="p8-switch__thumb p8-switch__thumb--on"></span>
          </button>
          Email me about product updates
        </label>
        <label class="p8-switch-row" data-p8="toggle">
          <button class="p8-switch" type="button" role="switch" aria-checked="false">
            <span class="p8-switch__thumb"></span>
          </button>
          Email me when someone mentions me
        </label>
        <label class="p8-switch-row" data-p8="toggle">
          <button class="p8-switch" type="button" role="switch" aria-checked="false">
            <span class="p8-switch__thumb"></span>
          </button>
          Send a weekly summary
        </label>
      </div>
    </section>
  </div>
</div>

<style>
  .p8-tpl-split {
    display: flex;
    flex-wrap: wrap;
    gap: var(--p8-space-12);
    width: 100%;
    max-width: var(--p8-size-500);
    color: var(--p8-color-ink);
  }

  .p8-sidenav {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    width: var(--p8-size-240);
    box-sizing: border-box;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-sidenav__item {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    color: var(--p8-color-ink-muted);
    text-decoration: none;
  }

  .p8-sidenav__item:hover:not(:disabled) {
    color: var(--p8-color-ink);
    background: var(--p8-color-control);
  }

