  <input class="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 2" />
  <input class="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 3" />
