exports[`codegen snapshots > tooltip #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<span class="p8-tooltip" data-p8="tooltip" data-placement="top">
  <button class="p8-button" type="button">Hover me</button>
  <span class="p8-tooltip__bubble p8-tooltip__bubble--top" role="tooltip">Helpful hint</span>
</span>

<style>
  .p8-tooltip {
    position: relative;
    display: inline-flex;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-tooltip__bubble {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-tooltip:hover .p8-tooltip__bubble, .p8-tooltip:focus-within .p8-tooltip__bubble {
    opacity: 1;
  }

  .p8-tooltip__bubble--top {
    bottom: 100%;
    margin-bottom: var(--p8-space-8);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function place(e) {
    var t = cl(e, '[data-p8~="tooltip"]');
    if (!t) return;
    var b = t.querySelector('[role="tooltip"]');
    if (!b) return;
    var win = doc.defaultView || window;
    var pref = t.getAttribute('data-placement') || 'top';
    b.style.translate = '';
    b.classList.toggle('p8-tooltip__bubble--top', pref === 'top');
    b.classList.toggle('p8-tooltip__bubble--bottom', pref !== 'top');
    var r = b.getBoundingClientRect();
    if (pref === 'top' && r.top < 8 || pref !== 'top' && r.bottom > win.innerHeight - 8) {
      b.classList.toggle('p8-tooltip__bubble--top');
      b.classList.toggle('p8-tooltip__bubble--bottom');
    }
    r = b.getBoundingClientRect();
    var w = win.innerWidth, dx = r.left < 8 ? 8 - r.left : (r.right > w - 8 ? w - 8 - r.right : 0);
    if (dx) b.style.translate = 'calc(-50% + ' + dx + 'px) 0';
  }
  root.addEventListener('mouseover', place, { signal: ac.signal });
  root.addEventListener('focusin', place, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(clearTimeout); };
}
initP8(document);
</script>
"
`;

