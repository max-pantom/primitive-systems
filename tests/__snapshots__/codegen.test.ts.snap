exports[`codegen snapshots > split-button #1 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-popover p8-split" role="group" aria-label="Save" data-p8="popover split" data-select-closes>
  <button class="p8-button p8-button--primary p8-split__main" type="button" data-main disabled>Save</button>
  <button class="p8-button p8-button--primary p8-split__toggle" type="button" aria-label="More save options" aria-haspopup="menu" aria-expanded="false" data-trigger disabled>
    <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3.5 5.5L7 9L10.5 5.5" />
    </svg>
  </button>
  <div class="p8-popover__panel p8-popover__panel--bare p8-popover__panel--end" data-panel hidden>
    <div class="p8-menu" role="menu" data-p8="menu">
      <button class="p8-menu__item" type="button" role="menuitem">Save as draft</button>
      <button class="p8-menu__item" type="button" role="menuitem">Save and publish</button>
      <div class="p8-divider" role="separator" aria-orientation="horizontal"></div>
      <button class="p8-menu__item" type="button" role="menuitem">Schedule…</button>
    </div>
  </div>
</div>

<style>
  .p8-popover {
    position: relative;
    display: inline-block;
  }

  .p8-split {
    display: inline-flex;
    align-items: stretch;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-split__main {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }

  .p8-split__toggle {
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    border-inline-start: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-popover__panel {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: var(--p8-space-8);
    z-index: 40;
    box-sizing: border-box;
    min-width: var(--p8-size-240);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-popover__panel[hidden] {
    display: none;
  }

  .p8-popover__panel--bare {
    padding: 0;
    background: transparent;
    outline: none;
  }

  .p8-popover__panel--end {
    left: auto;
    right: 0;
  }

  .p8-menu {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    min-width: var(--p8-size-240);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    border-radius: var(--p8-radius-12);
    font-family: var(--p8-type-family);
  }

  .p8-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    text-align: left;
    width: 100%;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-6);
    border-radius: var(--p8-radius-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-menu__item:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-menu__item:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-divider {
    flex-shrink: 0;
    width: var(--p8-size-400);
    max-width: 100%;
    height: 0;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-menu__item","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function pSet(p, open) {
    var panel = p.querySelector('[data-panel]'), tr = p.querySelector('[data-trigger]');
    panel.hidden = !open;
    tr.setAttribute('aria-expanded', String(open));
    if (open) { var f = panel.querySelector('[role="menuitem"], button, input, [tabindex]'); if (f) f.focus(); }
  }
  function pAll() { return all('[data-p8~="popover"]'); }
  root.addEventListener('click', function (e) {
    var tr = cl(e, '[data-trigger]');
    var p = tr && tr.closest('[data-p8~="popover"]');
    if (p && !tr.disabled) { pSet(p, p.querySelector('[data-panel]').hidden); return; }
    var item = cl(e, '[data-select-closes] [role="menuitem"]');
    if (item) { var host = item.closest('[data-p8~="popover"]'); pSet(host, false); host.querySelector('[data-trigger]').focus(); }
  }, { signal: ac.signal });
  doc.addEventListener('click', function (e) {
    pAll().forEach(function (p) { if (!p.contains(e.target)) pSet(p, false); });
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    pAll().forEach(function (p) { if (!p.querySelector('[data-panel]').hidden) { pSet(p, false); p.querySelector('[data-trigger]').focus(); } });
  }, { signal: ac.signal });
  root.addEventListener('p8-close', function (e) {
    var p = cl(e, '[data-p8~="popover"]');
    if (p) { pSet(p, false); p.querySelector('[data-trigger]').focus(); }
  }, { signal: ac.signal });

  root.addEventListener('click', function (e) {
    var s = cl(e, '[data-p8~="split"]');
    if (!s) return;
    var main = cl(e, '[data-p8~="split"] [data-main]'), item = cl(e, '[data-p8~="split"] [role="menuitem"]');
    if (main && !main.disabled) main.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: main.textContent.trim() } }));
    else if (item) item.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: (item.firstChild ? item.firstChild.textContent : item.textContent).trim() } }));
  }, { signal: ac.signal });

  function mItems(m) { return Array.from(m.querySelectorAll('[role="menuitem"]')).filter(function (x) { return !x.disabled; }); }
  function mMark(m, it) { mItems(m).forEach(function (x) { setOn(x, x === it); }); }
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="menu"] [role="menuitem"]');
    if (it) mMark(it.closest('[data-p8~="menu"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('focusin', function (e) {
    var it = cl(e, '[data-p8~="menu"] [role="menuitem"]');
    if (it) mMark(it.closest('[data-p8~="menu"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var m = cl(e, '[data-p8~="menu"]');
    if (!m) return;
    if (e.key === 'Escape') { m.dispatchEvent(new CustomEvent('p8-close', { bubbles: true })); return; }
    var list = mItems(m), i = list.indexOf(cl(e, '[role="menuitem"]')), k = e.key;
