  }

  .p8-dialog__footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--p8-space-12);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
