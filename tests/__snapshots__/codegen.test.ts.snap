"// Checkbox.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './checkbox.css';

export function Checkbox() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <label ref={ref} className="p8-check" data-p8="toggle">
      <button className="p8-check__box p8-check__box--on" type="button" role="checkbox" aria-checked="true">
        <svg className="p8-icon p8-check__icon p8-check__icon--on" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
      Label
    </label>
  );
}

/* checkbox.css */
.p8-check {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-check__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
