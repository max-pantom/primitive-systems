  pointer-events: none;
  color: var(--p8-color-ink);
}

.p8-check {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
