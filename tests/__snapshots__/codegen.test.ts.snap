      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 4" disabled defaultValue="p" />
      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 5" disabled defaultValue="l" />
      <input className="p8-otp__cell" type="text" inputmode="numeric" maxlength="1" autocomplete="off" aria-label="Digit 6" disabled defaultValue="e" />
