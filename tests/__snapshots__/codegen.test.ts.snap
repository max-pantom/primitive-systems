"// ChatComposer.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './chat-composer.css';

export function ChatComposer() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <form ref={ref} className="p8-composer" aria-label="Send a message" data-p8="composer" data-busy="false">
      <div className="p8-composer__box">
        <textarea className="p8-composer__input" rows="1" placeholder="Message the assistant…" aria-label="Message" aria-describedby="composer-hint" enterKeyHint="send" data-input></textarea>
        <div className="p8-composer__bar">
          <div className="p8-composer__tools">
            <button className="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Attach files" data-attach>
              <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="2.75" y1="7.75" x2="13.25" y2="7.75" />
                <line x1="7.75" y1="2.75" x2="7.75" y2="13.25" />
              </svg>
            </button>
            <input className="p8-composer__file" type="file" multiple tabIndex="-1" aria-hidden="true" aria-label="Attach files" data-file />
            <span className="p8-composer__files" aria-live="polite" data-files></span>
          </div>
          <div className="p8-composer__tools">
            <button className="p8-iconbtn p8-composer__send" type="button" aria-label="Stop generating" data-stop hidden>
              <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="4" y1="4" x2="12" y2="12" />
                <line x1="12" y1="4" x2="4" y2="12" />
              </svg>
            </button>
            <button className="p8-iconbtn p8-composer__send" type="submit" aria-label="Send message" data-send disabled>
              <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="2.75" y1="7.75" x2="13.25" y2="7.75" />
                <path d="M10.5 5L13.25 7.75L10.5 10.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>
      <p className="p8-composer__hint" id="composer-hint">Enter to send, Shift+Enter for a new line</p>
    </form>
  );
}

/* chat-composer.css */
.p8-composer {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  font-family: var(--p8-type-family);
}

.p8-composer__box {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-control);
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-composer__box:focus-within {
  background: var(--p8-color-control-strong);
}

.p8-composer__input {
  display: block;
  width: 100%;
  box-sizing: border-box;
  max-height: var(--p8-size-160);
  padding: 0;
