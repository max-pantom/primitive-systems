  align-items: center;
  gap: var(--p8-space-12);
  flex-wrap: wrap;
}

.p8-link {
  color: var(--p8-color-ink);
  text-decoration-line: underline;
  text-decoration-color: var(--p8-color-ink-muted);
  text-underline-offset: var(--p8-space-4);
  border-radius: var(--p8-radius-4);
  cursor: pointer;
  transition: text-decoration-color var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
  &:hover:not(:disabled) {
    text-decoration-color: var(--p8-color-ink);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-divider-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  width: var(--p8-size-400);
  max-width: 100%;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-divider__line {
  flex: 1;
  height: 0;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
