exports[`codegen snapshots > carousel #1 → scss 1`] = `
"// _carousel.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-carousel {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-400);
  max-width: 100%;
}

.p8-carousel__track {
  display: flex;
  gap: var(--p8-space-12);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  border-radius: var(--p8-radius-8);
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &::-webkit-scrollbar {
    display: none;
  }
}

.p8-carousel__slide {
  flex: 0 0 100%;
  scroll-snap-align: start;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: var(--p8-size-160);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-carousel__slide--half {
  flex: 0 0 calc((100% - var(--p8-space-12)) / 2);
}

.p8-carousel__nav {
  display: flex;
  justify-content: flex-end;
  gap: var(--p8-space-8);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-icon {
  flex-shrink: 0;
}

// Markup
