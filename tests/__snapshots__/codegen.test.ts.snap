  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-switch__thumb {
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-canvas);
}
"
