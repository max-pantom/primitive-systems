<div bind:this={el} class="p8-taginput" data-p8="taginput" data-max="10" data-placeholder="Add a tag…">
  <label class="p8-field__label" for="tag-entry">Tags</label>
  <div class="p8-taginput__field">
    <div class="p8-taginput__list" role="group" aria-label="Tags added" data-chips>
      <span class="p8-tag" data-chip="design">
        design
        <button class="p8-tag__close" type="button" aria-label="Remove design" data-close>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
      <span class="p8-tag" data-chip="research">
        research
        <button class="p8-tag__close" type="button" aria-label="Remove research" data-close>
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
            <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
          </svg>
        </button>
      </span>
    </div>
    <input class="p8-taginput__entry" id="tag-entry" type="text" placeholder="Add a tag…" autocomplete="off" aria-describedby="tag-help" data-entry />
  </div>
  <div class="p8-taginput__foot">
    <span id="tag-help">Enter or comma to add</span>
    <span aria-live="polite" data-count>2 / 10</span>
  </div>
  <input type="hidden" name="tags" value="design,research" data-value />
  <template data-chip-template>
    <span class="p8-tag" data-chip="__tag__">
      __tag__
      <button class="p8-tag__close" type="button" aria-label="Remove __tag__" data-close>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
        </svg>
      </button>
    </span>
  </template>
</div>

<style>
  .p8-taginput {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    width: var(--p8-size-500);
    max-width: 100%;
    font-family: var(--p8-type-family);
  }

  .p8-field__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
    color: var(--p8-color-ink);
  }

  .p8-taginput__field {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
    cursor: text;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-taginput__field:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-taginput__field:focus-within {
    background: var(--p8-color-control-strong);
  }

  .p8-taginput__field[aria-disabled="true"] {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-taginput__list {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    flex-shrink: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .p8-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-tag__close {
    display: inline-flex;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--p8-radius-4);
  }

  .p8-tag__close:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-taginput__entry {
    flex: 1;
    min-width: var(--p8-size-64);
    box-sizing: border-box;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    outline: none;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-taginput__entry:disabled {
    cursor: not-allowed;
  }

  .p8-taginput__entry::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-taginput__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }
</style>
