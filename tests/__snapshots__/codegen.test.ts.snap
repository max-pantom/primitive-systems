exports[`codegen snapshots > switch #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<label class="p8-switch-row" data-p8="toggle">
  <button class="p8-switch p8-switch--on" type="button" role="switch" aria-checked="true">
    <span class="p8-switch__thumb p8-switch__thumb--on"></span>
  </button>
  Label
</label>

<style>
  .p8-switch-row {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-switch {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    width: var(--p8-size-40);
    height: var(--p8-size-24);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-full);
    border: none;
    background: var(--p8-color-control-strong);
    cursor: inherit;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-switch:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-switch:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-switch--on {
    background: var(--p8-color-ink);
  }

  .p8-switch__thumb {
    position: absolute;
    top: var(--p8-space-2);
    left: var(--p8-space-2);
    width: var(--p8-size-20);
    height: var(--p8-size-20);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-canvas);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    box-sizing: border-box;
    transition: left var(--p8-motion-fast) var(--p8-motion-ease), width var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-switch:active:not(:disabled) .p8-switch__thumb {
    width: var(--p8-size-28);
  }

  .p8-switch__thumb--on {
    left: calc(100% - var(--p8-size-20) - var(--p8-space-2));
  }

  .p8-switch:active:not(:disabled) .p8-switch__thumb--on {
    width: var(--p8-size-28);
    left: calc(100% - var(--p8-size-28) - var(--p8-space-2));
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-switch","--on"],["p8-switch__thumb","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="toggle"] [role="checkbox"], [data-p8~="toggle"] [role="switch"]');
    if (!b || b.disabled) return;
    var on = b.getAttribute('aria-checked') !== 'true';
    b.setAttribute('aria-checked', String(on));
    [b].concat(Array.from(b.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(clearTimeout); };
}
initP8(document);
</script>
"
`;

