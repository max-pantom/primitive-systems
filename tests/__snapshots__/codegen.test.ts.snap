"// Heading.tsx — Requires the Primitive Systems theme variables (theme.css).
import './heading.css';

export function Heading() {
  return (
    <div className="p8-heading-group">
      <h6 className="p8-heading p8-heading--sm">Account settings</h6>
      <p className="p8-heading__desc">Sample {'{'}x{'}'} &lt;y&gt;</p>
    </div>
  );
}

/* heading.css */
.p8-heading-group {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-heading--sm {
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-heading__desc {
  margin: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}
"
`;

