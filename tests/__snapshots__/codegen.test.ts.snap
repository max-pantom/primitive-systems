"// Dialog.tsx — Requires the Primitive Systems theme variables (theme.css).
import './dialog.css';

export function Dialog() {
  return (
    <div className="p8-dialog" role="dialog" aria-modal="true">
      <div>
        <h2 className="p8-dialog__title">Dialog title</h2>
        <p className="p8-dialog__body">Explain what happens when the user confirms.</p>
      </div>
      <div className="p8-dialog__footer">
        <button className="p8-button p8-button--ghost" type="button" data-close>Cancel</button>
        <button className="p8-button p8-button--primary" type="button" data-close>Confirm</button>
      </div>
    </div>
  );
}

/* dialog.css */
.p8-dialog {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding: var(--p8-space-16);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  border-radius: var(--p8-radius-8);
  font-family: var(--p8-type-family);
}

.p8-dialog__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-dialog__body {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink-muted);
}

.p8-dialog__footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--p8-space-12);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}
"
