  <button class="p8-menu__item [display:flex] [align-items:center] [justify-content:space-between] [gap:var(--p8-space-12)] [box-sizing:border-box] [text-align:left] [width:100%] [padding-block:var(--p8-space-4)] [padding-inline:var(--p8-space-6)] [border-radius:var(--p8-radius-8)] [border:none] [background:transparent] [color:var(--p8-color-ink)] [cursor:pointer] [font-family:var(--p8-type-family)] [font-size:var(--p8-type-size-sm)] [line-height:var(--p8-type-line-sm)] [font-weight:var(--p8-type-weight)] enabled:hover:[background:var(--p8-color-control)] focus-visible:[box-shadow:0_0_0_var(--p8-border-focus)_var(--p8-color-ring-focus)]" type="button" role="menuitem" aria-keyshortcuts="⌫">
    Delete
    <span class="[color:var(--p8-color-ink-muted)] [font-family:var(--p8-type-mono)] [letter-spacing:var(--p8-type-tracking-mono)]" aria-hidden="true">⌫</span>
  </button>
</div>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-menu__item","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function mItems(m) { return Array.from(m.querySelectorAll('[role="menuitem"]')).filter(function (x) { return !x.disabled; }); }
  function mMark(m, it) { mItems(m).forEach(function (x) { setOn(x, x === it); }); }
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="menu"] [role="menuitem"]');
