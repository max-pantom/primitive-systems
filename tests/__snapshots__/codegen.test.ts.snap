    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-form__status {
    margin: 0;
    min-height: var(--p8-type-line-sm);
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-divider {
    flex-shrink: 0;
    width: var(--p8-size-400);
    max-width: 100%;
    height: 0;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-tpl-prefs {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
  }

  .p8-switch-row {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-switch {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
    width: var(--p8-size-40);
    height: var(--p8-size-24);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-full);
    border: none;
    background: var(--p8-color-control-strong);
    cursor: inherit;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-switch:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-switch:disabled {
    opacity: var(--p8-opacity-disabled);
