"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-filters" data-p8="filters" data-fields="{&quot;Status&quot;:[&quot;Open&quot;,&quot;In progress&quot;,&quot;Closed&quot;],&quot;Owner&quot;:[&quot;Ada&quot;,&quot;Grace&quot;,&quot;Alan&quot;],&quot;Priority&quot;:[&quot;High&quot;,&quot;Medium&quot;,&quot;Low&quot;]}">
  <div class="p8-filters__row">
    <div class="p8-select p8-filters__pick">
      <select class="p8-select__control" aria-label="Filter field" data-field>
        <option value="Status" selected>Status</option>
