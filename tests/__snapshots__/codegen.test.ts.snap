        <span className="p8-radio__dot"></span>
        Two
      </button>
      <button className="p8-radio" type="button" role="radio" aria-checked="false" tabIndex="-1">
        <span className="p8-radio__dot"></span>
        Three
      </button>
    </div>
  );
}

/* radio-group.css */
.p8-radiogroup {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
}

.p8-radio {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding: 0;
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
