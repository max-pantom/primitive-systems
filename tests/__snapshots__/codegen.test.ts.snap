/* sortable-list.css */
.p8-sortable-wrap {
  position: relative;
}

.p8-sortable {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-400);
  max-width: 100%;
  margin: 0;
  padding: 0;
  list-style: none;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-sortable__item {
  display: flex;
  align-items: center;
  gap: var(--p8-space-4);
  padding-block: var(--p8-space-4);
  padding-inline-start: var(--p8-space-4);
  padding-inline-end: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control);
  user-select: none;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-sortable__handle {
  cursor: grab;
  touch-action: none;
}

.p8-icon {
  flex-shrink: 0;
}

.p8-sortable__label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-sortable__status {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

