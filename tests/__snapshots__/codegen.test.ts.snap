exports[`codegen snapshots > password-input #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-password" data-p8="password">
  <div class="p8-password__wrap">
    <label class="p8-field__label" for="password">Password</label>
    <div class="p8-password__field">
      <input class="p8-input p8-password__input" id="password" type="password" autocomplete="new-password" spellcheck="false" data-password aria-describedby="password-rules" />
      <button class="p8-iconbtn p8-iconbtn--flat p8-password__toggle" type="button" aria-label="Show password" aria-pressed="false" data-reveal>
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1.75 8C4.75 1.75 11.25 1.75 14.25 8C11.25 14.25 4.75 14.25 1.75 8Z" />
          <circle cx="8" cy="8" r="2.25" />
        </svg>
      </button>
    </div>
  </div>
  <ul class="p8-password__rules" id="password-rules" aria-label="Password requirements">
    <li class="p8-password__rule" data-rule="length:8">
      <svg class="p8-icon p8-password__yes" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 7L5.5 10L11.5 4" />
      </svg>
      <svg class="p8-icon p8-password__no" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
      </svg>
      At least 8 characters
    </li>
    <li class="p8-password__rule" data-rule="number">
      <svg class="p8-icon p8-password__yes" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 7L5.5 10L11.5 4" />
      </svg>
      <svg class="p8-icon p8-password__no" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
      </svg>
      A number
    </li>
    <li class="p8-password__rule" data-rule="upper">
      <svg class="p8-icon p8-password__yes" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 7L5.5 10L11.5 4" />
      </svg>
      <svg class="p8-icon p8-password__no" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
      </svg>
      An uppercase letter
    </li>
    <li class="p8-password__rule" data-rule="symbol">
      <svg class="p8-icon p8-password__yes" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2.5 7L5.5 10L11.5 4" />
      </svg>
      <svg class="p8-icon p8-password__no" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
      </svg>
      A symbol
    </li>
  </ul>
</div>

<style>
  .p8-password {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    width: var(--p8-size-500);
    max-width: 100%;
    font-family: var(--p8-type-family);
  }

  .p8-password__wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-field__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
    color: var(--p8-color-ink);
  }

  .p8-password__field {
    position: relative;
    display: flex;
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-password__input {
    padding-inline-end: calc(var(--p8-size-40) + var(--p8-space-4));
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-password__toggle {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    inset-inline-end: var(--p8-space-2);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-password__rules {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-password__rule {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    transition: color var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-password__yes {
    display: none;
  }

  .p8-password__no {
    display: inline-flex;
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  var PWT = { number: /\\d/, upper: /[A-Z]/, lower: /[a-z]/, symbol: /[^A-Za-z0-9\\s]/ };
  function pwCheck(w) {
    var v = w.querySelector('[data-password]').value, ok = true;
    Array.from(w.querySelectorAll('[data-rule]')).forEach(function (li) {
      var r = li.getAttribute('data-rule'), met = r.indexOf('length:') === 0 ? v.length >= Number(r.slice(7)) : PWT[r] ? PWT[r].test(v) : true;
      li.classList.toggle('p8-password__rule--on', met); if (!met) ok = false;
    });
    w.setAttribute('data-valid', String(ok));
    return ok;
  }
  all('[data-p8~="password"]').forEach(pwCheck);
  root.addEventListener('input', function (e) {
    var w = cl(e, '[data-p8~="password"]');
