import './breadcrumbs.css';

export function Breadcrumbs() {
  return (
    <nav aria-label="Breadcrumb">
      <ol className="p8-breadcrumbs">
        <li>
          <a className="p8-breadcrumbs__link" href="#">Home</a>
        </li>
        <li className="p8-breadcrumbs__sep" aria-hidden="true">
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M5.5 3.5L9 7L5.5 10.5" />
          </svg>
        </li>
        <li>
          <a className="p8-breadcrumbs__link" href="#">Projects</a>
        </li>
        <li className="p8-breadcrumbs__sep" aria-hidden="true">
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M5.5 3.5L9 7L5.5 10.5" />
          </svg>
        </li>
        <li>
          <span className="p8-breadcrumbs__current" aria-current="page">Primitive</span>
        </li>
      </ol>
    </nav>
  );
}

/* breadcrumbs.css */
.p8-breadcrumbs {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  margin: 0;
  padding: 0;
  list-style: none;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-breadcrumbs__link {
  color: var(--p8-color-ink-muted);
  text-decoration: none;
}

.p8-breadcrumbs__link:hover:not(:disabled) {
  color: var(--p8-color-ink);
}

.p8-breadcrumbs__link:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-breadcrumbs__sep {
  display: inline-flex;
  color: var(--p8-color-ink-muted);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-breadcrumbs__current {
  color: var(--p8-color-ink);
}
"
`;

