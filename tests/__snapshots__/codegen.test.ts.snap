    background: var(--p8-color-control);
  }
}

.p8-password__toggle {
  position: absolute;
  top: 50%;
  translate: 0 -50%;
  inset-inline-end: var(--p8-space-2);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-password__rules {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  margin: 0;
  padding: 0;
  list-style: none;
}

.p8-password__rule {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  color: var(--p8-color-ink-muted);
