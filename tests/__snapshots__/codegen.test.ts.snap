"// MultiSelect.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './multi-select.css';

export function MultiSelect() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-multi" data-p8="multi">
      <div className="p8-multi__box">
        <span className="p8-multi__chips" data-chips>
          <span className="p8-tag" data-chip="Design">
            Design
            <button className="p8-tag__close" type="button" aria-label="Remove Design" data-close>
              <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
                <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
              </svg>
            </button>
          </span>
        </span>
        <input className="p8-multi__input" type="text" role="combobox" aria-expanded="true" aria-controls="multi-list" aria-label="Add option" placeholder="Add…" />
      </div>
      <div className="p8-multi__list" role="listbox" id="multi-list" aria-multiselectable="true">
        <button className="p8-multi__option p8-multi__option--active" type="button" role="option" tabIndex="-1" aria-selected="true">
          Design
          <span className="p8-multi__check">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </span>
        </button>
        <button className="p8-multi__option" type="button" role="option" tabIndex="-1" aria-selected="false">
          Engineering
          <span className="p8-multi__check">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </span>
        </button>
        <button className="p8-multi__option" type="button" role="option" tabIndex="-1" aria-selected="false">
          Research
          <span className="p8-multi__check">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </span>
        </button>
        <button className="p8-multi__option" type="button" role="option" tabIndex="-1" aria-selected="false">
          Support
          <span className="p8-multi__check">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </span>
        </button>
      </div>
      <template data-chip-template>
        <span className="p8-tag" data-chip="__label__">
          __label__
          <button className="p8-tag__close" type="button" aria-label="Remove __label__" data-close>
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
              <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
            </svg>
          </button>
        </span>
      </template>
    </div>
  );
}

/* multi-select.css */
.p8-multi {
  position: relative;
  width: var(--p8-size-500);
  max-width: 100%;
}

.p8-multi__box {
  min-height: calc(var(--p8-type-line-sm) + var(--p8-space-8) * 3);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
