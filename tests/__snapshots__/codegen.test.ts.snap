    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-password__toggle {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    inset-inline-end: var(--p8-space-2);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-password__rules {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-password__rule {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    transition: color var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-password__rule--on {
    color: var(--p8-color-ink);
  }

  .p8-password__rule--on .p8-password__yes {
    display: inline-flex;
  }

  .p8-password__rule--on .p8-password__no {
    display: none;
  }

  .p8-password__yes {
    display: none;
  }

  .p8-password__no {
    display: inline-flex;
  }
