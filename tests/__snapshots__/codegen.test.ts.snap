    width: var(--p8-space-8);
    height: var(--p8-space-8);
  }

  .p8-scroll::-webkit-scrollbar-thumb {
    background: var(--p8-color-ring-focus);
    border-radius: var(--p8-radius-full);
  }

  .p8-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .p8-scroll::-webkit-scrollbar-corner {
    background: transparent;
  }

  .p8-scroll--h320 {
    height: var(--p8-size-320);
  }

  .p8-scroll--x {
    overflow-x: auto;
    overflow-y: hidden;
    display: flex;
    gap: var(--p8-space-12);
  }

  .p8-scroll__row {
    padding-block: var(--p8-space-4);
    color: var(--p8-color-ink-muted);
    white-space: nowrap;
  }
</style>
"
`;

