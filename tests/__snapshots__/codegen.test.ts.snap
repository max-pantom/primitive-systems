<div class="p8-rating" role="radiogroup" aria-label="Rating" data-p8="rating">
  <button class="p8-rating__star p8-rating__star--on" type="button" role="radio" aria-checked="false" aria-label="1 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star p8-rating__star--on" type="button" role="radio" aria-checked="false" aria-label="2 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star p8-rating__star--on" type="button" role="radio" aria-checked="true" aria-label="3 of 7" tabindex="0" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star" type="button" role="radio" aria-checked="false" aria-label="4 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star" type="button" role="radio" aria-checked="false" aria-label="5 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star" type="button" role="radio" aria-checked="false" aria-label="6 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
  <button class="p8-rating__star" type="button" role="radio" aria-checked="false" aria-label="7 of 7" tabindex="-1" disabled>
    <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polygon points="8,2 9.8,5.7 14,6.3 11,9.2 11.7,13.3 8,11.4 4.3,13.3 5,9.2 2,6.3 6.2,5.7" />
    </svg>
  </button>
</div>

<style>
  .p8-rating {
    display: inline-flex;
    gap: var(--p8-space-4);
  }

  .p8-rating__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--p8-size-24);
    height: var(--p8-size-24);
    padding: 0;
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink-muted);
    cursor: pointer;
  }

  .p8-rating__star:hover:not(:disabled) {
    color: var(--p8-color-ink);
  }

  .p8-rating__star:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-rating__star:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-rating__star--on {
    color: var(--p8-color-ink);
  }

  .p8-rating__star--on svg {
    fill: currentColor;
  }

  .p8-icon {
    flex-shrink: 0;
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-rating__star","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function rSet(g, it) {
    var items = Array.from(g.querySelectorAll('[role="radio"]')), idx = items.indexOf(it);
    items.forEach(function (x, i) { x.setAttribute('aria-checked', String(i === idx)); x.tabIndex = i === idx ? 0 : -1; setOn(x, i <= idx); });
  }
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="rating"] [role="radio"]');
    if (it && !it.disabled) rSet(it.closest('[data-p8~="rating"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var it = cl(e, '[data-p8~="rating"] [role="radio"]');
    if (!it) return;
    var g = it.closest('[data-p8~="rating"]'), items = Array.from(g.querySelectorAll('[role="radio"]')), i = items.indexOf(it);
    if (e.key === 'ArrowRight' || e.key === 'ArrowUp') i = Math.min(items.length - 1, i + 1);
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') i = Math.max(0, i - 1);
    else return;
    e.preventDefault();
    rSet(g, items[i]);
    items[i].focus();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
`;

