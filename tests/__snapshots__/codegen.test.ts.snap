"// HoverCard.tsx — Requires the Primitive Systems theme variables (theme.css).
import './hover-card.css';

export function HoverCard() {
  return (
    <span className="p8-hovercard">
      <a className="p8-hovercard__trigger" href="#">@primitive</a>
      <span className="p8-hovercard__wrap p8-hovercard__wrap--open">
        <span className="p8-hovercard__card" role="tooltip">
          <span className="p8-avatar p8-avatar--40" role="img" aria-label="Primitive 8">P8</span>
          <span className="p8-hovercard__text">
            <span className="p8-hovercard__title">Primitive 8</span>
            <span className="p8-hovercard__body">A short preview of what this link points to.</span>
          </span>
        </span>
      </span>
    </span>
  );
}

/* hover-card.css */
.p8-hovercard {
  position: relative;
  display: inline-block;
}

.p8-hovercard__trigger {
  color: var(--p8-color-ink);
  text-decoration: underline;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-hovercard__trigger:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-hovercard__wrap {
  position: absolute;
  top: 100%;
  left: 0;
  padding-top: var(--p8-space-8);
  z-index: 40;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-hovercard:hover .p8-hovercard__wrap, .p8-hovercard:focus-within .p8-hovercard__wrap {
  opacity: 1;
  pointer-events: auto;
}

.p8-hovercard__wrap--open {
  opacity: 1;
  pointer-events: auto;
}

.p8-hovercard__card {
  display: flex;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-320);
  max-width: 100vw;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  width: var(--p8-size-32);
  height: var(--p8-size-32);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-avatar--40 {
  width: var(--p8-size-40);
  height: var(--p8-size-40);
}

.p8-hovercard__text {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-hovercard__title {
  font-weight: var(--p8-type-weight-strong);
}

.p8-hovercard__body {
  color: var(--p8-color-ink-muted);
}
"
`;

