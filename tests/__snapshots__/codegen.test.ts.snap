"// Switch.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './switch.css';

export function Switch() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <label ref={ref} className="p8-switch-row" data-p8="toggle">
      <button className="p8-switch" type="button" role="switch" aria-checked="false" disabled>
        <span className="p8-switch__thumb"></span>
      </button>
      Label
    </label>
  );
}

/* switch.css */
.p8-switch-row {
  display: flex;
