    var c = day.closest('[data-p8~="monthcal"]'), iso = day.getAttribute('data-date'), d = new Date(iso + 'T00:00:00Z'), ws = Number(c.getAttribute('data-week')), k = e.key, n = null;
    var dow = (d.getUTCDay() - ws + 7) % 7;
