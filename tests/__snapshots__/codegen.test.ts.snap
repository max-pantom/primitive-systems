      doc.addEventListener('pointermove', move, { signal: ac.signal }); doc.addEventListener('pointerup', up, { signal: ac.signal }); doc.addEventListener('pointercancel', up, { signal: ac.signal });
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
