"---
// Requires the Primitive Systems theme variables (theme.css).
---

<input class="p8-slider" type="range" min="0" max="100" step="1" value="40" aria-label="Value" />

<style>
  .p8-slider {
    appearance: none;
    width: var(--p8-size-320);
    max-width: 100%;
    height: var(--p8-size-20);
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .p8-slider:focus-visible {
    outline: none;
  }

  .p8-slider:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-slider::-webkit-slider-runnable-track {
    height: var(--p8-space-4);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
  }

  .p8-slider::-moz-range-track {
    height: var(--p8-space-4);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
  }

  .p8-slider::-webkit-slider-thumb {
    box-sizing: border-box;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    border-radius: var(--p8-radius-full);
    border: none;
    background: var(--p8-color-ink);
    transition: width var(--p8-motion-fast) var(--p8-motion-ease);
    appearance: none;
    margin-top: calc((var(--p8-space-4) - var(--p8-size-16)) / 2);
  }

  .p8-slider::-moz-range-thumb {
    box-sizing: border-box;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    border-radius: var(--p8-radius-full);
    border: none;
    background: var(--p8-color-ink);
    transition: width var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-slider:active:not(:disabled)::-webkit-slider-thumb {
    width: var(--p8-size-24);
  }

  .p8-slider:active:not(:disabled)::-moz-range-thumb {
    width: var(--p8-size-24);
  }

  .p8-slider:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-slider:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
</style>
"
`;

