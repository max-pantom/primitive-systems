"// Alert.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './alert.css';

export function Alert() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-alert" role="alert" data-p8="dismiss">
      <svg className="p8-icon p8-alert__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
        <circle cx="8" cy="8" r="6.25" />
        <circle cx="8" cy="5" r="1" fill="currentColor" stroke="none" />
        <line x1="7.75" y1="8.75" x2="7.75" y2="11.25" />
      </svg>
      <div className="p8-alert__text">
        <div className="p8-alert__title">Heads up</div>
        <div className="p8-alert__body">Something you should know about.</div>
      </div>
    </div>
  );
}

/* alert.css */
.p8-alert {
  display: flex;
  gap: var(--p8-space-12);
  align-items: flex-start;
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-alert__icon {
  margin-top: var(--p8-space-2);
}

.p8-alert__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-alert__title {
  font-weight: var(--p8-type-weight-strong);
}

.p8-alert__body {
  color: var(--p8-color-ink-muted);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var c = cl(e, '[data-p8~="dismiss"] [data-close]');
    if (c) c.closest('[data-p8~="dismiss"]').remove();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(clearTimeout); };
}
"
`;

