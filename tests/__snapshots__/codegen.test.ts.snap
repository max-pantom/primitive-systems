"// SegmentedProgress.tsx — Requires the Primitive Systems theme variables (theme.css).
import './segmented-progress.css';

export function SegmentedProgress() {
  return (
    <div className="p8-segmented-progress" role="progressbar" aria-label="Setup progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60" aria-valuetext="2 of 4 parts done, next 40%">
      <div className="p8-segmented-progress__head">
        <span>Setup progress</span>
        <span aria-hidden="true">60%</span>
      </div>
      <div className="p8-segmented-progress__bar" style={{ gridTemplateColumns: "repeat(4, minmax(0, 1fr))" }} aria-hidden="true">
        <span className="p8-segmented-progress__seg p8-segmented-progress__seg--done"></span>
        <span className="p8-segmented-progress__seg p8-segmented-progress__seg--done"></span>
        <span className="p8-segmented-progress__seg">
          <span className="p8-segmented-progress__fill" style={{ width: "40%" }}></span>
        </span>
        <span className="p8-segmented-progress__seg"></span>
      </div>
      <div className="p8-segmented-progress__labels" style={{ gridTemplateColumns: "repeat(4, minmax(0, 1fr))" }} aria-hidden="true">
        <span className="p8-segmented-progress__label p8-segmented-progress__label--done">Account</span>
        <span className="p8-segmented-progress__label p8-segmented-progress__label--done">Plan</span>
        <span className="p8-segmented-progress__label">Team</span>
        <span className="p8-segmented-progress__label">Confirm</span>
      </div>
    </div>
  );
}

/* segmented-progress.css */
.p8-segmented-progress {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
  width: var(--p8-size-400);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-segmented-progress__head {
  display: flex;
  justify-content: space-between;
  gap: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
}

.p8-segmented-progress__bar {
  display: grid;
  gap: var(--p8-space-4);
}

.p8-segmented-progress__seg {
  position: relative;
  height: var(--p8-space-8);
  overflow: hidden;
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-control-strong);
}

.p8-segmented-progress__seg--done {
  background: var(--p8-color-ink);
}

.p8-segmented-progress__fill {
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-ink);
}

.p8-segmented-progress__labels {
  display: grid;
  gap: var(--p8-space-4);
  color: var(--p8-color-ink-muted);
}

.p8-segmented-progress__label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p8-segmented-progress__label--done {
  color: var(--p8-color-ink);
}
"
`;

