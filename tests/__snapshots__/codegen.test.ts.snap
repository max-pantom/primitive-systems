"// EmptyState.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './empty-state.css';

export function EmptyState() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <section ref={ref} className="p8-empty p8-empty--bordered" aria-label="No projects yet" data-p8="action">
      <span className="p8-empty__icon">
        <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M5.75 11.25V3.75L13.25 2.75V10.25" />
          <circle cx="3.5" cy="12" r="1.75" fill="currentColor" stroke="none" />
          <circle cx="11" cy="11" r="1.75" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <h3 className="p8-empty__title">No projects yet</h3>
      <p className="p8-empty__desc">Projects keep tasks, files and people together. Create one to get started.</p>
      <div className="p8-empty__actions">
        <button className="p8-button p8-button--primary" type="button" data-action="New project">
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
            <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
          </svg>
          New project
        </button>
        <button className="p8-button p8-button--ghost" type="button" data-action="Import projects">Import projects</button>
      </div>
    </section>
  );
}

/* empty-state.css */
.p8-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding-block: var(--p8-space-32);
  padding-inline: var(--p8-space-16);
  text-align: center;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-empty--bordered {
  padding: var(--p8-space-16);
  border-radius: var(--p8-radius-12);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-empty__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: var(--p8-size-48);
  height: var(--p8-size-48);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-empty__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-empty__desc {
  margin: 0;
  max-width: var(--p8-size-320);
  color: var(--p8-color-ink-muted);
}

.p8-empty__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--p8-space-8);
  margin-top: var(--p8-space-4);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="action"] [data-action]');
    if (!b || b.disabled) return;
    b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

