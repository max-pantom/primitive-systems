"// SignIn.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './sign-in.css';

export function SignIn() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-tpl-center">
      <section className="p8-tpl-panel" aria-label="Sign in" data-p8="action">
        <div className="p8-heading-group">
          <h1 className="p8-heading">Sign in</h1>
          <p className="p8-heading__desc">Welcome back. Enter your details to continue.</p>
        </div>
        <form className="p8-form" noValidate aria-label="Form" data-p8="form action" data-success="Signed in.">
          <div className="p8-form__field">
            <label className="p8-field__label" htmlFor="form-email">Email</label>
            <input className="p8-input p8-form__control" id="form-email" name="email" aria-describedby="form-email-error" data-field="Email" required aria-required="true" type="email" autoComplete="email" />
            <p className="p8-form__error" id="form-email-error" data-error></p>
          </div>
          <div className="p8-form__field">
            <label className="p8-field__label" htmlFor="form-password">Password</label>
            <input className="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" type="password" autoComplete="new-password" />
            <p className="p8-form__error" id="form-password-error" data-error></p>
          </div>
          <div className="p8-form__actions">
            <button className="p8-button p8-button--primary" type="submit" data-submit>Sign in</button>
          </div>
          <p className="p8-form__status" role="status" data-status></p>
        </form>
        <div className="p8-tpl-row">
          <a className="p8-link" href="#">Forgot your password?</a>
        </div>
      </section>
    </div>
  );
}

/* sign-in.css */
.p8-tpl-center {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: var(--p8-size-320);
  padding-block: var(--p8-space-24);
  padding-inline: var(--p8-space-16);
}

.p8-tpl-panel {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-400);
  max-width: 100%;
  padding: var(--p8-space-16);
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-heading-group {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-heading__desc {
  margin: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-form {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
}

.p8-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-form__control[aria-invalid="true"] {
  outline: var(--p8-border-hairline) solid var(--p8-color-ink);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-form__error {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__actions {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-form__status {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tpl-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  flex-wrap: wrap;
}

.p8-link {
  color: var(--p8-color-ink);
  text-decoration-line: underline;
  text-decoration-color: var(--p8-color-ink-muted);
  text-underline-offset: var(--p8-space-4);
  border-radius: var(--p8-radius-4);
  cursor: pointer;
  transition: text-decoration-color var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-link:hover:not(:disabled) {
  text-decoration-color: var(--p8-color-ink);
}

.p8-link:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

