    var cells = Array.from(c.querySelectorAll('[data-grid] [data-date]'));
    var firstIn = null;
    cells.forEach(function (b, i) {
      var d = new Date(Date.UTC(ym[0], ym[1], 1 - off + i)), iso = mcIso(d), out = d.getUTCMonth() !== ym[1], list = ev[iso] || [];
