}

.p8-button--ghost {
  background: transparent;
  box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
