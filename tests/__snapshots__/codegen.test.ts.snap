"// Settings.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './settings.css';

export function Settings() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-tpl-split">
      <nav className="p8-sidenav" aria-label="Sidebar">
        <a className="p8-sidenav__item p8-sidenav__item--active" href="#" aria-current="page">Profile</a>
        <a className="p8-sidenav__item" href="#">Account</a>
        <a className="p8-sidenav__item" href="#">Notifications</a>
        <a className="p8-sidenav__item" href="#">Billing</a>
      </nav>
      <div className="p8-tpl-page p8-tpl-main">
        <section className="p8-tpl-section" aria-label="Profile">
          <div className="p8-heading-group">
            <h2 className="p8-heading">Profile</h2>
            <p className="p8-heading__desc">How you appear to others.</p>
          </div>
          <form className="p8-form" noValidate aria-label="Form" data-p8="form action" data-success="Profile saved.">
            <div className="p8-form__field">
              <label className="p8-field__label" htmlFor="form-display-name">Display name</label>
              <input className="p8-input p8-form__control" id="form-display-name" name="display-name" aria-describedby="form-display-name-error" data-field="Display name" required aria-required="true" type="text" autoComplete="name" />
              <p className="p8-form__error" id="form-display-name-error" data-error></p>
            </div>
            <div className="p8-form__field">
              <label className="p8-field__label" htmlFor="form-email">Email</label>
              <input className="p8-input p8-form__control" id="form-email" name="email" aria-describedby="form-email-error" data-field="Email" required aria-required="true" type="email" autoComplete="email" />
              <p className="p8-form__error" id="form-email-error" data-error></p>
            </div>
            <div className="p8-form__field">
              <label className="p8-field__label" htmlFor="form-bio">
                Bio
                <span className="p8-form__optional"> (optional)</span>
              </label>
              <textarea className="p8-input p8-form__control" id="form-bio" name="bio" aria-describedby="form-bio-error" data-field="Bio" rows="3"></textarea>
              <p className="p8-form__error" id="form-bio-error" data-error></p>
            </div>
            <div className="p8-form__actions">
              <button className="p8-button p8-button--primary" type="submit" data-submit>Save changes</button>
            </div>
            <p className="p8-form__status" role="status" data-status></p>
          </form>
        </section>
        <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
        <section className="p8-tpl-section" aria-label="Notifications">
          <div className="p8-heading-group">
            <h2 className="p8-heading">Notifications</h2>
            <p className="p8-heading__desc">Choose what we email you about.</p>
          </div>
          <div className="p8-tpl-prefs">
            <label className="p8-switch-row" data-p8="toggle">
              <button className="p8-switch p8-switch--on" type="button" role="switch" aria-checked="true">
                <span className="p8-switch__thumb p8-switch__thumb--on"></span>
              </button>
              Email me about product updates
            </label>
            <label className="p8-switch-row" data-p8="toggle">
              <button className="p8-switch" type="button" role="switch" aria-checked="false">
                <span className="p8-switch__thumb"></span>
              </button>
              Email me when someone mentions me
            </label>
            <label className="p8-switch-row" data-p8="toggle">
              <button className="p8-switch" type="button" role="switch" aria-checked="false">
                <span className="p8-switch__thumb"></span>
              </button>
              Send a weekly summary
            </label>
          </div>
        </section>
        <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
        <section className="p8-tpl-danger" aria-label="Danger zone" data-p8="action">
          <div className="p8-heading-group">
            <h2 className="p8-heading p8-heading--sm">Delete account</h2>
            <p className="p8-heading__desc">Permanently remove your account and all its data. This cannot be undone.</p>
          </div>
          <div className="p8-tpl-row">
            <button className="p8-button p8-button--ghost" type="button" data-action="delete-account">Delete account</button>
          </div>
        </section>
      </div>
    </div>
  );
}

/* settings.css */
.p8-tpl-split {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p8-space-12);
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-sidenav {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-240);
  box-sizing: border-box;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-sidenav__item {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  color: var(--p8-color-ink-muted);
  text-decoration: none;
}

.p8-sidenav__item:hover:not(:disabled) {
  color: var(--p8-color-ink);
  background: var(--p8-color-control);
}

.p8-sidenav__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-sidenav__item--active {
  color: var(--p8-color-ink);
  background: var(--p8-color-control-strong);
}

.p8-tpl-page {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-tpl-main {
  flex: 1 1 var(--p8-size-320);
  min-width: 0;
}

.p8-tpl-section {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  min-width: 0;
}

.p8-heading-group {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-heading__desc {
  margin: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-form {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
}

.p8-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-form__control[aria-invalid="true"] {
  outline: var(--p8-border-hairline) solid var(--p8-color-ink);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-form__error {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__optional {
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
}

.p8-form__actions {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-form__status {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-divider {
  flex-shrink: 0;
  width: var(--p8-size-400);
  max-width: 100%;
  height: 0;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-tpl-prefs {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
}

.p8-switch-row {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-switch {
  position: relative;
  display: inline-block;
  flex-shrink: 0;
  width: var(--p8-size-40);
  height: var(--p8-size-24);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-full);
  border: none;
  background: var(--p8-color-control-strong);
  cursor: inherit;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-switch:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-switch:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-switch--on {
  background: var(--p8-color-ink);
}

.p8-switch__thumb {
  position: absolute;
  top: var(--p8-space-2);
  left: var(--p8-space-2);
  width: var(--p8-size-20);
  height: var(--p8-size-20);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-canvas);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  box-sizing: border-box;
  transition: left var(--p8-motion-fast) var(--p8-motion-ease), width var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-switch:active:not(:disabled) .p8-switch__thumb {
  width: var(--p8-size-28);
}

.p8-switch__thumb--on {
  left: calc(100% - var(--p8-size-20) - var(--p8-space-2));
}

.p8-switch:active:not(:disabled) .p8-switch__thumb--on {
  width: var(--p8-size-28);
  left: calc(100% - var(--p8-size-28) - var(--p8-space-2));
}

.p8-tpl-danger {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-heading--sm {
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-tpl-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  flex-wrap: wrap;
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-button--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

