      <path d="M5.5 3.5L9 7L5.5 10.5" />
    </svg>
  </button>
</nav>

<style>
  .p8-pager {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
  }

  .p8-pager__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--p8-size-32);
    height: var(--p8-size-32);
