  .p8-multi {
    position: relative;
    width: var(--p8-size-500);
    max-width: 100%;
  }

  .p8-multi__box {
    min-height: calc(var(--p8-type-line-sm) + var(--p8-space-8) * 3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
  }

  .p8-multi__box:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-multi__chips {
    display: contents;
  }

  .p8-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-tag__close {
    display: inline-flex;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    cursor: pointer;
    border-radius: var(--p8-radius-4);
  }

  .p8-tag__close:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-multi__input {
    flex: 1;
    min-width: var(--p8-size-72);
    padding: 0;
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-multi__input:focus-visible {
    outline: none;
  }

  .p8-multi__input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-multi__input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-multi__list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--p8-space-8);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-multi__list[hidden] {
    display: none;
  }

  .p8-multi__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
    text-align: left;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-multi__option:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-multi__option:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-multi__option[hidden] {
    display: none;
  }

  .p8-multi__option[aria-selected="false"] .p8-multi__check {
    opacity: 0;
  }

  .p8-multi__option--active {
    background: var(--p8-color-control-strong);
  }

  .p8-multi__check {
    display: inline-flex;
  }
</style>
