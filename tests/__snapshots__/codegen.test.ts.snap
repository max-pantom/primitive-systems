  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

exports[`codegen snapshots > form #1 → scss 1`] = `
"// _form.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-form {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
}

.p8-form__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    background: var(--p8-color-control-strong);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &::placeholder {
    color: var(--p8-color-placeholder);
  }
}

.p8-form__control {
  &[aria-invalid="true"] {
    outline: var(--p8-border-hairline) solid var(--p8-color-ink);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }
}

.p8-form__error {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-form__optional {
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
}

.p8-select {
  position: relative;
  display: flex;
  align-items: center;
}

.p8-select__control {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  appearance: none;
  padding-inline-end: var(--p8-space-32);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    background: var(--p8-color-control-strong);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
}

.p8-icon {
  flex-shrink: 0;
}

.p8-select__icon {
  position: absolute;
  inset-inline-end: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink);
}

.p8-select__icon--disabled {
  opacity: var(--p8-opacity-disabled);
}

.p8-check {
  display: flex;
  width: max-content;
  align-items: center;
  gap: var(--p8-space-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-check__box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink-inverse);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  cursor: inherit;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
}

.p8-check__icon {
  opacity: 0;
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-form__actions {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
  &:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
}

.p8-form__status {
  margin: 0;
  min-height: var(--p8-type-line-sm);
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

