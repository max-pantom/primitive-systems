<style>
  .p8-overlay[hidden] {
    display: none !important;
  }

  .p8-palette__input:focus-visible {
    outline: none !important;
    background: var(--p8-color-control-strong) !important;
  }

  .p8-palette__input::placeholder {
    color: var(--p8-color-placeholder) !important;
  }

  .p8-palette__group[hidden] {
    display: none !important;
  }

  .p8-palette__item:hover:not(:disabled) {
