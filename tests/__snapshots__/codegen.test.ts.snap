"// InlineEdit.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './inline-edit.css';

export function InlineEdit() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-inline" data-p8="inline">
      <button className="p8-inline__view" type="button" data-view aria-label="Title: Click to edit. Edit">
        Click to edit
        <span className="p8-inline__pen">
          <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <polygon points="2.5,9 9,2.5 11.5,5 5,11.5 2.75,11.25" />
            <line x1="7.5" y1="4" x2="10" y2="6.5" />
          </svg>
        </span>
      </button>
      <input className="p8-input p8-inline__input" type="text" placeholder="Add a title" aria-label="Title" hidden data-edit defaultValue="Click to edit" />
    </div>
  );
}

/* inline-edit.css */
.p8-inline {
  display: inline-grid;
  max-width: 100%;
}

.p8-inline__view {
  grid-area: 1 / 1;
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  cursor: text;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-inline__view:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-inline__view:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-inline__view[hidden] {
  visibility: hidden;
  pointer-events: none;
}

.p8-inline__pen {
  display: inline-flex;
  color: var(--p8-color-ink-muted);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-inline__input {
  grid-area: 1 / 1;
  min-width: 0;
}

.p8-inline__input[hidden] {
  display: block;
  visibility: hidden;
  pointer-events: none;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


