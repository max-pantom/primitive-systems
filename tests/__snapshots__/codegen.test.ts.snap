"// Timeline.tsx — Requires the Primitive Systems theme variables (theme.css).
import './timeline.css';

export function Timeline() {
  return (
    <ol className="p8-timeline">
      <li className="p8-timeline__item">
        <span className="p8-timeline__dot" aria-hidden="true"></span>
        <div className="p8-timeline__body">
          <span className="p8-timeline__title">Created</span>
          <span className="p8-timeline__time">09:00</span>
        </div>
      </li>
      <li className="p8-timeline__item">
        <span className="p8-timeline__dot" aria-hidden="true"></span>
        <div className="p8-timeline__body">
          <span className="p8-timeline__title">Reviewed</span>
          <span className="p8-timeline__time">10:30</span>
          <span className="p8-timeline__detail">Two comments</span>
        </div>
      </li>
      <li className="p8-timeline__item p8-timeline__item--last">
        <span className="p8-timeline__dot" aria-hidden="true"></span>
        <div className="p8-timeline__body">
          <span className="p8-timeline__title">Published</span>
          <span className="p8-timeline__time">12:00</span>
        </div>
      </li>
    </ol>
  );
}

/* timeline.css */
.p8-timeline {
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  list-style: none;
  width: var(--p8-size-400);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-timeline__item {
  display: flex;
  gap: var(--p8-space-12);
  padding-bottom: var(--p8-space-12);
}

.p8-timeline__dot {
  flex-shrink: 0;
  width: var(--p8-size-16);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.p8-timeline__dot::before {
  content: '';
  width: var(--p8-space-8);
  height: var(--p8-space-8);
  margin-top: var(--p8-space-4);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-ink);
}

.p8-timeline__dot::after {
  content: '';
  flex: 1;
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  margin-top: var(--p8-space-4);
}

.p8-timeline__body {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  min-width: 0;
}

.p8-timeline__title {
  font-weight: var(--p8-type-weight-strong);
}

.p8-timeline__time {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-timeline__detail {
  color: var(--p8-color-ink-muted);
}

.p8-timeline__item--last {
  padding-bottom: 0;
}

.p8-timeline__item--last .p8-timeline__dot::after {
  display: none;
}
"
`;

