// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-infinite" data-p8="infinite" data-page="1" data-size="20" data-total="100" data-demo="false">
  <div class="p8-infinite__scroller" tabindex="0" role="region" aria-label="Results list" data-scroller>
    <ul class="p8-infinite__list" data-list aria-label="Results">
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1024</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1023</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1022</span>
        <span class="p8-infinite__meta">Refunded</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1021</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1020</span>
        <span class="p8-infinite__meta">Pending</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1019</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1018</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
      <li class="p8-infinite__item" data-item>
        <span class="p8-infinite__title">Order 1017</span>
        <span class="p8-infinite__meta">Paid</span>
      </li>
    </ul>
    <div class="p8-infinite__foot" data-foot>
      <button class="p8-button p8-button--ghost p8-button--block" type="button" data-more>Load more</button>
    </div>
    <p class="p8-infinite__end" data-end hidden>You have reached the end</p>
  </div>
  <p class="p8-infinite__status" role="status" data-status>Showing 8</p>
  <template data-item-template>
    <li class="p8-infinite__item" data-item>
      <span class="p8-infinite__title">__title__</span>
      <span class="p8-infinite__meta">__meta__</span>
    </li>
  </template>
</div>

<style>
  .p8-infinite {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    width: var(--p8-size-400);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-infinite__scroller {
    height: var(--p8-size-320);
    overflow-y: auto;
    border-radius: var(--p8-radius-12);
    overscroll-behavior: contain;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-infinite__scroller:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-infinite__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-infinite__item {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-infinite__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .p8-infinite__meta {
    color: var(--p8-color-ink-muted);
    white-space: nowrap;
  }

  .p8-infinite__foot {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
  }

  .p8-infinite__foot[hidden] {
    display: none;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-button--block {
    display: flex;
    width: 100%;
  }

  .p8-infinite__end {
    margin: 0;
    padding-block: var(--p8-space-12);
    text-align: center;
    color: var(--p8-color-ink-muted);
  }

  .p8-infinite__end[hidden] {
    display: none;
  }

  .p8-infinite__status {
    margin: 0;
    color: var(--p8-color-ink-muted);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function infRows(c) { return c.querySelectorAll('[data-list] [data-item]').length; }
  function infStatus(c, more) {
    var n = infRows(c), total = Number(c.getAttribute('data-total')), demo = c.getAttribute('data-demo') === 'true';
    c.querySelector('[data-status]').textContent = demo ? 'Showing ' + n + ' of ' + total : 'Showing ' + n;
    c.querySelector('[data-foot]').hidden = !more;
    c.querySelector('[data-end]').hidden = more;
  }
  function infAppend(c, items, more) {
    var tpl = c.querySelector('template[data-item-template]'), src = (tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild, list = c.querySelector('[data-list]');
    items.forEach(function (it) { var li = src.cloneNode(true), sp = li.querySelectorAll('span'); sp[0].textContent = it.title; sp[1].textContent = it.meta || ''; list.appendChild(li); });
    c.__loading = false; c.removeAttribute('aria-busy');
    infStatus(c, more);
  }
  function infLoad(c) {
    if (c.__loading) return;
    var foot = c.querySelector('[data-foot]');
    if (foot.hidden) return;
    c.__loading = true; c.setAttribute('aria-busy', 'true');
    var page = Number(c.getAttribute('data-page')) + 1;
    c.setAttribute('data-page', String(page));
    var ev = new CustomEvent('p8-load-more', { bubbles: true, cancelable: true, detail: { page: page, append: function (items, more) { infAppend(c, items, more); } } });
    var handled = !c.dispatchEvent(ev);
    if (handled || c.getAttribute('data-demo') !== 'true') return;
    var size = Number(c.getAttribute('data-size')) || 10, total = Number(c.getAttribute('data-total')), have = infRows(c), items = [];
    for (var i = have; i < Math.min(total, have + size); i++) items.push({ title: 'Item ' + (i + 1), meta: 'Page ' + page });
    infAppend(c, items, have + items.length < total);
  }
  root.addEventListener('scroll', function (e) {
    var s = e.target;
    if (!s.matches || !s.matches('[data-scroller]')) return;
    if (s.scrollTop + s.clientHeight >= s.scrollHeight - 32) infLoad(s.closest('[data-p8~="infinite"]'));
