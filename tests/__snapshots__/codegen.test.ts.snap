"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-tpl-page">
  <header class="p8-navbar" data-p8="nav action">
    <a class="p8-navbar__brand" href="/">
      <span class="p8-navbar__logo" aria-hidden="true"></span>
      Acme
    </a>
    <nav class="p8-navbar__links" aria-label="Main">
      <a class="p8-navbar__link" href="#overview" data-nav>Overview</a>
      <a class="p8-navbar__link p8-navbar__link--active" href="#projects" data-nav aria-current="page">Projects</a>
      <a class="p8-navbar__link" href="#team" data-nav>Team</a>
      <a class="p8-navbar__link" href="#settings" data-nav>Settings</a>
    </nav>
    <div class="p8-navbar__right">
      <button class="p8-iconbtn p8-iconbtn--flat" type="button" aria-label="Search" data-action="search">
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="7" cy="7" r="4.25" />
          <line x1="10.5" y1="10.5" x2="13.5" y2="13.5" />
        </svg>
      </button>
      <span class="p8-avatar" role="img" aria-label="Ada Lovelace">AL</span>
    </div>
  </header>
  <div class="p8-tpl-center">
    <section class="p8-empty" aria-label="No projects yet" data-p8="action">
      <span class="p8-empty__icon">
        <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.75 6.75V4.75Q2.75 2.75 4.75 2.75H6L8 4.75H11.25Q13.25 4.75 13.25 6.75V11.25Q13.25 13.25 11.25 13.25H4.75Q2.75 13.25 2.75 11.25Z" />
        </svg>
      </span>
      <h3 class="p8-empty__title">No projects yet</h3>
      <p class="p8-empty__desc">Projects keep tasks, files and people together. Create one to get started.</p>
      <div class="p8-empty__actions">
        <button class="p8-button p8-button--primary" type="button" data-action="New project">
          <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
            <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
          </svg>
          New project
        </button>
        <button class="p8-button p8-button--ghost" type="button" data-action="Import projects">Import projects</button>
      </div>
    </section>
  </div>
</div>

<style>
  .p8-tpl-page {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--p8-size-500);
    color: var(--p8-color-ink);
  }

  .p8-navbar {
    display: flex;
    align-items: center;
    gap: var(--p8-space-12);
    width: 100%;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    flex-shrink: 0;
    color: var(--p8-color-ink);
    font-weight: var(--p8-type-weight-strong);
    text-decoration: none;
    border-radius: var(--p8-radius-4);
  }

  .p8-navbar__brand:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-navbar__logo {
    width: var(--p8-size-24);
    height: var(--p8-size-24);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-ink);
  }

  .p8-navbar__links {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .p8-navbar__link {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    color: var(--p8-color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-navbar__link:hover:not(:disabled) {
    color: var(--p8-color-ink);
    background: var(--p8-color-control);
  }

  .p8-navbar__link:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-navbar__link--active {
    color: var(--p8-color-ink);
    background: var(--p8-color-control-strong);
  }

  .p8-navbar__right {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    flex-shrink: 0;
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    width: var(--p8-size-32);
    height: var(--p8-size-32);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-tpl-center {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: var(--p8-size-320);
    padding-block: var(--p8-space-24);
    padding-inline: var(--p8-space-16);
  }

  .p8-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding-block: var(--p8-space-32);
    padding-inline: var(--p8-space-16);
    text-align: center;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--p8-size-48);
    height: var(--p8-size-48);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
  }

  .p8-empty__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-empty__desc {
    margin: 0;
    max-width: var(--p8-size-320);
    color: var(--p8-color-ink-muted);
  }

  .p8-empty__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--p8-space-8);
    margin-top: var(--p8-space-4);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var a = cl(e, '[data-p8~="nav"] [data-nav]');
    if (!a) return;
    e.preventDefault();
    var host = a.parentNode;
    Array.from(host.querySelectorAll('[data-nav]')).forEach(function (x) {
      var on = x === a;
      if (on) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current');
      ['p8-navbar__link', 'p8-shell__item'].forEach(function (b) { if (x.classList.contains(b)) x.classList.toggle(b + '--active', on); });
    });
    var label = a.lastElementChild && a.querySelector('svg') ? a.lastElementChild.textContent : a.textContent;
    a.dispatchEvent(new CustomEvent('p8-navigate', { bubbles: true, detail: { label: label.trim(), href: a.getAttribute('href') } }));
  }, { signal: ac.signal });

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="action"] [data-action]');
    if (!b || b.disabled) return;
    b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
