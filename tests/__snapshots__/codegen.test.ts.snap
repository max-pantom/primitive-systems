"// Field.tsx — Requires the Primitive Systems theme variables (theme.css).
import './field.css';

export function Field() {
  return (
    <div className="p8-field">
      <label className="p8-field__label" htmlFor="field">Label</label>
      <input className="p8-input" id="field" type="text" placeholder="Placeholder" aria-describedby="field-msg" />
      <p className="p8-field__hint" id="field-msg">Helper text.</p>
    </div>
  );
}

/* field.css */
.p8-field {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  font-family: var(--p8-type-family);
  width: var(--p8-size-500);
  max-width: 100%;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
