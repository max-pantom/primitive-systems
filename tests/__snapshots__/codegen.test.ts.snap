      <button class="p8-tag__close" style="display: inline-flex; padding: 0; border: none; background: transparent; color: inherit; cursor: pointer; border-radius: var(--p8-radius-4)" type="button" aria-label="Remove __label__" data-close>
        <svg style="flex-shrink: 0" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3.5" y1="3.5" x2="10.5" y2="10.5" />
          <line x1="10.5" y1="3.5" x2="3.5" y2="10.5" />
