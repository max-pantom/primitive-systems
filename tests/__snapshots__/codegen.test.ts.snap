"// Form.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './form.css';

export function Form() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <form ref={ref} className="p8-form" noValidate aria-label="Form" data-p8="form action" data-success="Account created.">
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-full-name">Full name</label>
        <input className="p8-input p8-form__control" id="form-full-name" name="full-name" aria-describedby="form-full-name-error" data-field="Full name" required aria-required="true" type="text" autoComplete="name" />
        <p className="p8-form__error" id="form-full-name-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-work-email">Work email</label>
        <input className="p8-input p8-form__control" id="form-work-email" name="work-email" aria-describedby="form-work-email-error" data-field="Work email" required aria-required="true" type="email" autoComplete="email" />
        <p className="p8-form__error" id="form-work-email-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-password">Password</label>
        <input className="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" data-min="8" type="password" autoComplete="new-password" />
        <p className="p8-form__error" id="form-password-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-role">
          Role
          <span className="p8-form__optional"> (optional)</span>
        </label>
        <div className="p8-select">
          <select className="p8-select__control p8-form__control" id="form-role" name="role" aria-describedby="form-role-error" data-field="Role" defaultValue="Designer">
            <option value="Designer">Designer</option>
            <option value="Engineer">Engineer</option>
            <option value="Manager">Manager</option>
          </select>
          <svg className="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M4 6L8 10L12 6" />
          </svg>
        </div>
        <p className="p8-form__error" id="form-role-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-field__label" htmlFor="form-about-you">
          About you
          <span className="p8-form__optional"> (optional)</span>
        </label>
        <textarea className="p8-input p8-form__control" id="form-about-you" name="about-you" aria-describedby="form-about-you-error" data-field="About you" rows="3"></textarea>
        <p className="p8-form__error" id="form-about-you-error" data-error></p>
      </div>
      <div className="p8-form__field">
        <label className="p8-check" data-p8="toggle">
          <button className="p8-check__box p8-form__control" type="button" role="checkbox" aria-checked="false" id="form-i-agree-to-the-terms" name="i-agree-to-the-terms" aria-describedby="form-i-agree-to-the-terms-error" data-field="I agree to the terms" required aria-required="true">
            <svg className="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" />
            </svg>
          </button>
          I agree to the terms
        </label>
        <p className="p8-form__error" id="form-i-agree-to-the-terms-error" data-error></p>
      </div>
      <div className="p8-form__actions">
        <button className="p8-button p8-button--primary" type="submit" data-submit>Create account</button>
      </div>
      <p className="p8-form__status" role="status" data-status></p>
    </form>
