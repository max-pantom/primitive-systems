exports[`codegen snapshots > timer #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-timer" role="timer" aria-label="Countdown" data-p8="timer" data-mode="countdown" data-seconds="90">
  <span class="p8-timer__time" data-time>01:30</span>
  <span class="p8-timer__actions">
    <button class="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="toggle">Start</button>
    <button class="p8-button p8-button--ghost p8-timer__btn" type="button" data-timer="reset">Reset</button>
  </span>
</div>

<style>
  .p8-timer {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-12);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight);
  }

  .p8-timer__time {
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
    font-weight: var(--p8-type-weight-strong);
    font-variant-numeric: tabular-nums;
    min-width: var(--p8-size-64);
    text-align: center;
  }

  .p8-timer__actions {
    display: inline-flex;
    gap: var(--p8-space-8);
