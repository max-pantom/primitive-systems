"// CodeBlock.tsx — Requires the Primitive Systems theme variables (theme.css).
import './code-block.css';

export function CodeBlock() {
  return (
    <div className="p8-code">
      <div className="p8-code__head">
        <span className="p8-code__lang">html</span>
      </div>
      <pre className="p8-code__pre" tabIndex="0" aria-label="Code"><code><span className="p8-code__tok-t">&lt;p8-button</span> <span className="p8-code__tok-a">variant</span><span className="p8-code__tok-p">=</span><span className="p8-code__tok-s">"primary"</span><span className="p8-code__tok-p">&gt;</span>Save<span className="p8-code__tok-t">&lt;/p8-button</span><span className="p8-code__tok-p">&gt;</span></code></pre>
    </div>
  );
}

/* code-block.css */
.p8-code {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-500);
  max-width: 100%;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-syntax-1);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-code__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-code__lang {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-code__pre {
  margin: 0;
  overflow: auto;
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-syntax-1);
  scrollbar-width: thin;
}

.p8-code__pre:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-code__tok-t {
  color: var(--p8-color-syntax-1);
}

.p8-code__tok-a {
  color: var(--p8-color-syntax-2);
}

.p8-code__tok-p {
  color: var(--p8-color-syntax-4);
}

.p8-code__tok-s {
  color: var(--p8-color-syntax-3);
}
"
`;

