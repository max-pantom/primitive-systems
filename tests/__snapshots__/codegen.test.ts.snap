"// DataTable.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './data-table.css';

export function DataTable() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-dtable" data-p8="datatable">
      <div className="p8-dtable__bar">
        <span className="p8-dtable__count" aria-live="polite" data-count>4 rows</span>
      </div>
      <table className="p8-dtable__table">
        <thead>
          <tr>
            <th className="p8-dtable__head" scope="col" aria-sort="none" data-col="0">
              <button className="p8-dtable__sort" type="button" data-sort="0">
                Name
                <svg className="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M3.5 5.5L7 9L10.5 5.5" />
                </svg>
              </button>
            </th>
            <th className="p8-dtable__head" scope="col" aria-sort="none" data-col="1">
              <button className="p8-dtable__sort" type="button" data-sort="1">
                Role
                <svg className="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M3.5 5.5L7 9L10.5 5.5" />
                </svg>
              </button>
            </th>
            <th className="p8-dtable__head" scope="col" aria-sort="none" data-col="2">
              <button className="p8-dtable__sort" type="button" data-sort="2">
                Joined
                <svg className="p8-icon p8-dtable__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
                  <path d="M3.5 5.5L7 9L10.5 5.5" />
                </svg>
              </button>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr className="p8-dtable__row" data-row="0">
            <td className="p8-dtable__cell" data-col="0" title="Ada Lovelace">Ada Lovelace</td>
            <td className="p8-dtable__cell" data-col="1" title="Engineer">Engineer</td>
            <td className="p8-dtable__cell" data-col="2" title="2024-03-12">2024-03-12</td>
          </tr>
          <tr className="p8-dtable__row" data-row="1">
            <td className="p8-dtable__cell" data-col="0" title="Grace Hopper">Grace Hopper</td>
            <td className="p8-dtable__cell" data-col="1" title="Admiral">Admiral</td>
