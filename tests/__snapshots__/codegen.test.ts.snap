// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-mention" data-p8="mention" data-trigger="@">
  <textarea class="p8-input p8-mention__input" id="mention-input" rows="3" placeholder="Write a comment. Type @ to mention someone." role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="mention-list" aria-haspopup="listbox" data-input aria-label="Write a comment. Type @ to mention someone."></textarea>
  <div class="p8-mention__list" role="listbox" id="mention-list" aria-label="People" hidden data-list>
    <button class="p8-mention__option" type="button" role="option" id="mention-opt-0" tabindex="-1" data-value="Ada Lovelace">Ada Lovelace</button>
    <button class="p8-mention__option" type="button" role="option" id="mention-opt-1" tabindex="-1" data-value="Alan Turing">Alan Turing</button>
    <button class="p8-mention__option" type="button" role="option" id="mention-opt-2" tabindex="-1" data-value="Grace Hopper">Grace Hopper</button>
    <button class="p8-mention__option" type="button" role="option" id="mention-opt-3" tabindex="-1" data-value="Margaret Hamilton">Margaret Hamilton</button>
  </div>
  <p class="p8-mention__sr" role="status" aria-live="polite" data-live></p>
</div>

<style>
  .p8-mention {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    width: var(--p8-size-500);
    max-width: 100%;
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-mention__input {
    resize: vertical;
  }

  .p8-mention__list {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: var(--p8-space-4);
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    max-height: var(--p8-size-240);
    overflow-y: auto;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-mention__list[hidden] {
    display: none;
  }

  .p8-mention__option {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
    text-align: left;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-mention__option:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-mention__option:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-mention__option[hidden] {
    display: none;
  }

  .p8-mention__sr {
    position: absolute;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
