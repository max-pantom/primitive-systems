"// ContextMenu.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './context-menu.css';

export function ContextMenu() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-context" data-p8="context">
      <div className="p8-context__area" data-area tabIndex="0" aria-haspopup="menu" aria-expanded="true">Right-click here</div>
      <div className="p8-context__panel" data-panel>
        <div className="p8-menu" role="menu" data-p8="menu">
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘C">
            Copy
            <span className="p8-menu__shortcut" aria-hidden="true">⌘C</span>
          </button>
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘V">
            Paste
            <span className="p8-menu__shortcut" aria-hidden="true">⌘V</span>
          </button>
          <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
          <button className="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌫">
            Delete
            <span className="p8-menu__shortcut" aria-hidden="true">⌫</span>
          </button>
        </div>
      </div>
    </div>
  );
}

/* context-menu.css */
.p8-context {
  position: relative;
  display: inline-block;
  width: var(--p8-size-400);
  max-width: 100%;
}

.p8-context__area {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: var(--p8-size-160);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink-muted);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-context__area:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-context__panel {
  position: absolute;
  left: var(--p8-space-24);
  top: var(--p8-space-24);
  z-index: 40;
}

.p8-context__panel[hidden] {
  display: none;
}

.p8-menu {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  min-width: var(--p8-size-240);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  border-radius: var(--p8-radius-12);
  font-family: var(--p8-type-family);
}

.p8-menu__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  text-align: left;
  width: 100%;
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-6);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-menu__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-menu__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-menu__shortcut {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-divider {
  flex-shrink: 0;
  width: var(--p8-size-400);
  max-width: 100%;
  height: 0;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-menu__item","--active"]];
