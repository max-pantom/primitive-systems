"// SegmentedControl.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './segmented-control.css';

export function SegmentedControl() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-segmented" role="radiogroup" data-p8="group">
      <button className="p8-segmented__item p8-segmented__item--active" type="button" role="radio" aria-checked="true" tabIndex="0">Day</button>
      <button className="p8-segmented__item" type="button" role="radio" aria-checked="false" tabIndex="-1">Week</button>
      <button className="p8-segmented__item" type="button" role="radio" aria-checked="false" tabIndex="-1">Month</button>
    </div>
  );
}

/* segmented-control.css */
.p8-segmented {
  display: inline-flex;
  gap: var(--p8-space-4);
  padding: var(--p8-space-4);
  box-sizing: border-box;
  border-radius: var(--p8-radius-12);
  background: var(--p8-color-control);
}

.p8-segmented__item {
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink-muted);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-segmented__item:hover:not(:disabled) {
  color: var(--p8-color-ink);
}

.p8-segmented__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-segmented__item--active {
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

// ---behavior---
function initP8(root, opts) {
