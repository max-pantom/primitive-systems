"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-menu" role="menu">
  <button class="p8-menu__item" type="button" role="menuitem">Rename</button>
  <button class="p8-menu__item" type="button" role="menuitem">Duplicate</button>
  <div class="p8-divider" role="separator" aria-orientation="horizontal"></div>
  <button class="p8-menu__item" type="button" role="menuitem">Delete</button>
</div>

<style>
  .p8-menu {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    min-width: var(--p8-size-320);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
    border-radius: var(--p8-radius-12);
    font-family: var(--p8-type-family);
  }

  .p8-menu__item {
    box-sizing: border-box;
    text-align: left;
    width: 100%;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-6);
    border-radius: var(--p8-radius-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

