"// Card.tsx — Requires the Primitive Systems theme variables (theme.css).
import './card.css';

export function Card() {
  return (
    <div className="p8-card p8-card--even p8-card--flat">
      <div className="p8-card__text">
        <div className="p8-card__title">Card title</div>
        <p className="p8-card__body">Supporting text for the card.</p>
      </div>
      <div className="p8-card__actions">
        <button className="p8-button" type="button">Continue</button>
      </div>
    </div>
  );
}

/* card.css */
.p8-card {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
  font-family: var(--p8-type-family);
}

.p8-card--even {
  padding-block: var(--p8-space-16);
}

.p8-card--flat {
  box-shadow: none;
}

.p8-card__text {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-card__title {
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-card__body {
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-card__actions {
  display: flex;
  gap: var(--p8-space-12);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  box-shadow: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}
"
