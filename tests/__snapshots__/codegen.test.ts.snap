<style>
  .p8-chart {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-chart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-chart__title {
    margin: 0;
    font-weight: var(--p8-type-weight);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
  }

  .p8-chart__plot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--p8-space-8);
    row-gap: var(--p8-space-4);
  }

  .p8-chart__y {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--p8-size-160);
    color: var(--p8-color-ink-muted);
    text-align: right;
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
  }

  .p8-chart__area {
    position: relative;
    height: var(--p8-size-160);
    border-radius: var(--p8-radius-4);
    cursor: crosshair;
  }

  .p8-chart__area:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-chart__svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .p8-chart__gridline {
    stroke: var(--p8-color-ring);
    stroke-width: var(--p8-border-hairline);
    vector-effect: non-scaling-stroke;
  }

  .p8-chart__band {
    fill: var(--p8-color-control);
    opacity: 0;
  }

  .p8-chart__band[data-show] {
    opacity: 1;
  }

  .p8-chart__series[data-off] {
    display: none;
  }

  .p8-chart__s1 {
    fill: var(--p8-color-ink);
    stroke: var(--p8-color-ink);
    stroke-width: var(--p8-border-focus);
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .p8-chart__s1[data-line] {
    fill: none;
  }

  .p8-chart__s1[data-fill] {
    stroke: none;
    fill-opacity: 0.15;
  }

  .p8-chart__s1[data-bar] {
    stroke: none;
  }

  .p8-chart__s2 {
    fill: var(--p8-color-ink-muted);
    stroke: var(--p8-color-ink-muted);
    stroke-width: var(--p8-border-focus);
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .p8-chart__s2[data-line] {
    fill: none;
  }

  .p8-chart__s2[data-fill] {
    stroke: none;
    fill-opacity: 0.15;
  }

  .p8-chart__s2[data-bar] {
    stroke: none;
  }

  .p8-chart__tip {
    position: absolute;
    top: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    min-width: var(--p8-size-160);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    pointer-events: none;
    translate: -50% 0;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-chart__tip[hidden] {
    display: none;
  }

  .p8-chart__x {
    display: grid;
    color: var(--p8-color-ink-muted);
    text-align: center;
    grid-column: 2;
  }

  .p8-chart__sr {
    position: absolute;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .p8-chart__tip-row {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    white-space: nowrap;
  }

  .p8-chart__swatch {
    width: var(--p8-space-8);
    height: var(--p8-space-8);
    border-radius: var(--p8-radius-full);
    flex-shrink: 0;
  }
</style>

