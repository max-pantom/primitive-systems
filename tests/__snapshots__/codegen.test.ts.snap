"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-inline" data-p8="inline">
  <button class="p8-inline__view" type="button" data-view aria-label="Title: Click to edit. Edit">
    Click to edit
    <span class="p8-inline__pen">
      <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="2.5,9 9,2.5 11.5,5 5,11.5 2.75,11.25" />
        <line x1="7.5" y1="4" x2="10" y2="6.5" />
      </svg>
    </span>
  </button>
  <input class="p8-input p8-inline__input" type="text" value="Click to edit" placeholder="Add a title" aria-label="Title" hidden data-edit />
</div>

<style>
  .p8-inline {
    display: inline-grid;
    max-width: 100%;
  }

  .p8-inline__view {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: text;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-inline__view:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-inline__view:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-inline__view[hidden] {
    visibility: hidden;
    pointer-events: none;
  }

  .p8-inline__pen {
    display: inline-flex;
    color: var(--p8-color-ink-muted);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-inline__input {
    grid-area: 1 / 1;
    min-width: 0;
  }

  .p8-inline__input[hidden] {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function iDone(w, save) {
    var inp = w.querySelector('[data-edit]'), view = w.querySelector('[data-view]');
    if (inp.hidden) return;
    var label = inp.getAttribute('aria-label'), ph = inp.getAttribute('placeholder') || '';
    if (save) {
      var val = inp.value.trim();
      view.firstChild.textContent = val || ph;
      view.classList.toggle('p8-inline__view--empty', !val);
      view.setAttribute('aria-label', label + ': ' + (val || ph) + '. Edit');
      w.dispatchEvent(new CustomEvent('p8-change', { bubbles: true, detail: { value: val } }));
    } else inp.value = inp.getAttribute('data-old') || '';
    inp.hidden = true; view.hidden = false; view.focus();
  }
  root.addEventListener('click', function (e) {
    var v = cl(e, '[data-p8~="inline"] [data-view]');
    if (!v) return;
    var w = v.closest('[data-p8~="inline"]'), inp = w.querySelector('[data-edit]');
    inp.setAttribute('data-old', inp.value);
    v.hidden = true; inp.hidden = false; inp.focus(); inp.select();
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var inp = cl(e, '[data-p8~="inline"] [data-edit]');
    if (!inp) return;
    if (e.key === 'Enter') { e.preventDefault(); iDone(inp.closest('[data-p8~="inline"]'), true); }
    else if (e.key === 'Escape') { e.preventDefault(); iDone(inp.closest('[data-p8~="inline"]'), false); }
  }, { signal: ac.signal });
  root.addEventListener('focusout', function (e) {
    var inp = cl(e, '[data-p8~="inline"] [data-edit]');
    if (inp) iDone(inp.closest('[data-p8~="inline"]'), true);
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
