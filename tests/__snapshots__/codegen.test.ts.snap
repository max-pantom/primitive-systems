      b.textContent = '';
      var num = mcMk(c, 0, String(d.getUTCDate())); if (iso === today) num.setAttribute('data-today', ''); b.appendChild(num);
      list.slice(0, list.length > 2 ? 1 : 2).forEach(function (t) { b.appendChild(mcMk(c, 1, t)); });
