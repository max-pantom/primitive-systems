"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-resize" data-p8="resize">
  <div class="p8-resize__pane p8-resize__pane--first" data-pane style="flex-basis: 40%">
    <span class="p8-resize__title">Navigation</span>
    <span>Placeholder content</span>
  </div>
  <div class="p8-resize__handle" role="separator" tabindex="0" aria-orientation="vertical" aria-label="Resize Navigation and Content" aria-valuenow="40" aria-valuemin="20" aria-valuemax="80" data-handle></div>
  <div class="p8-resize__pane">
    <span class="p8-resize__title">Content</span>
    <span>Placeholder content</span>
  </div>
</div>

<style>
  .p8-resize {
    display: flex;
    width: var(--p8-size-500);
    max-width: 100%;
    height: var(--p8-size-240);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-resize__pane {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: auto;
    box-sizing: border-box;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-resize__pane--first {
    flex: 0 0 auto;
  }

  .p8-resize__title {
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-resize__handle {
    position: relative;
    flex: 0 0 var(--p8-space-8);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: col-resize;
    touch-action: none;
    background: transparent;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-resize__handle:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-resize__handle:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
    outline: none;
  }

  .p8-resize__handle::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 100%;
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-resize__handle[aria-orientation="horizontal"] {
    cursor: row-resize;
  }

  .p8-resize__handle[aria-orientation="horizontal"]::before {
    width: 100%;
    height: 0;
    border-left: none;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function rzSet(h, pct) {
    var min = Number(h.getAttribute('aria-valuemin')), max = Number(h.getAttribute('aria-valuemax'));
    pct = Math.round(Math.min(max, Math.max(min, pct)));
    h.setAttribute('aria-valuenow', String(pct));
    h.previousElementSibling.style.flexBasis = pct + '%';
    h.dispatchEvent(new CustomEvent('p8-resize', { bubbles: true, detail: { size: pct } }));
  }
  function rzVert(h) { return h.getAttribute('aria-orientation') === 'horizontal'; }
  root.addEventListener('keydown', function (e) {
    var h = cl(e, '[data-p8~="resize"] [data-handle]');
    if (!h) return;
    var now = Number(h.getAttribute('aria-valuenow')), k = e.key, vert = rzVert(h);
    if (k === (vert ? 'ArrowUp' : 'ArrowLeft')) rzSet(h, now - 5);
    else if (k === (vert ? 'ArrowDown' : 'ArrowRight')) rzSet(h, now + 5);
    else if (k === 'Home') rzSet(h, 0);
    else if (k === 'End') rzSet(h, 100);
    else return;
    e.preventDefault();
  }, { signal: ac.signal });
  root.addEventListener('pointerdown', function (e) {
    var h = cl(e, '[data-p8~="resize"] [data-handle]');
    if (!h || e.button !== 0) return;
    e.preventDefault(); h.focus();
    var box = h.parentElement, vert = rzVert(h);
    if (h.setPointerCapture) try { h.setPointerCapture(e.pointerId); } catch (err) { }
    function move(ev) { var r = box.getBoundingClientRect(); rzSet(h, vert ? (ev.clientY - r.top) / r.height * 100 : (ev.clientX - r.left) / r.width * 100); }
    function up() { h.removeEventListener('pointermove', move); h.removeEventListener('pointerup', up); h.removeEventListener('pointercancel', up); }
    h.addEventListener('pointermove', move, { signal: ac.signal }); h.addEventListener('pointerup', up, { signal: ac.signal }); h.addEventListener('pointercancel', up, { signal: ac.signal });
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
initP8(document);
</script>
"
