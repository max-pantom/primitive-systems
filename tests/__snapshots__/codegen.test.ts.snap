"// Menu.tsx — Requires the Primitive Systems theme variables (theme.css).
import './menu.css';

export function Menu() {
  return (
    <div className="p8-menu" role="menu">
      <button className="p8-menu__item" type="button" role="menuitem">Rename</button>
      <button className="p8-menu__item" type="button" role="menuitem">Duplicate</button>
      <div className="p8-divider" role="separator" aria-orientation="horizontal"></div>
      <button className="p8-menu__item" type="button" role="menuitem">Delete</button>
    </div>
  );
}

/* menu.css */
.p8-menu {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  min-width: var(--p8-size-320);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  box-shadow: 0 0 0 var(--p8-border-hairline) var(--p8-color-ring);
  border-radius: var(--p8-radius-12);
  font-family: var(--p8-type-family);
}

.p8-menu__item {
  box-sizing: border-box;
  text-align: left;
  width: 100%;
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-6);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-menu__item:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-menu__item:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}

.p8-divider {
  flex-shrink: 0;
  width: 100%;
  height: var(--p8-border-hairline);
  background: var(--p8-color-ring);
}
"
`;

