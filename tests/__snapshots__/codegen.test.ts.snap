        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
  .p8-tpl-page {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--p8-size-500);
    color: var(--p8-color-ink);
  }

  .p8-tpl-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

