  return (
    <div ref={ref} className="p8-mention" data-p8="mention" data-trigger="/">
      <label className="p8-field__label" htmlFor="mention-input">Sample {'{'}x{'}'} &lt;y&gt;</label>
      <textarea className="p8-input p8-mention__input" id="mention-input" rows="6" placeholder="Write a comment. Type @ to mention someone." role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="mention-list" aria-haspopup="listbox" data-input disabled defaultValue="Sample {x} &lt;y&gt;"></textarea>
      <div className="p8-mention__list" role="listbox" id="mention-list" aria-label="Commands" hidden data-list>
        <button className="p8-mention__option" type="button" role="option" id="mention-opt-0" tabIndex="-1" data-value="Ada Lovelace">Ada Lovelace</button>
        <button className="p8-mention__option" type="button" role="option" id="mention-opt-1" tabIndex="-1" data-value="Alan Turing">Alan Turing</button>
        <button className="p8-mention__option" type="button" role="option" id="mention-opt-2" tabIndex="-1" data-value="Grace Hopper">Grace Hopper</button>
        <button className="p8-mention__option" type="button" role="option" id="mention-opt-3" tabIndex="-1" data-value="Margaret Hamilton">Margaret Hamilton</button>
      </div>
      <p className="p8-mention__sr" role="status" aria-live="polite" data-live></p>
    </div>
  );
}

/* mention-input.css */
.p8-mention {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  width: var(--p8-size-500);
  max-width: 100%;
}

.p8-field__label {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
  color: var(--p8-color-ink);
}

.p8-input {
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
}

.p8-input:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-input:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-input:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-input::placeholder {
  color: var(--p8-color-placeholder);
}

.p8-mention__input {
  resize: vertical;
}

.p8-mention__list {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: var(--p8-space-4);
  z-index: 40;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  padding: var(--p8-space-4);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  max-height: var(--p8-size-240);
  overflow-y: auto;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-mention__list[hidden] {
  display: none;
}

.p8-mention__option {
  display: flex;
  justify-content: space-between;
  gap: var(--p8-space-12);
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-mention__option:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-mention__option:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-mention__option[hidden] {
  display: none;
}

.p8-mention__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-mention__option","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function mnOpts(m) { return Array.from(m.querySelectorAll('[role="option"]')); }
  function mnVis(m) { return mnOpts(m).filter(function (x) { return !x.hidden; }); }
  function mnTA(m) { return m.querySelector('[data-input]'); }
  function mnToken(m) {
    var ta = mnTA(m), t = m.getAttribute('data-trigger'), caret = ta.selectionStart, before = ta.value.slice(0, caret), i = before.lastIndexOf(t);
    if (i < 0 || (i > 0 && !/\\s/.test(before.charAt(i - 1)))) return null;
    var q = before.slice(i + 1);
    if (/\\n/.test(q) || q.length > 30 || /\\s\\s/.test(q)) return null;
    return { start: i, query: q, end: caret };
  }
  function mnClose(m) { m.querySelector('[data-list]').hidden = true; var ta = mnTA(m); ta.setAttribute('aria-expanded', 'false'); ta.removeAttribute('aria-activedescendant'); }
  function mnMark(m, it) {
    mnOpts(m).forEach(function (x) { setOn(x, x === it); });
    var ta = mnTA(m); if (it) ta.setAttribute('aria-activedescendant', it.id); else ta.removeAttribute('aria-activedescendant');
    if (it && it.scrollIntoView) it.scrollIntoView({ block: 'nearest' });
  }
  function mnUpdate(m) {
    var tok = mnToken(m);
    if (!tok) { mnClose(m); return; }
    var q = tok.query.toLowerCase();
    mnOpts(m).forEach(function (x) { x.hidden = x.getAttribute('data-value').toLowerCase().indexOf(q) < 0; });
    var vis = mnVis(m);
    if (!vis.length) { mnClose(m); return; }
    m.querySelector('[data-list]').hidden = false; mnTA(m).setAttribute('aria-expanded', 'true');
    mnMark(m, vis[0]);
    m.querySelector('[data-live]').textContent = vis.length + (vis.length === 1 ? ' suggestion' : ' suggestions');
  }
  function mnInsert(m, it) {
    var tok = mnToken(m); if (!tok) return;
    var ta = mnTA(m), t = m.getAttribute('data-trigger'), name = it.getAttribute('data-value');
    ta.value = ta.value.slice(0, tok.start) + t + name + ' ' + ta.value.slice(tok.end);
    var pos = tok.start + t.length + name.length + 1;
    ta.setSelectionRange(pos, pos);
    mnClose(m);
    ta.dispatchEvent(new Event('input', { bubbles: true }));
    m.dispatchEvent(new CustomEvent('p8-mention', { bubbles: true, detail: { name: name, trigger: t } }));
    m.querySelector('[data-live]').textContent = name + ' mentioned';
    ta.focus();
  }
  root.addEventListener('input', function (e) { var m = cl(e, '[data-p8~="mention"]'); if (m && e.target.hasAttribute('data-input')) mnUpdate(m); }, { signal: ac.signal });
  root.addEventListener('keyup', function (e) { var m = cl(e, '[data-p8~="mention"]'); if (m && e.target.hasAttribute('data-input') && ['ArrowLeft', 'ArrowRight', 'Home', 'End'].indexOf(e.key) >= 0) mnUpdate(m); }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="mention"] [role="option"]');
    if (it) { mnInsert(it.closest('[data-p8~="mention"]'), it); return; }
    var m = cl(e, '[data-p8~="mention"]');
    if (m && e.target.hasAttribute('data-input')) mnUpdate(m);
  }, { signal: ac.signal });
  root.addEventListener('mousedown', function (e) { if (cl(e, '[data-p8~="mention"] [role="option"]')) e.preventDefault(); }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var m = cl(e, '[data-p8~="mention"]');
    if (!m || !e.target.hasAttribute('data-input') || m.querySelector('[data-list]').hidden) return;
    var vis = mnVis(m), cur = vis.findIndex(function (x) { return x.classList.contains('p8-mention__option--active'); });
    if (e.key === 'ArrowDown') cur = (cur + 1) % vis.length;
    else if (e.key === 'ArrowUp') cur = (cur - 1 + vis.length) % vis.length;
    else if (e.key === 'Enter' || e.key === 'Tab') { if (vis[cur]) { e.preventDefault(); mnInsert(m, vis[cur]); } return; }
    else if (e.key === 'Escape') { e.preventDefault(); mnClose(m); return; }
    else return;
    e.preventDefault();
    mnMark(m, vis[cur]);
  }, { signal: ac.signal });
  root.addEventListener('focusout', function (e) { var m = cl(e, '[data-p8~="mention"]'); if (m && e.target.hasAttribute('data-input')) setTimeout(function () { if (!m.contains(doc.activeElement)) mnClose(m); }, 0); }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
