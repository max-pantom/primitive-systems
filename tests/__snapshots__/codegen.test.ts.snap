      function up() { h.removeEventListener('pointermove', move); h.removeEventListener('pointerup', up); h.removeEventListener('pointercancel', up); }
      h.addEventListener('pointermove', move, { signal: ac.signal }); h.addEventListener('pointerup', up, { signal: ac.signal }); h.addEventListener('pointercancel', up, { signal: ac.signal });
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-resize p8-resize--vertical" data-p8="resize">
  <div class="p8-resize__pane p8-resize__pane--first" data-pane style="flex-basis: 70%">
    <span class="p8-resize__title">Navigation</span>
    <span>Placeholder content</span>
  </div>
  <div class="p8-resize__handle" role="separator" tabindex="0" aria-orientation="horizontal" aria-label="Resize Navigation and Content" aria-valuenow="70" aria-valuemin="20" aria-valuemax="80" data-handle></div>
