  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: 100%;
  appearance: none;
  padding-inline-end: var(--p8-space-32);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    background: var(--p8-color-control-strong);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
}

.p8-icon {
  flex-shrink: 0;
}

.p8-select__icon {
  position: absolute;
  inset-inline-end: var(--p8-space-12);
  pointer-events: none;
  color: var(--p8-color-ink);
}

.p8-select__icon--disabled {
  opacity: var(--p8-opacity-disabled);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-filters__chips {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
}

.p8-filters__list {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  overflow-x: auto;
  scrollbar-width: thin;
  white-space: nowrap;
}

.p8-tag {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-8);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tag__close {
  display: inline-flex;
  padding: 0;
  border: none;
  background: transparent;
  color: inherit;
  cursor: pointer;
  border-radius: var(--p8-radius-4);
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-filters__empty {
  color: var(--p8-color-ink-muted);
  &[hidden] {
    display: none;
  }
}

.p8-button--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
}

