      </button>
      <button class="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘D">
        Duplicate
        <span class="p8-menu__shortcut" aria-hidden="true">⌘D</span>
      </button>
      <div class="p8-divider" role="separator" aria-orientation="horizontal"></div>
      <button class="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌫">
