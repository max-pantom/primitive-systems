"// Dashboard.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './dashboard.css';

export function Dashboard() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-tpl-page" data-p8="action">
      <div className="p8-tpl-bar">
        <h1 className="p8-heading">Overview</h1>
        <button className="p8-button p8-button--primary" type="button" data-action="New report">New report</button>
      </div>
      <div className="p8-tpl-grid">
        <div className="p8-stat">
          <span className="p8-stat__label">Revenue</span>
          <span className="p8-stat__value">12,400</span>
          <span className="p8-stat__change">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M3.5 8.5L7 5L10.5 8.5" />
            </svg>
            12%
          </span>
        </div>
        <div className="p8-stat">
          <span className="p8-stat__label">Signups</span>
          <span className="p8-stat__value">1,820</span>
          <span className="p8-stat__change">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M3.5 8.5L7 5L10.5 8.5" />
            </svg>
            4%
          </span>
        </div>
        <div className="p8-stat">
          <span className="p8-stat__label">Churn</span>
          <span className="p8-stat__value">2.1%</span>
          <span className="p8-stat__change">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M3.5 5.5L7 9L10.5 5.5" />
            </svg>
            0.3%
          </span>
        </div>
      </div>
      <div className="p8-tpl-wide">
        <figure className="p8-chart" data-p8="chart" data-chart="{&quot;labels&quot;:[&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;],&quot;series&quot;:[{&quot;name&quot;:&quot;Revenue&quot;,&quot;values&quot;:[120,150,170,140,190,230]},{&quot;name&quot;:&quot;Costs&quot;,&quot;values&quot;:[80,95,110,100,120,130]}]}">
          <div className="p8-chart__head">
            <figcaption className="p8-chart__title">Revenue vs costs</figcaption>
            <div className="p8-chart__legend" role="group" aria-label="Series">
              <button className="p8-chart__key" type="button" aria-pressed="true" data-key="0">
                <span className="p8-chart__swatch" style={{ background: "var(--p8-color-ink)" }}></span>
                Revenue
              </button>
              <button className="p8-chart__key" type="button" aria-pressed="true" data-key="1">
                <span className="p8-chart__swatch" style={{ background: "var(--p8-color-ink-muted)" }}></span>
                Costs
              </button>
            </div>
          </div>
          <div className="p8-chart__plot">
            <div className="p8-chart__y" aria-hidden="true">
              <span>250</span>
              <span>187.5</span>
              <span>125</span>
              <span>62.5</span>
              <span>0</span>
            </div>
            <div className="p8-chart__area" tabIndex="0" role="img" aria-label="Revenue vs costs: bar chart of Revenue, Costs over 6 points. Use the left and right arrow keys to read values." data-plot>
              <svg className="p8-chart__svg" viewBox="0 0 600 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <line className="p8-chart__gridline" x1="0" x2="600" y1="0" y2="0" />
                <line className="p8-chart__gridline" x1="0" x2="600" y1="25" y2="25" />
                <line className="p8-chart__gridline" x1="0" x2="600" y1="50" y2="50" />
                <line className="p8-chart__gridline" x1="0" x2="600" y1="75" y2="75" />
                <line className="p8-chart__gridline" x1="0" x2="600" y1="100" y2="100" />
                <rect className="p8-chart__band" x="0" y="0" width="100" height="100" data-band />
                <g className="p8-chart__series" data-series="0">
                  <rect className="p8-chart__s1" x="20" y="52" width="26" height="48" rx="2" data-bar />
                  <rect className="p8-chart__s1" x="120" y="40" width="26" height="60" rx="2" data-bar />
                  <rect className="p8-chart__s1" x="220" y="32" width="26" height="68" rx="2" data-bar />
                  <rect className="p8-chart__s1" x="320" y="44" width="26" height="56" rx="2" data-bar />
                  <rect className="p8-chart__s1" x="420" y="24" width="26" height="76" rx="2" data-bar />
                  <rect className="p8-chart__s1" x="520" y="8" width="26" height="92" rx="2" data-bar />
                </g>
                <g className="p8-chart__series" data-series="1">
                  <rect className="p8-chart__s2" x="50" y="68" width="26" height="32" rx="2" data-bar />
                  <rect className="p8-chart__s2" x="150" y="62" width="26" height="38" rx="2" data-bar />
                  <rect className="p8-chart__s2" x="250" y="56" width="26" height="44" rx="2" data-bar />
                  <rect className="p8-chart__s2" x="350" y="60" width="26" height="40" rx="2" data-bar />
                  <rect className="p8-chart__s2" x="450" y="52" width="26" height="48" rx="2" data-bar />
                  <rect className="p8-chart__s2" x="550" y="48" width="26" height="52" rx="2" data-bar />
                </g>
              </svg>
              <div className="p8-chart__tip" data-tip hidden aria-hidden="true"></div>
            </div>
            <div className="p8-chart__x" style={{ gridTemplateColumns: "repeat(6, minmax(0, 1fr))" }} aria-hidden="true">
              <span>Jan</span>
              <span>Feb</span>
              <span>Mar</span>
              <span>Apr</span>
              <span>May</span>
              <span>Jun</span>
            </div>
          </div>
          <p className="p8-chart__sr" aria-live="polite" data-live></p>
          <template data-row>
            <div className="p8-chart__tip-row">
              <span className="p8-chart__swatch"></span>
              <span></span>
            </div>
          </template>
          <table className="p8-chart__sr">
            <caption>Revenue vs costs</caption>
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">Revenue</th>
                <th scope="col">Costs</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Jan</th>
                <td>120</td>
                <td>80</td>
              </tr>
              <tr>
                <th scope="row">Feb</th>
                <td>150</td>
                <td>95</td>
              </tr>
              <tr>
                <th scope="row">Mar</th>
                <td>170</td>
                <td>110</td>
              </tr>
              <tr>
                <th scope="row">Apr</th>
                <td>140</td>
                <td>100</td>
              </tr>
              <tr>
                <th scope="row">May</th>
                <td>190</td>
                <td>120</td>
              </tr>
              <tr>
                <th scope="row">Jun</th>
                <td>230</td>
                <td>130</td>
              </tr>
            </tbody>
          </table>
        </figure>
      </div>
      <section className="p8-tpl-section">
        <h2 className="p8-heading p8-heading--sm">Recent activity</h2>
        <div className="p8-tpl-wide">
          <table className="p8-table">
            <thead>
              <tr>
                <th className="p8-table__head" scope="col">Event</th>
                <th className="p8-table__head" scope="col">Owner</th>
                <th className="p8-table__head" scope="col">When</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td className="p8-table__cell">Invoice 1042 paid</td>
                <td className="p8-table__cell">Ada</td>
                <td className="p8-table__cell">2 min ago</td>
              </tr>
              <tr>
                <td className="p8-table__cell">New signup</td>
                <td className="p8-table__cell">Alan</td>
                <td className="p8-table__cell">1 hour ago</td>
              </tr>
              <tr>
                <td className="p8-table__cell">Plan upgraded</td>
                <td className="p8-table__cell">Grace</td>
                <td className="p8-table__cell">Yesterday</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  );
}

/* dashboard.css */
.p8-tpl-page {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-tpl-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-tpl-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--p8-size-160), 1fr));
  gap: var(--p8-space-12);
}

.p8-stat {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-stat__label {
  color: var(--p8-color-ink-muted);
}

.p8-stat__value {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-stat__change {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  color: var(--p8-color-ink-muted);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-tpl-wide {
  min-width: 0;
  overflow: auto;
}

.p8-chart {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-chart__title {
  margin: 0;
  font-weight: var(--p8-type-weight);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-chart__legend {
  display: flex;
  gap: var(--p8-space-4);
}

.p8-chart__key {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__key:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-chart__key:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-chart__key[aria-pressed="false"] {
  color: var(--p8-color-ink-muted);
}

.p8-chart__key[aria-pressed="false"] .p8-chart__swatch {
  opacity: 0.3;
}

.p8-chart__swatch {
  width: var(--p8-space-8);
  height: var(--p8-space-8);
  border-radius: var(--p8-radius-full);
  flex-shrink: 0;
}

.p8-chart__plot {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: var(--p8-space-8);
  row-gap: var(--p8-space-4);
}

.p8-chart__y {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: var(--p8-size-160);
  color: var(--p8-color-ink-muted);
  text-align: right;
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-chart__area {
  position: relative;
  height: var(--p8-size-160);
  border-radius: var(--p8-radius-4);
  cursor: crosshair;
}

.p8-chart__area:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-chart__svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.p8-chart__gridline {
  stroke: var(--p8-color-ring);
  stroke-width: var(--p8-border-hairline);
  vector-effect: non-scaling-stroke;
}

.p8-chart__band {
  fill: var(--p8-color-control);
  opacity: 0;
}

.p8-chart__band[data-show] {
  opacity: 1;
}

.p8-chart__series[data-off] {
  display: none;
}

.p8-chart__s1 {
  fill: var(--p8-color-ink);
  stroke: var(--p8-color-ink);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.p8-chart__s1[data-line] {
  fill: none;
}

.p8-chart__s1[data-fill] {
  stroke: none;
  fill-opacity: 0.15;
}

.p8-chart__s1[data-bar] {
  stroke: none;
}

.p8-chart__s2 {
  fill: var(--p8-color-ink-muted);
  stroke: var(--p8-color-ink-muted);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.p8-chart__s2[data-line] {
  fill: none;
}

.p8-chart__s2[data-fill] {
  stroke: none;
  fill-opacity: 0.15;
}

.p8-chart__s2[data-bar] {
  stroke: none;
}

.p8-chart__tip {
  position: absolute;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  min-width: var(--p8-size-160);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  pointer-events: none;
  translate: -50% 0;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__tip[hidden] {
  display: none;
}

.p8-chart__x {
  display: grid;
  color: var(--p8-color-ink-muted);
  text-align: center;
  grid-column: 2;
}

.p8-chart__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.p8-chart__tip-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  white-space: nowrap;
}

.p8-tpl-section {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  min-width: 0;
}

.p8-heading--sm {
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-table {
  border-collapse: collapse;
  width: var(--p8-size-500);
  max-width: 100%;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
}

.p8-table__head {
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-table__cell {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="action"] [data-action]');
    if (!b || b.disabled) return;
    b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
  }, { signal: ac.signal });

  var chColors = ['color-ink', 'color-ink-muted', 'color-placeholder'];
  function chData(c) { try { return JSON.parse(c.getAttribute('data-chart')); } catch (err) { return { labels: [], series: [] }; } }
  function chOff(c, i) { var g = c.querySelector('[data-series="' + i + '"]'); return !!(g && g.hasAttribute('data-off')); }
  function chShow(c, idx) {
    var d = chData(c), n = d.labels.length, band = c.querySelector('[data-band]'), tip = c.querySelector('[data-tip]'), live = c.querySelector('[data-live]');
    if (idx === null || idx < 0 || idx >= n) { band.removeAttribute('data-show'); tip.hidden = true; return; }
    c.__idx = idx;
    band.setAttribute('x', String(idx * 100)); band.setAttribute('data-show', '');
    tip.textContent = '';
    var h = document.createElement('strong'); h.textContent = d.labels[idx]; tip.appendChild(h);
    var spoken = [];
    d.series.forEach(function (s, i) {
      if (chOff(c, i)) return;
      var tpl = c.querySelector('template[data-row]'), row = ((tpl.content && tpl.content.firstElementChild) || tpl.firstElementChild).cloneNode(true);
      row.firstElementChild.style.background = 'var(--p8-' + chColors[i] + ')';
      row.lastElementChild.textContent = s.name + ': ' + s.values[idx];
      tip.appendChild(row); spoken.push(s.name + ' ' + s.values[idx]);
    });
    tip.hidden = false;
    var pct = (idx + 0.5) / n * 100;
    tip.style.left = pct + '%'; tip.style.translate = pct > 60 ? '-100% 0' : '0 0';
    live.textContent = d.labels[idx] + ': ' + spoken.join(', ');
  }
  function chIndex(plot, e) { var d = chData(plot.closest('[data-p8~="chart"]')), r = plot.getBoundingClientRect(); return Math.min(d.labels.length - 1, Math.max(0, Math.floor((e.clientX - r.left) / (r.width || 1) * d.labels.length))); }
  root.addEventListener('pointermove', function (e) {
    var plot = cl(e, '[data-p8~="chart"] [data-plot]');
    if (plot) chShow(plot.closest('[data-p8~="chart"]'), chIndex(plot, e));
  }, { signal: ac.signal });
  root.addEventListener('pointerleave', function (e) {
    var c = cl(e, '[data-p8~="chart"]');
    if (c && !c.contains(doc.activeElement)) chShow(c, null);
  }, { signal: ac.signal, capture: true });
  root.addEventListener('keydown', function (e) {
    var plot = cl(e, '[data-p8~="chart"] [data-plot]');
    if (!plot) return;
    var c = plot.closest('[data-p8~="chart"]'), n = chData(c).labels.length, i = c.__idx === undefined ? -1 : c.__idx;
    if (e.key === 'ArrowRight') i = Math.min(n - 1, i + 1); else if (e.key === 'ArrowLeft') i = Math.max(0, i < 0 ? 0 : i - 1);
    else if (e.key === 'Home') i = 0; else if (e.key === 'End') i = n - 1;
    else if (e.key === 'Escape') { chShow(c, null); return; } else return;
    e.preventDefault();
    chShow(c, i);
  }, { signal: ac.signal });
  root.addEventListener('blur', function (e) { var c = cl(e, '[data-p8~="chart"]'); if (c && e.target.matches && e.target.matches('[data-plot]')) chShow(c, null); }, { signal: ac.signal, capture: true });
  root.addEventListener('click', function (e) {
    var k = cl(e, '[data-p8~="chart"] [data-key]');
    if (!k) return;
    var c = k.closest('[data-p8~="chart"]'), i = k.getAttribute('data-key'), g = c.querySelector('[data-series="' + i + '"]');
    var on = k.getAttribute('aria-pressed') === 'true';
    var visible = c.querySelectorAll('[data-key][aria-pressed="true"]').length;
    if (on && visible <= 1) return;
    k.setAttribute('aria-pressed', String(!on));
    if (on) g.setAttribute('data-off', ''); else g.removeAttribute('data-off');
    if (c.__idx !== undefined && !c.querySelector('[data-tip]').hidden) chShow(c, c.__idx);
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

exports[`codegen snapshots > dashboard #1 → scss 1`] = `
"// _dashboard.scss — Requires the Primitive Systems theme variables (theme.css).
.p8-tpl-page {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
}

.p8-tpl-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }
  &[hidden] {
    display: none;
  }
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
  &:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }
}

.p8-tpl-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--p8-size-160), 1fr));
  gap: var(--p8-space-12);
}

.p8-stat {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-stat__label {
  color: var(--p8-color-ink-muted);
}

.p8-stat__value {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-stat__change {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-4);
  color: var(--p8-color-ink-muted);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-tpl-wide {
  min-width: 0;
  overflow: auto;
}

.p8-chart {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-500);
  max-width: 100%;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-chart__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-chart__title {
  margin: 0;
  font-weight: var(--p8-type-weight);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-chart__legend {
  display: flex;
  gap: var(--p8-space-4);
}

.p8-chart__key {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-4);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  &:hover:not(:disabled) {
    background: var(--p8-color-control);
  }
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
  &[aria-pressed="false"] {
    color: var(--p8-color-ink-muted);
  }
  &[aria-pressed="false"] .p8-chart__swatch {
    opacity: 0.3;
  }
}

.p8-chart__swatch {
  width: var(--p8-space-8);
  height: var(--p8-space-8);
  border-radius: var(--p8-radius-full);
  flex-shrink: 0;
}

.p8-chart__plot {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  column-gap: var(--p8-space-8);
  row-gap: var(--p8-space-4);
}

.p8-chart__y {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: var(--p8-size-160);
  color: var(--p8-color-ink-muted);
  text-align: right;
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-chart__area {
  position: relative;
  height: var(--p8-size-160);
  border-radius: var(--p8-radius-4);
  cursor: crosshair;
  &:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }
}

.p8-chart__svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.p8-chart__gridline {
  stroke: var(--p8-color-ring);
  stroke-width: var(--p8-border-hairline);
  vector-effect: non-scaling-stroke;
}

.p8-chart__band {
  fill: var(--p8-color-control);
  opacity: 0;
  &[data-show] {
    opacity: 1;
  }
}

.p8-chart__series {
  &[data-off] {
    display: none;
  }
}

.p8-chart__s1 {
  fill: var(--p8-color-ink);
  stroke: var(--p8-color-ink);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
  &[data-line] {
    fill: none;
  }
  &[data-fill] {
    stroke: none;
    fill-opacity: 0.15;
  }
  &[data-bar] {
    stroke: none;
  }
}

.p8-chart__s2 {
  fill: var(--p8-color-ink-muted);
  stroke: var(--p8-color-ink-muted);
  stroke-width: var(--p8-border-focus);
  vector-effect: non-scaling-stroke;
  stroke-linejoin: round;
  stroke-linecap: round;
  &[data-line] {
    fill: none;
  }
  &[data-fill] {
    stroke: none;
    fill-opacity: 0.15;
  }
  &[data-bar] {
    stroke: none;
  }
}

.p8-chart__tip {
  position: absolute;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
  box-sizing: border-box;
  min-width: var(--p8-size-160);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  pointer-events: none;
  translate: -50% 0;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  &[hidden] {
    display: none;
  }
}

.p8-chart__x {
  display: grid;
  color: var(--p8-color-ink-muted);
  text-align: center;
  grid-column: 2;
}

.p8-chart__sr {
  position: absolute;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.p8-chart__tip-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  white-space: nowrap;
}

.p8-tpl-section {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  min-width: 0;
}

.p8-heading--sm {
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
}

.p8-table {
  border-collapse: collapse;
  width: var(--p8-size-500);
  max-width: 100%;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-ink);
}

.p8-table__head {
  text-align: left;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  color: var(--p8-color-ink-muted);
  font-weight: var(--p8-type-weight);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-table__cell {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

