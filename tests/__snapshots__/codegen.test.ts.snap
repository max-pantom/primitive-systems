          <path d="M2.75 6.75V4.75Q2.75 2.75 4.75 2.75H6L8 4.75H11.25Q13.25 4.75 13.25 6.75V11.25Q13.25 13.25 11.25 13.25H4.75Q2.75 13.25 2.75 11.25Z" />
        </svg>
