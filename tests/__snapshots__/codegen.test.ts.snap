  }

  .p8-chart__tip-row {
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    white-space: nowrap;
  }

  .p8-tpl-section {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    min-width: 0;
  }

  .p8-heading--sm {
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
  }

  .p8-table {
    border-collapse: collapse;
    width: var(--p8-size-500);
    max-width: 100%;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
