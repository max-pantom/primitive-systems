exports[`codegen snapshots > avatar-group #1 → react 1`] = `
"// AvatarGroup.tsx — Requires the Primitive Systems theme variables (theme.css).
import './avatar-group.css';

export function AvatarGroup() {
  return (
    <div className="p8-avatars" role="group" aria-label="Members">
      <span className="p8-avatar p8-avatar--40" role="img" aria-label="Ada Lovelace">AL</span>
      <span className="p8-avatar p8-avatar--40 p8-avatars__item" role="img" aria-label="Alan Turing">AT</span>
      <span className="p8-avatar p8-avatar--40 p8-avatars__item" role="img" aria-label="Grace Hopper">GH</span>
      <span className="p8-avatar p8-avatar--40 p8-avatars__item" role="img" aria-label="Linus Torvalds">LT</span>
      <span className="p8-avatar p8-avatar--40 p8-avatars__item" role="img" aria-label="Margaret Hamilton">MH</span>
    </div>
  );
}

/* avatar-group.css */
.p8-avatars {
  display: inline-flex;
  align-items: center;
}

.p8-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  width: var(--p8-size-32);
  height: var(--p8-size-32);
  border-radius: var(--p8-radius-full);
  background: var(--p8-color-control-strong);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight-strong);
}

.p8-avatar--40 {
  width: var(--p8-size-40);
  height: var(--p8-size-40);
}

.p8-avatars__item {
  margin-inline-start: calc(-1 * var(--p8-space-8));
  outline: var(--p8-border-focus) solid var(--p8-color-canvas);
}
"
`;

