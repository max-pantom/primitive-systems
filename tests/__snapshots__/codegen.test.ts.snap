"// Tabs.tsx — Requires the Primitive Systems theme variables (theme.css).
import './tabs.css';

export function Tabs() {
  return (
    <div className="p8-tabs-root">
      <div className="p8-tabs" role="tablist">
        <button className="p8-tabs__tab p8-tabs__tab--active" type="button" role="tab" aria-selected="true">Overview</button>
        <button className="p8-tabs__tab" type="button" role="tab" aria-selected="false">Activity</button>
        <button className="p8-tabs__tab" type="button" role="tab" aria-selected="false">Settings</button>
      </div>
      <div className="p8-tabs__panel" role="tabpanel">Panel content.</div>
    </div>
  );
}

/* tabs.css */
.p8-tabs-root {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  font-family: var(--p8-type-family);
  color: var(--p8-color-ink);
}

.p8-tabs {
  display: flex;
  gap: var(--p8-space-12);
}

.p8-tabs__tab {
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: transparent;
  color: var(--p8-color-ink-muted);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tabs__tab:hover:not(:disabled) {
  color: var(--p8-color-ink);
}

.p8-tabs__tab:focus-visible {
  outline: var(--p8-border-focus) solid var(--p8-color-ink);
  outline-offset: var(--p8-border-focus-offset);
}

.p8-tabs__tab--active {
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
}

.p8-tabs__panel {
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}
"
`;

