<style>
  .p8-infinite {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    width: var(--p8-size-400);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-infinite__scroller {
    height: var(--p8-size-320);
    overflow-y: auto;
    border-radius: var(--p8-radius-12);
    overscroll-behavior: contain;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-infinite__scroller:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-infinite__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-infinite__item {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-infinite__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .p8-infinite__meta {
    color: var(--p8-color-ink-muted);
    white-space: nowrap;
  }

  .p8-infinite__foot {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-16);
  }

  .p8-infinite__foot[hidden] {
    display: none;
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-button--block {
    display: flex;
    width: 100%;
  }

  .p8-infinite__end {
    margin: 0;
    padding-block: var(--p8-space-12);
    text-align: center;
    color: var(--p8-color-ink-muted);
  }

  .p8-infinite__end[hidden] {
    display: none;
  }

  .p8-infinite__status {
    margin: 0;
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

