            <th style="text-align: left; padding-block: var(--p8-space-8); padding-inline: var(--p8-space-12); color: var(--p8-color-ink-muted); font-weight: var(--p8-type-weight); border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring)" scope="col">Owner</th>
