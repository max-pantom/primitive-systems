  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: var(--p8-size-16);
  height: var(--p8-size-16);
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink-inverse);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  cursor: inherit;
  &:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
