exports[`codegen snapshots > rich-text #1 → svelte 1`] = `
"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


    function rtEd(r) { return r.querySelector('[data-editor]'); }
    function rtBtns(r) { return Array.from(r.querySelectorAll('[data-cmd]')); }
    function rtSel() { var w = doc.defaultView || window; return w.getSelection ? w.getSelection() : null; }
    function rtInside(r) { var s = rtSel(); return !!(s && s.rangeCount && s.anchorNode && rtEd(r).contains(s.anchorNode)); }
    function rtQ(c) { try { return typeof doc.queryCommandState === 'function' && doc.queryCommandState(c); } catch (err) { return false; } }
    function rtBlock() { try { return typeof doc.queryCommandValue === 'function' ? String(doc.queryCommandValue('formatBlock')).toLowerCase().replace(/[<>]/g, '') : ''; } catch (err) { return ''; } }
    function rtAnchor(r) { var s = rtSel(), n = s && s.anchorNode; while (n && n !== rtEd(r)) { if (n.nodeName === 'A') return n; n = n.parentNode; } return null; }
    function rtState(r) {
      if (!rtInside(r)) return;
      var b = rtBlock();
      var on = { bold: rtQ('bold'), italic: rtQ('italic'), underline: rtQ('underline'), ul: rtQ('insertUnorderedList'), ol: rtQ('insertOrderedList'), h2: b === 'h2', quote: b === 'blockquote', link: !!rtAnchor(r) };
      rtBtns(r).forEach(function (x) { var c = x.getAttribute('data-cmd'); if (c in on) { x.setAttribute('aria-pressed', String(on[c])); x.classList.toggle('p8-rich__btn--on', on[c]); } });
    }
    function rtChange(r) { var ed = rtEd(r); r.dispatchEvent(new CustomEvent('p8-change', { bubbles: true, detail: { html: ed.innerHTML, text: ed.innerText || ed.textContent } })); }
    function rtRestore(r) { var s = rtSel(); if (r.__range && s && !rtInside(r)) { s.removeAllRanges(); s.addRange(r.__range); } }
    function rtEx(c, v) { return typeof doc.execCommand === 'function' ? doc.execCommand(c, false, v) : false; }
    function rtLinkOpen(r) {
      var s = rtSel(); if (s && rtInside(r)) r.__range = s.getRangeAt(0).cloneRange();
      var bar = r.querySelector('[data-linkbar]'), url = r.querySelector('[data-url]'), a = rtAnchor(r);
      bar.hidden = false; r.querySelector('[data-linkerr]').hidden = true; url.removeAttribute('aria-invalid'); url.value = a ? a.getAttribute('href') : '';
      url.focus();
    }
    function rtLinkClose(r) { r.querySelector('[data-linkbar]').hidden = true; r.querySelector('[data-linkerr]').hidden = true; rtEd(r).focus(); rtRestore(r); }
    function rtLinkApply(r) {
      var url = r.querySelector('[data-url]'), v = url.value.trim(), err = r.querySelector('[data-linkerr]');
      if (!/^(https?:\\/\\/|mailto:|\\/|#)/i.test(v)) { err.textContent = 'Enter an address that starts with https://, http://, mailto:, / or #.'; err.hidden = false; url.setAttribute('aria-invalid', 'true'); url.focus(); return; }
      err.hidden = true; url.removeAttribute('aria-invalid');
      rtEd(r).focus(); rtRestore(r);
      rtEx('createLink', v);
      Array.from(rtEd(r).querySelectorAll('a[href]')).forEach(function (a) { if (/^https?:/i.test(a.getAttribute('href'))) a.setAttribute('rel', 'noopener noreferrer'); });
      r.querySelector('[data-linkbar]').hidden = true;
      rtState(r); rtChange(r);
    }
    function rtRun(r, cmd) {
      var ed = rtEd(r);
      if (cmd === 'link') { rtLinkOpen(r); return; }
      ed.focus(); rtRestore(r);
      if (cmd === 'bold' || cmd === 'italic' || cmd === 'underline' || cmd === 'undo' || cmd === 'redo') rtEx(cmd);
      else if (cmd === 'h2') rtEx('formatBlock', rtBlock() === 'h2' ? 'p' : 'h2');
      else if (cmd === 'quote') rtEx('formatBlock', rtBlock() === 'blockquote' ? 'p' : 'blockquote');
      else if (cmd === 'ul') rtEx('insertUnorderedList');
      else if (cmd === 'ol') rtEx('insertOrderedList');
      rtState(r); rtChange(r);
      var b = r.querySelector('[data-cmd="' + cmd + '"]'); if (b) r.querySelector('[data-live]').textContent = b.getAttribute('aria-label') + (b.getAttribute('aria-pressed') === 'true' ? ' on' : ' off');
    }
    root.addEventListener('mousedown', function (e) { if (cl(e, '[data-p8~="richtext"] [data-cmd]')) e.preventDefault(); }, { signal: ac.signal });
    root.addEventListener('click', function (e) {
      var r = cl(e, '[data-p8~="richtext"]');
      if (!r) return;
      var b = cl(e, '[data-p8~="richtext"] [data-cmd]');
      if (b && !b.disabled) { rtRun(r, b.getAttribute('data-cmd')); return; }
      if (cl(e, '[data-p8~="richtext"] [data-link-apply]')) rtLinkApply(r);
      else if (cl(e, '[data-p8~="richtext"] [data-link-cancel]')) rtLinkClose(r);
    }, { signal: ac.signal });
    root.addEventListener('input', function (e) { var r = cl(e, '[data-p8~="richtext"]'); if (r && e.target.hasAttribute('data-editor')) rtChange(r); }, { signal: ac.signal });
    root.addEventListener('paste', function (e) {
      var r = cl(e, '[data-p8~="richtext"]');
      if (!r || !e.target.hasAttribute || !e.target.hasAttribute('data-editor')) return;
      e.preventDefault();
      var t = (e.clipboardData && e.clipboardData.getData('text/plain')) || '';
      if (t) { rtEx('insertText', t); rtChange(r); }
    }, { signal: ac.signal });
    root.addEventListener('keydown', function (e) {
      var r = cl(e, '[data-p8~="richtext"]');
      if (!r) return;
      var t = e.target;
      if (t.hasAttribute && t.hasAttribute('data-editor') && (e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); rtLinkOpen(r); return; }
      if (t.hasAttribute && t.hasAttribute('data-url')) {
        if (e.key === 'Enter') { e.preventDefault(); rtLinkApply(r); } else if (e.key === 'Escape') { e.preventDefault(); rtLinkClose(r); }
        return;
      }
      var btns = rtBtns(r).filter(function (x) { return !x.disabled; }), i = btns.indexOf(t);
      if (i < 0) return;
      if (e.key === 'ArrowRight') i = (i + 1) % btns.length; else if (e.key === 'ArrowLeft') i = (i - 1 + btns.length) % btns.length;
      else if (e.key === 'Home') i = 0; else if (e.key === 'End') i = btns.length - 1; else return;
      e.preventDefault();
      btns.forEach(function (x) { x.tabIndex = -1; }); btns[i].tabIndex = 0; btns[i].focus();
    }, { signal: ac.signal });
    doc.addEventListener('selectionchange', function () { all('[data-p8~="richtext"]').forEach(rtState); }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-rich" data-p8="richtext">
  <div class="p8-rich__bar" role="toolbar" aria-label="Notes formatting" aria-controls="rich-editor">
    <button class="p8-rich__btn p8-rich__btn--bold" type="button" data-cmd="bold" aria-label="Bold" aria-pressed="false" tabindex="0" disabled>B</button>
    <button class="p8-rich__btn p8-rich__btn--italic" type="button" data-cmd="italic" aria-label="Italic" aria-pressed="false" tabindex="-1" disabled>I</button>
    <button class="p8-rich__btn p8-rich__btn--underline" type="button" data-cmd="underline" aria-label="Underline" aria-pressed="false" tabindex="-1" disabled>U</button>
    <span class="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
    <button class="p8-rich__btn" type="button" data-cmd="h2" aria-label="Heading" aria-pressed="false" tabindex="-1" disabled>H</button>
    <button class="p8-rich__btn" type="button" data-cmd="quote" aria-label="Quote" aria-pressed="false" tabindex="-1" disabled>“</button>
    <span class="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
    <button class="p8-rich__btn" type="button" data-cmd="ul" aria-label="Bulleted list" aria-pressed="false" tabindex="-1" disabled>
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="3" cy="4" r="1" fill="currentColor" stroke="none" />
        <circle cx="3" cy="8" r="1" fill="currentColor" stroke="none" />
        <circle cx="3" cy="12" r="1" fill="currentColor" stroke="none" />
        <path d="M7.75 3.75H13.25M7.75 7.75H13.25M7.75 12.25H13.25" />
      </svg>
    </button>
    <button class="p8-rich__btn" type="button" data-cmd="ol" aria-label="Numbered list" aria-pressed="false" tabindex="-1" disabled>1.</button>
    <span class="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
    <button class="p8-rich__btn" type="button" data-cmd="link" aria-label="Link" aria-pressed="false" tabindex="-1" disabled>
      <svg class="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6.5 4.5L8 3A3.535 3.535 0 0 1 13 8L11.5 9.5M4.5 6.5L3 8A3.535 3.535 0 0 0 8 13L9.5 11.5" />
        <line x1="5.5" y1="10.5" x2="10.5" y2="5.5" />
      </svg>
    </button>
    <span class="p8-rich__sep" role="separator" aria-orientation="vertical"></span>
    <button class="p8-rich__btn" type="button" data-cmd="undo" aria-label="Undo" aria-pressed="false" tabindex="-1" disabled>Undo</button>
    <button class="p8-rich__btn" type="button" data-cmd="redo" aria-label="Redo" aria-pressed="false" tabindex="-1" disabled>Redo</button>
  </div>
  <div class="p8-rich__link" data-linkbar role="group" aria-label="Add link" hidden>
    <input class="p8-input p8-rich__link-field" type="url" placeholder="https://" aria-label="Link address" data-url />
    <button class="p8-rich__btn" type="button" data-link-apply>Apply</button>
    <button class="p8-rich__btn" type="button" data-link-cancel>Cancel</button>
    <p class="p8-rich__error" role="alert" data-linkerr hidden></p>
  </div>
  <div class="p8-rich__editor p8-rich__editor--h12" id="rich-editor" role="textbox" aria-multiline="true" aria-label="Notes" data-placeholder="Start writing…" tabindex="0" contenteditable="false" data-editor aria-readonly="true">
    <p>Write something worth reading.</p>
    <p>Select some text to format it.</p>
  </div>
  <p class="p8-rich__sr" role="status" aria-live="polite" data-live></p>
</div>

<style>
  .p8-rich {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-rich__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
  }

  .p8-rich__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--p8-size-32);
    height: var(--p8-size-32);
    box-sizing: border-box;
    padding-inline: var(--p8-space-12);
    padding-block: 0;
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink-muted);
    cursor: pointer;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease), color var(--p8-motion-fast) var(--p8-motion-ease);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-rich__btn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
  }

  .p8-rich__btn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-rich__btn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-rich__btn--bold {
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-rich__btn--italic {
    font-style: italic;
  }

  .p8-rich__btn--underline {
    text-decoration: underline;
  }

  .p8-rich__sep {
    width: 0;
    height: var(--p8-size-16);
    margin-inline: var(--p8-space-4);
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-rich__link {
    position: absolute;
    top: var(--p8-size-40);
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-canvas);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-rich__link[hidden] {
    display: none;
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-rich__link-field {
    flex: 1 1 auto;
    min-width: var(--p8-size-160);
  }

  .p8-rich__error {
    margin: 0;
    flex-basis: 100%;
    color: var(--p8-color-ink);
    font-weight: var(--p8-type-weight);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
  }

  .p8-rich__error[hidden] {
    display: none;
  }

  .p8-rich__editor {
    box-sizing: border-box;
    overflow-y: auto;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    outline: none;
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-rich__editor:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-rich__editor:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-rich__editor:empty::before {
    content: attr(data-placeholder);
    color: var(--p8-color-placeholder);
    pointer-events: none;
  }

  .p8-rich__editor h2 {
    margin: 0 0 var(--p8-space-8);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-rich__editor p {
    margin: 0 0 var(--p8-space-8);
  }

  .p8-rich__editor blockquote {
    margin: 0 0 var(--p8-space-8);
    padding-inline-start: var(--p8-space-12);
    border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
    color: var(--p8-color-ink-muted);
  }

  .p8-rich__editor ul {
    margin: 0 0 var(--p8-space-8);
    padding-inline-start: var(--p8-space-24);
  }

  .p8-rich__editor ol {
    margin: 0 0 var(--p8-space-8);
    padding-inline-start: var(--p8-space-24);
  }

  .p8-rich__editor a {
    color: var(--p8-color-ink);
    text-decoration: underline;
  }

  .p8-rich__editor > :last-child {
    margin-bottom: 0;
  }

  .p8-rich__editor--h12 {
    min-height: var(--p8-size-240);
  }

  .p8-rich__sr {
    position: absolute;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
"
`;

