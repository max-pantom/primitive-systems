exports[`codegen snapshots > form #0 → svelte 1`] = `
"<script>
  import { onMount } from 'svelte';
  let el;
  onMount(() => initP8(el));
  function initP8(root, opts) {
    opts = opts || {};
    var ac = new AbortController(), timers = [];
    var doc = root.ownerDocument || root;
    function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
    var PAIRS = [["p8-check__box","--on"],["p8-check__icon","--on"]];
    function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

    var frmEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;
    function frmValue(el) { return el.getAttribute('role') === 'checkbox' ? el.getAttribute('aria-checked') === 'true' : el.value; }
    function frmCheck(el) {
      var label = el.getAttribute('data-field') || 'This field', v = frmValue(el), type = el.getAttribute('type'), min = Number(el.getAttribute('data-min')) || 0;
      var empty = v === false || (typeof v === 'string' && !v.trim());
      if (el.hasAttribute('required') && empty) return el.getAttribute('role') === 'checkbox' ? 'You must accept: ' + label : label + ' is required';
      if (empty) return '';
      if (type === 'email' && !frmEmail.test(v)) return 'Enter a valid email address';
      if (type === 'url') { try { new URL(v); } catch (err) { return 'Enter a full URL, like https://example.com'; } }
      if (type === 'number' && isNaN(Number(v))) return 'Enter a number';
      if (type === 'tel' && !/^[+\\d][\\d\\s().-]{5,}$/.test(v)) return 'Enter a valid phone number';
      if (min && typeof v === 'string' && v.length < min) return label + ' must be at least ' + min + ' characters';
      return '';
    }
    function frmShow(el, msg) {
      var err = el.id ? el.closest('form').querySelector('#' + el.id + '-error') : null;
      if (err) err.textContent = msg;
      if (msg) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
    }
    function frmFields(f) { return Array.from(f.querySelectorAll('[data-field]')); }
    function frmStatus(f, msg) { f.querySelector('[data-status]').textContent = msg; }
    root.addEventListener('submit', function (e) {
      var f = cl(e, '[data-p8~="form"]');
      if (!f) return;
      e.preventDefault();
      f.__tried = true;
      var bad = frmFields(f).filter(function (el) { var m = frmCheck(el); frmShow(el, m); return !!m; });
      if (bad.length) { frmStatus(f, bad.length + (bad.length === 1 ? ' field needs' : ' fields need') + ' attention'); bad[0].focus(); return; }
      var values = {};
      frmFields(f).forEach(function (el) { values[el.getAttribute('name') || el.id] = frmValue(el); });
      var btn = f.querySelector('[data-submit]');
      function done(r) {
        r = r || { ok: true };
        btn.disabled = false; btn.removeAttribute('aria-busy');
        if (r.errors) {
          var first = null;
          Object.keys(r.errors).forEach(function (k) { var el = f.querySelector('[name="' + k + '"]'); if (el) { frmShow(el, r.errors[k]); first = first || el; } });
          frmStatus(f, 'Could not save: fix the highlighted fields');
          if (first) first.focus();
        } else if (r.ok !== false) frmStatus(f, r.message || f.getAttribute('data-success') || 'Saved.');
        else frmStatus(f, r.message || 'Could not save.');
      }
      var ev = new CustomEvent('p8-submit', { bubbles: true, cancelable: true, detail: { values: values, done: done } });
      var handled = !f.dispatchEvent(ev);
      if (handled) { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); frmStatus(f, 'Saving…'); } else done({ ok: true });
    }, { signal: ac.signal });
    function frmLive(e) {
      var f = cl(e, '[data-p8~="form"]');
      if (!f || !f.__tried || !e.target.hasAttribute || !e.target.hasAttribute('data-field')) return;
      frmShow(e.target, frmCheck(e.target));
    }
    root.addEventListener('input', frmLive, { signal: ac.signal });
    root.addEventListener('change', frmLive, { signal: ac.signal });
    root.addEventListener('click', function (e) { var cb = cl(e, '[data-p8~="form"] [role="checkbox"][data-field]'); if (cb) setTimeout(function () { frmLive({ target: cb }); }, 0); }, { signal: ac.signal });

    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="action"] [data-action]');
      if (!b || b.disabled) return;
      b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
    }, { signal: ac.signal });

    root.addEventListener('click', function (e) {
      var b = cl(e, '[data-p8~="toggle"] [role="checkbox"], [data-p8~="toggle"] [role="switch"]');
      if (!b || b.disabled) return;
      var on = b.getAttribute('aria-checked') !== 'true';
      b.setAttribute('aria-checked', String(on));
      [b].concat(Array.from(b.querySelectorAll('*'))).forEach(function (el) { setOn(el, on); });
    }, { signal: ac.signal });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<form bind:this={el} class="p8-form" novalidate aria-label="Form" data-p8="form action" data-success="Account created.">
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-full-name">Full name</label>
    <input class="p8-input p8-form__control" id="form-full-name" name="full-name" aria-describedby="form-full-name-error" data-field="Full name" required aria-required="true" type="text" autocomplete="name" />
    <p class="p8-form__error" id="form-full-name-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-work-email">Work email</label>
    <input class="p8-input p8-form__control" id="form-work-email" name="work-email" aria-describedby="form-work-email-error" data-field="Work email" required aria-required="true" type="email" autocomplete="email" />
    <p class="p8-form__error" id="form-work-email-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-password">Password</label>
    <input class="p8-input p8-form__control" id="form-password" name="password" aria-describedby="form-password-error" data-field="Password" required aria-required="true" data-min="8" type="password" autocomplete="new-password" />
    <p class="p8-form__error" id="form-password-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-role">
      Role
      <span class="p8-form__optional"> (optional)</span>
    </label>
    <div class="p8-select">
      <select class="p8-select__control p8-form__control" id="form-role" name="role" aria-describedby="form-role-error" data-field="Role">
        <option value="Designer" selected>Designer</option>
        <option value="Engineer">Engineer</option>
        <option value="Manager">Manager</option>
      </select>
      <svg class="p8-icon p8-select__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6L8 10L12 6" />
      </svg>
    </div>
    <p class="p8-form__error" id="form-role-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-field__label" for="form-about-you">
      About you
      <span class="p8-form__optional"> (optional)</span>
    </label>
    <textarea class="p8-input p8-form__control" id="form-about-you" name="about-you" aria-describedby="form-about-you-error" data-field="About you" rows="3"></textarea>
    <p class="p8-form__error" id="form-about-you-error" data-error></p>
  </div>
  <div class="p8-form__field">
    <label class="p8-check" data-p8="toggle">
      <button class="p8-check__box p8-form__control" type="button" role="checkbox" aria-checked="false" id="form-i-agree-to-the-terms" name="i-agree-to-the-terms" aria-describedby="form-i-agree-to-the-terms-error" data-field="I agree to the terms" required aria-required="true">
        <svg class="p8-icon p8-check__icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
      I agree to the terms
    </label>
    <p class="p8-form__error" id="form-i-agree-to-the-terms-error" data-error></p>
  </div>
  <div class="p8-form__actions">
    <button class="p8-button p8-button--primary" type="submit" data-submit>Create account</button>
  </div>
  <p class="p8-form__status" role="status" data-status></p>
</form>

<style>
  .p8-form {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    margin: 0;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
  }

  .p8-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    min-width: 0;
  }

  .p8-field__label {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
    color: var(--p8-color-ink);
  }

  .p8-input {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
  }

  .p8-input:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-input:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-input:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-form__control[aria-invalid="true"] {
    outline: var(--p8-border-hairline) solid var(--p8-color-ink);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-form__error {
    margin: 0;
    min-height: var(--p8-type-line-sm);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-form__optional {
    color: var(--p8-color-ink-muted);
    font-weight: var(--p8-type-weight);
  }

  .p8-select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .p8-select__control {
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    width: 100%;
    appearance: none;
    padding-inline-end: var(--p8-space-32);
    cursor: pointer;
  }

  .p8-select__control:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:focus-visible {
    background: var(--p8-color-control-strong);
  }

  .p8-select__control:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-select__icon {
    position: absolute;
    inset-inline-end: var(--p8-space-12);
    pointer-events: none;
    color: var(--p8-color-ink);
  }

  .p8-check {
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--p8-space-8);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-check__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    padding: 0;
    box-sizing: border-box;
    border-radius: var(--p8-radius-8);
    border: none;
