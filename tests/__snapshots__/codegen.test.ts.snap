"// Popover.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './popover.css';

export function Popover() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <span ref={ref} className="p8-popover" data-p8="popover">
      <button className="p8-button" type="button" data-trigger aria-expanded="true" aria-haspopup="dialog">Open</button>
      <div className="p8-popover__panel" data-panel>Popover content.</div>
    </span>
  );
}

/* popover.css */
.p8-popover {
  position: relative;
  display: inline-block;
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-popover__panel {
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: var(--p8-space-8);
  z-index: 40;
  box-sizing: border-box;
  min-width: var(--p8-size-240);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-popover__panel[hidden] {
  display: none;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function pSet(p, open) {
    var panel = p.querySelector('[data-panel]'), tr = p.querySelector('[data-trigger]');
    panel.hidden = !open;
    tr.setAttribute('aria-expanded', String(open));
    if (open) { var f = panel.querySelector('[role="menuitem"], button, input, [tabindex]'); if (f) f.focus(); }
  }
  function pAll() { return all('[data-p8~="popover"]'); }
  root.addEventListener('click', function (e) {
    var tr = cl(e, '[data-trigger]');
    var p = tr && tr.closest('[data-p8~="popover"]');
    if (p) { pSet(p, p.querySelector('[data-panel]').hidden); return; }
    var item = cl(e, '[data-select-closes] [role="menuitem"]');
    if (item) { var host = item.closest('[data-p8~="popover"]'); pSet(host, false); host.querySelector('[data-trigger]').focus(); }
  }, { signal: ac.signal });
  doc.addEventListener('click', function (e) {
    pAll().forEach(function (p) { if (!p.contains(e.target)) pSet(p, false); });
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    pAll().forEach(function (p) { if (!p.querySelector('[data-panel]').hidden) { pSet(p, false); p.querySelector('[data-trigger]').focus(); } });
  }, { signal: ac.signal });
  root.addEventListener('p8-close', function (e) {
    var p = cl(e, '[data-p8~="popover"]');
    if (p) { pSet(p, false); p.querySelector('[data-trigger]').focus(); }
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
