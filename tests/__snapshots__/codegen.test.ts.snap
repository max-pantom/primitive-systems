<style>
  .p8-mcal {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-mcal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-mcal__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-mcal__nav {
    display: flex;
    align-items: center;
    gap: var(--p8-space-4);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-mcal__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-radius: var(--p8-radius-12);
    overflow: hidden;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-mcal__dow {
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-8);
    color: var(--p8-color-ink-muted);
    text-align: left;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-mcal__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--p8-space-4);
    min-width: 0;
    height: var(--p8-size-72);
    padding: var(--p8-space-4);
    border: none;
    border-radius: 0;
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
    border-inline-end: var(--p8-border-hairline) solid var(--p8-color-ring);
    transition: background var(--p8-motion-fast) var(--p8-motion-ease);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-mcal__cell:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-mcal__cell:focus-visible {
    box-shadow: inset 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
    outline: none;
  }

  .p8-mcal__cell--out {
    color: var(--p8-color-ink-muted);
  }

  .p8-mcal__num {
    padding-inline: var(--p8-space-4);
  }

  .p8-mcal__num[data-today] {
    align-self: flex-start;
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-mcal__event {
    padding-inline: var(--p8-space-4);
    border-radius: var(--p8-radius-4);
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .p8-mcal__cell--on {
    background: var(--p8-color-control-strong);
  }

  .p8-mcal__cell--on:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-mcal__more {
    padding-inline: var(--p8-space-4);
    color: var(--p8-color-ink-muted);
    white-space: nowrap;
  }

  .p8-mcal__agenda {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    height: var(--p8-size-72);
    overflow-y: auto;
  }

  .p8-mcal__agenda-head {
    margin: 0;
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-mcal__agenda-list {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

