                <circle cx="2.5" cy="3" r="1" fill="currentColor" stroke="none" />
                <circle cx="2.5" cy="7" r="1" fill="currentColor" stroke="none" />
                <circle cx="2.5" cy="11" r="1" fill="currentColor" stroke="none" />
