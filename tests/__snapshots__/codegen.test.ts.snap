`;

exports[`codegen snapshots > context-menu #0 → astro 1`] = `
"---
// Requires the Primitive Systems theme variables (theme.css).
---

<div class="p8-context" data-p8="context">
  <div class="p8-context__area" data-area tabindex="0" aria-haspopup="menu" aria-expanded="true">Right-click here</div>
  <div class="p8-context__panel" data-panel>
    <div class="p8-menu" role="menu" data-p8="menu">
      <button class="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘C">
        Copy
        <span class="p8-menu__shortcut" aria-hidden="true">⌘C</span>
      </button>
      <button class="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌘V">
        Paste
        <span class="p8-menu__shortcut" aria-hidden="true">⌘V</span>
      </button>
      <div class="p8-divider" role="separator" aria-orientation="horizontal"></div>
      <button class="p8-menu__item" type="button" role="menuitem" aria-keyshortcuts="⌫">
        Delete
        <span class="p8-menu__shortcut" aria-hidden="true">⌫</span>
      </button>
    </div>
  </div>
</div>

<style>
  .p8-context {
    position: relative;
    display: inline-block;
    width: var(--p8-size-400);
    max-width: 100%;
  }

  .p8-context__area {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: var(--p8-size-160);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink-muted);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-context__area:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-context__panel {
    position: absolute;
    left: var(--p8-space-24);
    top: var(--p8-space-24);
    z-index: 40;
  }

  .p8-context__panel[hidden] {
    display: none;
  }

  .p8-menu {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    padding: var(--p8-space-4);
    min-width: var(--p8-size-240);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    border-radius: var(--p8-radius-12);
    font-family: var(--p8-type-family);
  }

  .p8-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    text-align: left;
    width: 100%;
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-6);
    border-radius: var(--p8-radius-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-menu__item:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-menu__item:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-menu__shortcut {
    color: var(--p8-color-ink-muted);
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
  }

  .p8-divider {
    flex-shrink: 0;
    width: var(--p8-size-400);
    max-width: 100%;
    height: 0;
    border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
  }
</style>

<script>
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-menu__item","--active"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  function xPanel(c) { return c.querySelector('[data-panel]'); }
  function xClose(c) { xPanel(c).hidden = true; c.querySelector('[data-area]').setAttribute('aria-expanded', 'false'); }
  function xOpen(c, x, y) {
    var p = xPanel(c), r = c.getBoundingClientRect();
    p.style.left = (x - r.left) + 'px'; p.style.top = (y - r.top) + 'px'; p.hidden = false; c.querySelector('[data-area]').setAttribute('aria-expanded', 'true');
    var f = p.querySelector('[role="menuitem"]'); if (f) f.focus();
  }
  root.addEventListener('contextmenu', function (e) {
    var a = cl(e, '[data-p8~="context"] [data-area]');
    if (!a) return;
    e.preventDefault();
    xOpen(a.closest('[data-p8~="context"]'), e.clientX, e.clientY);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var a = cl(e, '[data-p8~="context"] [data-area]');
    if (!a || !(e.key === 'ContextMenu' || (e.shiftKey && e.key === 'F10'))) return;
    e.preventDefault();
    var r = a.getBoundingClientRect();
    xOpen(a.closest('[data-p8~="context"]'), r.left + r.width / 2, r.top + r.height / 2);
  }, { signal: ac.signal });
  root.addEventListener('p8-close', function (e) {
    var c = cl(e, '[data-p8~="context"]');
    if (c) { xClose(c); c.querySelector('[data-area]').focus(); }
  }, { signal: ac.signal });
  root.addEventListener('click', function (e) {
    var item = cl(e, '[data-p8~="context"] [role="menuitem"]');
    if (item) xClose(item.closest('[data-p8~="context"]'));
  }, { signal: ac.signal });
  doc.addEventListener('click', function (e) { all('[data-p8~="context"]').forEach(function (c) { if (!c.contains(e.target)) xClose(c); }); }, { signal: ac.signal });

  function mItems(m) { return Array.from(m.querySelectorAll('[role="menuitem"]')).filter(function (x) { return !x.disabled; }); }
  function mMark(m, it) { mItems(m).forEach(function (x) { setOn(x, x === it); }); }
  root.addEventListener('click', function (e) {
    var it = cl(e, '[data-p8~="menu"] [role="menuitem"]');
    if (it) mMark(it.closest('[data-p8~="menu"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('focusin', function (e) {
    var it = cl(e, '[data-p8~="menu"] [role="menuitem"]');
    if (it) mMark(it.closest('[data-p8~="menu"]'), it);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var m = cl(e, '[data-p8~="menu"]');
    if (!m) return;
    if (e.key === 'Escape') { m.dispatchEvent(new CustomEvent('p8-close', { bubbles: true })); return; }
    var list = mItems(m), i = list.indexOf(cl(e, '[role="menuitem"]')), k = e.key;
    if (k === 'ArrowDown') i = (i + 1) % list.length;
