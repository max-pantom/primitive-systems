}

.p8-code__pre:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-code__tok-t {
  color: var(--p8-color-syntax-1);
}

.p8-code__tok-a {
  color: var(--p8-color-syntax-2);
}

.p8-code__tok-p {
  color: var(--p8-color-syntax-4);
}

.p8-code__tok-s {
