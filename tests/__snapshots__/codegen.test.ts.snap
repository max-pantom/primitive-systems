"// CodeBlock.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './code-block.css';

export function CodeBlock() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-code">
