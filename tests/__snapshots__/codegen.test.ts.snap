      <select class="p8-select__control p8-form__control" id="form-role" name="role" aria-describedby="form-role-error" data-field="Role" disabled>
        <option value="Designer" selected>Designer</option>
        <option value="Engineer">Engineer</option>
        <option value="Manager">Manager</option>
      </select>
      <svg class="p8-icon p8-select__icon p8-select__icon--disabled" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 6L8 10L12 6" />
