    </div>
  );
}

/* code-block.css */
.p8-code {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  width: var(--p8-size-500);
  max-width: 100%;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-syntax-1);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-code__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
}

.p8-code__lang {
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-mono);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  letter-spacing: var(--p8-type-tracking-mono);
}

.p8-copybtn {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-copybtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-copybtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-copybtn--ghost {
  background: transparent;
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-copybtn--ghost:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-copybtn__icon {
  display: none;
}

.p8-copybtn__icon--on {
  display: block;
}

.p8-code__pre {
  margin: 0;
  overflow: auto;
  font-family: var(--p8-type-mono);
  letter-spacing: var(--p8-type-tracking-mono);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  color: var(--p8-color-syntax-1);
  scrollbar-width: thin;
}

.p8-code__pre:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-code__tok-t {
  color: var(--p8-color-syntax-1);
}

.p8-code__tok-a {
  color: var(--p8-color-syntax-2);
}

.p8-code__tok-p {
  color: var(--p8-color-syntax-4);
}

.p8-code__tok-s {
  color: var(--p8-color-syntax-3);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }
  var PAIRS = [["p8-copybtn__icon","--on"]];
  function setOn(el, on) { PAIRS.forEach(function (p) { if (el.classList && el.classList.contains(p[0])) el.classList.toggle(p[0] + p[1], on); }); }

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="copy"]');
    if (!b) return;
    var text = b.getAttribute('data-copy') || '';
    if (doc.defaultView && doc.defaultView.navigator && doc.defaultView.navigator.clipboard) doc.defaultView.navigator.clipboard.writeText(text);
    var icons = Array.from(b.querySelectorAll('svg'));
    icons.forEach(function (i) { setOn(i, !i.classList.contains('p8-copybtn__icon--on')); });
    timers.push(setTimeout(function () { icons.forEach(function (i) { setOn(i, !i.classList.contains('p8-copybtn__icon--on')); }); }, 1500));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
