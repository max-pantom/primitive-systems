"// OtpInput.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './otp-input.css';

export function OtpInput() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-otp" role="group" aria-label="One-time code" data-p8="otp">
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="one-time-code" aria-label="Digit 1" disabled defaultValue="S" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 2" disabled defaultValue="a" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 3" disabled defaultValue="m" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 4" disabled defaultValue="p" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 5" disabled defaultValue="l" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 6" disabled defaultValue="e" />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 7" disabled defaultValue=" " />
      <input className="p8-otp__cell" type="text" inputMode="numeric" maxLength="1" autoComplete="off" aria-label="Digit 8" disabled defaultValue="{" />
    </div>
  );
}

/* otp-input.css */
.p8-otp {
  display: inline-flex;
  gap: var(--p8-space-8);
}

.p8-otp__cell {
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-mono);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  width: var(--p8-size-40);
  text-align: center;
  letter-spacing: normal;
}

.p8-otp__cell:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-otp__cell:focus-visible {
  background: var(--p8-color-control-strong);
}

.p8-otp__cell:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function oCells(g) { return Array.from(g.querySelectorAll('input')); }
  root.addEventListener('input', function (e) {
    var g = cl(e, '[data-p8~="otp"]');
    if (!g) return;
    var t = e.target, cells = oCells(g);
    t.value = t.value.replace(/D/g, '').slice(-1);
    var i = cells.indexOf(t);
    if (t.value && cells[i + 1]) cells[i + 1].focus();
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var g = cl(e, '[data-p8~="otp"]');
    if (!g) return;
    var cells = oCells(g), i = cells.indexOf(e.target);
    if (e.key === 'Backspace' && !e.target.value && cells[i - 1]) { cells[i - 1].value = ''; cells[i - 1].focus(); e.preventDefault(); }
    else if (e.key === 'ArrowLeft' && cells[i - 1]) { cells[i - 1].focus(); e.preventDefault(); }
    else if (e.key === 'ArrowRight' && cells[i + 1]) { cells[i + 1].focus(); e.preventDefault(); }
  }, { signal: ac.signal });
  root.addEventListener('paste', function (e) {
    var g = cl(e, '[data-p8~="otp"]');
    if (!g) return;
    var digits = ((e.clipboardData && e.clipboardData.getData('text')) || '').replace(/D/g, '');
    if (!digits) return;
    e.preventDefault();
    var cells = oCells(g), i = Math.max(0, cells.indexOf(e.target));
    for (var k = 0; k < digits.length && cells[i + k]; k++) cells[i + k].value = digits[k];
    cells[Math.min(cells.length - 1, i + digits.length)].focus();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

