"// ListDetail.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './list-detail.css';

export function ListDetail() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-tpl-master" data-p8="listdetail action">
      <div className="p8-tpl-master-list" role="group" aria-label="Items">
        <button className="p8-tpl-master-row p8-tpl-master-row--active" type="button" data-target="detail-0" aria-controls="detail-0" aria-current="true">
          <span>Order 1042</span>
          <span className="p8-tpl-master-meta">Paid</span>
        </button>
        <button className="p8-tpl-master-row" type="button" data-target="detail-1" aria-controls="detail-1">
          <span>Order 1041</span>
          <span className="p8-tpl-master-meta">Pending</span>
        </button>
        <button className="p8-tpl-master-row" type="button" data-target="detail-2" aria-controls="detail-2">
          <span>Order 1040</span>
          <span className="p8-tpl-master-meta">Refunded</span>
        </button>
      </div>
      <div className="p8-tpl-section">
        <article className="p8-tpl-master-detail" id="detail-0" data-detail aria-label="Order 1042">
          <div className="p8-heading-group">
            <h2 className="p8-heading">Order 1042</h2>
            <p className="p8-heading__desc">Paid</p>
          </div>
          <p className="p8-text">Placed on 12 Nov by Ada Lovelace. Two items, shipped to London.</p>
          <div className="p8-tpl-row">
            <button className="p8-button" type="button" data-action="Open order: Order 1042">Open order</button>
          </div>
        </article>
        <article className="p8-tpl-master-detail" id="detail-1" data-detail aria-label="Order 1041" hidden>
          <div className="p8-heading-group">
            <h2 className="p8-heading">Order 1041</h2>
            <p className="p8-heading__desc">Pending</p>
          </div>
          <p className="p8-text">Waiting for payment confirmation from the bank.</p>
          <div className="p8-tpl-row">
            <button className="p8-button" type="button" data-action="Open order: Order 1041">Open order</button>
          </div>
        </article>
        <article className="p8-tpl-master-detail" id="detail-2" data-detail aria-label="Order 1040" hidden>
          <div className="p8-heading-group">
            <h2 className="p8-heading">Order 1040</h2>
            <p className="p8-heading__desc">Refunded</p>
          </div>
          <p className="p8-text">Refunded on 9 Nov at the customer's request.</p>
          <div className="p8-tpl-row">
            <button className="p8-button" type="button" data-action="Open order: Order 1040">Open order</button>
          </div>
        </article>
      </div>
    </div>
  );
}

/* list-detail.css */
.p8-tpl-master {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--p8-size-240), 1fr));
  gap: var(--p8-space-12);
  width: 100%;
  max-width: var(--p8-size-500);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tpl-master-list {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-tpl-master-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--p8-space-4);
  width: 100%;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border: none;
  border-radius: var(--p8-radius-8);
  background: transparent;
  color: var(--p8-color-ink);
  text-align: left;
  cursor: pointer;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tpl-master-row:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-tpl-master-row:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-tpl-master-row--active {
  background: var(--p8-color-control-strong);
}

.p8-tpl-master-meta {
  color: var(--p8-color-ink-muted);
}

.p8-tpl-section {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  min-width: 0;
}

.p8-tpl-master-detail {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-tpl-master-detail[hidden] {
  display: none;
}

.p8-heading-group {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-heading {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-heading__desc {
  margin: 0;
  color: var(--p8-color-ink-muted);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-text {
  margin: 0;
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-tpl-row {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  flex-wrap: wrap;
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  function ldSelect(c, row) {
    Array.from(c.querySelectorAll('[data-target]')).forEach(function (x) {
      var on = x === row;
      if (on) x.setAttribute('aria-current', 'true'); else x.removeAttribute('aria-current');
      x.classList.toggle('p8-tpl-master-row--active', on); x.tabIndex = on ? 0 : -1;
    });
    Array.from(c.querySelectorAll('[data-detail]')).forEach(function (d) { d.hidden = d.id !== row.getAttribute('data-target'); });
    c.dispatchEvent(new CustomEvent('p8-select', { bubbles: true, detail: { id: row.getAttribute('data-target'), title: row.firstElementChild.textContent.trim() } }));
  }
  root.addEventListener('click', function (e) {
    var row = cl(e, '[data-p8~="listdetail"] [data-target]');
    if (row) ldSelect(row.closest('[data-p8~="listdetail"]'), row);
  }, { signal: ac.signal });
  root.addEventListener('keydown', function (e) {
    var row = cl(e, '[data-p8~="listdetail"] [data-target]');
    if (!row) return;
    var c = row.closest('[data-p8~="listdetail"]'), rows = Array.from(c.querySelectorAll('[data-target]')), i = rows.indexOf(row), k = e.key;
    if (k === 'ArrowDown') i = Math.min(rows.length - 1, i + 1); else if (k === 'ArrowUp') i = Math.max(0, i - 1);
    else if (k === 'Home') i = 0; else if (k === 'End') i = rows.length - 1; else return;
    e.preventDefault();
    rows[i].focus(); ldSelect(c, rows[i]);
  }, { signal: ac.signal });

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="action"] [data-action]');
    if (!b || b.disabled) return;
    b.dispatchEvent(new CustomEvent('p8-action', { bubbles: true, detail: { action: b.getAttribute('data-action') } }));
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
