"---
// Requires the Primitive Systems theme variables (theme.css).
---

<dl class="p8-datalist">
  <div class="p8-datalist__row">
    <dt class="p8-datalist__term">Status</dt>
    <dd class="p8-datalist__def">Active</dd>
  </div>
  <div class="p8-datalist__row">
    <dt class="p8-datalist__term">Owner</dt>
    <dd class="p8-datalist__def">Primitive 8</dd>
  </div>
  <div class="p8-datalist__row">
    <dt class="p8-datalist__term">Updated</dt>
    <dd class="p8-datalist__def">Today</dd>
  </div>
</dl>

<style>
  .p8-datalist {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    min-width: var(--p8-size-320);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    color: var(--p8-color-ink);
  }

  .p8-datalist__row {
    display: flex;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-datalist__term {
    margin: 0;
    color: var(--p8-color-ink-muted);
  }

  .p8-datalist__def {
    margin: 0;
    text-align: right;
  }
</style>
