"// Toast.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './toast.css';

export function Toast() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-toast-stack" data-p8="toast" role="region" aria-label="Notifications">
      <div className="p8-toast" role="status" data-duration="4000">
        <span className="p8-toast__message">Changes saved.</span>
        <button className="p8-toast__close" type="button" aria-label="Dismiss" data-close>
          <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <line x1="4" y1="4" x2="12" y2="12" />
            <line x1="12" y1="4" x2="4" y2="12" />
          </svg>
        </button>
      </div>
    </div>
  );
}

/* toast.css */
.p8-toast-stack {
  position: fixed;
  right: var(--p8-space-24);
  bottom: var(--p8-space-24);
  z-index: 60;
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-8);
}

.p8-toast {
  display: flex;
  align-items: center;
  gap: var(--p8-space-12);
  box-sizing: border-box;
  min-width: var(--p8-size-320);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  border-radius: var(--p8-radius-8);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-toast__message {
  flex: 1;
}

.p8-toast__close {
  display: inline-flex;
  border: none;
  background: transparent;
  color: inherit;
  padding: 0;
  cursor: pointer;
}

.p8-toast__close:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-icon {
  flex-shrink: 0;
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  all('[data-p8~="toast"] [data-duration]').forEach(function (t) {
    var d = Number(t.getAttribute('data-duration'));
    if (d > 0 && !opts.noTimers) timers.push(setTimeout(function () { t.remove(); }, d));
  });
  root.addEventListener('click', function (e) {
    var c = cl(e, '[data-p8~="toast"] [data-close]');
    if (c) c.closest('[data-duration]').remove();
  }, { signal: ac.signal });
  return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
}
"
`;

