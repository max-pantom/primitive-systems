  .p8-cal__day--on:hover:not(:disabled) {
    background: var(--p8-color-ink);
  }

  .p8-cal__day--active {
    background: var(--p8-color-control-strong);
    color: var(--p8-color-ink);
  }

  .p8-cal__day--active:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }
</style>
"
