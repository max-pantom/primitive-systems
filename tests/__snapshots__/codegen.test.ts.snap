      <p class="p8-chart__sr" aria-live="polite" data-live></p>
      <template data-row>
        <div class="p8-chart__tip-row">
          <span class="p8-chart__swatch"></span>
          <span></span>
        </div>
      </template>
      <table class="p8-chart__sr">
        <caption>Revenue vs costs</caption>
        <thead>
          <tr>
            <th scope="col"></th>
            <th scope="col">Revenue</th>
            <th scope="col">Costs</th>
