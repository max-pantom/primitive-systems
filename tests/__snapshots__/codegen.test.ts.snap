    function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


    function ntSync(w) {
      var n = w.querySelectorAll('[data-unread="true"]').length;
      w.querySelector('[data-count]').textContent = n ? n + ' unread' : 'All caught up';
      w.querySelector('[data-all]').disabled = !n;
      return n;
    }
    root.addEventListener('click', function (e) {
      var w = cl(e, '[data-p8~="notify"]');
      if (!w) return;
      var one = cl(e, '[data-read]'), allB = cl(e, '[data-all]');
      if (one) {
        var li = one.closest('[data-unread]');
        li.setAttribute('data-unread', 'false'); one.disabled = true;
        var left = ntSync(w), next = w.querySelector('[data-unread="true"] [data-read]');
        (next || (left ? w.querySelector('[data-all]') : w)).focus();
        w.dispatchEvent(new CustomEvent('p8-read', { bubbles: true, detail: { index: Number(li.getAttribute('data-index')) } }));
        return;
      }
      if (allB && !allB.disabled) {
        Array.from(w.querySelectorAll('[data-unread="true"]')).forEach(function (li) { li.setAttribute('data-unread', 'false'); li.querySelector('[data-read]').disabled = true; });
        ntSync(w); w.focus();
        w.dispatchEvent(new CustomEvent('p8-read', { bubbles: true, detail: { all: true } }));
      }
    }, { signal: ac.signal });
    all('[data-p8~="notify"]').forEach(function (w) { Array.from(w.querySelectorAll('[data-unread="false"] [data-read]')).forEach(function (b) { b.disabled = true; }); });
    return function () { ac.abort(); timers.forEach(function (x) { clearTimeout(x); clearInterval(x); }); };
  }
</script>

<!-- Requires the Primitive Systems theme variables (theme.css). -->
<section bind:this={el} class="p8-notify" aria-label="Notifications" tabindex="-1" data-p8="notify">
  <div class="p8-notify__head">
    <div class="p8-notify__heading">
      <h2 class="p8-notify__title">Notifications</h2>
      <span class="p8-notify__count" aria-live="polite" data-count>2 unread</span>
    </div>
    <button class="p8-button p8-button--ghost" type="button" data-all>Mark all read</button>
  </div>
  <ul class="p8-notify__list">
    <li class="p8-notify__item" data-unread="true" data-index="0">
      <span class="p8-notify__dot" role="img" aria-label="Unread"></span>
      <div class="p8-notify__body">
        <span class="p8-notify__name">New comment</span>
        <span class="p8-notify__detail">Ada replied to your design review</span>
      </div>
      <span class="p8-notify__time">2m</span>
      <button class="p8-iconbtn p8-iconbtn--flat p8-notify__read" type="button" aria-label="Mark &quot;New comment&quot; as read" data-read>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
    </li>
    <li class="p8-notify__item" data-unread="true" data-index="1">
      <span class="p8-notify__dot" role="img" aria-label="Unread"></span>
      <div class="p8-notify__body">
        <span class="p8-notify__name">Build passed</span>
        <span class="p8-notify__detail">main was deployed to production</span>
      </div>
      <span class="p8-notify__time">1h</span>
      <button class="p8-iconbtn p8-iconbtn--flat p8-notify__read" type="button" aria-label="Mark &quot;Build passed&quot; as read" data-read>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
    </li>
    <li class="p8-notify__item" data-unread="false" data-index="2">
      <span class="p8-notify__dot" role="img" aria-label="Unread"></span>
      <div class="p8-notify__body">
        <span class="p8-notify__name">Invite accepted</span>
        <span class="p8-notify__detail">Grace joined the workspace</span>
      </div>
      <span class="p8-notify__time">Yesterday</span>
      <button class="p8-iconbtn p8-iconbtn--flat p8-notify__read" type="button" aria-label="Mark &quot;Invite accepted&quot; as read" data-read>
        <svg class="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2.5 7L5.5 10L11.5 4" />
        </svg>
      </button>
    </li>
  </ul>
</section>

<style>
  .p8-notify {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-12);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-notify:focus-visible {
    outline: none;
  }

  .p8-notify__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-notify__heading {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-notify__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-notify__count {
    color: var(--p8-color-ink-muted);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--ghost {
    background: transparent;
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-button--ghost:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-notify__list {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p8-notify__item {
    display: flex;
    align-items: flex-start;
    gap: var(--p8-space-12);
    padding-block: var(--p8-space-8);
    border-radius: var(--p8-radius-8);
  }

  .p8-notify__item[data-unread="false"] .p8-notify__dot {
    visibility: hidden;
  }

  .p8-notify__item[data-unread="false"] .p8-notify__read {
    visibility: hidden;
  }

  .p8-notify__item[data-unread="false"] .p8-notify__name {
    font-weight: var(--p8-type-weight);
  }

  .p8-notify__dot {
    flex-shrink: 0;
    width: var(--p8-space-8);
    height: var(--p8-space-8);
    margin-top: var(--p8-space-4);
    border-radius: var(--p8-radius-full);
    background: var(--p8-color-ink);
  }

  .p8-notify__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-notify__name {
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-notify__detail {
    color: var(--p8-color-ink-muted);
  }

  .p8-notify__time {
    color: var(--p8-color-ink-muted);
    white-space: nowrap;
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-icon {
    flex-shrink: 0;
  }
</style>
"
`;

