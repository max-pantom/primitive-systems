            <td>140</td>
            <td>100</td>
          </tr>
          <tr>
            <th scope="row">May</th>
            <td>190</td>
            <td>120</td>
          </tr>
          <tr>
            <th scope="row">Jun</th>
            <td>230</td>
            <td>130</td>
          </tr>
        </tbody>
      </table>
    </figure>
  </div>
  <section class="p8-tpl-section">
    <h2 class="p8-heading p8-heading--sm">Recent activity</h2>
    <div class="p8-tpl-wide">
      <table class="p8-table">
        <thead>
          <tr>
            <th class="p8-table__head" scope="col">Event</th>
            <th class="p8-table__head" scope="col">Owner</th>
            <th class="p8-table__head" scope="col">When</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p8-table__cell">Invoice 1042 paid</td>
            <td class="p8-table__cell">Ada</td>
            <td class="p8-table__cell">2 min ago</td>
          </tr>
          <tr>
            <td class="p8-table__cell">New signup</td>
            <td class="p8-table__cell">Alan</td>
            <td class="p8-table__cell">1 hour ago</td>
          </tr>
          <tr>
            <td class="p8-table__cell">Plan upgraded</td>
            <td class="p8-table__cell">Grace</td>
            <td class="p8-table__cell">Yesterday</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

<style>
  .p8-tpl-page {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    box-sizing: border-box;
    width: 100%;
    max-width: var(--p8-size-500);
    color: var(--p8-color-ink);
  }

  .p8-tpl-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-heading {
    margin: 0;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-tpl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--p8-size-160), 1fr));
    gap: var(--p8-space-12);
  }

  .p8-stat {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
    box-sizing: border-box;
    min-width: var(--p8-size-240);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-surface);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-stat__label {
    color: var(--p8-color-ink-muted);
  }

  .p8-stat__value {
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-stat__change {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-4);
    color: var(--p8-color-ink-muted);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-tpl-wide {
    min-width: 0;
    overflow: auto;
  }

  .p8-chart {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-500);
    max-width: 100%;
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-chart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
  }

  .p8-chart__title {
    margin: 0;
    font-weight: var(--p8-type-weight);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
  }

  .p8-chart__legend {
    display: flex;
    gap: var(--p8-space-4);
  }

  .p8-chart__key {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-4);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-chart__key:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-chart__key:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-chart__key[aria-pressed="false"] {
    color: var(--p8-color-ink-muted);
  }

  .p8-chart__key[aria-pressed="false"] .p8-chart__swatch {
    opacity: 0.3;
  }

  .p8-chart__swatch {
    width: var(--p8-space-8);
    height: var(--p8-space-8);
    border-radius: var(--p8-radius-full);
    flex-shrink: 0;
  }

  .p8-chart__plot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--p8-space-8);
    row-gap: var(--p8-space-4);
  }

  .p8-chart__y {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: var(--p8-size-160);
    color: var(--p8-color-ink-muted);
    text-align: right;
    font-family: var(--p8-type-mono);
    letter-spacing: var(--p8-type-tracking-mono);
  }

  .p8-chart__area {
    position: relative;
    height: var(--p8-size-160);
    border-radius: var(--p8-radius-4);
    cursor: crosshair;
  }

  .p8-chart__area:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-chart__svg {
    display: block;
