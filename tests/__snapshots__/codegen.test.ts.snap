<!-- Requires the Primitive Systems theme variables (theme.css). -->
<div bind:this={el} class="p8-overlay" data-p8="overlay" data-hotkey>
  <div class="p8-palette" role="dialog" aria-label="Command palette" data-p8="palette">
    <input class="p8-palette__input" type="text" role="combobox" aria-expanded="true" placeholder="Type a command" aria-label="Command" />
    <div class="p8-palette__list" role="listbox">
      <button class="p8-palette__item p8-palette__item--active" type="button" role="option">Go to Overview</button>
      <button class="p8-palette__item" type="button" role="option">Create project</button>
      <button class="p8-palette__item" type="button" role="option">Open settings</button>
    </div>
  </div>
</div>

<style>
  .p8-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
    background: var(--p8-color-backdrop);
    box-sizing: border-box;
    padding: var(--p8-space-24);
  }

  .p8-overlay[hidden] {
    display: none;
  }

  .p8-palette {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-8);
    box-sizing: border-box;
    width: var(--p8-size-400);
    max-width: 100%;
    padding: var(--p8-space-8);
    border-radius: var(--p8-radius-12);
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    outline: var(--p8-border-hairline) solid var(--p8-color-ring);
    outline-offset: calc(-1 * var(--p8-border-hairline));
  }

  .p8-palette__input {
    box-sizing: border-box;
    width: 100%;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-palette__input:focus-visible {
    outline: none;
    background: var(--p8-color-control-strong);
  }

  .p8-palette__input::placeholder {
    color: var(--p8-color-placeholder);
  }

  .p8-palette__list {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-palette__item {
    text-align: left;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border: none;
    border-radius: var(--p8-radius-8);
    background: transparent;
    color: var(--p8-color-ink);
    cursor: pointer;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-palette__item:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-palette__item:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-palette__item--active {
    background: var(--p8-color-control-strong);
  }
</style>
"
`;

