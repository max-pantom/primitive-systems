"// AppShell.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './app-shell.css';

export function AppShell() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-shell p8-shell--framed" data-p8="shell nav action">
      <aside className="p8-shell__side" aria-label="Sidebar">
        <div className="p8-shell__side-head">
          <span className="p8-shell__brand">
            <span className="p8-shell__logo" aria-hidden="true"></span>
            Acme
          </span>
          <button className="p8-iconbtn p8-iconbtn--flat p8-shell__toggle" type="button" aria-label="Collapse sidebar" aria-expanded="true" aria-controls="shell-nav" data-collapse>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M10 4L6 8L10 12" />
            </svg>
          </button>
        </div>
        <nav className="p8-shell__nav" id="shell-nav" aria-label="Sidebar">
          <a className="p8-shell__item" href="#home" data-nav>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.75 7.75L8 2.5L13.25 7.75V12.25Q13.25 13.25 12.25 13.25H3.75Q2.75 13.25 2.75 12.25Z" />
              <path d="M6.75 13.25V9.75H9.25V13.25" />
            </svg>
            <span className="p8-shell__label">Home</span>
          </a>
          <a className="p8-shell__item p8-shell__item--active" href="#projects" data-nav aria-current="page">
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <path d="M2.75 6.75V4.75Q2.75 2.75 4.75 2.75H6L8 4.75H11.25Q13.25 4.75 13.25 6.75V11.25Q13.25 13.25 11.25 13.25H4.75Q2.75 13.25 2.75 11.25Z" />
            </svg>
            <span className="p8-shell__label">Projects</span>
          </a>
          <a className="p8-shell__item" href="#team" data-nav>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <circle cx="8" cy="4.5" r="2" />
              <path d="M2.75 13.25C2.75 7 13.25 7 13.25 13.25" />
            </svg>
            <span className="p8-shell__label">Team</span>
          </a>
          <a className="p8-shell__item" href="#settings" data-nav>
            <svg className="p8-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="2.75" y1="4.75" x2="13.25" y2="4.75" />
              <line x1="2.75" y1="11.25" x2="13.25" y2="11.25" />
              <line x1="5.75" y1="2.75" x2="5.75" y2="6.25" />
              <line x1="10.25" y1="9.75" x2="10.25" y2="13.25" />
            </svg>
            <span className="p8-shell__label">Settings</span>
          </a>
        </nav>
      </aside>
      <div className="p8-shell__main">
        <header className="p8-shell__header">
          <h1 className="p8-shell__title">Projects</h1>
          <button className="p8-button p8-button--primary" type="button" data-action="New project">
            <svg className="p8-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
              <line x1="2.75" y1="6.75" x2="11.25" y2="6.75" />
              <line x1="6.75" y1="2.75" x2="6.75" y2="11.25" />
            </svg>
            New project
          </button>
        </header>
        <main className="p8-shell__content" tabIndex="-1">
          <p className="p8-shell__placeholder">Page content goes here.</p>
        </main>
      </div>
    </div>
  );
}

/* app-shell.css */
.p8-shell {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  width: 100%;
  min-height: 100dvh;
  box-sizing: border-box;
  background: var(--p8-color-canvas);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-shell--framed {
  width: var(--p8-size-720);
  max-width: 100%;
  height: var(--p8-size-400);
  min-height: 0;
  overflow: hidden;
  border-radius: var(--p8-radius-12);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
}

.p8-shell__side {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-12);
  width: var(--p8-size-240);
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-12);
  background: var(--p8-color-surface);
  border-right: var(--p8-border-hairline) solid var(--p8-color-ring);
  overflow: hidden;
  transition: width var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-shell__side .p8-shell__label {
  transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-shell__side-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-8);
}

.p8-shell__brand {
  display: inline-flex;
  align-items: center;
  gap: var(--p8-space-8);
  font-weight: var(--p8-type-weight-strong);
  white-space: nowrap;
  min-width: 0;
}

.p8-shell__logo {
  width: var(--p8-size-24);
  height: var(--p8-size-24);
  flex-shrink: 0;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-ink);
}

.p8-iconbtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  cursor: pointer;
}

.p8-iconbtn:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-iconbtn:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-iconbtn:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-iconbtn[hidden] {
  display: none;
}

.p8-iconbtn--flat {
  background: transparent;
}

.p8-iconbtn--flat:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-shell__toggle svg {
  transition: rotate var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-icon {
  flex-shrink: 0;
}

.p8-shell__nav {
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-shell__item {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  color: var(--p8-color-ink-muted);
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
}

.p8-shell__item:hover:not(:disabled) {
  color: var(--p8-color-ink);
  background: var(--p8-color-control);
}

.p8-shell__item:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-shell__item--active {
  color: var(--p8-color-ink);
  background: var(--p8-color-control-strong);
}

.p8-shell__main {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}

.p8-shell__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p8-space-12);
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-shell__title {
  margin: 0;
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-md);
  line-height: var(--p8-type-line-md);
  font-weight: var(--p8-type-weight-strong);
}

.p8-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--p8-space-8);
  padding-block: var(--p8-space-8);
  padding-inline: var(--p8-space-12);
  border-radius: var(--p8-radius-8);
  border: none;
  background: var(--p8-color-control);
  color: var(--p8-color-ink);
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
  cursor: pointer;
}

.p8-button:hover:not(:disabled) {
  background: var(--p8-color-control-strong);
}

.p8-button:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
}

.p8-button:disabled {
  opacity: var(--p8-opacity-disabled);
  cursor: not-allowed;
}

.p8-button[hidden] {
  display: none;
}

.p8-button--primary {
  background: var(--p8-color-ink);
  color: var(--p8-color-ink-inverse);
}

.p8-button--primary:hover:not(:disabled) {
  background: var(--p8-color-ink);
  opacity: var(--p8-opacity-hover);
}

.p8-shell__content {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-block: var(--p8-space-16);
  padding-inline: var(--p8-space-16);
}

.p8-shell__placeholder {
  margin: 0;
  color: var(--p8-color-ink-muted);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="shell"] [data-collapse]');
    if (!b) return;
    var sh = b.closest('[data-p8~="shell"]'), side = sh.querySelector('aside'), on = !side.classList.contains('p8-shell__side--on');
    side.classList.toggle('p8-shell__side--on', on);
    b.setAttribute('aria-expanded', String(!on)); b.setAttribute('aria-label', on ? 'Expand sidebar' : 'Collapse sidebar');
    Array.from(sh.querySelectorAll('[data-nav]')).forEach(function (a) {
      var l = a.lastElementChild;
      if (on && l) a.setAttribute('title', l.textContent.trim()); else a.removeAttribute('title');
    });
    sh.dispatchEvent(new CustomEvent('p8-toggle', { bubbles: true, detail: { collapsed: on } }));
  }, { signal: ac.signal });

  root.addEventListener('click', function (e) {
    var a = cl(e, '[data-p8~="nav"] [data-nav]');
    if (!a) return;
    e.preventDefault();
    var host = a.parentNode;
    Array.from(host.querySelectorAll('[data-nav]')).forEach(function (x) {
      var on = x === a;
      if (on) x.setAttribute('aria-current', 'page'); else x.removeAttribute('aria-current');
      ['p8-navbar__link', 'p8-shell__item'].forEach(function (b) { if (x.classList.contains(b)) x.classList.toggle(b + '--active', on); });
    });
    var label = a.lastElementChild && a.querySelector('svg') ? a.lastElementChild.textContent : a.textContent;
    a.dispatchEvent(new CustomEvent('p8-navigate', { bubbles: true, detail: { label: label.trim(), href: a.getAttribute('href') } }));
  }, { signal: ac.signal });

  root.addEventListener('click', function (e) {
    var b = cl(e, '[data-p8~="action"] [data-action]');
    if (!b || b.disabled) return;
