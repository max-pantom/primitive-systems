  .p8-dtable__arrow {
    opacity: 0;
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease), rotate var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-dtable__sort:hover .p8-dtable__arrow, .p8-dtable__sort:focus-within .p8-dtable__arrow {
    opacity: 1;
