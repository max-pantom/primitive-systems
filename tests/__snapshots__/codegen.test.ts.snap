"// Chart.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './chart.css';

export function Chart() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <figure ref={ref} className="p8-chart" data-p8="chart" data-chart="{&quot;labels&quot;:[&quot;Jan&quot;,&quot;Feb&quot;,&quot;Mar&quot;,&quot;Apr&quot;,&quot;May&quot;,&quot;Jun&quot;],&quot;series&quot;:[{&quot;name&quot;:&quot;Revenue&quot;,&quot;values&quot;:[120,150,170,140,190,230]},{&quot;name&quot;:&quot;Costs&quot;,&quot;values&quot;:[80,95,110,100,120,130]}]}">
