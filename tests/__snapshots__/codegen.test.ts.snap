<style>
  .p8-shell {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    width: 100%;
    min-height: 100dvh;
    box-sizing: border-box;
    background: var(--p8-color-canvas);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
  }

  .p8-shell__side {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-12);
    width: var(--p8-size-240);
    box-sizing: border-box;
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-12);
    background: var(--p8-color-surface);
    border-right: var(--p8-border-hairline) solid var(--p8-color-ring);
    overflow: hidden;
    transition: width var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-shell__side .p8-shell__label {
    transition: opacity var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-shell__side--on {
    width: var(--p8-size-72);
  }

  .p8-shell__side--on .p8-shell__label {
    position: absolute;
    width: var(--p8-size-16);
    height: var(--p8-size-16);
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .p8-shell__side--on .p8-shell__brand {
    display: none;
  }

  .p8-shell__side--on .p8-shell__side-head {
    justify-content: center;
  }

  .p8-shell__side--on .p8-shell__toggle svg {
    rotate: 180deg;
  }

  .p8-shell__side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-8);
  }

  .p8-shell__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--p8-space-8);
    font-weight: var(--p8-type-weight-strong);
    white-space: nowrap;
    min-width: 0;
  }

  .p8-shell__logo {
    width: var(--p8-size-24);
    height: var(--p8-size-24);
    flex-shrink: 0;
    border-radius: var(--p8-radius-8);
    background: var(--p8-color-ink);
  }

  .p8-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    cursor: pointer;
  }

  .p8-iconbtn:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-iconbtn:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-iconbtn:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-iconbtn[hidden] {
    display: none;
  }

  .p8-iconbtn--flat {
    background: transparent;
  }

  .p8-iconbtn--flat:hover:not(:disabled) {
    background: var(--p8-color-control);
  }

  .p8-shell__toggle svg {
    transition: rotate var(--p8-motion-fast) var(--p8-motion-ease);
  }

  .p8-icon {
    flex-shrink: 0;
  }

  .p8-shell__nav {
    display: flex;
    flex-direction: column;
    gap: var(--p8-space-4);
  }

  .p8-shell__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    color: var(--p8-color-ink-muted);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .p8-shell__item:hover:not(:disabled) {
    color: var(--p8-color-ink);
    background: var(--p8-color-control);
  }

  .p8-shell__item:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-shell__item--active {
    color: var(--p8-color-ink);
    background: var(--p8-color-control-strong);
  }

  .p8-shell__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }

  .p8-shell__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--p8-space-12);
    padding-block: var(--p8-space-12);
    padding-inline: var(--p8-space-16);
    border-bottom: var(--p8-border-hairline) solid var(--p8-color-ring);
  }

  .p8-shell__title {
    margin: 0;
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-md);
    line-height: var(--p8-type-line-md);
    font-weight: var(--p8-type-weight-strong);
  }

  .p8-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--p8-space-8);
    padding-block: var(--p8-space-8);
    padding-inline: var(--p8-space-12);
    border-radius: var(--p8-radius-8);
    border: none;
    background: var(--p8-color-control);
    color: var(--p8-color-ink);
    font-family: var(--p8-type-family);
    font-size: var(--p8-type-size-sm);
    line-height: var(--p8-type-line-sm);
    font-weight: var(--p8-type-weight);
    cursor: pointer;
  }

  .p8-button:hover:not(:disabled) {
    background: var(--p8-color-control-strong);
  }

  .p8-button:focus-visible {
    box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  }

  .p8-button:disabled {
    opacity: var(--p8-opacity-disabled);
    cursor: not-allowed;
  }

  .p8-button[hidden] {
    display: none;
  }

  .p8-button--primary {
    background: var(--p8-color-ink);
    color: var(--p8-color-ink-inverse);
  }

  .p8-button--primary:hover:not(:disabled) {
    background: var(--p8-color-ink);
    opacity: var(--p8-opacity-hover);
  }

  .p8-shell__content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-block: var(--p8-space-16);
    padding-inline: var(--p8-space-16);
  }

  .p8-shell__placeholder {
    margin: 0;
    color: var(--p8-color-ink-muted);
  }
</style>
"
`;

