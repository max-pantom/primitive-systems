      <svg className="p8-icon p8-copybtn__icon p8-copybtn__icon--on" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
