"// ResizablePanels.tsx — Requires the Primitive Systems theme variables (theme.css).
import { useEffect, useRef } from 'react';
import './resizable-panels.css';

export function ResizablePanels() {
  const ref = useRef<any>(null);
  useEffect(() => initP8(ref.current), []);
  return (
    <div ref={ref} className="p8-resize" data-p8="resize">
      <div className="p8-resize__pane p8-resize__pane--first" data-pane style={{ flexBasis: "40%" }}>
        <span className="p8-resize__title">Navigation</span>
        <span>Placeholder content</span>
      </div>
      <div className="p8-resize__handle" role="separator" tabIndex="0" aria-orientation="vertical" aria-label="Resize Navigation and Content" aria-valuenow="40" aria-valuemin="20" aria-valuemax="80" data-handle></div>
      <div className="p8-resize__pane">
        <span className="p8-resize__title">Content</span>
        <span>Placeholder content</span>
      </div>
    </div>
  );
}

/* resizable-panels.css */
.p8-resize {
  display: flex;
  width: var(--p8-size-500);
  max-width: 100%;
  height: var(--p8-size-240);
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--p8-radius-8);
  background: var(--p8-color-surface);
  color: var(--p8-color-ink);
  outline: var(--p8-border-hairline) solid var(--p8-color-ring);
  outline-offset: calc(-1 * var(--p8-border-hairline));
  font-family: var(--p8-type-family);
  font-size: var(--p8-type-size-sm);
  line-height: var(--p8-type-line-sm);
  font-weight: var(--p8-type-weight);
}

.p8-resize__pane {
  flex: 1 1 0;
  min-width: 0;
  min-height: 0;
  overflow: auto;
  box-sizing: border-box;
  padding-block: var(--p8-space-12);
  padding-inline: var(--p8-space-16);
  display: flex;
  flex-direction: column;
  gap: var(--p8-space-4);
}

.p8-resize__pane--first {
  flex: 0 0 auto;
}

.p8-resize__title {
  font-weight: var(--p8-type-weight-strong);
}

.p8-resize__handle {
  position: relative;
  flex: 0 0 var(--p8-space-8);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: col-resize;
  touch-action: none;
  background: transparent;
  transition: background var(--p8-motion-fast) var(--p8-motion-ease);
}

.p8-resize__handle:hover:not(:disabled) {
  background: var(--p8-color-control);
}

.p8-resize__handle:focus-visible {
  box-shadow: 0 0 0 var(--p8-border-focus) var(--p8-color-ring-focus);
  outline: none;
}

.p8-resize__handle::before {
  content: '';
  position: absolute;
  inset: 0;
  margin: auto;
  width: 0;
  height: 100%;
  border-left: var(--p8-border-hairline) solid var(--p8-color-ring);
}

.p8-resize__handle[aria-orientation="horizontal"] {
  cursor: row-resize;
}

.p8-resize__handle[aria-orientation="horizontal"]::before {
  width: 100%;
  height: 0;
  border-left: none;
  border-top: var(--p8-border-hairline) solid var(--p8-color-ring);
}

// ---behavior---
function initP8(root, opts) {
  opts = opts || {};
  var ac = new AbortController(), timers = [];
  var doc = root.ownerDocument || root;
  function cl(e, sel) { var t = e.target; return t && t.closest ? t.closest(sel) : null; }
  function all(sel) { return Array.from(root.querySelectorAll(sel)).concat(root.matches && root.matches(sel) ? [root] : []); }


