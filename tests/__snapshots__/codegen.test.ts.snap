    <div style="display: flex; align-items: center; justify-content: space-between">
      <h2 style="margin: 0; font-family: var(--p8-type-family); font-size: var(--p8-type-size-md); line-height: var(--p8-type-line-md); font-weight: var(--p8-type-weight-strong)">Sheet title</h2>
      <button class="p8-sheet__close" style="display: inline-flex; padding: var(--p8-space-4); border: none; background: transparent; color: inherit; cursor: pointer; border-radius: var(--p8-radius-8)" type="button" aria-label="Close" data-close>
        <svg style="flex-shrink: 0" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="4" x2="12" y2="12" />
          <line x1="12" y1="4" x2="4" y2="12" />
        </svg>
