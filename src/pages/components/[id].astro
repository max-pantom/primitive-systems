---
import Layout from '../../layouts/Layout.astro';
import Playground from '../../docs/Playground';
import { components, getDef } from '../../components';

export function getStaticPaths() {
  return components.map((c) => ({ params: { id: c.id } }));
}
const def = getDef(Astro.params.id!)!;
---
<Layout title={def.name} current={def.id}>
  <Playground client:load id={def.id} />
</Layout>
