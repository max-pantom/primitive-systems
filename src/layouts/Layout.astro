---
import '../styles/global.css';
import { site } from '../config/site';
import { components } from '../components';
import { allCss } from '../codegen';
import ThemeToggle from '../docs/ThemeToggle';
interface Props { title: string; current?: string }
const { title, current } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {site.name}</title>
    <link rel="stylesheet" href="/theme.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" />
    <style set:html={allCss()} />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('theme') ||
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <div class="grid min-h-screen grid-cols-[240px_1fr]">
      <aside class="flex flex-col gap-6 p-4 sticky top-0 h-screen box-border">
        <a href="/" class="font-medium">{site.name}</a>
        <nav class="nav flex flex-col gap-1" aria-label="Components">
          {components.map((c) => <a href={`/components/${c.id}`} aria-current={current === c.id ? 'page' : undefined}>{c.name}</a>)}
        </nav>
        <div class="mt-auto flex flex-col gap-3">
          <div data-testid="seeds-banner" class="hairline rounded-lg p-3">
            <div class="font-medium">DESIGN SEEDS — applied</div>
            <div class="muted">2 of 2 seeds drive every token. Hover, focus and disabled are derived; confirm in <code>seeds/README.md</code>.</div>
          </div>
          <ThemeToggle client:load />
        </div>
      </aside>
      <main class="p-8 box-border min-w-0"><slot /></main>
    </div>
  </body>
</html>
